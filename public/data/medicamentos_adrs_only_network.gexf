          <attvalue for="2" value="[{&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Paroxetina me fazendo sentir como se tivesse Parkinson&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;1 dia sem bupropiona. Boca já está menos seca, diminuiu o trismo. Humor um pouco mais rebaixado.&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;última semana, acabei de tomar meu venlafaxina, acordei com um quase torcicolo, meus olhos tremem sempre e eu amo muito ainda em 2024 \n\nbingo&quot;}]" />
