      <node id="Methylphenidate" label="Methylphenidate">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="55" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Headache&quot;, &quot;content&quot;: &quot;esqueço de tomar metilfenidato: no máximo uma dorzinha de cabeça \n\nesqueço a desvenlafaxina: dor morte tendências homicid&quot;}|||{&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;galera acho que misturar energético, metilfenidato e nicotina começou a dar ruim, to tremendo \n\n(sim, eu sei que dá ruim e eu vou morrer. é o objetivo. o post é irônico. obg.)&quot;}|||{&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;lembrete: NUNCA tomar café quando eu for tomar metilfenidato, to tremendo aqui\nporra, o café demorou muito tempo pra funcionar, tomei meu remedio dps do almoço E AGR O CAFÉ FEZ EFEITO... PQP&quot;}|||{&quot;category&quot;: &quot;Nervosismo&quot;, &quot;content&quot;: &quot;passar nervoso depois de 18mg de metilfenidato é um laxante alternativo&quot;}|||{&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;Só para vocês terem noção: o metilfenidato pode produzir intoxicação dopaminérgica e envelhecer/demanciar um cérebro de uma pessoa n-TDAH, mas pode gerar neurônios e fazê-loa se conectá-los com mais destreza em alguns autistas e na maioria dos TDAHs.&quot;}|||{&quot;category&quot;: &quot;Tensão muscular&quot;, &quot;content&quot;: &quot;Só para vocês terem noção: o metilfenidato pode produzir intoxicação dopaminérgica e envelhecer/demanciar um cérebro de uma pessoa n-TDAH, mas pode gerar neurônios e fazê-loa se conectá-los com mais destreza em alguns autistas e na maioria dos TDAHs.&quot;}|||{&quot;category&quot;: &quot;Voices in my head&quot;, &quot;content&quot;: &quot;A receita tava substância pq primeiro testei o metilfenidato genérico, aí minha mãe chega c ritalina (não é genérico). Ok vamos lá testar se marca melhora esse possível efeito colateral fonte vozes da minha cabeça q não tá descrito na bula nem em nenhum dos estudos ou na vdd foi só uma coincidência&quot;}|||{&quot;category&quot;: &quot;Eufemismo&quot;, &quot;content&quot;: &quot;As pessoas ao menos sabem que metilfenidato é um eufemismo para cocaína?\n\nEle mimetiza a ação estimulante do cloridrato em pó. Temos cocaína sendo vendida em caixinhas na farmácia.&quot;}|||{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;ayer me equivoqué con la dosis de la tesilina (aka metilfenidato, medicina pa hacer la tesis), dupliqué la dosis, me dormí tardísimo, me desperté tardísimo y estoy pagando las consecuencias. #nolohagacompa&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;ENANO: ¡Me levanto todos los días a las 6:30 y me chupo tres cuartos de hora de autobús para llegar al instituto!\nYO: Sí, aunque duerme bien se levanta muy temprano. Querían darle metilfenidato de pequeño y lo rechazamos, así que cuando empezó a madrugar decidimos que cafeína mejor que anfetas.&quot;}|||{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;onda este es mi último recurso, estoy cansado de tener mucho sueño todo el día y tener que andar tomando metilfenidato a cada rato para despertar 🥺&quot;}|||{&quot;category&quot;: &quot;Estresse&quot;, &quot;content&quot;: &quot;Igual me da miedito porque ando en metilfenidato y se supone que me pueden subir la presión \nAndo vigilante nomas porque me parece que la venla me hace efecto muy bien&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;Eu tentando me concentrar e tenho q levantar de 10 em 10 minutos pq n paro de suar e nem tá calor nessa porra, se o metilfenidato aumentar a minha sudorese eu vou ficar PUTA pq grande ironia o remédio q deveria me ajudar me atrapalhar por causa de SUOR&quot;}|||{&quot;category&quot;: &quot;Tremors&quot;, &quot;content&quot;: &quot;Por supuesto que no aprendo y me tomé el metilfenidato con café y ahora ando todo tembloroso&quot;}|||{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;Sobrevivo a puro metilfenidato todos los días 😭 pinche hipersomnia&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;fiz novamente: misturei metilfenidato com energético. o burro morre pela boca.&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;Para el tdah? Qué tomabas antes? \nYo noto que el metilfenidato de marca genérica me da menos ansiedad que el concerta.&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;eu já tomei metilfenidato (não tomava energético na época), mas tive que parar pq me dava muuuuita ansiedade e taquicardia, fora que a baixa dele quando passa o efeito é terrível, eu ficava me sentindo muito deprimida e burra&quot;}|||{&quot;category&quot;: &quot;Taquicardia&quot;, &quot;content&quot;: &quot;eu já tomei metilfenidato (não tomava energético na época), mas tive que parar pq me dava muuuuita ansiedade e taquicardia, fora que a baixa dele quando passa o efeito é terrível, eu ficava me sentindo muito deprimida e burra&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;eu já tomei metilfenidato (não tomava energético na época), mas tive que parar pq me dava muuuuita ansiedade e taquicardia, fora que a baixa dele quando passa o efeito é terrível, eu ficava me sentindo muito deprimida e burra&quot;}|||{&quot;category&quot;: &quot;Calafrios&quot;, &quot;content&quot;: &quot;Amor al metilfenidato pero en verano me da más calor&quot;}|||{&quot;category&quot;: &quot;Embotamento afetivo&quot;, &quot;content&quot;: &quot;E com essa situação eu consegui identificar uma mudança no meu humor que a falta do metilfenidato está fazendo. Eu não me irritava tanto e com tanta facilidade enquanto tomava ele.\nMeu humor está bem mais desregulado.&quot;}|||{&quot;category&quot;: &quot;Alerta social&quot;, &quot;content&quot;: &quot;El metilfenidato es especialmente arriesgado con autistas y si se desaconseja como primera opción en TDAH es especialmente desaconsejado en cualquier grupo con riesgo aumentado de presentar brotes psicóticos (como los autistas). Pero claro que puede ayudar cuando nada más funciona.&quot;}|||{&quot;category&quot;: &quot;Constipação&quot;, &quot;content&quot;: &quot;En mi caso era con el metilfenidato y la sensación era de estar llena constantemente. Perdí 6 kg en los dos meses que estuve intentando con esa a ver si se equilibraba al subir la dosis.\nMe pasaron a lisdexanfetamina y ya no me ocurre.&quot;}|||{&quot;category&quot;: &quot;Perda de peso&quot;, &quot;content&quot;: &quot;En mi caso era con el metilfenidato y la sensación era de estar llena constantemente. Perdí 6 kg en los dos meses que estuve intentando con esa a ver si se equilibraba al subir la dosis.\nMe pasaron a lisdexanfetamina y ya no me ocurre.&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;El metilfenidato me está dando una ansiedad la perra ☠️&quot;}|||{&quot;category&quot;: &quot;Inibição social&quot;, &quot;content&quot;: &quot;frutas cítricas aumentam o efeito de opiáceos e opióides mas diminuem o de anfetaminas e metilfenidato talvez não se possa ter tudo mesmo&quot;}|||{&quot;category&quot;: &quot;Exaustão&quot;, &quot;content&quot;: &quot;Dias como hoje em q eu me sinto me arrastando APESAR de ter tomado meu remedinho™ do TDAH me fazem questionar o q alguém q não tem TDAH sente qnd toma lisdex ou metilfenidato&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;a mí el café me relaja, me da hasta sueño, lo mismo que cualquier energética o el metilfenidato 🤠&quot;}|||{&quot;category&quot;: &quot;Paralisia&quot;, &quot;content&quot;: &quot;Es que si son días divertidos lo desperdicio, en cambio para días tediosos es ideal. A mí me da mucha parálisis ejecutiva, entonces si me siento en parálisis empiezo a tomar el metilfenidato&quot;}|||{&quot;category&quot;: &quot;Hipoventilação&quot;, &quot;content&quot;: &quot;um dia sem metilfenidato é como uma realidade sem lesbicas é tipo a day without sunshine (nao paro de bocejar&quot;}|||{&quot;category&quot;: &quot;Perda de apetite&quot;, &quot;content&quot;: &quot;supongo que depende de cada uno! a mi por ejemplo el metilfenidato (yo tomaba equasym) me anulaba por completo el apetito y era incapaz de comer (ni de dormir), pero conozco a otra gente a la que le va genial! ojalá a mí, porque el puto elvanse es caro como el infierno 🥲&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;supongo que depende de cada uno! a mi por ejemplo el metilfenidato (yo tomaba equasym) me anulaba por completo el apetito y era incapaz de comer (ni de dormir), pero conozco a otra gente a la que le va genial! ojalá a mí, porque el puto elvanse es caro como el infierno 🥲&quot;}|||{&quot;category&quot;: &quot;Enxaqueca&quot;, &quot;content&quot;: &quot;aí é bem ruim :(( que pena que não se adaptou\nme ajudou mt\neu tentei com metilfenidato e não deu nada certo, tive a pior enxaqueca da minha vida&quot;}|||{&quot;category&quot;: &quot;Vertigem&quot;, &quot;content&quot;: &quot;hoje não tomei o metilfenidato porque acho que tá me dando enxaqueca mas aí tou feito barata tonta tentando ser produtivo fazendo tudo de forma desorganizada&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Gente, cês também precisa gozar pra acordar de fato quando estão sem metilfenidato?\n\nSenhor, meu nome é sono.&quot;}|||{&quot;category&quot;: &quot;Mania&quot;, &quot;content&quot;: &quot;nao sei se eh o metilfenidato ou o escitalopram ou a venlafaxina ou a quetiapina ou o rexulti ou o litio\n\nmas eu ando me sentindo imensamente feliz&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;N tomei metilfenidato hoje então to o dia inteiro pescando os olho&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;eu falei que estava super elétrica pq tomei café dps de tomar cloridrato de metilfenidato (remédio pro tratamento do meu TDAH) e falei também que eu fiquei 6 horas dormindo direto por causa disso, isso é romantizar?  não só falei abertamente meus sintomas pq fiz sem perceber algo contraindicado&quot;}|||{&quot;category&quot;: &quot;Dor&quot;, &quot;content&quot;: &quot;traz meu metilfenidato prefeitura, por favor, eu já tô ficando dodói de novo&quot;}|||{&quot;category&quot;: &quot;Arritmia&quot;, &quot;content&quot;: &quot;Metilfenidato com cafeína realmente é algo que induz taquicardia, todos os NDRIs, mesmo em dosagens baixas me passam uma impressão de desconforto quando misturado com qualquer outro stim&quot;}|||{&quot;category&quot;: &quot;Arritmia&quot;, &quot;content&quot;: &quot;agora meu pai me botou neura depois de estar tomando metilfenidato tem 1 ano\n\&quot;presta atenção se teu ritmo cardíaco tá alterado, tu que corre\&quot;\nkkkkkkkk me dar uma mi band e ele não quer né&quot;}|||{&quot;category&quot;: &quot;Hiperventilação&quot;, &quot;content&quot;: &quot;Essa semana meu café da manhã tem sido um comprimido de antidepressivo, outro de metilfenidato e uma xícara de café. \nTá osso conseguir comer&quot;}|||{&quot;category&quot;: &quot;Efeito rebote&quot;, &quot;content&quot;: &quot;dependo do metilfenidato pra conseguir me concentrar e fazer o que tenho pra fazer mas nao posso tomar toda hora pq da efeito rebote nao posso ter nada mesmo&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;metilfenidato você não tá com nada mesmo, irei te despedir do meu corpo, não consegue fazer sua função direito e ainda quando vai embora me deixa super ansioso&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;é muito estranho que eu só consigo funcionar mesmo algumas horas depois que o primeiro pico do metilfenidato. esse primeiro pico sempre é acompanhado de uma ansiedade considerável, é uma mistura esquisita de sono e agitação. tdah é massa po.&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;é muito estranho que eu só consigo funcionar mesmo algumas horas depois que o primeiro pico do metilfenidato. esse primeiro pico sempre é acompanhado de uma ansiedade considerável, é uma mistura esquisita de sono e agitação. tdah é massa po.&quot;}|||{&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;aún hay metilfenidato en este cuerpo y mi cuerpo lo sabe (me duele la cabeza porque sed y hambrita, más sed que hambrita)&quot;}|||{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;Cómo chucha con un metilfenidato entero me quiere dar sueño ;;&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Yo: quería hacer el multistep form para el character tracker con react hoy.\nYo: procedo a dormir toda la tarde porque supongo que el metilfenidato hizo eso conmigo hoy.\n\nYa será.&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Yo: -toma medio metilfenidato-\nYo: -se duerme toda la tarde y sigue con tutito-\n\n?????&quot;}|||{&quot;category&quot;: &quot;Sleepiness&quot;, &quot;content&quot;: &quot;el problema no es mimir, porque yo duermo (gracias al metilfenidato) y Nacchi duerme (gracias a que tiene el talento de tocar la almohada y mimir en el acto). El problema es que las luces culias estan encendidas de dia y de noche, pasan piola a menos que nos tiremos a la cama&quot;}|||{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;No es solo el trabajo, vengo con un down de metilfenidato y estoy a 2 pastillas de distancia de mimir en la oficina&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;Me estoy metiendo tanto té, miel y sopa en el cuerpo que voy a acabar como uno de los monjes momificados esos. \n\nY yessss, el psiquiatra me confirmó que el metilfenidato me estaba causando depresión xD A probar otras cosas.&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;Me estoy quedando dormidisimo en la clase pero no me puedo tomar el metilfenidato, super F&quot;}" />
          <attvalue for="3" value="36" />
          <attvalue for="4" value="1" />
          <attvalue for="5" value="-0.811584 -0.917850" />
          <attvalue for="6" value="#2DCD9F" />
        </attvalues>
      </node>
      <node id="Venlafaxina" label="Venlafaxina">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="83" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Sedação&quot;, &quot;content&quot;: &quot;\&quot;se puede\&quot; pero no lo recomiendan por los efectos adversos que trae, igual depende del antidepresivo y el cuerpo, por ejemplo con la venlafaxina tomé mucho y tuve caña de 2-3 días 💀💀💀 y con el escitalopram si tomo harta agua mientras tomo, no me pasa nada y 0 caña jeje&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;kahsjwkwjwjw eu tomo venlafaxina 😭 o nome fluoxetina é por causa de um paciente cachorro 😁 posso tomar nada q me dê mais vontade de dormir nao kkkkkkk&quot;}|||{&quot;category&quot;: &quot;Inquietação&quot;, &quot;content&quot;: &quot;Mi hija toma paroxetina y mi marido venlaflaxina, uno es solo inhibidor de la recaptación y el otro también tiene estimulante (uno es como un porro y el otro es como M) se supone que ambos te tienen que quitar las pesadillas y los pensamientos intrusivos (la cabeza a toda velocidad).&quot;}|||{&quot;category&quot;: &quot;Arritmia&quot;, &quot;content&quot;: &quot;La paroxetina, che ricordi\nPoi la duloxetina e infine la venlafaxina a cui sono tanto affezionato ma che mi ha rovinato il muscolo cardiaco\n\nPosso solo mandarti un grosso in bocca al lupo&quot;}|||{&quot;category&quot;: &quot;Enxaqueca&quot;, &quot;content&quot;: &quot;Tenho me sentido tão mal ultimamente que meu psiquiatra aumentou mais um remédio pra eu fazer uso. 4 comprimidos de manhã da venlafaxina+ 1 comprimido a noite de mirtazapina e agora 1 comprimido de depakene... tem acontecido tanta coisa que tenho pra piorar sentido muita enxaqueca...&quot;}|||{&quot;category&quot;: &quot;Disforia&quot;, &quot;content&quot;: &quot;Si el fármaco pertenece a la familia de los IRSN como la venlafaxina, desvenlafaxina o la duloxetina es bastante normal que produzcan disforia si se interrumpe de golpe, aunque sean dos días. Los ISRS como la fluoxetina o el escitalopram toleran mucho mejor los despistes.&quot;}|||{&quot;category&quot;: &quot;Alucinação&quot;, &quot;content&quot;: &quot;Esse remédio mexe com seu corpo inteiro pqp, é o remédio mais louco que eu experimentei\nEu já sentia isso com o venlafaxina também, mas tô sentindo mais com o duloxetina\nE me dá uma fome desgraçada&quot;}|||{&quot;category&quot;: &quot;Síndrome serotoninérgica&quot;, &quot;content&quot;: &quot;Esse remédio mexe com seu corpo inteiro pqp, é o remédio mais louco que eu experimentei\nEu já sentia isso com o venlafaxina também, mas tô sentindo mais com o duloxetina\nE me dá uma fome desgraçada&quot;}|||{&quot;category&quot;: &quot;Formigamento&quot;, &quot;content&quot;: &quot;nossa eu odiei usar venlafaxina! Minha perna formigava e eu sentia que ficava mais dopado que tudo.&quot;}|||{&quot;category&quot;: &quot;Sedação&quot;, &quot;content&quot;: &quot;nossa eu odiei usar venlafaxina! Minha perna formigava e eu sentia que ficava mais dopado que tudo.&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;hoje eu apenas quis chorar uma vez cada dia resistindo melhor a diminuição da venlafaxina no meu corpo&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;amiga, é a venlafaxina\n\nela me deixa menos ansiosa e menos estressada e isso tem contribuído bastante pra eu não desistir de sair de casa&quot;}|||{&quot;category&quot;: &quot;Estresse&quot;, &quot;content&quot;: &quot;amiga, é a venlafaxina\n\nela me deixa menos ansiosa e menos estressada e isso tem contribuído bastante pra eu não desistir de sair de casa&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Bom dia de hoje para:\n- Todos que sofrem com semana de 5 dias adiante;\n- Usuários de divalproato de sódio, venlafaxina (ou desvenla), diagnosticados com TDAH;\n- Os que tem medo de amar tanto quanto sentem vontade;\n- Quem treina peito hoje.&quot;}|||{&quot;category&quot;: &quot;Embotamento afetivo&quot;, &quot;content&quot;: &quot;amanha faz 1 semana que aumentei o venlafaxina e eu já to tão anestesiado que não to mais ligando de ta + 6 meses sem beijar (o * não conta pq eu dissociei ja, nem lembro)&quot;}|||{&quot;category&quot;: &quot;Pesadelos&quot;, &quot;content&quot;: &quot;mano pelo amor de deus pesadelo de abstinencia de venlafaxina é ruim demais pqp&quot;}|||{&quot;category&quot;: &quot;Nausea&quot;, &quot;content&quot;: &quot;É Venlafaxina? Esse me deixou muito nauseada nas primeiras semanas.&quot;}|||{&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;Cinco dias já tomando Venlafaxina e continuo me sentindo bem enjoado. Alguém que já tomou sabe se isso passa?&quot;}|||{&quot;category&quot;: &quot;Interação medicamentosa&quot;, &quot;content&quot;: &quot;vc já tomou sumax? se tiver muito forte toma sumax pro. mas se vc toma venlafaxina cuidado que não eh bom misturar (eu e meu namorado ja misturamos com venla e deu tudo certo mas tá na bula então Teje Avisado)&quot;}|||{&quot;category&quot;: &quot;Nausea&quot;, &quot;content&quot;: &quot;Eu tomei 150mg de venlafaxina por 3 dias so e foi o suficiente pra eu quase ir de comes e bebes, foi a pior experiência que eu já tive na vida&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;Maluco\nPrimeira hora depois de tomar venlafaxina pela primeira vez pensei que ia morrer&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;Real, e a venlafaxina é pior, hj eu tomo a desve e no máximo que dá quando eu esqueço é essa doidera aí. Quando eu esquecia a venlafaxina parecia que tinha uma bomba na minha cabeça pronta pra explodir a qualquer segundo&quot;}|||{&quot;category&quot;: &quot;Comportamento impulsivo&quot;, &quot;content&quot;: &quot;posso ter tomado 140mg de venlafaxina por n lembrar se tinha tomado de manha ou nao quais as chances de eu parar no hospital hoje&quot;}|||{&quot;category&quot;: &quot;Dizziness&quot;, &quot;content&quot;: &quot;dia (?) de desmame da venlafaxina \n\n- minha libido existe\n- eu nao demoro mais 3 dias uteis pra gozar 🙏🙏\n- fora a tontura nao ando tendo mtos efeitos colaterais&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;venlafaxina eu nunca vou te perdoar pela sudorese e me fazer tomar banho com uma garrafa de água da geladeira. que humilhação&quot;}|||{&quot;category&quot;: &quot;Dizso&quot;, &quot;content&quot;: &quot;diário de desmame total da venlafaxina:\n\n- eu to tonto pra caralho puta que pariu\n- minha libido voltou ao normal (?)&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;nossa, pra mim ela serviu super. a que acabou cmg foi a venlafaxina, eu fiquei parecendo um cracudo, suando horrores, irritado, tendo pesadelos...um horror.&quot;}|||{&quot;category&quot;: &quot;Irritação&quot;, &quot;content&quot;: &quot;nossa, pra mim ela serviu super. a que acabou cmg foi a venlafaxina, eu fiquei parecendo um cracudo, suando horrores, irritado, tendo pesadelos...um horror.&quot;}|||{&quot;category&quot;: &quot;Pesadelos&quot;, &quot;content&quot;: &quot;nossa, pra mim ela serviu super. a que acabou cmg foi a venlafaxina, eu fiquei parecendo um cracudo, suando horrores, irritado, tendo pesadelos...um horror.&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;A minha querida (inimiga) venlafaxina está in&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;A minha querida (inimiga) venlafaxina está in&quot;}|||{&quot;category&quot;: &quot;Confusão&quot;, &quot;content&quot;: &quot;quantos dias demora para passar os efeitos colerais da venlafaxina? hoje é o segundo dia e eu não consigo ler muita coisa, falar precisa de muito esforço, e precisei tomar banho sentada em uma cadeira de madeira porque quase cai no chuveiro de tanta tontura&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;1 dia com venlafaxina no meu corpo, sinto um hormônio diferente sendo produzido no meu cérebro e alguma coisa querendo sair a todo momento pela transpiração, que não é só consequência do calor&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Se me olvidó la venlafaxina para el fin de semana y ya el dolor e barriga no sé si es por ansiedad o por la comida en si&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;O Venlafaxina sempre inibiu meu choro, com 1 semana que troquei ja chorei em terapia coisa que quase nunca fazia. O Venla atrapalhou mto meu processo. To ansioso com esse novo, só não to aguentando ficar com enjoo todos os dias, to parecendo grávida kkkkkkk&quot;}|||{&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;O Venlafaxina sempre inibiu meu choro, com 1 semana que troquei ja chorei em terapia coisa que quase nunca fazia. O Venla atrapalhou mto meu processo. To ansioso com esse novo, só não to aguentando ficar com enjoo todos os dias, to parecendo grávida kkkkkkk&quot;}|||{&quot;category&quot;: &quot;Cinetose&quot;, &quot;content&quot;: &quot;quero parar de ter cinetose pra jogar hello kitty espero que amanha minha abstinencia de venlafaxina passe&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Venlafaxina somnolencia be hittin hard af 🔥&quot;}|||{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;sertralina é mais tranquilo, tomei também até amamentando. O q me fodeu foi o Abilify (e provavelmente venlafaxina tbm); ganhei 20 kgs e fiquei com muita coisa fodida :(\nforça aí muié &lt;3&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;venlafaxina eu te amo mas precisava vc me fazer suar igual uma desgraçada e sentir mais calor que o normal??????????? MINHA ROUPA TA GRUDANDO NO CORPO BICHO\n\ndetalhe: to de frente p ar condicionado&quot;}|||{&quot;category&quot;: &quot;Sensação de calor&quot;, &quot;content&quot;: &quot;venlafaxina eu te amo mas precisava vc me fazer suar igual uma desgraçada e sentir mais calor que o normal??????????? MINHA ROUPA TA GRUDANDO NO CORPO BICHO\n\ndetalhe: to de frente p ar condicionado&quot;}|||{&quot;category&quot;: &quot;Desespero&quot;, &quot;content&quot;: &quot;ok três dias sem venlafaxina e estou completamente enlouquecida 100% me jogaria na frente de um trem agora ou arrancaria minha pele e me colocaria debaixo de um sol de 40°&quot;}|||{&quot;category&quot;: &quot;Nausea&quot;, &quot;content&quot;: &quot;Tuve que ir a comprar reliveran por las náuseas que me produce la baja de venlafaxina más una ansiedad de la san punta quiero la cabeza de mí psiquiatra en una pica&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;Tuve que ir a comprar reliveran por las náuseas que me produce la baja de venlafaxina más una ansiedad de la san punta quiero la cabeza de mí psiquiatra en una pica&quot;}|||{&quot;category&quot;: &quot;Apathia&quot;, &quot;content&quot;: &quot;Consecuencias de bajar la venlafaxina a la mitad:\nEpisodios repentinos de tristeza\nDiarrea\nCalentura\n\nSaldo: negativo, muy negativo&quot;}|||{&quot;category&quot;: &quot;Diarreia&quot;, &quot;content&quot;: &quot;Consecuencias de bajar la venlafaxina a la mitad:\nEpisodios repentinos de tristeza\nDiarrea\nCalentura\n\nSaldo: negativo, muy negativo&quot;}|||{&quot;category&quot;: &quot;Fadiga&quot;, &quot;content&quot;: &quot;Consecuencias de bajar la venlafaxina a la mitad:\nEpisodios repentinos de tristeza\nDiarrea\nCalentura\n\nSaldo: negativo, muy negativo&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;eu odeio ficar suada e consumo 150mg de venlafaxina todo santo dia&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;vai ajudar sim, vc vai ver 🙏🏼\n\neu tomo o venlafaxina (venlift), não parei com ele não, só tava com problema na receita aí fiquei uns dias sem 🥲 pior coisa do mundo&quot;}|||{&quot;category&quot;: &quot;Esquecimento&quot;, &quot;content&quot;: &quot;Venlafaxina é uma delícia, mas como é ruim esquecer, parece q seu sistema nervoso entra em curto circuito&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;Eu amo que a venlafaxina me faz funcionar minimamente bem porém ficar suando feito um cavalo é um efeito adverso muito ruim. Fora o fato que eu tive que diminuir a dose porque meus sonhos estavam ficando tão intensos que eu acordava enjoada. 😩😩😩 não é fácil a vida do ansioso.&quot;}|||{&quot;category&quot;: &quot;Mania&quot;, &quot;content&quot;: &quot;Eu amo que a venlafaxina me faz funcionar minimamente bem porém ficar suando feito um cavalo é um efeito adverso muito ruim. Fora o fato que eu tive que diminuir a dose porque meus sonhos estavam ficando tão intensos que eu acordava enjoada. 😩😩😩 não é fácil a vida do ansioso.&quot;}|||{&quot;category&quot;: &quot;Vômito&quot;, &quot;content&quot;: &quot;Eu amo que a venlafaxina me faz funcionar minimamente bem porém ficar suando feito um cavalo é um efeito adverso muito ruim. Fora o fato que eu tive que diminuir a dose porque meus sonhos estavam ficando tão intensos que eu acordava enjoada. 😩😩😩 não é fácil a vida do ansioso.&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;Isso passou a acontecer comigo todas as noites depois que comecei com a venlafaxina. Eu não sou uma pessoa que transpira muito, na verdade é quase nada, mas agora eu acordo de tanto suor nas pernas.&quot;}|||{&quot;category&quot;: &quot;Distração&quot;, &quot;content&quot;: &quot;essa noite dormi melhor que a minha sobrinha de um mês mas em compensação atrasei 30 minutos a venlafaxina o que já foi o suficiente pro cérebro descolar do crânio pqp&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;tava o dia inteiro, passando mal, suando frio, tendo crise de ansiedade, as vozes da minha cabeça tavam a mil, daí eu percebi que esqueci de tomar a venlafaxina por dois dias seguidos \n\nremedio do inferno, a abstinência é o cão&quot;}|||{&quot;category&quot;: &quot;Anhedonia&quot;, &quot;content&quot;: &quot;tava o dia inteiro, passando mal, suando frio, tendo crise de ansiedade, as vozes da minha cabeça tavam a mil, daí eu percebi que esqueci de tomar a venlafaxina por dois dias seguidos \n\nremedio do inferno, a abstinência é o cão&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Indo de dormes mais cedo que o normal por motivos de venlafaxina.\nTe amo véia, conte comigo pra tudo.&quot;}|||{&quot;category&quot;: &quot;Irritação&quot;, &quot;content&quot;: &quot;tô fazendo o desmame da venlafaxina e meu deus, que doideira SENTIR SENTIMENTOS\n\nsemana passada eu até CHOREI&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;Essa PM do BBB parecendo que tomou venlafaxina de tanto que tá suando&quot;}|||{&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;porra essa venlafaxina ta me dando MUITA tremedeira e uma dor no peito&quot;}|||{&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;porra essa venlafaxina ta me dando MUITA tremedeira e uma dor no peito&quot;}|||{&quot;category&quot;: &quot;Agitação&quot;, &quot;content&quot;: &quot;PESSOAL DA VENLAFAXINA\n\nVc que tomou, sentiu-de mais agressivo? \nQuais efeitos colaterais vc sentiu???&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;Não acredito q todo o mal estar q estava estou sentindo eh culpa da venlafaxina! Dois dias sem ela e já estava assim 💀 e voltei a tomar hj e tô assim 💀🙏🏼&quot;}|||{&quot;category&quot;: &quot;Anedonia&quot;, &quot;content&quot;: &quot;o venlafaxina me ajudando a nao ter crises ao msm tempo q me dá crises pq tira minha libido logo eu q sou viciado em contato fisico&quot;}|||{&quot;category&quot;: &quot;Embotamento emocional&quot;, &quot;content&quot;: &quot;Como pode a Venlafaxina tirar todos os sentimentos de dentro de vc e ao mesmo tempo vc ainda sentir um monte de coisa&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;Odeio a venlafaxina me fazendo suar MUITO com qualquer exercício físico&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;Eu não consigo comer eu não consigo dormir não consigo relaxar \nVenlafaxina vc me paga&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;estou sentindo emocoes tipo SENTINDO nao gostei. por esse lado eu queria ficar tomando o venlafaxina a vida td, só quero parar por causa de sudorese etc&quot;}|||{&quot;category&quot;: &quot;Zumbido&quot;, &quot;content&quot;: &quot;eu ACHO que esqueci de tomar minha venlafaxina hoje. to sentindo brain zaps e super esquisito&quot;}|||{&quot;category&quot;: &quot;Apatia&quot;, &quot;content&quot;: &quot;Esquecer de tomar a venlafaxina é um estado de espírito né? É como se sua alma saísse do corpo e te desse vários porradão na cabeça pra te lembrar.&quot;}|||{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;atrasei algumas horas pra tomar meu antidepressivo e já me encontro em estagio vegetativo. eu acho que se algum dia eu parar de tomar venlafaxina eu vou morrer&quot;}|||{&quot;category&quot;: &quot;Dependência&quot;, &quot;content&quot;: &quot;e o pior é que nem to exagerando 😭 venlafaxina desgracada vei, tomei a maior dose existente e não funcionou comigo, continuei como sempre, mas foi só passar um dia sem tomar que eu tô apanhando que nem uma fdp 😭&quot;}|||{&quot;category&quot;: &quot;Sensações estranhas&quot;, &quot;content&quot;: &quot;eu nao aguento mais a venlafaxina deixando minha pupila ENORME \n\nmeu olho ta ficando sensivel demais que ódio&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;sim hahaha eu uso drogas...... (venlafaxina 37.5mg e um comprimido de melatonina sabor maracuja)&quot;}|||{&quot;category&quot;: &quot;Pupilas dilatadas&quot;, &quot;content&quot;: &quot;desde que comecei a tomar venlafaxina minha pupila TÁ ENORME&quot;}|||{&quot;category&quot;: &quot;Dizente&quot;, &quot;content&quot;: &quot;Acordando todo dia tontinha aí estou começando a desconfiar que seja a venlafaxina&quot;}|||{&quot;category&quot;: &quot;Desespero&quot;, &quot;content&quot;: &quot;Não quero mais viver entre as realidades da minha vida e dos meus sonhos.\n\nVenlafaxina eu te culpo por isso.&quot;}|||{&quot;category&quot;: &quot;Sobrecarga sensorial&quot;, &quot;content&quot;: &quot;n sei se tem a ver com eu ter reduzido oficialmente a dose da venlafaxina para fazer desmame mas esses dias tiveram sido um inferno sensorial pra mim. o comercial da spaten no yt me deixa muito incomodado&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;KKKKKK eram bons tempos quando eu tomava venlafaxina. Era ótimo pq eu não sentia nada, nem ansiedade nem nada kkkkkkk&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;Deixei de tomar a venlafaxina ontem de noite pra começar a tomar de manhã e esqueci hoje porque acordei atrasada pra atender e agora ACABEI com minha semana porque se eu tomar a essa hora eu perco o sono e se esperar até amanhã eu vou começar o mês com a maior enxaqueca e mau humor já vistos 🕊️&quot;}|||{&quot;category&quot;: &quot;Enxaqueca&quot;, &quot;content&quot;: &quot;Deixei de tomar a venlafaxina ontem de noite pra começar a tomar de manhã e esqueci hoje porque acordei atrasada pra atender e agora ACABEI com minha semana porque se eu tomar a essa hora eu perco o sono e se esperar até amanhã eu vou começar o mês com a maior enxaqueca e mau humor já vistos 🕊️&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;eu to tomando venlafaxina e tem funcionado porém: 1) qnd eu esqueço de tomar 1 dia da abstinência e é bem zoado 2) acho q remédio nenhum vai me deixar 100% pq meio q a minha vida é meio difícil mesmo 😅&quot;}" />
