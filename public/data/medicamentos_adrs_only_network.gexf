      <node id="Paroxetine" label="Paroxetine">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="35" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Como me pille a mí, que he conseguido un equilibrio con la cafeína para paliar parte de los efectos secundarios de la paroxetina....me excomulga&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;Quando eu comecei a paroxetina cortou por completo minha vontade de tomar café. Hoje eu tomo mas não me ataca a ansiedade, mas tá dando insônia.&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;tenho mais 03 dias de paroxetina e um total de 0 receitas pra repor estoque\n\no fernando ansioso está voltando e ele é uma máquina de desaforos&quot;}|||{&quot;category&quot;: &quot;Tosse&quot;, &quot;content&quot;: &quot;Tra l’altro, la sintesi della paroxetina è un tal casino che la metà basta (e coinvolge roba parecchio tossica, nonché una delle reazioni chimiche che preferisco 😊)&quot;}|||{&quot;category&quot;: &quot;Anorgasmia&quot;, &quot;content&quot;: &quot;Oq mais vc ta tomando?? Qdo eu tomei paroxetina eu tive anorgasmia, nada salvaria nesse caso. Nao tem como conversar com a medica?&quot;}|||{&quot;category&quot;: &quot;Apatia&quot;, &quot;content&quot;: &quot;Graças a paroxetina não tô chorando amuada num canto, triste da vida.&quot;}|||{&quot;category&quot;: &quot;Pontos de Dor&quot;, &quot;content&quot;: &quot;sério, eu tô com muita dor. do dedo mindinho até o último fio de cabelo. maldita paroxetina&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;faz 2 semanas. a dor não é muito forte, mas é irritante. talvez seja tb pq eu tô retirando a paroxetina e dizem que essa é bem difícil de parar&quot;}|||{&quot;category&quot;: &quot;Perda de apetite&quot;, &quot;content&quot;: &quot;zero apetite\n\ndizem que essa paroxetina dá uma fome insaciável, tô esperando essa fome chegar faz uns 2/3 meses desde que comecei a tomar \n\n(selfie duvidosa abaixo)&quot;}|||{&quot;category&quot;: &quot;Reações alérgicas&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Síndrome serotoninérgica&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Sensação de frio&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Vertigem&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Disfunção sexual&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Síndrome do intestino irritável&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Estresse&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Sintomas de TDAH&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Vômito&quot;, &quot;content&quot;: &quot;Ya me he comido la Paroxetina, que es lo único que tengo y ya la he vomitao.🤷🏼‍♀️&quot;}|||{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;paroxetina me dá um sono dos infernos&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;paroxetina e tipo vc não pode ter depressão se você só dormir 👍🏼👍🏼👍🏼&quot;}|||{&quot;category&quot;: &quot;Vômito&quot;, &quot;content&quot;: &quot;amg quando faltava ou eu nao tomava a dose rapido minha visao ficava toda zoada eu ODEIO paroxetina\nmeu medico quer q eu saia do tarja preta nada mais dificil q isso\neu adoro tarja preta&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Não gosto de romantizar remédios psiquiátricos mas não posso negar que a paroxetina SALVOU minha vida e sinto cada vez menos efeitos colaterais 🙌&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;eu acho q me encontrei demais na paroxetina, nao senti nenhum efeito colateral (nao aparente) e ele controla bem minha ansiedade&quot;}|||{&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;eu to tomando Paxil(Paroxetina) e Seroquel (Quetiapina), vei meu corpo todo treme, parece que eu to doente, quais vc toma?&quot;}|||{&quot;category&quot;: &quot;Apatia&quot;, &quot;content&quot;: &quot;Agr n sei mais se o Paroxetina me deixa apático ou se antes era eu q sentia coisas demais&quot;}|||{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;Muita coisa pra fazer e eu simplesmente não consigo sair de cima desse colchão. Paroxetina, minha filha, é vc?&quot;}|||{&quot;category&quot;: &quot;Headache&quot;, &quot;content&quot;: &quot;comecei com a risperidona e a paroxetina hoje, tô com leve dor de cabeça porém sono&quot;}|||{&quot;category&quot;: &quot;Sleepiness&quot;, &quot;content&quot;: &quot;comecei com a risperidona e a paroxetina hoje, tô com leve dor de cabeça porém sono&quot;}|||{&quot;category&quot;: &quot;Stress&quot;, &quot;content&quot;: &quot;Mi nivel de stress esta tan elevado que tarde demasiado en darme cuenta que era mala idea no pelearme con el psiquiatra por solo sugerir que dejara el café. Ahora debo agregar Paroxetina a la lista del botiquín&quot;}|||{&quot;category&quot;: &quot;Disfunção sexual&quot;, &quot;content&quot;: &quot;Quando eu tomava paroxetina eu não conseguia gozar… chegava a esfolar… mais ou menos 1 h transando&quot;}|||{&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;Paroxetina parece eficaz en sínt vasomotores; Evidencia moderada. Ef 2º→nauseas/mareos ─Metanálisis [Int J Obs Gyn] http://ow.ly/4n63Qp&quot;}|||{&quot;category&quot;: &quot;Vômito&quot;, &quot;content&quot;: &quot;Paroxetina parece eficaz en sínt vasomotores; Evidencia moderada. Ef 2º→nauseas/mareos ─Metanálisis [Int J Obs Gyn] http://ow.ly/4n63Qp&quot;}" />
