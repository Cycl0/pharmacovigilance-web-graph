      <node id="Lidocaína" label="Lidocaína">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="1" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Dor&quot;, &quot;content&quot;: &quot;Sentindo o treino nas paleta... Tudo doi — principalmente as panturrilhas. E eu ainda ia na aula de dança, acabei ficando porque ainda tava meio tontinha da lidocaína com cetamina que fiz na médica da dor.&quot;}" />
          <attvalue for="3" value="1" />
          <attvalue for="4" value="11" />
          <attvalue for="5" value="-1.759871 1.504023" />
          <attvalue for="6" value="#2DCD9F" />
        </attvalues>
      </node>
      <node id="Tusi" label="Tusi">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="1" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;No quarto foram encontrados saquinhos com um pó rosa, identificado como tusi, uma mistura de drogas que contém MDMA e cetamina, além de um preservativo no lixo. \n\nA causa da morte foi oficialmente declarada como overdose acidental.&quot;}" />
          <attvalue for="3" value="1" />
          <attvalue for="4" value="54" />
          <attvalue for="5" value="4.494680 3.008344" />
          <attvalue for="6" value="#2DCD9F" />
        </attvalues>
      </node>
      <node id="Maconha" label="Maconha">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="1" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;Embora seja bilionário, no seu cérebro, não passa de um tresloucado que  só abre a sua boca, latrina, para falar mherdha sob o efeito de maconha e cetamina.&quot;}" />
          <attvalue for="3" value="1" />
          <attvalue for="4" value="28" />
          <attvalue for="5" value="-1.929505 -2.175719" />
          <attvalue for="6" value="#2DCD9F" />
        </attvalues>
      </node>
      <node id="Overdose" label="Overdose">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="1" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;Acabei de ver a notícia q um médico fdp forneceu cetamina pro Matthew Perry e por conta disso ele teve overdose, sério, é esse tipo de coisa q acaba com o meu bom senso, dá vontade de pegar esse médico e acabar com a raça dele, é inacreditavelmente absurdo alguém fazer isso com outro ser humano&quot;}" />
          <attvalue for="3" value="1" />
          <attvalue for="4" value="28" />
          <attvalue for="5" value="-0.450948 -1.516141" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
      <node id="Sequelas" label="Sequelas">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="1" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;Os cientistas precisam pesquisar mais sobre os efeitos da cetamina no cérebro pq eu acho que os gays do RJ estão ficando permanentemente sequelados de key&quot;}" />
          <attvalue for="3" value="1" />
          <attvalue for="4" value="28" />
          <attvalue for="5" value="-1.957943 0.212208" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
