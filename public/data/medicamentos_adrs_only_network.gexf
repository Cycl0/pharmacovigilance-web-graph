      <node id="Dispneia" label="Dispneia">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="3" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;takin all of these at once to trigger a hard reset of my brain and be normal finally\n\nin all seriousness fuck citalopram for making me not able to breathe sertraline DONT LET ME DOWN BABY&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;+ eu uso sertralina faz um bom tempo então minha ansiedade está controlada, e por causa da bupropiona as vezes começo a sentir um início de uma crise (peito doendo, início de falta de ar) sem motivo nenhum, mas meu lado controlado pela sertralina +&quot;}, {&quot;category&quot;: &quot;Cabergolina&quot;, &quot;content&quot;: &quot;tomei cabergolina pq a duloxetina tava aumentando minha prolactina aí agora tô com fôlego curto kkkkk tomara q eu morra&quot;}]" />
