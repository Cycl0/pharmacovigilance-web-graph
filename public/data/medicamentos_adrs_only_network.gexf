          <attvalue for="1" value="4" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;o efeito da mirtazapina é nível zolpidem pelo amor de deus se eu tomar esse remédio e não ir dormir logo eh capaz d'eu mandar mensagem pra ex ficante pedindo a pessoa em casamento e postar frente e verso do meu cartão com a senha nos stories do insta&quot;}, {&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;Cetamina dá mto problema até onde eu vi, mta gente queixa dela criar ideia errada na cabeça.&quot;}, {&quot;category&quot;: &quot;Maconha&quot;, &quot;content&quot;: &quot;Embora seja bilionário, no seu cérebro, não passa de um tresloucado que  só abre a sua boca, latrina, para falar mherdha sob o efeito de maconha e cetamina.&quot;}, {&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;Embora seja bilionário, no seu cérebro, não passa de um tresloucado que  só abre a sua boca, latrina, para falar mherdha sob o efeito de maconha e cetamina.&quot;}]" />
