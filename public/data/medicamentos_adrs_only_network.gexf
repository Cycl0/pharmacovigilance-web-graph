      <node id="Cognitive decline" label="Cognitive decline">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="3" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Un estudio con 18,740 pacientes con demencia señala que los antidepresivos aceleran el deterioro cognitivo. Los que provocaron un deterioro más rápido fueron escitalopram, citalopram y sertralina en comparación con aquellos que no tomaban medicación. neurosciencenews.com/ssris-cognit...&quot;}|||{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Un estudio con 18,740 pacientes con demencia señala que los antidepresivos aceleran el deterioro cognitivo. Los que provocaron un deterioro más rápido fueron escitalopram, citalopram y sertralina en comparación con aquellos que no tomaban medicación. neurosciencenews.com/ssris-cognit...&quot;}|||{&quot;category&quot;: &quot;Sertraline&quot;, &quot;content&quot;: &quot;Un estudio con 18,740 pacientes con demencia señala que los antidepresivos aceleran el deterioro cognitivo. Los que provocaron un deterioro más rápido fueron escitalopram, citalopram y sertralina en comparación con aquellos que no tomaban medicación. neurosciencenews.com/ssris-cognit...&quot;}" />
