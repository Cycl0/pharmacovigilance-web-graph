      <node id="Clonazepan" label="Clonazepan">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="3" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;ᵈᶦᵃʳᶦᵒ ᵈᵉ ᵐᵉᵈᶦᶜᵃᶜᵃᵒ \nontem não tomei o clonazepan pq não almocei e estava com minha namorada. venlafaxina me causa ansiedade, e talvez o clonazepan vai diminuir isso pq me dá sono. tentei dormir agora, mas não consegui e meu apetite diminuiu um pouco, vejo comida e sinto vontade de vomitar&quot;}, {&quot;category&quot;: &quot;Sedação&quot;, &quot;content&quot;: &quot;Sou neuropatica e tomei Amitriptilina com clonazepan e estou na TPM. Tô me sentindo altamente chapada. Eu tô ficando lélé da cuca.&quot;}, {&quot;category&quot;: &quot;Confusão&quot;, &quot;content&quot;: &quot;Sou neuropatica e tomei Amitriptilina com clonazepan e estou na TPM. Tô me sentindo altamente chapada. Eu tô ficando lélé da cuca.&quot;}]" />
