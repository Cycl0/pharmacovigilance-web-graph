          <attvalue for="0" value="adr" />
          <attvalue for="1" value="5" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;tomar escitalopram é acontecer uma coisa hiper bosta com voce e vc reagir assim 🙂 e a pessoa pergunta pq vc nao ta triste e vc responde “eu to triste, queria chorar mas nao consigo lkkkk eu tomo antidepressivo”&quot;}|||{&quot;category&quot;: &quot;Bupropion&quot;, &quot;content&quot;: &quot;querer mesmo eu num quero hueheuhe mas sei que seria bom. quando tomei a bup sentia zero vontade de fumar, mas agora com a duloxetina voltei naquele meu normal de um cigarro por dia (porem dez cigarros seguidos) se tou bebendo&quot;}|||{&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;tava o dia inteiro, passando mal, suando frio, tendo crise de ansiedade, as vozes da minha cabeça tavam a mil, daí eu percebi que esqueci de tomar a venlafaxina por dois dias seguidos \n\nremedio do inferno, a abstinência é o cão&quot;}|||{&quot;category&quot;: &quot;Vyvanse&quot;, &quot;content&quot;: &quot;ai passo mal demais com alguns nomes de medicamento referência saindo diretamente de uma roda de amigos da faria lima\n\nja conhecia o DESVE e o ESC mas o CLO pra clomipramina acabou de me causar uma síncope&quot;}|||{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;ai passo mal demais com alguns nomes de medicamento referência saindo diretamente de uma roda de amigos da faria lima\n\nja conhecia o DESVE e o ESC mas o CLO pra clomipramina acabou de me causar uma síncope&quot;}" />
