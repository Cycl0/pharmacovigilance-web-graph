          <attvalue for="2" value="{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;takin all of these at once to trigger a hard reset of my brain and be normal finally\n\nin all seriousness fuck citalopram for making me not able to breathe sertraline DONT LET ME DOWN BABY&quot;}" />
          <attvalue for="3" value="1" />
