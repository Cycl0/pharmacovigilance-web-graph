          <attvalue for="1" value="1" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Lembrando da música:\n\nFluoxetine, fluoxetine\nParoxetine, paroxetine\nCitalopram, citalopram\nMay cause dry mouth\n\nQueria que essa última parte não tivesse tão presente agora kkkring&quot;}" />
