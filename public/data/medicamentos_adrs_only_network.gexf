          <attvalue for="0" value="adr" />
          <attvalue for="1" value="1" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;I've had a couple of periods on Citalopram due to anxiety and depression. I didn't suffer terribly from side effects aside from a bit of scalp creep, slight increase in sweating, and excessive yawning. Everything settled after a couple of weeks.&quot;}]" />
