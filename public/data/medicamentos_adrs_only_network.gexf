          <attvalue for="0" value="adr" />
          <attvalue for="1" value="6" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Venlafaxin&quot;, &quot;content&quot;: &quot;Ich schleiche Venlafaxin seit 3 Wochen ein. Bin erst bei 75 mg. Das scheint auf jeden Fall zu wenig zu sein. Da im Moment eher wieder depressiver. Von mehr Antrieb (noch) keine Spur.\nHabe vorher 5 Jahre 20 mg Escitalopram genommen. War soweit okay. Allerdings fehlte auch da der Antrieb.&quot;}|||{&quot;category&quot;: &quot;Fluoxetin&quot;, &quot;content&quot;: &quot;Quase gabaritando os efeitos adversos da fluoxetina, mas pelo menos ainda tenho apetite&quot;}|||{&quot;category&quot;: &quot;Fluoxetine&quot;, &quot;content&quot;: &quot;minha fluoxetina acabou junto com o meu dinheiro. agora não vou saber se é depressao ou pobreza mas a tristeza é certa&quot;}|||{&quot;category&quot;: &quot;Fluoxetin&quot;, &quot;content&quot;: &quot;Bendita seja a fluoxetina, que me puxa da tristeza e me empurra pra diminuição da libido&quot;}|||{&quot;category&quot;: &quot;Sertraline&quot;, &quot;content&quot;: &quot;O sertralina tirou todo sentimento humano de dentro de mim que um dia eu senti na vida \n\nNão sinto mais nada!&quot;}|||{&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Consecuencias de bajar la venlafaxina a la mitad:\nEpisodios repentinos de tristeza\nDiarrea\nCalentura\n\nSaldo: negativo, muy negativo&quot;}" />
