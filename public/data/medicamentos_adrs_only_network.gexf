          <attvalue for="1" value="1" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Fluoxetine&quot;, &quot;content&quot;: &quot;Como que o povo 'vai gozar' se a gestão atual tem dado altas doses de fluxoetina e venlafaxina para nós?&quot;}" />
