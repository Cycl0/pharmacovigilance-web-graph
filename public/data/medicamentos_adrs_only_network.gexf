      <node id="Sonhos vívidos" label="Sonhos vívidos">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="1" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;I’ve been on citalopram for nearly 8 years and have had a good experience. They took a while to kick in (the leading theory is they promote neuroplasticity in the brain which is so cool) but the only side effect I get from them is vivid dreams. They gave me my life back.&quot;}]" />
