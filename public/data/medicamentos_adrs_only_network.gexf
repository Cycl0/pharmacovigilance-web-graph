      <node id="Morte" label="Morte">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="12" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;\&quot;Investigação sobre a morte de The Vivienne: O alerta sobre os perigos da cetamina na comunidade LGBT\&quot;  http://dlvr.it/TJbRpP http://dlvr.it/TJbRpc&quot;}, {&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;\&quot;Tragédia e Conscientização: A Morte de The Vivienne e os Riscos do Uso de Cetamina entre Jovens no Reino Unido\&quot;  http://dlvr.it/TJb6Ss http://dlvr.it/TJb6St&quot;}, {&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;\&quot;Tragédia na Comunidade LGBTQ+: A Morte de The Vivienne e os Riscos do Abuso de Cetamina\&quot;  http://dlvr.it/TJb0gf http://dlvr.it/TJb0gj&quot;}, {&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;\&quot;Investigação Revela Causa da Morte de The Vivienne e Alerta para os Riscos do Uso de Cetamina entre Jovens\&quot;  http://dlvr.it/TJZssk http://dlvr.it/TJZssp&quot;}, {&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;O médico Mark Chavez se declarou culpado pela morte de Matthew Perry em um tribunal de Los Angeles.\n\nDurante audiência, ele admitiu ter ajudado a fornecer a droga cetamina ilegalmente ao ator, que teve overdose. Chavez pode ser condenado a até 10 anos de prisão.&quot;}, {&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;➡️Médico que ajudou a fornecer cetamina a Matthew Perry se declara culpado por morte do ator\n\nredeondadigital.com.br/mundo/medico...&quot;}, {&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;#ISTOÉGENTE Médico acusado pela morte de #MatthewPerry se declara culpado. Autópsia determinou que a morte foi causada pelos 'efeitos agudos da cetamina'.\nistoe.com.br/medico-acusa...&quot;}, {&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;Médico que ajudou a distribuir cetamina a Matthew Perry se declara culpado pela morte do ator&quot;}, {&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;\&quot;Todos nós usávamos a mesma quantidade de cetamina. Tem os exames, eles vieram colher nosso sangue. Ou seja, se fosse uma overdose mesmo por que o Ademar não está morto se fazemos uso do mesmo psicodélico?”, quis saber ela.\&quot; Porque cada organismo reage de um jeito né?! Estúpida!!! Que od1o!!!!!&quot;}, {&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;Médico se declara culpado em esquema de fornecimento de cetamina que resultou na morte de Matthew Perry&quot;}, {&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;Como morte de Matthew Perry revelou a 'terra sem lei' da cetamina em Hollywood&quot;}, {&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;'Rede criminosa' e 'rainha da cetamina' estão por trás de morte de Matthew Perry, diz polícia&quot;}]" />
          <attvalue for="3" value="1" />
          <attvalue for="4" value="5" />
          <attvalue for="5" value="0.473782 -0.704848" />
          <attvalue for="6" value="#E9573F" />
