      <node id="Tontura" label="Tontura">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="44" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Mum's been on citalopram (an SSRI antidepressant) for 10 years. All previous attempts to wean her off it have destabilised her. And stopping it suddenly can cause withdrawal, dizziness, confusion and falls. \n\nI'll check with the doctor, says the nurse.\nA while later she returns.&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Paroxetina parece eficaz en sínt vasomotores; Evidencia moderada. Ef 2º→nauseas/mareos ─Metanálisis [Int J Obs Gyn] http://ow.ly/4n63Qp&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;-Ufff qué mareo tengo, siento que voy a desfallecer. La verdad es que no sé por qué me siento así -exclamó el muchacho mientras que en su cuerpo solamente se hallaba una sertralina de 100mg.&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;Tienen idea de si el mareo/cansancio es un síntoma normal de dejar la sertralina? Me siento medio raro y no quiero joder a la médica el finde&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;A bupropiona te esculhamba antes de te tratar amigos\nUma náusea e tontura do cão&quot;}, {&quot;category&quot;: &quot;Trazodona&quot;, &quot;content&quot;: &quot;cara tomei a porra da trazodona, não deu nem 30min e comecei a sentir uma tontura e náusea do caralho&quot;}, {&quot;category&quot;: &quot;Trazodona&quot;, &quot;content&quot;: &quot;Voltei a tomar trazodona pra dormir e estou sentindo muito efeito colateral, que o médico prometeu que não ia ter. Tontura, sensação de corpo pesado, dificuldade até pra andar, muito muito sono e o mais estranho: dores musculares (?).&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Amigos q tomam desvenlafaxina, ela dá tontura?&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Desvenlafaxina remedio nojento escroto odeio tomar essa merda preciso desmamar e simplesmente não consigo passar mais de 24h sem tomar q dá tontura e náusea e vontade d eme jogar da janela \nIncrivel&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;eu tomo desvenlafaxina vai fazer uns 5 anos, foi o que deu uma segurada durante a pandemia, junto com a terapia\n\n&lt;&lt;&lt;PORÉM&gt;&gt;&gt;\n\ncacete, esquecer desse remédio de manhã, na hora do almoço eu já tô dando pinote de enxaqueca + tontura e enjoo\n\no remédio bom pra quem esquece, cê aprende a tomar na marra&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;esqueci de tomar desvenlafaxina ontem e hoje estou sofrendo as consequências\ncomecei a alucinar ter tontura e não conseguir fazer nada\n\ntenho uma reuniao importantissima com minha chefe 14h. \n\nmorte morte morte morte morte&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;não tomei meu ansiolítico hoje e minha cabeça tá girando meus ouvidos estão estourando parabéns por dar uma abstinência ridícula de um dia desvenlafaxina&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Todo mês eu deixo pra comprar s desvenlafaxina em cima da hora aí eu chego na farmácia tonta passando mal&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Fiquei sem tomar a desvenlafaxina por 2 dias e parecia que tinham sugado todas as minhas forças. Bateu logo uma tontura e minha pressão foi no chão.&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;tava pesquisando e muito provavelmente os surtos que ando tendo são abstinência de desvenlafaxina, mas eu vou continuar tonto sequelado e maluco até essa abstinência passar eu não quero mais saber de remédio controlado nem ficar gastando 300 todo mês com isso! tanta coisa que eu preciso comprar&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;É importante não interromper abruptamente o uso da Desvenlafaxina, pois pode causar síndrome de descontinuação, com sintomas como tontura e irritabilidade.\n\n#saudemental&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Entre os efeitos colaterais mais comuns da Desvenlafaxina estão náusea, dor de cabeça, tontura, boca seca e aumento da sudorese.\n\n#saudemental&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;hoje eu tive que tomar muito cuidado pra não cair na rua\ne foram só 3 dias sem a desvenlafaxina e já fiquei assim&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;sobrevivendo hj com aquela tontura gostosa de abstinência de desvenlafaxina \n(já comprei meu remédio)&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;👈esqueceu de tomar a desvenlafaxina no horário e agora está com tontura&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Não me adaptei a desvenlafaxina, me dava uma tontura pavorosa! Imagino se eu bebesse então!&quot;}, {&quot;category&quot;: &quot;Duloxetina&quot;, &quot;content&quot;: &quot;Acho que eu entendi minha diarréia e minha nausea, tontura\n\nTô começando a achar que é o duloxetina com a abstinencia retardada que deveria ter começado antes\nEu estou levemente fodido\nVou ter que comprar vonau&quot;}, {&quot;category&quot;: &quot;Duloxetina&quot;, &quot;content&quot;: &quot;tô com umas tonturas e enjôo bem iguais ao que sentia no desmame da duloxetina, mas tô tomando certinho??? será que tô doente meu deus&quot;}, {&quot;category&quot;: &quot;Duloxetina&quot;, &quot;content&quot;: &quot;Na última consulta esqueci de pedir pro meu psiq a receita de duloxetina, ele esqueceu de enviar o PDF\nO remédio acabou ontem eu já tô com tonteira e brain zap\nPQP COMO EU ODEIO TER TDAHHHHHHH&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;na boa é muito brutal a tontura causada pela falta de Venlafaxina\n\nontem eu esqueci de tomar o medicamento e agora a sensação é de que vou morrer a qualquer momento&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;passando mal de enjoo, cuspindo a cada 10 segundos, tonta, fraca, mente anuviada e ouvindo o ventilador de satanás do lado esquerdo\nnynca mais atraso a venlafaxina&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;esqueci de tomar o doidex™ ontem e foi ok o dia mas hj to completamente coisada as coisa piscando a cabeça rodando venlafaxina eu te odeio (amo mt mas pourran n pode esquecer 1 dia&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;dia (?) de desmame da venlafaxina \n\n- minha libido existe\n- eu nao demoro mais 3 dias uteis pra gozar 🙏🙏\n- fora a tontura nao ando tendo mtos efeitos colaterais&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;eu tô tomando a venlafaxina por mais de 6 anos, mas nem todo dia pq fico muito, muito, tonto, não interessa a dosagem. eu não queria abandonar esse remédio, ele tá funcionando, é só a parte da tontura e ansia que me destrói. :/&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;diário de desmame total da venlafaxina:\n\n- eu to tonto pra caralho puta que pariu\n- minha libido voltou ao normal (?)&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;quantos dias demora para passar os efeitos colerais da venlafaxina? hoje é o segundo dia e eu não consigo ler muita coisa, falar precisa de muito esforço, e precisei tomar banho sentada em uma cadeira de madeira porque quase cai no chuveiro de tanta tontura&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;é cloridrato de venlafaxina\n\neu tomo 2 de 150\n\nEU VOU FICAR COM MUITA TONTURA KKKKKKKKKKK&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;queria que esquecer de tomar a venlafaxina me desse depressão igual as outras pessoas mas me dá uma tontura tão sinistra que eu começo até a suar frio&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Eu tomo venlafaxina genérico (antes tomava escitalopram e senti uma melhora). O chato é que tem que tomar sempre no MESMO horário, senão já fico com tonturas e dor de cabeça. Mas também pode ser porque tb tomo o metilfenidato.\nJá tinha tomado venlafaxina anos antes e não lembro desses efeitos, +&quot;}, {&quot;category&quot;: &quot;Metilfenidato&quot;, &quot;content&quot;: &quot;Eu tomo venlafaxina genérico (antes tomava escitalopram e senti uma melhora). O chato é que tem que tomar sempre no MESMO horário, senão já fico com tonturas e dor de cabeça. Mas também pode ser porque tb tomo o metilfenidato.\nJá tinha tomado venlafaxina anos antes e não lembro desses efeitos, +&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Acordando todo dia tontinha aí estou começando a desconfiar que seja a venlafaxina&quot;}, {&quot;category&quot;: &quot;Quetiapina&quot;, &quot;content&quot;: &quot;eu fico todo tonto cambaleando batendo nas paredes e quase caindo nas coisas é mais com quetiapina, mas a amitriptilina ja começa a dar isso tbm só q menos, e olha que eu tomo MUITO remedio desde que me machuquei em 2012, entao pra perceber efeito colateral nesse coquetel ele tem q ser bem fortinho&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;eu fico todo tonto cambaleando batendo nas paredes e quase caindo nas coisas é mais com quetiapina, mas a amitriptilina ja começa a dar isso tbm só q menos, e olha que eu tomo MUITO remedio desde que me machuquei em 2012, entao pra perceber efeito colateral nesse coquetel ele tem q ser bem fortinho&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;mds eu sinto tontura até deitada tá sem condições só pode ser o amitriptilina q ta piorando essas minhas tonturas&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;tinha esquecido que o amitriptilina me deixa zonza e com muito sono, vou passar o dia todo ranzinza&quot;}, {&quot;category&quot;: &quot;Ritalina&quot;, &quot;content&quot;: &quot;eu vou ficar assim só por uns dias, o remédio que eu tomo é ritalina, mas não tinha o original nas farmácias aqui da minha cidade, só o composto que é o metilfenidato aí ele tá me deixando assim. nós primeiros dias eu tive tontura e enjoo e agora tô assim\na tontura e o enjôo eu tive c a ritalina tbm&quot;}, {&quot;category&quot;: &quot;Lidocaína&quot;, &quot;content&quot;: &quot;Sentindo o treino nas paleta... Tudo doi — principalmente as panturrilhas. E eu ainda ia na aula de dança, acabei ficando porque ainda tava meio tontinha da lidocaína com cetamina que fiz na médica da dor.&quot;}, {&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;Sentindo o treino nas paleta... Tudo doi — principalmente as panturrilhas. E eu ainda ia na aula de dança, acabei ficando porque ainda tava meio tontinha da lidocaína com cetamina que fiz na médica da dor.&quot;}, {&quot;category&quot;: &quot;Cetamina&quot;, &quot;content&quot;: &quot;Ou algo do tipo. Eu tô tonta de cetamina.\n\nMas expressar que alguém envelheceu bem, sabe?\n\nE não falo de manter aparência jovial, necessariamente.&quot;}]" />
          <attvalue for="3" value="14" />
          <attvalue for="4" value="62" />
          <attvalue for="5" value="0.759675 1.676132" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
      <node id="Confusão" label="Confusão">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="13" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Mum's been on citalopram (an SSRI antidepressant) for 10 years. All previous attempts to wean her off it have destabilised her. And stopping it suddenly can cause withdrawal, dizziness, confusion and falls. \n\nI'll check with the doctor, says the nurse.\nA while later she returns.&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Cortei um comprimido de 12,5 da paroxetina espero que seja o suficiente pro meu cérebro parar de ficar zureta pq eu não quero voltar pra esse medicamento&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;sertralina me deixou zureta da cabeça mas curou onde doía&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;A sertralina me deixa muito pedro scooby das ideias kkkkkkkkkkkkkk&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;acho que ficar 4 dias sem bupropiona afrouxou uns parafuso que já não são muito preso mesmo, ainda esse calor e a iminência dos 40, vibes muito sinistras hoje&quot;}, {&quot;category&quot;: &quot;Desve&quot;, &quot;content&quot;: &quot;O problema do Desve é que se você não toma um dia ele já tenta te matar, e eu tenho tdah severo então foi uma combinação que quase me enlouqueceu. Bupropiona já ouvi as histórias de terror&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;A bupropiona tá fazendo o reverso aqui .. tô entendendo é nada... Caos total&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;gente ?? por quanto tempo o mirtazapina fez vcs apagarem por mais de 15 horas e acordarem completamente perdidos e sem força????&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Ontem esqueci de tomar a desvenlafaxina e hj estou em uma constante brisa de loló&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Eu sofro disso com a venlafaxina\n\nOutro dia eu tomei duas vezes essa desgraça aí e não foi legal\n\nPassei o dia inteiro parecendo um doido&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Atrasei duas horinhas pra tomar a venlafaxina hj e agora tô aqui andando em nuvens  e com a cabeça enuviada bem loca&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;Sou neuropatica e tomei Amitriptilina com clonazepan e estou na TPM. Tô me sentindo altamente chapada. Eu tô ficando lélé da cuca.&quot;}, {&quot;category&quot;: &quot;Clonazepan&quot;, &quot;content&quot;: &quot;Sou neuropatica e tomei Amitriptilina com clonazepan e estou na TPM. Tô me sentindo altamente chapada. Eu tô ficando lélé da cuca.&quot;}]" />
          <attvalue for="3" value="10" />
          <attvalue for="4" value="1" />
          <attvalue for="5" value="0.471308 0.464656" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
      <node id="Apatia" label="Apatia">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="48" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Fluoxetina&quot;, &quot;content&quot;: &quot;&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Yes, I had it for a few years before GP prescribed citalopram. My exp was it's pretty mild on the old depression but made me feel sleepy. In hindisght I think I preferred it to the zombie nothingness of 'pram but YMMV of course.&quot;}, {&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Citalopram hatte ich als erstes Antidepressivum. Es hat mich komplett ausgeknockt. Dauernd müde, apathisch, kognitive Ausfälle, teilweise minutenlang einfach weggetreten.\nUmstellung auf Duloxetin. Keine Probleme mehr.&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;meu deus, o escitalopram me tirou a ansiedade, a tristeza, a alegria, a calma, o nervosismo, a vontade de dar, a inspiração pra trabalhar, eu não sinto mais nada, eu tô completamente anestesiada&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Escitalopram side effects:\n- a lot of staring at the ceiling \n- texting @stefb.bsky.social for permission to make bad life decisions in order to feel something&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Esperava do escitalopram melhorar a ansiedade. Ganhei sono e apatia&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Eles precisam de receita,mas escitalopram é meu xodó. Faz você não sentir NADA&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;aqui o escitalopram, depois de 1 ano, me deixou totalmente apática e sem graça de tudo. trocou pra venlafaxina e beeeem melhor&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Pode ser sim, o escitalopram me transformou num ser completamente apático e sem nenhum sentimento, eu era a música do Arnaldo Antunes ambulante. Quando troquei pelo Bup a vida voltou pro meu corpo&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;I cannot wait to come off escitalopram I have no passion for anything at all rn just feel restless af&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Also, only appreciable side effect of 15mg of escitalopram that I've noticed thus far is that it has sent my internal temperature a little bit higher, thus necessitating colder AC settings. I guess I'm possibly a bit more apathetic as well, which is good(?) I think.&quot;}, {&quot;category&quot;: &quot;Fluoxetina&quot;, &quot;content&quot;: &quot;Na época eu tomei Fluoxetina e a sensação era literalmente estar morto por dentro, só vendo sua vida como uma câmera. \n\nLógico que, se você tá tomando, eh pq houve necessidade, como eu também tive uma época, então tem que avaliar qual dinâmica fica melhor pra tua vida.&quot;}, {&quot;category&quot;: &quot;Fluvoxamina&quot;, &quot;content&quot;: &quot;aaaaaahhhhh, é por causa do aumento da dose. um dos efeitos da fluvoxamina é a sonolência mesmo, talvez seja isso que tá te deixando pra baixo. em alguns casos a sonolência com o tempo, voce tá tomando de noite?&quot;}, {&quot;category&quot;: &quot;Fluvoxamina&quot;, &quot;content&quot;: &quot;Eu tô tomando Fluvoxamina que é indicado tbm pra TOC e ansiedade. Único efeito colateral que sinto é uma certa apatia, mas é ótimo.&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Calma, Pedro. Remédio bate diferente pra cada pessoa. É só por causa dele que eu ainda não fui de arrasta. Diferente da Paroxetina, que me transformou numa ameba.&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Agr n sei mais se o Paroxetina me deixa apático ou se antes era eu q sentia coisas demais&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;depende de pessoa pra pessoa, as vezes o remédio q faz mal pra mim pode ser bom pra vc. Quando tomava ele eu era um morto-vivo. Não comia, não dormia e não SENTIA NADA, COMPLETAMENTE APÁTICO. Tive q trocar pro paroxetina&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;A sertralina me tirou a inquietação das crises de ansiedade e trocou por apatia 👍\n\nFico paralisada, esqueço que ia fazer&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;eu quando tomava sertralina tinha vez que eu só desistia&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;Não cheguei nem na metade da dose da sertralina e já tô sofrendo na adaptação... vou tentar seguir mais um mês, até o final, mas tô bem menos produtiva no trabalho e na faculdade e agora comecei a passar mal... talvez só não funcione pra mim...&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;Eu preciso de outro antidepressivo.\nA sertralina e eu fomos felizes por um tempo, mas ultimamente ela tem me deixado um pouco apática e eu preciso sentir raiva.\nNão dá pra defender os direitos de dois filhos autistas sem sangue nos olhos 😌&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;O sertralina tirou todo sentimento humano de dentro de mim que um dia eu senti na vida \n\nNão sinto mais nada!&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;Emocionalmente estou todo quebrado, murcho, desmotivado. A sertralina ainda coloca uma camada de apatía tão profunda que nem consigo ter uma reação emocional.&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;o sertralina me causou efeitos colaterais terríveis de inicio\n\nvivi igual zumbi, mas dps veio a energia q a psiquiatra prometeu&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;Uma coisa que a sertralina faz em mim que eu não pontuei aí também: eu não ligo pra nada\n\nEu já não ligo pra nada sem medicamento, aí com medicamento eu fico 300% nem aí pra nada&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;ah tá o chat chatgpt disse q isso é ansiedade 😃 saudades do sertralina q me deixava apática sobre tudo pq tô realmente odiando sentir várias coisas de novo&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;qnd parei a bupropiona fiquei 2 semanas felicidade eterna ai agr parei a desvenlafaxina e nunca estive tao bem e nem parece efeito de remedio simplesmente nao sabia q eu tava perdendo TANTA energia&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;qnd parei a bupropiona fiquei 2 semanas felicidade eterna ai agr parei a desvenlafaxina e nunca estive tao bem e nem parece efeito de remedio simplesmente nao sabia q eu tava perdendo TANTA energia&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Yo no digo ná, pero la mirtazapina que me mandaron el otro día, aparte de tenerme un poquito (un poquito eh, no nos pasemos) más relajado y hacer que me la sude todo y tener la autoestima más alta, también está haciendo que me incremente la libido reducida por la sertralina 😏😏&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Buenas noches, ando algo asustada y necesito consejo farmacéutico.\nMi dra. me ha recetado mirtazapina, leyendo el prospecto me he acojonado. Me dijo q me tome media pero en el prospecto pone que me voy a volver loca, con sueño, desganada, irritable y un largo etc. \nAlguien por aquí que haya tomado?&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Meu humor ficou uma bosta, meu animo zerado, parece que ta atrapalhando um pouco o soninho do mirtazapina, nao to conseguindo prestar atencao em nada (Nao que eu conseguisse antes, mas era menos pior e eu conseguia com esforço)&quot;}, {&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;amg tu acredita q quando tomei mirtazapina eu entrei na minha honeymoon era?? eu JURO, mas assim o citalopram me deixava apática sabe?! com  ele eu nao sentia tristeza, mas tambem nao sentia alegria nenhuma, ja o mirtazapina eu nao me sentia tao pra baixo, e eu ja conseguia ter disposicao p fazer+&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;ai amg pior que os remedios acabam msm com a gnt. quando eu tomava desvenlafaxina eu ficava bem meh + sem libido total,,,&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Desvenlafaxina é um remédio dos deuses pq eu não ando fazendo NADA o dia todo e mesmo assim não ando depressiva&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;por enquanto o único efeito colateral que sinto da desvenlafaxina é o olho embaçando. mas é o menor dos males considerando que a sertralina tinha sugado minha vontade de viver&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;A desvenlafaxina me deixa apatica 99% do tempo mas aquele 1% tbm desbagaça tudo. Comecei a chorar por causa do que aconteceu no aeroporto hoje e agora ja to chorando pq nunca serei amada !!!&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;gente desculpa ai td mundo por hoje\neu não consegui existir direito por motivos de DESVENLAFAXINA&quot;}, {&quot;category&quot;: &quot;Duloxetina&quot;, &quot;content&quot;: &quot;Issoo, vdd, e justamente a duloxetina tinha interação com o Venvanse e pontecializava seus efeitos, ai ficava igual ao Willy Wonka, full pistola crazy e do nada a branca de neve, era um carrossel, fora que dava compulsão sexual kkk pqp, ai o escitalopram caiu como uma luva, me sinto um robô, amei kk&quot;}, {&quot;category&quot;: &quot;Duloxetina&quot;, &quot;content&quot;: &quot;Eu descobri meu desinteresse nas coisas\nOu é a duloxetina ou o topiromato&quot;}, {&quot;category&quot;: &quot;Topiromato&quot;, &quot;content&quot;: &quot;Eu descobri meu desinteresse nas coisas\nOu é a duloxetina ou o topiromato&quot;}, {&quot;category&quot;: &quot;Duloxetina&quot;, &quot;content&quot;: &quot;duloxetina tira minha ansiedade mas em compensação me deixa meio vagabundo&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Muitas vezes sim\n\nQuando eu tive burnout, psiq me passou venlafaxina\nFoi ótimo eu me sentir meio meh pq eu tava mto mal\n\nDps de um tempo tava me sentindo apática demais aí troquei\n\nSe dps do período de estabilização essa sensação não passar e tiver incomodando mto, veja possibilidade de troca&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;segundo dia tomando venlafaxina e meu humor não oscilou uma vez, não fiquei ansiosa por nada e me sinto morta por dentro e isso me deixa adorável&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;A venlafaxina: vc nao pode ser depressiva ansiosa se vc nao sente nada!!&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;q falta me faz a apatia da venlafaxina&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;oiii, tomo amitriptilina, já acho ele super pesado por si só, dormi umas 23h e acordei agora, ele me deixa super cansada, com bastante sono e muita das vezes apática mas tá sendo bom pra mim, e tbm tenho a sensação de estar chapada e sem emoção.&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;Tomei amitriptilina pra dormir e agora não quero mais falar nada&quot;}, {&quot;category&quot;: &quot;Fluoxetina&quot;, &quot;content&quot;: &quot;&quot;}]" />
          <attvalue for="3" value="13" />
          <attvalue for="4" value="8" />
          <attvalue for="5" value="-1.335069 -0.583664" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
      <node id="Ganho de peso" label="Ganho de peso">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="70" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Bei Escitalopram /Citalopram muss man aufs Gewicht achten. Starke Gewichtszunahme innerhalb eines Jahres rechtfertigt Umsetzung auf anderes Präparat.&quot;}, {&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Bei Escitalopram /Citalopram muss man aufs Gewicht achten. Starke Gewichtszunahme innerhalb eines Jahres rechtfertigt Umsetzung auf anderes Präparat.&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;I miss venlaflaxine cause It stopped me from overthinking during the day and I liked it but the weight gain it was giving me was not ideal 🙃 \n\nDo hope I can work along with citalopram. I am in a better situation now&quot;}, {&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Years ago I was on citalopram and it basically made my penis numb and caused weight gain. Made my depression worse.&quot;}, {&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;fuck yeah, citalopram. Sure, I can't lose weight or cum but at least I don't feel like a living raw nerve and the world is sandpaper&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;وزنم رسید به ۲۰۰ پوند! تو ۱۵ ماه گذشته حدودا ۲۰ پوند اضافه کرده‌ام! مثل اینکه از عوارض مصرف Escitalopram ئه.&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;coloco na conta do escitalopram e o ac que precisei tomar por 3 meses (agora que pensei nisso e acabei o tratamento com ac espero manter os kg, pelo amor de deus 🙏&quot;}, {&quot;category&quot;: &quot;Ac&quot;, &quot;content&quot;: &quot;coloco na conta do escitalopram e o ac que precisei tomar por 3 meses (agora que pensei nisso e acabei o tratamento com ac espero manter os kg, pelo amor de deus 🙏&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;pior que nao, 2019 eu engordei por causa do escitalopram e passei a pandemia toda assim aí só fui voltar pro peso de 10 anos atrás ano passado\nfoi uma diferença de 5-7kg oq não é quase nada mas fico pensando que pode acontecer de mudar meu peso no futuro por conta do metabolismo e n faço exercicios&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;escitalopram me fez engordar, eu ganhei uma bundinha gostosa quando tomava 😩&quot;}, {&quot;category&quot;: &quot;Lexapro&quot;, &quot;content&quot;: &quot;Steroidal drugs or antidepressants. Lexapro (escitalopram) and most other selective serotonin reuptake inhibitors (SSRIs) are likely to cause weight gain if you take them long term.&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;cn essen essstörung\n\nimmerhin klappt es mit all dem stress und ohne escitalopram wieder mit dem wunschgewicht. no fat shaming. just traumata. und vielleicht auch essstörungen. idk tbh&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;eu dia 15 vestindo traje de gala p ir pedir p psiquiatra p tirar a mirtazapina (pq ela ta atrapalhando minha dieta) e trocar a sertralina pela fluoxetina (pq a segunda funciona mlr e me ajuda)&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Eu tinha 58 kg qnd comecei a tomar paroxetina agr To cm 65 e estabilizei agr nesse peso mas sinceramente? Sou mais feliz agr eu tava mt magra antes e me sentia fraca eu realmente acho q o meu peso atual é proporcional p minha altura relativamente alta&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Eu já engordei um monte e não tava conseguindo voltar pro meu peso \&quot;normal\&quot; (o novo normal) com o escitalopram, agora vou tomar paroxetina, um remédio que costuma engordar bem mais. Porém tô completamente fodida de ansiedade e ele faz sentido pras minhas necessidades urgentes ¯\\_(ツ)_/¯&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Eu já engordei um monte e não tava conseguindo voltar pro meu peso \&quot;normal\&quot; (o novo normal) com o escitalopram, agora vou tomar paroxetina, um remédio que costuma engordar bem mais. Porém tô completamente fodida de ansiedade e ele faz sentido pras minhas necessidades urgentes ¯\\_(ツ)_/¯&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Paroxetina foi o melhor remédio que eu já tomei na vida, pena que eu engordei 15kg com ele&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Antidepressivos:\n\n De acordo com um estudo da Universidade de Harvard, os antidepressivos que mais podem causar aumento de peso são o escitalopram, a paroxetina e a duloxetina. Os antidepressivos tricíclicos e tetracíclicos também podem causar ganho de peso.&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Antidepressivos:\n\n De acordo com um estudo da Universidade de Harvard, os antidepressivos que mais podem causar aumento de peso são o escitalopram, a paroxetina e a duloxetina. Os antidepressivos tricíclicos e tetracíclicos também podem causar ganho de peso.&quot;}, {&quot;category&quot;: &quot;Duloxetina&quot;, &quot;content&quot;: &quot;Antidepressivos:\n\n De acordo com um estudo da Universidade de Harvard, os antidepressivos que mais podem causar aumento de peso são o escitalopram, a paroxetina e a duloxetina. Os antidepressivos tricíclicos e tetracíclicos também podem causar ganho de peso.&quot;}, {&quot;category&quot;: &quot;Tricíclicos&quot;, &quot;content&quot;: &quot;Antidepressivos:\n\n De acordo com um estudo da Universidade de Harvard, os antidepressivos que mais podem causar aumento de peso são o escitalopram, a paroxetina e a duloxetina. Os antidepressivos tricíclicos e tetracíclicos também podem causar ganho de peso.&quot;}, {&quot;category&quot;: &quot;Tetracíclicos&quot;, &quot;content&quot;: &quot;Antidepressivos:\n\n De acordo com um estudo da Universidade de Harvard, os antidepressivos que mais podem causar aumento de peso são o escitalopram, a paroxetina e a duloxetina. Os antidepressivos tricíclicos e tetracíclicos também podem causar ganho de peso.&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Antidepressivos: De acordo com um estudo da Universidade de Harvard, os antidepressivos que mais podem causar aumento de peso são o escitalopram, a paroxetina e a duloxetina. Os antidepressivos tricíclicos e tetracíclicos também podem causar ganho de peso.&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Antidepressivos: De acordo com um estudo da Universidade de Harvard, os antidepressivos que mais podem causar aumento de peso são o escitalopram, a paroxetina e a duloxetina. Os antidepressivos tricíclicos e tetracíclicos também podem causar ganho de peso.&quot;}, {&quot;category&quot;: &quot;Duloxetina&quot;, &quot;content&quot;: &quot;Antidepressivos: De acordo com um estudo da Universidade de Harvard, os antidepressivos que mais podem causar aumento de peso são o escitalopram, a paroxetina e a duloxetina. Os antidepressivos tricíclicos e tetracíclicos também podem causar ganho de peso.&quot;}, {&quot;category&quot;: &quot;Tricíclicos&quot;, &quot;content&quot;: &quot;Antidepressivos: De acordo com um estudo da Universidade de Harvard, os antidepressivos que mais podem causar aumento de peso são o escitalopram, a paroxetina e a duloxetina. Os antidepressivos tricíclicos e tetracíclicos também podem causar ganho de peso.&quot;}, {&quot;category&quot;: &quot;Tetracíclicos&quot;, &quot;content&quot;: &quot;Antidepressivos: De acordo com um estudo da Universidade de Harvard, os antidepressivos que mais podem causar aumento de peso são o escitalopram, a paroxetina e a duloxetina. Os antidepressivos tricíclicos e tetracíclicos também podem causar ganho de peso.&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;Toda vez q larguei a sertralina engordo horrores. E ja acinteceu de novo 😭&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;Nós garotas que tomamos kg de sertralina 💔😭✨&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;Então, aparentemente a bupropiona é usada pra emagrecer mesmo, o efeito de engorda que eu tive é raro 🤷🏻‍♀️&quot;}, {&quot;category&quot;: &quot;Risperidona&quot;, &quot;content&quot;: &quot;esses mesmos que me deram peso vei n sei oq acontece o risperidona o psiquiatra disse que já veio gente com relato de ter saído leite dos peitos ????¿ mexe muito com os hormônios, finalmente ele me deu bupropiona q controla vícios e compulsão alimentar mas só senti dps de 3 meses&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;soi diagnosticada com bipolaridade, borderline, depressão e ansiedade generalizada, e tomo bupropiona, trazodona, buspirona e lamotrigina 🙏 pelo oq eu pesquisei n dá ganho de peso mas se vcs souberem que algum engorda me digam pfvr / eu antes e depois mas meu menor peso ainda foi fucking 65kg&quot;}, {&quot;category&quot;: &quot;Trazodona&quot;, &quot;content&quot;: &quot;soi diagnosticada com bipolaridade, borderline, depressão e ansiedade generalizada, e tomo bupropiona, trazodona, buspirona e lamotrigina 🙏 pelo oq eu pesquisei n dá ganho de peso mas se vcs souberem que algum engorda me digam pfvr / eu antes e depois mas meu menor peso ainda foi fucking 65kg&quot;}, {&quot;category&quot;: &quot;Buspirona&quot;, &quot;content&quot;: &quot;soi diagnosticada com bipolaridade, borderline, depressão e ansiedade generalizada, e tomo bupropiona, trazodona, buspirona e lamotrigina 🙏 pelo oq eu pesquisei n dá ganho de peso mas se vcs souberem que algum engorda me digam pfvr / eu antes e depois mas meu menor peso ainda foi fucking 65kg&quot;}, {&quot;category&quot;: &quot;Lamotrigina&quot;, &quot;content&quot;: &quot;soi diagnosticada com bipolaridade, borderline, depressão e ansiedade generalizada, e tomo bupropiona, trazodona, buspirona e lamotrigina 🙏 pelo oq eu pesquisei n dá ganho de peso mas se vcs souberem que algum engorda me digam pfvr / eu antes e depois mas meu menor peso ainda foi fucking 65kg&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;Mana, tu é a única pessoa além de mim que eu conheço que tomou Bupropiona e engordou. Eu tomei por três meses, engordei seis quilos nesse tempo e passei a roncar tão alto que nem meu marido queria dormir ao meu lado. Parei, sigo só com o Escitalopram.&quot;}, {&quot;category&quot;: &quot;Valproato&quot;, &quot;content&quot;: &quot;olha, tenho bastante hits mesmo:\n- mirtazapina (mãe) \n- bupropiona  (madrasta boa) \n- venlafaxina (perfeita) \n- valproato (bom, mas engorda).\n- topiramato (DEUS) \n- lamotrigina (diva)&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;topiramato e bupropiona eu preciso pq a fibromialgia engorda e medicamentos como mirtazapina e gabapentina, engordam, mas não posso me livrar delas por serem eficazes. atomoxetina pro tdah é boa, melhor que a dependência da ritalina. acho que vou tirar a lamotrigina. se precisar, jogo um valproato.&quot;}, {&quot;category&quot;: &quot;Gabapentina&quot;, &quot;content&quot;: &quot;topiramato e bupropiona eu preciso pq a fibromialgia engorda e medicamentos como mirtazapina e gabapentina, engordam, mas não posso me livrar delas por serem eficazes. atomoxetina pro tdah é boa, melhor que a dependência da ritalina. acho que vou tirar a lamotrigina. se precisar, jogo um valproato.&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Eu vou recuperar meu corpo pré-hipotireoidismo + mirtazapina e daí it's over pra todo mundo que cruzar meu caminho&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Comecei a tomar mirtazapina e estou a ponto de comer o pé da mesa. Já engordei 4 kg em pouco mais de 2 meses&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Quando eu comecei a tomar mirtazapina, eu tinha uma fissura insana por doce, principalmente de noite antes de ir dormir. Com o tempo foi passando e voltou ao normal, mas foram bem uns seis meses ou mais nisso, e foi assim que engordei 12kgs.&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Es normal que los antidepresivos den sueñito. Estate también atento a los efectos secundarios y a cómo te va porque a veces el que te mandan puede no irte bien. A mí me cambiaron la fluoxetina por mirtazapina porque la fluoxetina me quitaba el hambre y no comía nada. Con la otra hasta engordé 🤣&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;sdds mirtazapina 😭 eu tomava ele e dez minutos depois já tava me acabando de sono e geralmente so acordava mesmo com o despertador, uma pena que tinha vezes que eu tomava e o sono demorava a bater e o mais triste ainda é que me fez engordar 10KG EM 6 MESES!!!!!! sinceramente&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Sou uma baleia, galera. Tive descontrole ontem😐😐😐 não devia ter voltado pra mirtazapina. Agora é correr atrás do prejuízo&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Efectivamente, la mirtazapina es un heterocíclico. Le va genial a algunas personas, aunque yo lo suelo dejar esa familia como segunda línea por dos efectos secundarios muy frecuentes: ganancia de peso (por aumento del apetito) e hipersomnia que puede durar hasta bien entrado el día siguiente...&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Sem falar que um dos meus antidepressivos é a porra da MIRTAZAPINA. Essa BUCETA dá uma fome do caralho e no início do tratamento, me fez ganhar uns 5kg&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;tw // o post não é necessariamente sobre isso mas é gatilho pra transtornos alimentares \n\nConselho do fundo do meu coração \n\nA não ser que vc esteja preparado pra engordar TANTO que vc vai ter que renovar seu guarda roupa inteiro PQ NENHUMA ROUPA SUA VAI SERVIR MAIS, não aceite tomar mirtazapina&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Eu uso mirtazapina a noite e buspirona durante o dia só em casos de crise de ansiedade. A Sertralina marquei o bingo dos efeitos colaterais kkkk a mirtazapina tem muita gente que n da certo pq abre o apetite, aí a galera ganha peso&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;o mirtazapina engorda que ódio&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Sendo que só 5 tão me servindo pq a desgraçada da mirtazapina me deu 10 kg de presente mas estou me vingando e uma hora chegarei lá novamente&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;tomo  alguns  que  emagrecem  e  a  mirtazapina  que  engorda  fico  confusa  :,(&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;pensando em pedir pro meu psiquiatra pra pararmos com a mirtazapina. engorda e dá sono, ta me irritando ja.&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;falaram que a mirtazapina engorda demais, mas vc gosta dos dois ?&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;desvenlafaxina engorda??&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;E eu que tomo Venlafaxina + tenho uma neuropatia bizarra que mexe em parte com sensação e percepção de calor + excesso de peso?! 🤡\nCombinação do DEMOOOOO&quot;}, {&quot;category&quot;: &quot;Abilify&quot;, &quot;content&quot;: &quot;sertralina é mais tranquilo, tomei também até amamentando. O q me fodeu foi o Abilify (e provavelmente venlafaxina tbm); ganhei 20 kgs e fiquei com muita coisa fodida :(\nforça aí muié &lt;3&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;sertralina é mais tranquilo, tomei também até amamentando. O q me fodeu foi o Abilify (e provavelmente venlafaxina tbm); ganhei 20 kgs e fiquei com muita coisa fodida :(\nforça aí muié &lt;3&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;eu engual ela depois que comecei a tomar a venlafaxina&quot;}, {&quot;category&quot;: &quot;Quetiapina&quot;, &quot;content&quot;: &quot;Alguém que já tomou quetiapina pode me dizer se engorda??? Vou tomar junto com o a venlafaxina e tô com medo de engordar&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Alguém que já tomou quetiapina pode me dizer se engorda??? Vou tomar junto com o a venlafaxina e tô com medo de engordar&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Alguém já tomou venlafaxina sabe se engorda? Tô vendo relatos de pessoas que perderam mais de 20kg em 6 meses e outras que engordaram 17kg😭😭&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;eu ate me doparia con amitriptilina so q esse remedio engorda e ja q provavelmente nao foi morrer não quero ficar balofo amanhã.&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;amitriptilina amg,to morrendo de medo de engordar&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;Eu engordei uns 10kg na amitriptilina, sem brincadeira. A fome que ele te faz sentir é incontrolável e surreal, nunca senti isso na vida, nem depois de dias em jejum&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;amitriptilina trazendo toda a gordurinha que ritalina me tirou amém&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;so tomar 25mg de amitriptilina por dia amr engordei 10kg 👏🏾👏🏾&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;aí amg pede outro, amitriptilina tbm engorda, por isso sempre faço nf quando eu tomo&quot;}, {&quot;category&quot;: &quot;Lítio&quot;, &quot;content&quot;: &quot;eu: não quero mais tomar lítio\npsiqui: pq?\neu: não notei efeito positivo e dá fome, estou pré-diabética e engordando.\npsiqui: ok, vamos trocar, vai tomar nortriptilina - 4cps\n ----- duas semanas depois-----\neu: sono sem fim e comendo mais que uma leitoa\n😥&quot;}, {&quot;category&quot;: &quot;Nortriptilina&quot;, &quot;content&quot;: &quot;engordei 10kg com nortriptilina essa merda&quot;}]" />
          <attvalue for="3" value="24" />
