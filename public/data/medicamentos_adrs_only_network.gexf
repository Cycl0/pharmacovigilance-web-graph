      <node id="Alcool" label="Alcool">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="2" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Mirtazapin&quot;, &quot;content&quot;: &quot;Mirtazapina+ escitalopram tomados juntos + uma latinha de cerveja por dia (não necessariamente junto dos medicamentos) = exatamente isso aí com o plus super dopação\n\nContras: bom, esses remédios não podem ser tomados juntos, mirtazapina+ álcool tbm não pode! Vc não morre né mas eu não arriscaria +&quot;}|||{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Mirtazapina+ escitalopram tomados juntos + uma latinha de cerveja por dia (não necessariamente junto dos medicamentos) = exatamente isso aí com o plus super dopação\n\nContras: bom, esses remédios não podem ser tomados juntos, mirtazapina+ álcool tbm não pode! Vc não morre né mas eu não arriscaria +&quot;}" />
          <attvalue for="3" value="3" />
