          <attvalue for="2" value="[{&quot;category&quot;: &quot;Alucinação&quot;, &quot;content&quot;: &quot;Aff eu alucinei com sertralina e propanolol juntos no começo eu tive ataque de pânico depois rachei o bico, o melhor foi meus pais achando q eu tinha usado alguma droga 🤡&quot;}, {&quot;category&quot;: &quot;Ataques de pânico&quot;, &quot;content&quot;: &quot;Aff eu alucinei com sertralina e propanolol juntos no começo eu tive ataque de pânico depois rachei o bico, o melhor foi meus pais achando q eu tinha usado alguma droga 🤡&quot;}, {&quot;category&quot;: &quot;Hipotensão&quot;, &quot;content&quot;: &quot;Agora eu fui raciocinar q oq me deixou assim foi os 15 comprimido de propanolol q eu tomei junto com meia cartela de sertralina 😔 burra do carai\nAi a pressão desregulou e to aqui desfalecida&quot;}, {&quot;category&quot;: &quot;Fraqueza&quot;, &quot;content&quot;: &quot;Agora eu fui raciocinar q oq me deixou assim foi os 15 comprimido de propanolol q eu tomei junto com meia cartela de sertralina 😔 burra do carai\nAi a pressão desregulou e to aqui desfalecida&quot;}]" />
