      <node id="Venvanse" label="Venvanse">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="13" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;&quot;}, {&quot;category&quot;: &quot;Irritabilidade&quot;, &quot;content&quot;: &quot;&quot;}, {&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;&quot;}, {&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;a abstinencia do escitalopram ta bem mais bizarra do que a abstinencia da ritalina/venvanse pqp&quot;}, {&quot;category&quot;: &quot;Perda da libido&quot;, &quot;content&quot;: &quot;É real, Escitalopram e Venvanse = Líbido -350&quot;}, {&quot;category&quot;: &quot;Alteração do apetite&quot;, &quot;content&quot;: &quot;Ai n sabia que o venvanse cortava o apetite… lembro de quando tomei fluoxetina pela primeira vez e me sentia tão magrinha…&quot;}, {&quot;category&quot;: &quot;Fadiga&quot;, &quot;content&quot;: &quot;tô no litio faz uns 3/4, vou morrer tomando \n\nquetiapina comecei ano passado mas me deu problema, parei e agr voltei e tá sendo uma delícia \n\nsertralina tive q largar pq me deu 1 mês de mania kkk\n\nvenvanse na época q eu achei q tinha tdah (n tenho) passei 3 morto e o resto do mês tomando placebo&quot;}, {&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;suando em bicas e tremendo mais que vara verde\n\num oferecimento: adaptação venvanse + sertralina&quot;}, {&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;suando em bicas e tremendo mais que vara verde\n\num oferecimento: adaptação venvanse + sertralina&quot;}, {&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Felizmente tá sendo melhor que a adaptação ao duloxetina, ali foi inferno viu.. mas também estava no auge na TAG, ai foi peso.. mas o escitalopram tá caindo como uma luva, tava foda viver feito Willy Wonka com o duloxetina, ainda tinha o Venvanse que piorava kkkkk agora o esc segura a onda, top kkkk&quot;}, {&quot;category&quot;: &quot;Mania&quot;, &quot;content&quot;: &quot;Nossa que louco isso né, eu sentia isso quando ficava um dia sem tomar o duloxetina que se não me engano tem quase a mesma via de ação do venla e desvenla, mas aí antes de ontem eu mudei pra o escitalopram e tá sendo um sonho porque ainda tomo Venvanse, ficava mto serelepe, maniaco kkk o esc segurou&quot;}, {&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;&quot;}]" />
          <attvalue for="3" value="10" />
          <attvalue for="4" value="15" />
          <attvalue for="5" value="4.083120 -0.297196" />
          <attvalue for="6" value="#2DCD9F" />
        </attvalues>
      </node>
      <node id="Nortriptilina" label="Nortriptilina">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="17" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Embotamento afetivo&quot;, &quot;content&quot;: &quot;No geral todos os antidepressivos deixam a gente lesa. Tomei a venla a desvenla, lítio, sertralina, fluoxetina, nortriptilina , Amitriptilina. A risperidona comecei estes dias e faço combo com mais dois dos citados. O nosso cérebro parece derreter. ( São 22 anos com remédios, ainda não acertam)&quot;}, {&quot;category&quot;: &quot;Distúrbios gastrointestinais&quot;, &quot;content&quot;: &quot;tomo! Kkkry Ansitec e desvenlafaxina, além do venvanse pro tdah e o rahime pra dormir e nortriptilina pra enxaqueca (mas esse acaba agora essa semana graças a deus n tem estômago q aguente essa tuia de remédio&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Quero sair do amitriptilina pro nortriptilina\nE testar talvez o imipramina, porém não daria pra usar os dois juntos pq ambos dão sono. Vortioxetina é interessante também mas não trata neuropatia\nEntão eu teria que escolher só um&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;abstinência de nortriptilina gostoso demais&quot;}, {&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;náusea inacreditável causada por abstinência de nortriptilina e privação de sono&quot;}, {&quot;category&quot;: &quot;Labilidade emocional&quot;, &quot;content&quot;: &quot;E daí é isso, crise de choro hoje, por qual motivo não sei, mas com o desbalanço emocional grátis causado por nortriptilina+ clorpromazina pq é isso q a neurologista escolheu pra usar pra eu sair desse estado porém essa combi tá estranho na minha mente&quot;}, {&quot;category&quot;: &quot;Desregulação emocional&quot;, &quot;content&quot;: &quot;E daí é isso, crise de choro hoje, por qual motivo não sei, mas com o desbalanço emocional grátis causado por nortriptilina+ clorpromazina pq é isso q a neurologista escolheu pra usar pra eu sair desse estado porém essa combi tá estranho na minha mente&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;eu: não quero mais tomar lítio\npsiqui: pq?\neu: não notei efeito positivo e dá fome, estou pré-diabética e engordando.\npsiqui: ok, vamos trocar, vai tomar nortriptilina - 4cps\n ----- duas semanas depois-----\neu: sono sem fim e comendo mais que uma leitoa\n😥&quot;}, {&quot;category&quot;: &quot;Aumento do apetite&quot;, &quot;content&quot;: &quot;eu: não quero mais tomar lítio\npsiqui: pq?\neu: não notei efeito positivo e dá fome, estou pré-diabética e engordando.\npsiqui: ok, vamos trocar, vai tomar nortriptilina - 4cps\n ----- duas semanas depois-----\neu: sono sem fim e comendo mais que uma leitoa\n😥&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;mas eu tomo a nortriptilina que sinceramente acho que é o que faz dormir o ansitec so da um senso de tranquilidade mesmo (que eu estava precisando sinceramente)&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;essa noite vou tomar uma cartela inteira de cloridrato de nortriptilina e qro ver qm vai me impedir de ter uma overdose e morrer 🖤&quot;}, {&quot;category&quot;: &quot;Pressão no nervo óptico&quot;, &quot;content&quot;: &quot;te falar q fiz tomando 150mg de nortriptilina dai tava c a pressao do nervo optico la na puta que pariu e fiz praticamente as cegas&quot;}, {&quot;category&quot;: &quot;Visão turva&quot;, &quot;content&quot;: &quot;te falar q fiz tomando 150mg de nortriptilina dai tava c a pressao do nervo optico la na puta que pariu e fiz praticamente as cegas&quot;}, {&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;engordei 10kg com nortriptilina essa merda&quot;}, {&quot;category&quot;: &quot;Taquicardia&quot;, &quot;content&quot;: &quot;já sim, batimentos acima de 100 em repouso e o Holter e o ergométrico indicaram a mesma coisa, taquicardia sinusal, depois de descobrir eu até parei de tomar nortriptilina que eu tomava antes pq ela pode causar taquicardia\nvou no arritmologista mesmo, acho melhor né&quot;}, {&quot;category&quot;: &quot;Taquicardia&quot;, &quot;content&quot;: &quot;dps que eu passei a tomar desvenlafaxina meu intestino voltou ao normal e agr eu consigo ir no banheiro todo dia 😸 já amo mais que a cachorra da nortriptilina que me deu taquicardia e eu ficava 1 semana sem c4g4r&quot;}, {&quot;category&quot;: &quot;Constipação&quot;, &quot;content&quot;: &quot;dps que eu passei a tomar desvenlafaxina meu intestino voltou ao normal e agr eu consigo ir no banheiro todo dia 😸 já amo mais que a cachorra da nortriptilina que me deu taquicardia e eu ficava 1 semana sem c4g4r&quot;}]" />
