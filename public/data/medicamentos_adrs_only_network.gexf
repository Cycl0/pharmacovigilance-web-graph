      <node id="Dor" label="Dor">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="7" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;sério, eu tô com muita dor. do dedo mindinho até o último fio de cabelo. maldita paroxetina&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;faz 2 semanas. a dor não é muito forte, mas é irritante. talvez seja tb pq eu tô retirando a paroxetina e dizem que essa é bem difícil de parar&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;uma noite chegaram com ele pra eu tomar. mandei pra dentro 300mg de bupropiona de liberação normal e senti tanta tanta tanta dor que eu URRAVA, só consegui dormir depois de 10mg de morfina e uma injeção de fenergan. no dia seguinte, acordei BOA como se NADA????&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;inclusive, posso te fazer uma pergunta já que vc toma o bupropiona tb? vc teve dores de cabeça/no corpo quando começou ele? pra mim tá foda&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;esqueço de tomar metilfenidato: no máximo uma dorzinha de cabeça \n\nesqueço a desvenlafaxina: dor morte tendências homicid&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;nossa viado acordei cm uma dor fudida na costela q irradia p peito barriga qnd eu faço alguns movimentos n sei se eh por causa do amitriptilina espero q eu nao esteja morrendo ! de tanto me chamarem d idosa por ser chata rabugenta eu acho q virei mesmo&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;amitriptilina amg, único efeito ruim é q dps q eu acordo parace q me espancaram, acordo com mta dor&quot;}]" />
          <attvalue for="3" value="4" />
          <attvalue for="4" value="18" />
