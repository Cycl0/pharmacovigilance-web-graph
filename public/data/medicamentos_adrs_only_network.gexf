          <attvalue for="2" value="[{&quot;category&quot;: &quot;Psicose&quot;, &quot;content&quot;: &quot;O cara é tão nazi que matou o próprio robozinho num surto de cetamina&quot;}, {&quot;category&quot;: &quot;Alucinação&quot;, &quot;content&quot;: &quot;este pessoal anda a dar-lhe forte na cetamina e está tudo alucinado&quot;}, {&quot;category&quot;: &quot;Dependência física&quot;, &quot;content&quot;: &quot;The Vivienne e a luta secreta contra o vício em cetamina  http://dlvr.it/TKKZSL http://dlvr.it/TKKZSM&quot;}, {&quot;category&quot;: &quot;Efeitos Agudos&quot;, &quot;content&quot;: &quot;Matthew Perry, Ator de \&quot;Friends\&quot;, Morre por Efeitos Agudos de Cetamina\n\nwww.memeiros.com/2025/04/matt...&quot;}, {&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;conheço quando alguém transpira cetamina e alguém usou tanto key que está transpirando cetamina no metrô&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;\&quot;Morte de The Vivienne: A Trágica Realidade do Uso de Cetamina e Seus Impactos na Comunidade LGBTQIA+\&quot;  http://dlvr.it/TJhc6X http://dlvr.it/TJhc6c&quot;}, {&quot;category&quot;: &quot;Dependência&quot;, &quot;content&quot;: &quot;\&quot;Tragédia na Comunidade Drag: O Legado de The Vivienne e a Luta Contra a Dependência de Cetamina\&quot;  http://dlvr.it/TJdq9h http://dlvr.it/TJdq9j&quot;}, {&quot;category&quot;: &quot;Insuficiência Cardíaca&quot;, &quot;content&quot;: &quot;\&quot;Morte de The Vivienne: O Impacto da Insuficiência Cardíaca Induzida por Cetamina na Comunidade Drag e LGBTQ+\&quot;  http://dlvr.it/TJdP2l http://dlvr.it/TJdP2m&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;\&quot;Morte de The Vivienne: A Trágica Perda que Revela os Perigos da Cetamina e Impacta a Comunidade LGBT\&quot;  http://dlvr.it/TJcB3f http://dlvr.it/TJcB3g&quot;}, {&quot;category&quot;: &quot;Morte Trágica&quot;, &quot;content&quot;: &quot;\&quot;Drag Queen The Vivienne: Morte Trágica Revela Perigos do Uso de Cetamina e Desperta Debate sobre Saúde Mental na Comunidade LGBT\&quot;  http://dlvr.it/TJc9nf http://dlvr.it/TJc9nh&quot;}, {&quot;category&quot;: &quot;Morte&quot;, &quot;content&quot;: &quot;\&quot;Investigação sobre a morte de The Vivienne: O alerta sobre os perigos da cetamina na comunidade LGBT\&quot;  http://dlvr.it/TJbRpP http://dlvr.it/TJbRpc&quot;}, {&quot;category&quot;: &quot;Morte&quot;, &quot;content&quot;: &quot;\&quot;Tragédia e Conscientização: A Morte de The Vivienne e os Riscos do Uso de Cetamina entre Jovens no Reino Unido\&quot;  http://dlvr.it/TJb6Ss http://dlvr.it/TJb6St&quot;}, {&quot;category&quot;: &quot;Mortes&quot;, &quot;content&quot;: &quot;\&quot;Mortes e Dependência: O Legado de The Vivienne e o Crescente Uso de Cetamina no Reino Unido\&quot;  http://dlvr.it/TJb6HK http://dlvr.it/TJb6HL&quot;}, {&quot;category&quot;: &quot;Dependência física&quot;, &quot;content&quot;: &quot;\&quot;Mortes e Dependência: O Legado de The Vivienne e o Crescente Uso de Cetamina no Reino Unido\&quot;  http://dlvr.it/TJb6HK http://dlvr.it/TJb6HL&quot;}, {&quot;category&quot;: &quot;Parada Cardíaca&quot;, &quot;content&quot;: &quot;A família de The Vivienne veio a publico revelar a causa da morte da queen. Ela sofreu uma parada cardíaca provocada pelos efeitos do uso de cetamina. #DragRace&quot;}, {&quot;category&quot;: &quot;Morte&quot;, &quot;content&quot;: &quot;\&quot;Tragédia na Comunidade LGBTQ+: A Morte de The Vivienne e os Riscos do Abuso de Cetamina\&quot;  http://dlvr.it/TJb0gf http://dlvr.it/TJb0gj&quot;}, {&quot;category&quot;: &quot;Morte&quot;, &quot;content&quot;: &quot;\&quot;Investigação Revela Causa da Morte de The Vivienne e Alerta para os Riscos do Uso de Cetamina entre Jovens\&quot;  http://dlvr.it/TJZssk http://dlvr.it/TJZssp&quot;}, {&quot;category&quot;: &quot;Dependência física&quot;, &quot;content&quot;: &quot;\&quot;Tragédia de The Vivienne: Aumento do uso de cetamina entre jovens levanta alertas sobre saúde mental e dependência\&quot;  http://dlvr.it/TJZsVY http://dlvr.it/TJZsVf&quot;}, {&quot;category&quot;: &quot;Dependência física&quot;, &quot;content&quot;: &quot;\&quot;Elon não consegue gerenciar sua própria empresa (TSLA despencando) nem proteger o X de ataques cibernéticos.\n\nMas não se preocupe: Trump diz q o egomaníaco nascido no exterior e viciado em cetamina definitivamente se importa mais com você e com esta nação do q consigo mesmo e com suas empresas.\&quot;\n🤣&quot;}, {&quot;category&quot;: &quot;Alucinação&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Dissociação&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Agitação&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Comprometimento cognitivo&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Inconsciência&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Amnésia&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Alucinações&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Agitação&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Comprometimento cognitivo&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Inconsciência&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Amnésia&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Agitação&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Comprometimento cognitivo&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Inconsciência&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Amnésia&quot;, &quot;content&quot;: &quot;A cetamina produz alucinações. Ela distorce as percepções de visão e som e faz com que o usuário se sinta desconectado e sem controle. A cetamina pode causar efeitos colaterais indesejados, como: agitação, depressão, dificuldades cognitivas, inconsciência e amnésia.&quot;}, {&quot;category&quot;: &quot;Dissociação&quot;, &quot;content&quot;: &quot;loucão de cetamina&quot;}, {&quot;category&quot;: &quot;Euforia&quot;, &quot;content&quot;: &quot;loucão de cetamina&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;&gt;coca zero sem cafeína. \n\nfdp é burro mas sabe evitar overdose de cetamina&quot;}, {&quot;category&quot;: &quot;Estado dissociativo&quot;, &quot;content&quot;: &quot;revogar a cidadania de alguém por causa de uma petição online é certamente algo que o Hélio Mosca certamente defenderia durante um surto chapado de cetamina&quot;}, {&quot;category&quot;: &quot;Comprometimento cognitivo&quot;, &quot;content&quot;: &quot;fica mais engraçado ainda considerando como recentemente o muskkk nao consegue formar uma frase coerente pois sempre está sob efeito de cetamina&quot;}, {&quot;category&quot;: &quot;Prejuízo do julgamento&quot;, &quot;content&quot;: &quot;Cetamina dá mto problema até onde eu vi, mta gente queixa dela criar ideia errada na cabeça.&quot;}, {&quot;category&quot;: &quot;Estado dissociativo&quot;, &quot;content&quot;: &quot;e ainda mais trilouco de cetamina&quot;}, {&quot;category&quot;: &quot;Dependência física&quot;, &quot;content&quot;: &quot;é alguém com a maturidade de um miúdo mimado de 13 anos, com o cérebro completamente viciado em cetamina, com 426 biliões para andar a fazer merda pelo mundo fora&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;Sentindo o treino nas paleta... Tudo doi — principalmente as panturrilhas. E eu ainda ia na aula de dança, acabei ficando porque ainda tava meio tontinha da lidocaína com cetamina que fiz na médica da dor.&quot;}, {&quot;category&quot;: &quot;Alucinação&quot;, &quot;content&quot;: &quot;Completamente alucinado, viciado em cetamina, e com síndrome de messianismo.&quot;}, {&quot;category&quot;: &quot;Dependência física&quot;, &quot;content&quot;: &quot;Completamente alucinado, viciado em cetamina, e com síndrome de messianismo.&quot;}, {&quot;category&quot;: &quot;Dependência física&quot;, &quot;content&quot;: &quot;É mto engraçado que os democratas pra bater no Elon Musk usam ao invés de qq coisa pavorosa q ele já tenha feito ou faz, o vício dele (segundo dizem) em Cetamina. Como se o universo libs democratas n fosse abarrotado de adictos de toda e qq substância existente. Ficam pior as carolas televangelistas&quot;}, {&quot;category&quot;: &quot;Agitação&quot;, &quot;content&quot;: &quot;Ontem ele tava virado na cetamina.&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;Ex-sinhazinha do Boi Garantido foi encontrada morta em maio passado e a suspeita é de overdose por cetamina.&quot;}, {&quot;category&quot;: &quot;Mal-estar&quot;, &quot;content&quot;: &quot;mandando mensagem pro meu medico implorando pra ele reduzir a dose da cetamina pq eu nao aguento mais passar mal pra caralho a cada sessao&quot;}, {&quot;category&quot;: &quot;Alucinação&quot;, &quot;content&quot;: &quot;pior que na sessão de cetamina as coisas se mexem muito parecido com algumas mídias e eu fico sempre \&quot;essa pessoa usa ketamina com ctz\&quot;&quot;}, {&quot;category&quot;: &quot;Dependência física&quot;, &quot;content&quot;: &quot;Amg acabei de ler a reportagem. Tá tendo um epidemia de pessoas usuárias de cetamina nos eua, dizem que é muito mais viciante e perigosa que outras drogas&quot;}, {&quot;category&quot;: &quot;Dissociação&quot;, &quot;content&quot;: &quot;eu faço microdosagem de cetamina com médico e tal. é surreal, os lugares, quem eu sou, meio que nada importa. mas a vez que a Vi foi mais real, parecia que eu conseguia ver o cabelo dela balançando com o vento e o sol. \n(não use drogas sem supervisão!!!)&quot;}, {&quot;category&quot;: &quot;Alucinação&quot;, &quot;content&quot;: &quot;eu faço microdosagem de cetamina com médico e tal. é surreal, os lugares, quem eu sou, meio que nada importa. mas a vez que a Vi foi mais real, parecia que eu conseguia ver o cabelo dela balançando com o vento e o sol. \n(não use drogas sem supervisão!!!)&quot;}, {&quot;category&quot;: &quot;Ideações suicidas&quot;, &quot;content&quot;: &quot;Será possível q voltar pra cetamina na vdd AUMENTOU a frequência das minhas ideacoes suicidas e crises de desrealização&quot;}, {&quot;category&quot;: &quot;Desrealização&quot;, &quot;content&quot;: &quot;Será possível q voltar pra cetamina na vdd AUMENTOU a frequência das minhas ideacoes suicidas e crises de desrealização&quot;}, {&quot;category&quot;: &quot;Comprometimento cognitivo&quot;, &quot;content&quot;: &quot;Ouvi boatos que a cetamina afeta o cognitivo........\nAakjdhdhdhndre&quot;}, {&quot;category&quot;: &quot;Morte&quot;, &quot;content&quot;: &quot;O médico Mark Chavez se declarou culpado pela morte de Matthew Perry em um tribunal de Los Angeles.\n\nDurante audiência, ele admitiu ter ajudado a fornecer a droga cetamina ilegalmente ao ator, que teve overdose. Chavez pode ser condenado a até 10 anos de prisão.&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;O médico Mark Chavez se declarou culpado pela morte de Matthew Perry em um tribunal de Los Angeles.\n\nDurante audiência, ele admitiu ter ajudado a fornecer a droga cetamina ilegalmente ao ator, que teve overdose. Chavez pode ser condenado a até 10 anos de prisão.&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;Mark Chavez, médico de Matthew Perry, se declarou culpado por fornecer cetamina ao ator, morto por overdose em outubro de 2023.\n\nO americano fez sua declaração nesta quarta-feira (2), no tribunal federal de Los Angeles (EUA), e se tornou a terceira pessoa a admitir culpa pela morte do ator.&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;Um dos dois médicos acusados pela morte por overdose do ator Matthew Perry, famoso pelo papel de Chandler na série Friends, se declarou culpado. Mark Chávez, de 54 anos, admitiu ter fornecido ilegalmente a droga cetamina para outro médico do ator.\n\n➡ Assista à GloboNews ao vivo: glo.bo/3ZelrCG&quot;}, {&quot;category&quot;: &quot;Overdose&quot;, &quot;content&quot;: &quot;1) O médico Mark Chavez se declarou culpado pela morte de Matthew Perry em um tribunal de Los Angeles nesta quarta-feira (2). Ele é um dos cinco acusados pela morte do astro de “Friends”.\n\nDurante audiência, ele admitiu ter ajudado a fornecer a droga cetamina ilegalmente ao ator, que teve overdose.&quot;}, {&quot;category&quot;: &quot;Overdose&quot;, &quot;content&quot;: &quot;🚨 Médico se declara culpado em caso de overdose de Matthew Perry, Mark Chavez, um dos médicos acusados pela morte por overdose do ator Matthew Perry, se declarou culpado de conspiração para distribuir cetamina. \n\nEle pode enfrentar até 10 anos de prisão.\n\nLeia mais em: curt.link/tBmar&quot;}, {&quot;category&quot;: &quot;Dependência&quot;, &quot;content&quot;: &quot;amiga ele morreu de overdose de cetamina aparentemente acidental ate que descobriram que o assistente e dois médicos tavam se aproveitando da dependência dele p fornecer e o assistente aplicava, tem ate mensagens entre eles debochando disso, aí hj o medico confessou, da um google ai que tem tudo&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;O médico Mark Chavez se declarou culpado pela morte de Matthew Perry por fornecer cetamina ilegalmente, resultando em sua overdose.&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;O médico Mark Chavez se declarou culpado pela morte de Matthew Perry em um tribunal de Los Angeles.\n\nDurante audiência, ele admitiu ter ajudado a fornecer a droga cetamina ilegalmente ao ator, que teve overdose. Chavez pode ser condenado a até 10 anos de prisão.&quot;}, {&quot;category&quot;: &quot;Overdose&quot;, &quot;content&quot;: &quot;Acabei de ver a notícia q um médico fdp forneceu cetamina pro Matthew Perry e por conta disso ele teve overdose, sério, é esse tipo de coisa q acaba com o meu bom senso, dá vontade de pegar esse médico e acabar com a raça dele, é inacreditavelmente absurdo alguém fazer isso com outro ser humano&quot;}, {&quot;category&quot;: &quot;Morte&quot;, &quot;content&quot;: &quot;➡️Médico que ajudou a fornecer cetamina a Matthew Perry se declara culpado por morte do ator\n\nredeondadigital.com.br/mundo/medico...&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;www.brasil247.com/mundo/medico...\nDe acordo com a autópsia, a causa da morte foi atribuída aos \&quot;efeitos agudos da cetamina\&quot;, uma substância controlada que o ator utilizava&quot;}, {&quot;category&quot;: &quot;Morte&quot;, &quot;content&quot;: &quot;#ISTOÉGENTE Médico acusado pela morte de #MatthewPerry se declara culpado. Autópsia determinou que a morte foi causada pelos 'efeitos agudos da cetamina'.\nistoe.com.br/medico-acusa...&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;Médico de Matthew Perry se declara culpado pela morte do ator por overdose\n\n↪️ Em audiência nos Estados Unidos, Mark Chavez admitiu ter ajudado a fornecer cetamina para o artista da série 'Friends'&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;MATTHEW PERRY | Médico que forneceu cetamina confessa envolvimento na morte do ator\n\nAtor, conhecido pelo papel de Chandler Bing na série 'Friends', morreu no ano passado de overdose&quot;}, {&quot;category&quot;: &quot;Morte&quot;, &quot;content&quot;: &quot;Médico que ajudou a distribuir cetamina a Matthew Perry se declara culpado pela morte do ator&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;🚨AGORA: O médico Mark Chavez se declarou culpado por fornecer cetamina ao ator Matthew Perry, morto por overdose em outubro de 2023.&quot;}, {&quot;category&quot;: &quot;Alucinação&quot;, &quot;content&quot;: &quot;Nossa mas o Elon não é um visionário, um empresário excepcional? Pelo visto o toque de Merdas do gênio não tá funcionando kkkkkk o pudim de cetamina tá alucinando sozinho em casa&quot;}, {&quot;category&quot;: &quot;Morte&quot;, &quot;content&quot;: &quot;\&quot;Todos nós usávamos a mesma quantidade de cetamina. Tem os exames, eles vieram colher nosso sangue. Ou seja, se fosse uma overdose mesmo por que o Ademar não está morto se fazemos uso do mesmo psicodélico?”, quis saber ela.\&quot; Porque cada organismo reage de um jeito né?! Estúpida!!! Que od1o!!!!!&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;Ou algo do tipo. Eu tô tonta de cetamina.\n\nMas expressar que alguém envelheceu bem, sabe?\n\nE não falo de manter aparência jovial, necessariamente.&quot;}, {&quot;category&quot;: &quot;Sequelas&quot;, &quot;content&quot;: &quot;Os cientistas precisam pesquisar mais sobre os efeitos da cetamina no cérebro pq eu acho que os gays do RJ estão ficando permanentemente sequelados de key&quot;}, {&quot;category&quot;: &quot;Mania&quot;, &quot;content&quot;: &quot;eu penso muito nos ex-executivos do twitter que tiveram o brio de esperar o tonhão foguetes entrar num episódio maníaco de cetamina, anunciar pro mundo que ia comprar o twitter, trucaram, largaram essa bomba no colo dele e ainda saíram com 44 bilhões de lucro em cima do otário&quot;}, {&quot;category&quot;: &quot;Agitação&quot;, &quot;content&quot;: &quot;Gente. A cetamina tava fervendo ontem a noite. Isso pode levar a interpretações que vão do estupro ao tráfico de crianças&quot;}, {&quot;category&quot;: &quot;Delírio&quot;, &quot;content&quot;: &quot;Gente. A cetamina tava fervendo ontem a noite. Isso pode levar a interpretações que vão do estupro ao tráfico de crianças&quot;}, {&quot;category&quot;: &quot;Estado dissociativo&quot;, &quot;content&quot;: &quot;Gente. A cetamina tava fervendo ontem a noite. Isso pode levar a interpretações que vão do estupro ao tráfico de crianças&quot;}, {&quot;category&quot;: &quot;Aumento do apetite&quot;, &quot;content&quot;: &quot;o novo tratamento com Cetamina tá me devolvendo o prazer de viver: tô sentindo MUITA fome&quot;}, {&quot;category&quot;: &quot;Alucinação&quot;, &quot;content&quot;: &quot;\&quot;Cetamina, quetamina ou ketamina: entenda anestésico que tem histórico de uso como droga ilícita. (...) Anestésico de uso humano e veterinário é utilizado na produção de droga sintética que causa alucinações.\&quot;&quot;}, {&quot;category&quot;: &quot;Dependência&quot;, &quot;content&quot;: &quot;Provavelmente na próxima consulta minha médica vai me receitar cetamina\n\nAlguém já usou? Tenho medo de ser fácil criar dependência&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;Tive que seguir uma página de notícias sensacionalistas bem péssima de Manaus pra eu poder acompanhar o caso da Djdja Cardoso que morreu de overdose de cetamina&quot;}, {&quot;category&quot;: &quot;Dependência física&quot;, &quot;content&quot;: &quot;Foi cetamina. Um droga usada como anestésico que vicia muito. Essa história que vc publicou é muito louca. Quando envolve violência de mãe com filho deixa todo mundo perplexo.&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;Acho que cetamina foi o que matou o Matthew Perry do Friends. Pesado!&quot;}, {&quot;category&quot;: &quot;Dissociação&quot;, &quot;content&quot;: &quot;Um off: a cetamina me deixou doidona quando usei na cirurgia&quot;}, {&quot;category&quot;: &quot;Estado dissociativo&quot;, &quot;content&quot;: &quot;Totalmente virado na cetamina esse tonho&quot;}, {&quot;category&quot;: &quot;Dependência física&quot;, &quot;content&quot;: &quot;Tem que lembrar que ele é viciado em cetamina&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;Roberto Cabrini solicitou e obteve autorização para realizar uma reportagem com Ademar Farias Cardoso Neto e Cleusimar Cardoso, irmão e mãe de Djidja Cardoso, que foi encontrada morta em 28 de maio de 2024, vítima de overdose provocada pelo uso excessivo de cetamina, uma substância anestésica.&quot;}, {&quot;category&quot;: &quot;Dependência física&quot;, &quot;content&quot;: &quot;E que assim seja pra esse filho da puta mimado cheirador de cobalto viciado em cetamina.&quot;}, {&quot;category&quot;: &quot;Morte&quot;, &quot;content&quot;: &quot;Médico se declara culpado em esquema de fornecimento de cetamina que resultou na morte de Matthew Perry&quot;}, {&quot;category&quot;: &quot;Psicose&quot;, &quot;content&quot;: &quot;O cara deve tá muito louco na cetamina nesses dias. Acho que vem mais surtada por aí.&quot;}, {&quot;category&quot;: &quot;Morte&quot;, &quot;content&quot;: &quot;Como morte de Matthew Perry revelou a 'terra sem lei' da cetamina em Hollywood&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;Matthew Perry: Justiça dos EUA acusa 5 pessoas de fornecer droga que causou morte do ator\nAutoridades acusam o assistente, um conhecido e dois médicos de conspiração para distribuir cetamina que resultou na overdose que matou ex-astro de 'Friends'\n#Resistencia2324Dias\nSiga nosso BlueSky DilmaResiste&quot;}, {&quot;category&quot;: &quot;Morte&quot;, &quot;content&quot;: &quot;'Rede criminosa' e 'rainha da cetamina' estão por trás de morte de Matthew Perry, diz polícia&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;Cetamina: com intoxicações em alta, Unicamp monitora consumo abusivo em festas e até erro médico&quot;}, {&quot;category&quot;: &quot;Rigidez&quot;, &quot;content&quot;: &quot;VÍDEO: mãe de Djidja Cardoso mostra filhos \&quot;travados\&quot; sob efeito de cetamina e pedindo mais\nwww.diariodocentrodomundo.com.br/essencial/vi...&quot;}, {&quot;category&quot;: &quot;Dependência física&quot;, &quot;content&quot;: &quot;O #SemCensura de ontem, 04/05, falou sobre como lidar com adição às drogas e o uso recreativo e ilegal da Cetamina. Flávia Alessandra explicou sobre seu novo projeto como apresentadora e ainda sobre as expectativas para seu aniversário de 50 anos.&quot;}, {&quot;category&quot;: &quot;Micção frequente&quot;, &quot;content&quot;: &quot;Cetamina, a droga que destrói saúde de jovens no Reino Unido: 'Não ando mais de 50 metros sem ter que urinar'. g1.globo.com/saude/notici...&quot;}, {&quot;category&quot;: &quot;Micção frequente&quot;, &quot;content&quot;: &quot;Cetamina, a droga que destrói saúde de jovens no Reino Unido: 'Não ando mais de 50 metros sem ter que urinar'&quot;}, {&quot;category&quot;: &quot;Micção frequente&quot;, &quot;content&quot;: &quot;Cetamina, a droga que destrói saúde de jovens no Reino Unido: 'Não ando mais de 50 metros sem ter que urinar'&quot;}, {&quot;category&quot;: &quot;Delírio&quot;, &quot;content&quot;: &quot;Embora seja bilionário, no seu cérebro, não passa de um tresloucado que  só abre a sua boca, latrina, para falar mherdha sob o efeito de maconha e cetamina.&quot;}, {&quot;category&quot;: &quot;Prejuízo do julgamento&quot;, &quot;content&quot;: &quot;Embora seja bilionário, no seu cérebro, não passa de um tresloucado que  só abre a sua boca, latrina, para falar mherdha sob o efeito de maconha e cetamina.&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;O que é cetamina, a droga poderosa que causou a morte do ator de 'Friends' Matthew Perry&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;Matthew Perry morreu devido à cetamina, aponta laudo&quot;}, {&quot;category&quot;: &quot;Dependência física&quot;, &quot;content&quot;: &quot;https://expresso.pt/sociedade/2023-08-14-Colegio-de-Psiquiatria-uso-de-cetamina-nao-deve-ser-promovido-publicamente-nem-publicitado-do-ponto-de-vista-comercial-a1123898&quot;}, {&quot;category&quot;: &quot;Comprometimento cognitivo&quot;, &quot;content&quot;: &quot;https://expresso.pt/sociedade/2023-08-14-Colegio-de-Psiquiatria-uso-de-cetamina-nao-deve-ser-promovido-publicamente-nem-publicitado-do-ponto-de-vista-comercial-a1123898&quot;}, {&quot;category&quot;: &quot;Dissociação&quot;, &quot;content&quot;: &quot;https://expresso.pt/sociedade/2023-08-14-Colegio-de-Psiquiatria-uso-de-cetamina-nao-deve-ser-promovido-publicamente-nem-publicitado-do-ponto-de-vista-comercial-a1123898&quot;}]" />
