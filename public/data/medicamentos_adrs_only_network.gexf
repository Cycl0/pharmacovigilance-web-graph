          <attvalue for="2" value="{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;try 40mg of Citalopram! I cannot cry at all, which is somehow worse!&quot;}|||{&quot;category&quot;: &quot;Trazodona&quot;, &quot;content&quot;: &quot;minha trazodona acabou vou me m&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;to literalmente uma combinação de pinscher com pitbull esses dias resultado do desmame da desvenlafaxina + tpm + ódio de classe&quot;}|||{&quot;category&quot;: &quot;Venlafaxine&quot;, &quot;content&quot;: &quot;segundo dia tomando venlafaxina e meu humor não oscilou uma vez, não fiquei ansiosa por nada e me sinto morta por dentro e isso me deixa adorável&quot;}|||{&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Como pode a Venlafaxina tirar todos os sentimentos de dentro de vc e ao mesmo tempo vc ainda sentir um monte de coisa&quot;}|||{&quot;category&quot;: &quot;Venlafaxine&quot;, &quot;content&quot;: &quot;Eu sofro disso com a venlafaxina\n\nOutro dia eu tomei duas vezes essa desgraça aí e não foi legal\n\nPassei o dia inteiro parecendo um doido&quot;}|||{&quot;category&quot;: &quot;Clomipramina&quot;, &quot;content&quot;: &quot;meu psiquiatra falou que clomipramina diminui o libido mas desde a hora que acordei hj só penso em sexo com o *&quot;}" />
