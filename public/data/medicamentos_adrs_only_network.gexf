      <node id="Suicídio" label="Suicídio">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="3" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Ich hab Citalopram kurzzeitig bekommen und dann akute Suizidgedanken. Zum Glück war ich nicht allein, das wurde dann abgesetzt und ich hab den Arzt gewechselt (nicht aus dem Grund) der hat mir \&quot;Duloxetin\&quot; verordnet und damit komme ich klar!&quot;}|||{&quot;category&quot;: &quot;Bupropion&quot;, &quot;content&quot;: &quot;clomipramina - 100mg (depressão)\nclorpromazina - 100mg (é um antipsicótico mas eu uso pra dormir)\nclonazepam - 4mg (pra ansiedade e pra dormir)\nbupropiona - 300mg (pra segurar os impulsos suicidas)\ndepakene - 200mg (pra impulso também)\ne por último mas não menos importante\nritalina - 10mg (TDAH)&quot;}|||{&quot;category&quot;: &quot;Amitriptyline&quot;, &quot;content&quot;: &quot;Sou filha única de uma mulher separada que recusa ajuda até do ex-marido q quer nos ajudar. Sou Bipolar, tenho TAG, tendências su1c1das. Meu remédio da Bipolaridade, a Amitriptilina acabou no SuS, tenho q pedir dinheiro emprestado pros outros pra comprar. Ou seja, me entupo de clonazepam pra dormir&quot;}" />
          <attvalue for="3" value="3" />
          <attvalue for="4" value="17" />
          <attvalue for="5" value="3.549017 1.984798" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
