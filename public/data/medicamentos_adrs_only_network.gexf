      <node id="Nortriptilina" label="Nortriptilina">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="8" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;náusea inacreditável causada por abstinência de nortriptilina e privação de sono&quot;}|||{&quot;category&quot;: &quot;Desregulação emocional&quot;, &quot;content&quot;: &quot;E daí é isso, crise de choro hoje, por qual motivo não sei, mas com o desbalanço emocional grátis causado por nortriptilina+ clorpromazina pq é isso q a neurologista escolheu pra usar pra eu sair desse estado porém essa combi tá estranho na minha mente&quot;}|||{&quot;category&quot;: &quot;Choro&quot;, &quot;content&quot;: &quot;Crises de choro no domingo a noite a base de nortriptilina + clorpromazina&quot;}|||{&quot;category&quot;: &quot;Enxaqueca&quot;, &quot;content&quot;: &quot;pensando seriamente em trocar a nortriptilina por propanolol no controle da enxaqueca porque ta insustentável&quot;}|||{&quot;category&quot;: &quot;Dependência física&quot;, &quot;content&quot;: &quot;Passei por isso e a minha é refrativa, não melhora com nenhuma medicação depois que começa. Hoje faço tratamento preventivo com nortriptilina + propranolol, reduziu em 90%. Foi o único tratamento que deu certo...&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;tomei a nortriptilina e o ansitec so faltou um clonazepam para ser perfeito eu ia dormir tão em paz que eu acho que ia derreter&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;cinegripe nortriptilina e rivotril ai papai vou dormir por 15 horas um beijo a todos&quot;}|||{&quot;category&quot;: &quot;Arritmia&quot;, &quot;content&quot;: &quot;já sim, batimentos acima de 100 em repouso e o Holter e o ergométrico indicaram a mesma coisa, taquicardia sinusal, depois de descobrir eu até parei de tomar nortriptilina que eu tomava antes pq ela pode causar taquicardia\nvou no arritmologista mesmo, acho melhor né&quot;}" />
          <attvalue for="3" value="7" />
          <attvalue for="4" value="11" />
          <attvalue for="5" value="2.497744 -1.800479" />
          <attvalue for="6" value="#2DCD9F" />
        </attvalues>
      </node>
      <node id="Desvenlafaxine" label="Desvenlafaxine">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="81" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;nuss to mt dodoi da cabeca.. n tomo remedio tem 2 dias 1 pq repeti dose sem querer ai resolvi ficar 1 dia sem tomar e no dia seguinte esqueci de tomar... os efeitos de ficar sem desvenlafaxina parecem com os da paroxetina.. pior sensacao do mundo mas a culpa é minha msm&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;gente aproveitando a reunião dos depressivos nas replies, comentem experiências com sertralina… atualmente eu tomo desvenlafaxina e tenho medo da mudança&quot;}|||{&quot;category&quot;: &quot;Irritabilidade&quot;, &quot;content&quot;: &quot;Se alguém vê algum Bluet (ex-tweet) meu e acha que tô bebade saiba que eu sou assim mesmo 24h por dia\n\nSe um dia eu estiver sob efeitos de outra substância além de succinato de desvenlafaxina monoidratado e Mirtazapina fujam eu viro o mal encarnado em 1,54m o ser mais irritante q já pisou nessa terr&quot;}|||{&quot;category&quot;: &quot;Choro&quot;, &quot;content&quot;: &quot;acho que só tomei calmante uma vez quando fiquei em abstinência de desvenlafaxina e chorava o tempo todo? nem sei como deve ser num dia \&quot;normal\&quot;&quot;}|||{&quot;category&quot;: &quot;Calafrios&quot;, &quot;content&quot;: &quot;15 graus e eu com calor, obrigada desvenlafaxina&quot;}|||{&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;Amigos q tomam desvenlafaxina, ela dá tontura?&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;minha depressão/ansiedade tá no talo hoje, quem diria que ficar 3 dias sem a desvenlafaxina me daria vontade de dormir por uma semana seguida&quot;}|||{&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Pois é, no meu caso é a desvenlafaxina e a abstinência dela é brutal, eu fico biruta&quot;}|||{&quot;category&quot;: &quot;Sonhos estranhos&quot;, &quot;content&quot;: &quot;o lado bom do desvenlafaxina é q ele te dá uns sonhos estranhos e aleatórios, seria mt divertido se fosse possível gravar oq a gente sonha. Dá umas histórias interessantes por incrível q pareça kk&quot;}|||{&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;Desvenlafaxina remedio nojento escroto odeio tomar essa merda preciso desmamar e simplesmente não consigo passar mais de 24h sem tomar q dá tontura e náusea e vontade d eme jogar da janela \nIncrivel&quot;}|||{&quot;category&quot;: &quot;Nausea&quot;, &quot;content&quot;: &quot;Desvenlafaxina remedio nojento escroto odeio tomar essa merda preciso desmamar e simplesmente não consigo passar mais de 24h sem tomar q dá tontura e náusea e vontade d eme jogar da janela \nIncrivel&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Eu tomo desvenlafaxina de 50mg, mas desde o ano passado minha vida é só porrada atrás de porrada\nEu duplique em dezembro, funcionou bem, mas eu q eu parei mto rápido\nMeu problema é q eu viciei em alprazola e rivotril pra mim agora é água 🥲&quot;}|||{&quot;category&quot;: &quot;Embotamento afetivo&quot;, &quot;content&quot;: &quot;aumentar a dose da desvenlafaxina realmente funcionou. funcionou pra virar um robô que nada sente incapaz de chorar e por consequência paro de sofrer por aquilo que está fora do meu controle. obrigado indústria farmacêutica&quot;}|||{&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;a mão de dizer \&quot;vamo voltar pra desvenlafaxina\&quot; chega a tremer 👋&quot;}|||{&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Caralho eu esqueci de tomar meus remédios ent mto provavelmente vou passar mal sem a desvenlafaxina😭😭 ABSTINENCIA VC ME PAGA!!&quot;}|||{&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;DITO ISSO eu descobri que se eu tomo a desvenlafaxina mais cedo eu fico com menos tremelique da cafeína, então estou aos poucos lutando para resgatar meu direito ao segundo café&quot;}|||{&quot;category&quot;: &quot;Mania&quot;, &quot;content&quot;: &quot;É minha cachorra kkkkkk faz amizade com todo mundo, a miss simpatia \n\nE siiiiim, eu não tava com grana pra ir no psiquiatra, e ele me vendeu o remédio. Abstinência de desvenlafaxina é brutal e eu não tô podendo&quot;}|||{&quot;category&quot;: &quot;Estresse&quot;, &quot;content&quot;: &quot;Vc ta triste e estressado nao é pq sua vida é uma bosta seu emprego é uma merda vc nao tem dinheiro a qualidade de vida é terrível o leite condensado virou mistura lactea! É  pq vc tem Transtorno Misto Depressivo Ansioso!!! Tome aqui 50mg de desvenlafaxina&quot;}|||{&quot;category&quot;: &quot;Calor&quot;, &quot;content&quot;: &quot;Mana, nem eu! Pensei até que tava na perimenopausa, mas a gineco descartou por conta do calor constante, não em ondas. \n\nDaí tava no tiktok e um psiquiatra falou de quem toma venlafaxina e desvenlafaxina sofrendo no calor por conta do estímulo de noradrenalina&quot;}|||{&quot;category&quot;: &quot;Choro&quot;, &quot;content&quot;: &quot;não tenho fotos do onsen em si porque não podia entrar com celular obviamente então me contento vendo essas da página do hotel.. 2 dias sem a desvenlafaxina e eu to chorando só de olhar fotos que nao fui nem eu que tirei&quot;}|||{&quot;category&quot;: &quot;Alucinação&quot;, &quot;content&quot;: &quot;esqueci de tomar desvenlafaxina ontem e hoje estou sofrendo as consequências\ncomecei a alucinar ter tontura e não conseguir fazer nada\n\ntenho uma reuniao importantissima com minha chefe 14h. \n\nmorte morte morte morte morte&quot;}|||{&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;esqueci de tomar desvenlafaxina ontem e hoje estou sofrendo as consequências\ncomecei a alucinar ter tontura e não conseguir fazer nada\n\ntenho uma reuniao importantissima com minha chefe 14h. \n\nmorte morte morte morte morte&quot;}|||{&quot;category&quot;: &quot;Vômito&quot;, &quot;content&quot;: &quot;Si no la tomo un día* o a veces menos, 12 horas, vomito todo durante varios días. Estuve un año buscando la causa y era eso. \n\n*igual yo tomo desvenlafaxina y en dosis altas, por eso el síndrome de abstinencia.&quot;}|||{&quot;category&quot;: &quot;Nervosismo&quot;, &quot;content&quot;: &quot;voltei a tomar desvenlafaxina se só porque to muito nervosa com o rumo que minha carreira vai tomar (ou deixar de tomar) e afinal não foi só lidar com trauma&quot;}|||{&quot;category&quot;: &quot;Tristeza&quot;, &quot;content&quot;: &quot;tô com tanta vontade de morrer e tão triste que só pode ser tpm, desvenlafaxina você me prometeu!!&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;hoje tirei a conclusao de que todos os efeitos colaterais que tenho da desvenlafaxina sao os mesmos da menopausa&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;hoje tirei a conclusao de que todos os efeitos colaterais que tenho da desvenlafaxina sao os mesmos da menopausa&quot;}|||{&quot;category&quot;: &quot;Inibição social&quot;, &quot;content&quot;: &quot;às vezes eu me pergunto o que rola no meu organismo pq todo mundo fala que esquecer de tomar desvenlafaxina causa muitos efeitos colaterais, assim como outros antidepressivos também causam efeitos nos primeiros dias ou no desmame. nunca aconteceu NADA disso comigo&quot;}|||{&quot;category&quot;: &quot;Sensações estranhas&quot;, &quot;content&quot;: &quot;às vezes eu me pergunto o que rola no meu organismo pq todo mundo fala que esquecer de tomar desvenlafaxina causa muitos efeitos colaterais, assim como outros antidepressivos também causam efeitos nos primeiros dias ou no desmame. nunca aconteceu NADA disso comigo&quot;}|||{&quot;category&quot;: &quot;Estresse&quot;, &quot;content&quot;: &quot;às vezes eu me pergunto o que rola no meu organismo pq todo mundo fala que esquecer de tomar desvenlafaxina causa muitos efeitos colaterais, assim como outros antidepressivos também causam efeitos nos primeiros dias ou no desmame. nunca aconteceu NADA disso comigo&quot;}|||{&quot;category&quot;: &quot;Alterações de energia&quot;, &quot;content&quot;: &quot;às vezes eu me pergunto o que rola no meu organismo pq todo mundo fala que esquecer de tomar desvenlafaxina causa muitos efeitos colaterais, assim como outros antidepressivos também causam efeitos nos primeiros dias ou no desmame. nunca aconteceu NADA disso comigo&quot;}|||{&quot;category&quot;: &quot;Dificuldade de concentração&quot;, &quot;content&quot;: &quot;às vezes eu me pergunto o que rola no meu organismo pq todo mundo fala que esquecer de tomar desvenlafaxina causa muitos efeitos colaterais, assim como outros antidepressivos também causam efeitos nos primeiros dias ou no desmame. nunca aconteceu NADA disso comigo&quot;}|||{&quot;category&quot;: &quot;Disfunção executiva&quot;, &quot;content&quot;: &quot;às vezes eu me pergunto o que rola no meu organismo pq todo mundo fala que esquecer de tomar desvenlafaxina causa muitos efeitos colaterais, assim como outros antidepressivos também causam efeitos nos primeiros dias ou no desmame. nunca aconteceu NADA disso comigo&quot;}|||{&quot;category&quot;: &quot;Sintomas de TDAH&quot;, &quot;content&quot;: &quot;às vezes eu me pergunto o que rola no meu organismo pq todo mundo fala que esquecer de tomar desvenlafaxina causa muitos efeitos colaterais, assim como outros antidepressivos também causam efeitos nos primeiros dias ou no desmame. nunca aconteceu NADA disso comigo&quot;}|||{&quot;category&quot;: &quot;Esquecimento&quot;, &quot;content&quot;: &quot;às vezes eu me pergunto o que rola no meu organismo pq todo mundo fala que esquecer de tomar desvenlafaxina causa muitos efeitos colaterais, assim como outros antidepressivos também causam efeitos nos primeiros dias ou no desmame. nunca aconteceu NADA disso comigo&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;nossa lítio deve derrubar memo né que merda meu deus\ntalvez meu desvenlafaxina funcione pela associação também e na moral que ficar sem libido traz PAZ DE ESPÍRITO&quot;}|||{&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Eu tomo desvenlafaxina há mais de 8 anos. Ontem esqueci meu remédio em Campinas e estou há mais de 48h sem.\nÉ impressionante o efeito da abstinência dele. Tive os piores pesadelos à noite e não consigo esboçar um sorriso nesse Natal. Me sinto exausto, culpado e tudo de pior.&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;3 dias sem desvenlafaxina e eu me vejo como candidato natural pra presidência do brasil, do banco dos brics, da cúpula do g20 e do fundo monetário internacional&quot;}|||{&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;umas 3 semanas, porém, eu to passando por um processo insuportável de desmame da desvenlafaxina... tá bem merda pq to sentindo sintomas físicos da abstinência, então acho que isso contribui pro estado que me encontro&quot;}|||{&quot;category&quot;: &quot;Dizziness&quot;, &quot;content&quot;: &quot;Hj acordei mt errado\nTo toda zonza esquisita parece q to sem tomar o desvenlafaxina ha 10 dias&quot;}|||{&quot;category&quot;: &quot;Confusion&quot;, &quot;content&quot;: &quot;Hj acordei mt errado\nTo toda zonza esquisita parece q to sem tomar o desvenlafaxina ha 10 dias&quot;}|||{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;viado do ceu tomei a desvenlafaxina e nao consigo ficar sequer de olho aberto e eu preciso estudar&quot;}|||{&quot;category&quot;: &quot;Tristeza&quot;, &quot;content&quot;: &quot;como eu vou ser triste se esse ano eu… comecei a tomar desvenlafaxina 🤍🙏&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Não queria estragar a piada, mas desde quando desvenlafaxina da sono?&quot;}|||{&quot;category&quot;: &quot;Nausea&quot;, &quot;content&quot;: &quot;psiquiatra me voltou pra desvenlafaxina e já estou sentindo as dores de cabeça nauseantes pq nunca tomo essa bosta no horário certo&quot;}|||{&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;psiquiatra me voltou pra desvenlafaxina e já estou sentindo as dores de cabeça nauseantes pq nunca tomo essa bosta no horário certo&quot;}|||{&quot;category&quot;: &quot;Paralisia do sono&quot;, &quot;content&quot;: &quot;ai mas que não sei o quê não sei o que lá esse horário é ruim pra engajamento\n\neu sei, é que eu acordei de um combo pesadelo + alucinação + paralisia do sono resultado de eu ter esquecido de tomar minha desvenlafaxina e tô esperando o remédio fazer efeito pra eu voltar a dormir&quot;}|||{&quot;category&quot;: &quot;Despersonalização&quot;, &quot;content&quot;: &quot;Quando vc esquece de tomar a desvenlafaxina e só percebe depois de algumas horas, quando parece que seu cérebro foi substituído por uma gelatina&quot;}|||{&quot;category&quot;: &quot;Inquietação&quot;, &quot;content&quot;: &quot;para dormir uso o Rivotril, mas tem dias que mesmo assim não durmo\n\na tremedeira eu tinha tomando carbolitio/desvenlafaxina&quot;}|||{&quot;category&quot;: &quot;Dizziness&quot;, &quot;content&quot;: &quot;É importante não interromper abruptamente o uso da Desvenlafaxina, pois pode causar síndrome de descontinuação, com sintomas como tontura e irritabilidade.\n\n#saudemental&quot;}|||{&quot;category&quot;: &quot;Irritability&quot;, &quot;content&quot;: &quot;É importante não interromper abruptamente o uso da Desvenlafaxina, pois pode causar síndrome de descontinuação, com sintomas como tontura e irritabilidade.\n\n#saudemental&quot;}|||{&quot;category&quot;: &quot;Mania&quot;, &quot;content&quot;: &quot;MULHER SIM!!!!!!! inclusive dizem q o desmame da desvenlafaxina é horrendo, né? eu já esqueci algumas vezes e parecia q eu ia morrer&quot;}|||{&quot;category&quot;: &quot;Nausea&quot;, &quot;content&quot;: &quot;agora se eu esquecer de tomar a desvenlafaxina de manhã, no final da tarde eu já tô nauseando, com dor de cabeça e querendo sair correndo pelo mundo 🫠 não perdoa 1 dia essa peste!&quot;}|||{&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;agora se eu esquecer de tomar a desvenlafaxina de manhã, no final da tarde eu já tô nauseando, com dor de cabeça e querendo sair correndo pelo mundo 🫠 não perdoa 1 dia essa peste!&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;Eu fiquei meio que o mesmo safado de sempre com ela 😂\n\nSertralina era péssima\n\nDesvenlafaxina foi o melhor, mas muito cara&quot;}|||{&quot;category&quot;: &quot;Abstinência&quot;, &quot;content&quot;: &quot;indo no psiquiatra com a abstinência da desvenlafaxina batendo&quot;}|||{&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;segundo dia sem desvenlafaxina e uma tremedeira incontrolável já me acometeu&quot;}|||{&quot;category&quot;: &quot;Dizzy&quot;, &quot;content&quot;: &quot;👈esqueceu de tomar a desvenlafaxina no horário e agora está com tontura&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;Eu já sou calorento e a adaptação da desvenlafaxina causa sudorese tô sentindo como se estivesse uns 30°C 🫠&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;aproveitei que já amanheceu pra já tomar a desvenlafaxina in hopes this will help me function properly and get me some sleep when the right time comes&quot;}|||{&quot;category&quot;: &quot;Vertigem&quot;, &quot;content&quot;: &quot;Sertralina bebeu, dormiu, parece que é até automático, já eu tomo desvenlafaxina e ele fez minha pressão cair do penhasco fora o embrulho no estômago, nota 0/10 para experiência&quot;}|||{&quot;category&quot;: &quot;Diarreia&quot;, &quot;content&quot;: &quot;Sertralina bebeu, dormiu, parece que é até automático, já eu tomo desvenlafaxina e ele fez minha pressão cair do penhasco fora o embrulho no estômago, nota 0/10 para experiência&quot;}|||{&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;sensação de que meu celebro tá solto na cabeça em razão do desmame da desvenlafaxina + enjôo em razão da adaptação do o vortioxetina = drama de minha parte&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;dia 2 sem desvenlafaxina pq não peguei a receita nova: ontem tava plena não senti bosta nenhuma, hoje parece que vou morrer a qualquer momento&quot;}|||{&quot;category&quot;: &quot;Esquecimento&quot;, &quot;content&quot;: &quot;Eu não sei se tô passando por um placebo de falta (?), mas esqueci a desvenlafaxina ontem (já retomei hoje) e parece que fui atropelada por um ônibus.&quot;}|||{&quot;category&quot;: &quot;Querência&quot;, &quot;content&quot;: &quot;olha. eu tomo desvenlafaxina vai fazer um ano e a minha vida melhorou MUITO, mas muito mesmo. o problema só é que se eu passo 24 horas sem tomar (as veis menos) eu começo a ter uma abstinência pancada. a venlafaxina, pelo que pesquisei, é parecida. FÉ E MARCHA&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;saudades da minha desvenlafaxina de rir atoa constantemente de não pensar em morrer 24h unica parte ruim era a dissociação os pesadelos o suor a falta de memória e q matou minha libido mas pelo menos eu tava alegrinha com 0 neurônios 0 ansiedade&quot;}|||{&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;eu tomando desvenlafaxina\n\nqueria: disposição\ntenho: tremedeira dps de fzr exercício/esforço físico&quot;}|||{&quot;category&quot;: &quot;Esquecimento&quot;, &quot;content&quot;: &quot;quando eu tomava sertralina e esquecia parecia que meu cérebro tirava print \n\nsinto a mesma coisa agora que tomo desvenlafaxina mas bemm pior&quot;}|||{&quot;category&quot;: &quot;Apatia&quot;, &quot;content&quot;: &quot;Me prometeram vontade de viver com desvenlafaxina e eu to cada vez menos querendo existir&quot;}|||{&quot;category&quot;: &quot;Desidratação&quot;, &quot;content&quot;: &quot;se a falta de desvenlafaxina faz com que eu sinta morte tomar então uma cartela inteira vai fazer eu me sentir viva ou me matar de vez?&quot;}|||{&quot;category&quot;: &quot;Despersonalização&quot;, &quot;content&quot;: &quot;se a falta de desvenlafaxina faz com que eu sinta morte tomar então uma cartela inteira vai fazer eu me sentir viva ou me matar de vez?&quot;}|||{&quot;category&quot;: &quot;Desregulação emocional&quot;, &quot;content&quot;: &quot;se a falta de desvenlafaxina faz com que eu sinta morte tomar então uma cartela inteira vai fazer eu me sentir viva ou me matar de vez?&quot;}|||{&quot;category&quot;: &quot;Desorientação&quot;, &quot;content&quot;: &quot;se a falta de desvenlafaxina faz com que eu sinta morte tomar então uma cartela inteira vai fazer eu me sentir viva ou me matar de vez?&quot;}|||{&quot;category&quot;: &quot;Desconforto&quot;, &quot;content&quot;: &quot;se a falta de desvenlafaxina faz com que eu sinta morte tomar então uma cartela inteira vai fazer eu me sentir viva ou me matar de vez?&quot;}|||{&quot;category&quot;: &quot;Desconforto mental&quot;, &quot;content&quot;: &quot;se a falta de desvenlafaxina faz com que eu sinta morte tomar então uma cartela inteira vai fazer eu me sentir viva ou me matar de vez?&quot;}|||{&quot;category&quot;: &quot;Tensão muscular&quot;, &quot;content&quot;: &quot;amg wu já tô há uns dois anos tomando desvenlafaxina e vira e mexe eu tenho umas crises, hoje mesmo eu tô aqui com o peito apertado, dificuldade de respirar mds que desatino&quot;}|||{&quot;category&quot;: &quot;Pain&quot;, &quot;content&quot;: &quot;esqueço de tomar metilfenidato: no máximo uma dorzinha de cabeça \n\nesqueço a desvenlafaxina: dor morte tendências homicid&quot;}|||{&quot;category&quot;: &quot;Dizziness&quot;, &quot;content&quot;: &quot;o desvenlafaxina é igualzinho kkkkk nao tem como esquecer mesmo de tomar o remedio pq começo a sentir tonturas e dor de cabeça&quot;}|||{&quot;category&quot;: &quot;Headache&quot;, &quot;content&quot;: &quot;o desvenlafaxina é igualzinho kkkkk nao tem como esquecer mesmo de tomar o remedio pq começo a sentir tonturas e dor de cabeça&quot;}|||{&quot;category&quot;: &quot;Reações alérgicas&quot;, &quot;content&quot;: &quot;Muita gente indicou o venlafaxina (Effexor) e falaram q o desvenlafaxine (pristiq) dá muito efeito colateral\nNo meu caso não tenho depressão \&quot;só\&quot; (😅) ansiedade&quot;}" />
