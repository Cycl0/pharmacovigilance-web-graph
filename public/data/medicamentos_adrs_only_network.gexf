      <node id="Zopiclone" label="Zopiclone">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="2" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Yeah I am fucking terrified of that. Currently 30mg citalopram with occasional interventions with diazepam and zopiclone keeps me stable&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;Which is what my GP and GIC Endo decided for me instead of P (which I was already taking).\nI already was on citalopram at the time.\nThey added different ones, which gave me different effects, unable to sleep, awful joint pain, etc. In the end they gave me a week of Zopiclone and left me without P.&quot;}" />
          <attvalue for="3" value="2" />
          <attvalue for="4" value="54" />
          <attvalue for="5" value="3.851945 1.902994" />
