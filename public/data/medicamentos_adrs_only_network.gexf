      <node id="Bupropion" label="Bupropion">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="236" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Irritabilidade&quot;, &quot;content&quot;: &quot;Quick update! I actually feel pretty great? The only withdraw symptoms I had were nausea &amp; irritability. I know I'm not completely out of the woods yet but hopefully that this was the extent of it. Just to give you an idea of how odd this is, I was on Citalopram for 3 yrs and Bupropion for 2ish.&quot;}|||{&quot;category&quot;: &quot;Libido&quot;, &quot;content&quot;: &quot;amg tem uns que não prejudicam a libido não, como é o caso da bupropiona (q inclusive da mt fogo no kur, tomava ela junto c a venlafaxina pra melhorar a libido e entrei no cio) a vortioxetina, fluvoxamina tbm não mexem na libido&quot;}|||{&quot;category&quot;: &quot;Reações alérgicas&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Síndrome serotoninérgica&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Sensação de frio&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Vertigem&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Disfunção sexual&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Síndrome do intestino irritável&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Estresse&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Sintomas de TDAH&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;Estoy entrando en tremenda etapa depresiva tomando antidepresivos \n\nJaque mate sertralina y Bupropion, yo soy más fuerte xddd&quot;}|||{&quot;category&quot;: &quot;Ataques de pânico&quot;, &quot;content&quot;: &quot;1 dia sem bupropiona. Boca já está menos seca, diminuiu o trismo. Humor um pouco mais rebaixado.&quot;}|||{&quot;category&quot;: &quot;Adverse Reaction&quot;, &quot;content&quot;: &quot;Nunca fiquei chapada tomando bupropiona. Será que vai dar ruim?&quot;}|||{&quot;category&quot;: &quot;Energia&quot;, &quot;content&quot;: &quot;Eu tenho depressão, ansiedade, autismo, TDAH e fobia social. O aripiprazol é um antipsicótico q trata os meus pensamentos paranóicos e irritabilidade. O vortioxetina é um antidepressivo normal e a bupropiona é outro antidepressivo mas que dá bastante energia e dá bom pra quem tem TDAH.&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;Bupropiona tá sendo vida!\n\nEm dois dias tomando ela eu já limpei coisas na minha casa e já to animada pra voltar a trabalhar e estudar 🥰&quot;}|||{&quot;category&quot;: &quot;Vômito&quot;, &quot;content&quot;: &quot;a lolly vomito começou a tomar bupropiona então esse post faz mais sentido doq qualquer coisa&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;Uma vez me passaram um remédio que ajudava nisso, mas zoava na ansiedade (a bupropiona)&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;enquanto tô fazendo as aulas atrasadas, tô vendo um vídeo de torcedores do vasco. depressão severíssima !!! \n\nhaja bupropiona, eu juro por deus&quot;}|||{&quot;category&quot;: &quot;Sonhos estranhos&quot;, &quot;content&quot;: &quot;Acordei dos sonhos mais insanos causados por 300mg de bupropiona.&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;Status da saúde mental: mandei msg ontem pra padaria perguntando qto tava a bupropiona e me irritei hj qdo vi q n tinham respondido... 🤪&quot;}|||{&quot;category&quot;: &quot;Perda de peso&quot;, &quot;content&quot;: &quot;recomendo vc comenta sobre com sua psiquiatra ou enfermeira pra elas te receitarem bupropiona.\neu to tomandk justamente por conta de cigarro e ta me ajudando horrores, de quebra a bupropiona tira fome tb e eh antidepressivo/ansiolitico&quot;}|||{&quot;category&quot;: &quot;Queda de cabelo&quot;, &quot;content&quot;: &quot;Bom ver que a Lorde saiu da Skin loira com dose excessiva de bupropiona e tá de novo com o cabelo da cor natural e a dose adequada do antidepressivo 😆&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;[2] queria bupropiona mas eh ansiogenico&quot;}|||{&quot;category&quot;: &quot;Alterações do sono&quot;, &quot;content&quot;: &quot;Mas, felizmente, não é tão ruim mais. Acho que bupropiona deve estar ajudando. Pelo amor, né, 300gr mais o venla tem que fazer algum efeito além de brincar com a minha libido.&quot;}|||{&quot;category&quot;: &quot;Álito&quot;, &quot;content&quot;: &quot;A bupropiona me transforma num pinscher: 50% ódio e 50% tremedeira&quot;}|||{&quot;category&quot;: &quot;Síndrome do intestino irritável&quot;, &quot;content&quot;: &quot;A jornada psiquiatrica continua, sempre continuará. Acrescentei uma dose de 5mg de memantina no meu protocolo (que é 300mg bupropiona pela manhã). Um dia a anedonia vai desaparecer. Eu acredito.&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Mais um dia desejando morte à bupropiona \nQue saudade da minha desvenla&quot;}|||{&quot;category&quot;: &quot;Reação adversa&quot;, &quot;content&quot;: &quot;aí entendi que era a bupropiona mesmo. como tomei uma dose alta passei muito mal, mas como não era liberação controlada, saiu rápido do meu sistema. suspendi e nunca mais tive. e essa é a história de como eu tive uma reação adversa que eu não consegui encontrar relatos iguais em lugar nenhum 😬&quot;}|||{&quot;category&quot;: &quot;Pain&quot;, &quot;content&quot;: &quot;uma noite chegaram com ele pra eu tomar. mandei pra dentro 300mg de bupropiona de liberação normal e senti tanta tanta tanta dor que eu URRAVA, só consegui dormir depois de 10mg de morfina e uma injeção de fenergan. no dia seguinte, acordei BOA como se NADA????&quot;}|||{&quot;category&quot;: &quot;Anorexia&quot;, &quot;content&quot;: &quot;nessas horas é muuuuito fácil romantizar remédio pra emagrecer. \nenquanto eu tava tomando bupropiona eu não tinha fome, tava magrinha. mas tava LELÉ DA CUCA. \ne aí??????????????&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;A do TDAH, com certeza. Eu já tomei bupropiona, que é inibidor de recaptação da dopamina e estava dormindo uma quantidade de horas dentro do normal. Mas minhas estereotipias e minha ansiedade pioraram e quando parei, voltei a dormir horrores. Parece que não tem jeito.&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Isso! meu exame tb indicou pré-diabetes. Perguntei pro meu  clínico quase chorando se eu teria que tomar remédio e ele \&quot;Não, diminua doce e massas e procure um nutricionista\&quot; e o psiquiatra sugeriu associar a bupropiona no meu tratamento para ansiedade, pois eu tava realmente comendo MUITO doce&quot;}|||{&quot;category&quot;: &quot;Reação adversa&quot;, &quot;content&quot;: &quot;Vitamina de leite de coco com mamão fodaose calorias isso e saudável então vou ignorar a densidade calórica \n\n(Tô tomando bupropiona e eu tinha tomado um pouco de leite c café e minha mãe disse q n pode porque faz revertério no estômago e pode prejudicar os efeitos então p limpar o estômago fiz isso&quot;}|||{&quot;category&quot;: &quot;Letargia&quot;, &quot;content&quot;: &quot;Tomar bupropiona é um constante esquecer de comer e a pressao cair nas piores horas 🫠&quot;}|||{&quot;category&quot;: &quot;Comportamento impulsivo&quot;, &quot;content&quot;: &quot;na época que saiu meu cérebro ainda não tinha sido realinhado pela bupropiona e fiquei 'ai nossa q bosta a mulher e um monstro ridiculo' e nunca vi, agora quero mto ver&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;old pode sim!!.. porém curiosamente eu não tomo pra tdah, tomo por causa da depressão junto com bupropiona p levantar da cama e conseguir fazer as coisas... apesar d ser autista e ter algumas coisa meio tdah das ideia ainda sim n é a msm coisa q Ter tdah&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;Eu tô reduzindo a bupropiona esse mês pq eu reclamei do suor excessivo com o meu psiquiatra e a gente pretende trocar de medicação na próxima consulta.\nE rapaz, eu tinha até esquecido como é não conseguir fazer nada direito.&quot;}|||{&quot;category&quot;: &quot;Zumbido&quot;, &quot;content&quot;: &quot;Um dos colaterais do bupropiona é ouvir zumbido às vezes. Mas é engraçado que nunca acontece quando tô fazendo algo concentrado, é quando eu paro e descanso apenas, e às vezes é só em um dos ouvidos.&quot;}|||{&quot;category&quot;: &quot;Disfunção erétil&quot;, &quot;content&quot;: &quot;Eu pedi pra experimentar a bupropiona exatamente por isso, e o que ela me deu foi disfunção erétil 😭&quot;}|||{&quot;category&quot;: &quot;Distúrbios gastrointestinais&quot;, &quot;content&quot;: &quot;a bupropiona assim\n\n(ela é um dos antidepressivos que não alteram a libido. sim, eles existem! peçam pro psiquiatra de vcs pra testar outro antidepressivo se vc está incomodade com os efeitos colaterais. existem dezenas de antidepressivos diferentes!)&quot;}|||{&quot;category&quot;: &quot;Hipertireoidismo&quot;, &quot;content&quot;: &quot;a bupropiona assim\n\n(ela é um dos antidepressivos que não alteram a libido. sim, eles existem! peçam pro psiquiatra de vcs pra testar outro antidepressivo se vc está incomodade com os efeitos colaterais. existem dezenas de antidepressivos diferentes!)&quot;}|||{&quot;category&quot;: &quot;Anedonia&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Alterações do sono&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Inibição social&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Tristeza&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Alterações de humor&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Perda de peso&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Constipação&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Anedonia&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Distúrbios gastrointestinais&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Síndrome do intestino irritável&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Estresse&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Comportamento compulsivo&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Alterações de temperamento&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Distúrbios respiratórios do sono&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Ataxia&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Ataque de pânico&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Desidratação&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Reações alérgicas&quot;, &quot;content&quot;: &quot;putz…. comigo sempre foi osso, mas associar com bupropiona ajudava (até demais). agora veio o lítio e rip 🪦&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;Quase troquei o baclofeno por bupropiona. Já passei a última noite em claro (insônia, e não farra), imagina se eu não tivesse me dado conta&quot;}|||{&quot;category&quot;: &quot;Perda de apetite&quot;, &quot;content&quot;: &quot;comecei a tomar bupropiona 2 semanas antes do Natal e o apetite da gata foi pra casa de carai. Tentando ficar menos deprimida mas A QUE CUSTO&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;emagreci 3kg e isso me deixou puta demais. é depressão, ansiedade ou bupropiona de liberação prolongada 300mg? foda&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;emagreci 3kg e isso me deixou puta demais. é depressão, ansiedade ou bupropiona de liberação prolongada 300mg? foda&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;Quase dobrei a dose de Bupropiona, a essas hora.\n\nEu ia virar a noite latindo no teto, e ficar sem vontade de fumar até o final da semana.&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;qualquer três dias sem meu amor bupropiona e eu me sinto assim&quot;}|||{&quot;category&quot;: &quot;Nausea&quot;, &quot;content&quot;: &quot;A bupropiona te esculhamba antes de te tratar amigos\nUma náusea e tontura do cão&quot;}|||{&quot;category&quot;: &quot;Tinnitus&quot;, &quot;content&quot;: &quot;A bupropiona te esculhamba antes de te tratar amigos\nUma náusea e tontura do cão&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;Bupropiona batendo já tem uma hora que tô acordada e QUERO LAVAR CABELO CACHEADO AGORA&quot;}|||{&quot;category&quot;: &quot;Thoughts of inadequacy&quot;, &quot;content&quot;: &quot;nao estou de tpm e aumentei a dose da bupropiona nao era pra eu estar querendo me jogar da janela&quot;}|||{&quot;category&quot;: &quot;Suicidal ideation&quot;, &quot;content&quot;: &quot;nao estou de tpm e aumentei a dose da bupropiona nao era pra eu estar querendo me jogar da janela&quot;}|||{&quot;category&quot;: &quot;Disfunção erétil&quot;, &quot;content&quot;: &quot;O antdepressivo Bupropiona, tá escrito que como vasodilatador e com efeitos secundários de uma \&quot;ereção prolongada\&quot; ou \&quot;maior perfomance sexual\&quot;, na própria bula.\n\nTinha que então vender com o slogan:\n\&quot;A vida é dura, mas seja mais duro que a vida!\&quot;&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;é, se tem coisa emocional n tem remedio no mundo q resolva\n\ntomo nortriptilina, bupropiona, divalproato, lurasidona, rivs e cabei de trocar a rita por aquela atomoxetina e eu to odiando mas perco a mao qdo tenho acesso a ritalina entao acho q por enquanto vai se isso&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;convence  que  tu  eh  depre  e  tem  muito  sono  que  eles  te  dão  bupropiona  que  depressão ,,  trás  insônia  i  inebe  apetite  por  ser  um  medicamento  que  tambem  trata  obesidade&quot;}|||{&quot;category&quot;: &quot;Perda de apetite&quot;, &quot;content&quot;: &quot;convence  que  tu  eh  depre  e  tem  muito  sono  que  eles  te  dão  bupropiona  que  depressão ,,  trás  insônia  i  inebe  apetite  por  ser  um  medicamento  que  tambem  trata  obesidade&quot;}|||{&quot;category&quot;: &quot;Hipertireoidismo&quot;, &quot;content&quot;: &quot;eu preciso lembrar de tomar minha bupropiona de manhã\nchega de noite, eu fico tilili da cabeça sem saber o motivo e aí eu lembro que é porque eu não tomei o remédio&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;Já tomei escitalopram e funcionou bem da 1a vez. Da outra vez não tava indo, aí mudei p desvenlafaxina, q nao foi tudo isso. E agora é um combo fluoxetina + bupropiona, ainda não tá como eu gostaria. Mas tá dando p levar. É um porre achar o w funciona&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Off um remédio que quase me matou foi o bupropiona puta medicamento ruim cheio de efeito colateral além de piorar meu quadro de ansiedade&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;Bupropiona no começo da um acelero! uma ansiedade do cacete! mas depois de humilhar ela me dá um up brabo&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Quase indo pra 3° cochileta russa do dia e tive um clique do pq tão lesada, sonolenta e com sensação de improdutiva: esqueci de tomar a dose de carisma diária, vulgo bupropiona. Medicada antes tarde do que nunca 🙃&quot;}|||{&quot;category&quot;: &quot;Olho de doida&quot;, &quot;content&quot;: &quot;notando que depois de a tomar o bupropiona to ficando com olho de doida nas fotos&quot;}|||{&quot;category&quot;: &quot;Convulsão&quot;, &quot;content&quot;: &quot;sou meio contra psicotropico no geral mas a bupropiona em especifico ate que faria sentido pra bulimia . se nao causasse CONVULSAO&quot;}|||{&quot;category&quot;: &quot;Tremor&quot;, &quot;content&quot;: &quot;alguém que toma bupropiona tbm fica com as mãos tremendo feito um pinscher raivoso? eu tomo há meses e isso não passa nunca&quot;}|||{&quot;category&quot;: &quot;Confusão&quot;, &quot;content&quot;: &quot;Meu escitalopram acabou no sábado. Eu achei que tinha guardado uma cartela e fiquei procurando. Segunda-feira eu fiquei pixuleca, meio tonta, e hoje estou me sentindo bem, muito bem, só com a bupropiona. E o sono e memória fraca não deram o ar da graça.&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Meu escitalopram acabou no sábado. Eu achei que tinha guardado uma cartela e fiquei procurando. Segunda-feira eu fiquei pixuleca, meio tonta, e hoje estou me sentindo bem, muito bem, só com a bupropiona. E o sono e memória fraca não deram o ar da graça.&quot;}|||{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;Então, aparentemente a bupropiona é usada pra emagrecer mesmo, o efeito de engorda que eu tive é raro 🤷🏻‍♀️&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;Quem toma remédio controlado pra transtorno mental realmente sente diferença entre genérico e marca? Eu nunca senti, mas tomando bupropiona agora eu senti diferença, pq tô com mais ansiedade tomando o genérico. \n\nEu n consigo acreditar nisso, pois sou mto defensora do genérico. 🫠&quot;}|||{&quot;category&quot;: &quot;Vômito&quot;, &quot;content&quot;: &quot;eu não aguento mais ânsia de vômito tomando Bupropiona\nDeus por que judia tanto dos depressivos?&quot;}|||{&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;E me fode ridiculamente. É estar em um ótimo momento, feliz e \&quot;estável\&quot; que algo aqui dentro se ativa e vem me desestabilizar tentando fazer eu me sentir não merecedora de tudo isso. Mas eu sei que eu sou. Nem que eu coma bupropiona e selegilina eu vou passar pelos tremores e tensão e vou ir trampar&quot;}|||{&quot;category&quot;: &quot;Tensão&quot;, &quot;content&quot;: &quot;E me fode ridiculamente. É estar em um ótimo momento, feliz e \&quot;estável\&quot; que algo aqui dentro se ativa e vem me desestabilizar tentando fazer eu me sentir não merecedora de tudo isso. Mas eu sei que eu sou. Nem que eu coma bupropiona e selegilina eu vou passar pelos tremores e tensão e vou ir trampar&quot;}|||{&quot;category&quot;: &quot;Apatia&quot;, &quot;content&quot;: &quot;Eu nunca contei a ninguém de como foi quando eu estava tratando com Bupropiona e parei de ter emoções.\nNunca falei de como sentir vontade de morrer era melhor do que não sentir nada.\nE nem disse que eu me transformei num robô vivendo no automático.&quot;}|||{&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;eu quase vomitei nas internas hoje tamanho enjoo, foi o dia todo 🤢 certeza deve ser a bupropiona que ódio&quot;}|||{&quot;category&quot;: &quot;Vômito&quot;, &quot;content&quot;: &quot;eu quase vomitei nas internas hoje tamanho enjoo, foi o dia todo 🤢 certeza deve ser a bupropiona que ódio&quot;}|||{&quot;category&quot;: &quot;Ideias de suicídio&quot;, &quot;content&quot;: &quot;a medica falando q a bupropiona me faria emagrecer aí eu falei q tinha ideacao suicida e ela disse q era contraindicado nesse sentido mas q \&quot;nao dava p resolver tudo\&quot;.. pensando nisso&quot;}|||{&quot;category&quot;: &quot;Comportamento compulsivo&quot;, &quot;content&quot;: &quot;esses mesmos que me deram peso vei n sei oq acontece o risperidona o psiquiatra disse que já veio gente com relato de ter saído leite dos peitos ????¿ mexe muito com os hormônios, finalmente ele me deu bupropiona q controla vícios e compulsão alimentar mas só senti dps de 3 meses&quot;}|||{&quot;category&quot;: &quot;Esquecimento&quot;, &quot;content&quot;: &quot;Pior que eu tomo bupropiona pra ansiedade e me ajuda bastante! \nAjuda também com tdah\n\nÚnico efeito colateral é não ter memória de curto prazo kkkkk daí tudo que eu tenho que anotar eu tenho que anotar imediatamente senão eu esqueço&quot;}|||{&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;já tomei bupropiona e as pessoas começaram a me falar pra consultar com neuro por causa da tremedeira&quot;}|||{&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;Eu não consigo parar pq a tremedeira do lítio e da bupropiona vai nas alturas, parece que estou misturando um milk-shake&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;DEU GENTE O MEU NAMORADO COMPROU A BUSPIRONA E A VAKINHA JÁ DA PRA BUPROPIONA MUITO OBRIGADA GENTE 🥺😭🥲🥹🥺🩷🩷🎀🎉&quot;}|||{&quot;category&quot;: &quot;Depression&quot;, &quot;content&quot;: &quot;DEU GENTE O MEU NAMORADO COMPROU A BUSPIRONA E A VAKINHA JÁ DA PRA BUPROPIONA MUITO OBRIGADA GENTE 🥺😭🥲🥹🥺🩷🩷🎀🎉&quot;}|||{&quot;category&quot;: &quot;Headache&quot;, &quot;content&quot;: &quot;Parei de tomar bupropiona, tava me dando muita dor de cabeça mesmo depois do tempo que já deveria ter parado os efeitos colaterais, mas minha prima me deu um comprimido de venvance ontem e hoje me sinto outra pessoa&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;2° dia tomando fluoxetina e bupropiona: não dormi direito noite passada, tava com sono e mesmo assim não desligava, e acordei bem mais cedo do que o planejado. Então tô com dor de cabeça&quot;}|||{&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;2° dia tomando fluoxetina e bupropiona: não dormi direito noite passada, tava com sono e mesmo assim não desligava, e acordei bem mais cedo do que o planejado. Então tô com dor de cabeça&quot;}|||{&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;começou a tremedeira na mão pq coca cola (cafeina) + bupropiona 🫨&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;dawg whats got my panties such in a knot\n\nokay mayhaps it's the fact que eu esqueci de tomar bupropiona a tipo 3 dias but why r the withdrawal symptoms almsot the exact same of the side effects i had when i started taking it \n\n\&quot;ai bupropiona nao da abstinência\&quot; minha rola enorme&quot;}|||{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;passei 2 semanas sem bupropiona e engordei 4kg, sem condições. esse negócio de compulsão é terrível.&quot;}|||{&quot;category&quot;: &quot;Constipação&quot;, &quot;content&quot;: &quot;Desde que passei a tomar bupropiona meu cu só faz cagar em suas diferentes texturas&quot;}|||{&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;inclusive, posso te fazer uma pergunta já que vc toma o bupropiona tb? vc teve dores de cabeça/no corpo quando começou ele? pra mim tá foda&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;Tá difícil e olha que eu tomo bupropiona pra depressão (um remédio que passam pra ajudar a parar de fumar). Imagina se não tomasse&quot;}|||{&quot;category&quot;: &quot;Anorexia&quot;, &quot;content&quot;: &quot;pra mim isso não aconteceu nao. bupropiona é mais facil de dar anorexia&quot;}|||{&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Apatia&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Arritmia&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Reações alérgicas&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Alucinação&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Síndrome serotoninérgica&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Comprometimento cognitivo&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Fratura&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Irritação&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Tristeza&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Fraqueza&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Aumento do apetite&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Inquietação&quot;, &quot;content&quot;: &quot;o ta