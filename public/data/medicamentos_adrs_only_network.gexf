      <node id="Tremores" label="Tremores">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="35" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;He can come pry my Citalopram from my depressed/raging/shaking/brain shocked hands. 😡&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;i have twitches, clenching and limb movements non stop, but back when i was on escitalopram they defo got worse!!\n\nagain i have always have em so i cant really tell if thats related or just a coincidence but yeah&quot;}, {&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Acho que o único que não causa tremedeira em mim é a fluvoxamina. Eu tomei citalopram por um tempo e tremia muito, e o remédio parou de funcionar, diga ai&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;tomei paroxetina mas tá doido deu tremelique, insônia, enjoo e piriri, tomo mais não rs&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;eu to tomando Paxil(Paroxetina) e Seroquel (Quetiapina), vei meu corpo todo treme, parece que eu to doente, quais vc toma?&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Paroxetina me fazendo sentir como se tivesse Parkinson&quot;}, {&quot;category&quot;: &quot;Venvanse&quot;, &quot;content&quot;: &quot;suando em bicas e tremendo mais que vara verde\n\num oferecimento: adaptação venvanse + sertralina&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;suando em bicas e tremendo mais que vara verde\n\num oferecimento: adaptação venvanse + sertralina&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;A bupropiona me transforma num pinscher: 50% ódio e 50% tremedeira&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;alguém que toma bupropiona tbm fica com as mãos tremendo feito um pinscher raivoso? eu tomo há meses e isso não passa nunca&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;já tomei bupropiona e as pessoas começaram a me falar pra consultar com neuro por causa da tremedeira&quot;}, {&quot;category&quot;: &quot;Lítio&quot;, &quot;content&quot;: &quot;Eu não consigo parar pq a tremedeira do lítio e da bupropiona vai nas alturas, parece que estou misturando um milk-shake&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;Eu não consigo parar pq a tremedeira do lítio e da bupropiona vai nas alturas, parece que estou misturando um milk-shake&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;começou a tremedeira na mão pq coca cola (cafeina) + bupropiona 🫨&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;parei de tomar mirtazapina pq tava comendo demais e agora to com tremedeira e depressao&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Tomei desvenlafaxina e minha pernas começaram a tremer\n\nDevo me preocupar?&quot;}, {&quot;category&quot;: &quot;Carbonato&quot;, &quot;content&quot;: &quot;para dormir uso o Rivotril, mas tem dias que mesmo assim não durmo\n\na tremedeira eu tinha tomando carbolitio/desvenlafaxina&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;para dormir uso o Rivotril, mas tem dias que mesmo assim não durmo\n\na tremedeira eu tinha tomando carbolitio/desvenlafaxina&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;segundo dia sem desvenlafaxina e uma tremedeira incontrolável já me acometeu&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;tô tentando ao máximo fingir que não tô tendo uma crise, mas minhas mãos não mentem........... desvenlafaxina já me deixa normalmente tremendo, qd tô mal, piora&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;como eu ODEIO desvenlafaxina eu tomei ontem antes d dormir consegui dormir 3hrs só e to tremendo igual cachorro ate agora vsf&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;eu tomando desvenlafaxina\n\nqueria: disposição\ntenho: tremedeira dps de fzr exercício/esforço físico&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Meu olho tremendo e meus 100mg de desvenlafaxina concordam com tudo nesse fio…&quot;}, {&quot;category&quot;: &quot;Duloxetina&quot;, &quot;content&quot;: &quot;Llevo desde la semana pasada con espasmos, temblores, ronquera, me siento inquieta… Pensaba que me habría resfriado porque soy bastante propensa, pero de pronto he caído en que me subieron la dosis de la duloxetina esta semana 🙃\n\nDe verdad, qué harta estoy de los efectos secundarios de la medicación&quot;}, {&quot;category&quot;: &quot;Duloxetina&quot;, &quot;content&quot;: &quot;O duloxetina tá me deixando assim\nHoje na feira eu não conseguia segurar nada sem tremer, tava torcendo pra ninguém perceber&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;porra essa venlafaxina ta me dando MUITA tremedeira e uma dor no peito&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;última semana, acabei de tomar meu venlafaxina, acordei com um quase torcicolo, meus olhos tremem sempre e eu amo muito ainda em 2024 \n\nbingo&quot;}, {&quot;category&quot;: &quot;Fluoxetina&quot;, &quot;content&quot;: &quot;sim, eu tomo fluoxetina e amitriptilina, me dá tanto tremor que não consigo ter firmeza mas mãos KKKKKKKK&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;sim, eu tomo fluoxetina e amitriptilina, me dá tanto tremor que não consigo ter firmeza mas mãos KKKKKKKK&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;review do amitriptilina 10mg to agora só com um pouco de tremedeira por dentro sabe parece q ta vibrando meu corpo to me sentindo aquele tweet do felipe neto Eu to me tremendo. a resposta Entao tira o vibrador da bunda&quot;}, {&quot;category&quot;: &quot;Clomipramina&quot;, &quot;content&quot;: &quot;chorando de frustração pq quero fazer uma coisa fofa mas minha mão fica tremendo por causa da clomipramina e aí tudo que eu desenho fica uma BOSTA&quot;}, {&quot;category&quot;: &quot;Clomipramina&quot;, &quot;content&quot;: &quot;eu tomo ele de manhã e tomo clomipramina a noite. eu tive alguns efeitos chatos com tremor de mão e vista embaçada, mas foi só no primeiro mês e depois foi bem de boa. só que eu não sou um bom exemplo porque eu já me dei de cara com o remédio rs&quot;}, {&quot;category&quot;: &quot;Metilfenidato&quot;, &quot;content&quot;: &quot;galera acho que misturar energético, metilfenidato e nicotina começou a dar ruim, to tremendo \n\n(sim, eu sei que dá ruim e eu vou morrer. é o objetivo. o post é irônico. obg.)&quot;}, {&quot;category&quot;: &quot;Metilfenidato&quot;, &quot;content&quot;: &quot;lembrete: NUNCA tomar café quando eu for tomar metilfenidato, to tremendo aqui\nporra, o café demorou muito tempo pra funcionar, tomei meu remedio dps do almoço E AGR O CAFÉ FEZ EFEITO... PQP&quot;}, {&quot;category&quot;: &quot;Metilfenidato&quot;, &quot;content&quot;: &quot;Por supuesto que no aprendo y me tomé el metilfenidato con café y ahora ando todo tembloroso&quot;}]" />
          <attvalue for="3" value="16" />
          <attvalue for="4" value="15" />
          <attvalue for="5" value="4.275987 1.714206" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
      <node id="Desregulação emocional" label="Desregulação emocional">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="12" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;citalopram is a fucking ROLLERCOASTER&quot;}, {&quot;category&quot;: &quot;*   Estado confusional (Estado confusional)\n    *   Agitação (Agitação)\n    *   Labilidade emocional (Labilidade emocional)\n    *   Desregulação emocional (Desregulação emocional)\n    *   Estado confusional (Estado confusional)Citalopram&quot;, &quot;content&quot;: &quot;I met Martin from Homes Under The Hammer at a work event. He was very drunk and I was on my first week of Citalopram and all over the place. He didn’t like being called Dion Dublin for lols&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;dr asked me to taper off of Escitalopram (general anxiety disorder meds) &amp; so my focus/emotions are all over the place\n&amp; I get irritated more easily 🥰\nso of course WiFi decided to be wonky today\nat least Fri/Mon are off&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Wellbutrin has kinda just made me feel a tad off. I much prefer it to escitalopram which caused me to have a multi-day mental breakdown.&quot;}, {&quot;category&quot;: &quot;cope&quot;, &quot;content&quot;: &quot;Eu fiz tratamento com ela durante anos, na época me ajudou muito, mas os efeitos colaterais são péssimos mesmo, agora eu troquei pelo paroxetina&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Muitas crises identitárias após trocar o sertralina pelo paroxetina..... Sinto Q estou enganado meus mutuals\n\nMe sinto uma farsa 😭😭😭😭😭😭&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;acho que ficar 4 dias sem bupropiona afrouxou uns parafuso que já não são muito preso mesmo, ainda esse calor e a iminência dos 40, vibes muito sinistras hoje&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Pior que quando eu parei de tomar eu me senti ótimo relativamente rápido pq era a desvenlafaxina que estava me fazendo surtar&quot;}, {&quot;category&quot;: &quot;Fluoxetina&quot;, &quot;content&quot;: &quot;Tenho saudades de quando tomei fluoxetina pela primeira vez\nEu tomava e o negócio batia daqui uns 30 minutos, ou eu ficava tão ansioso que queria me m4t4r ou eu ficava tranquilo\nQuando tomo duloxetina não sinto nada\nA longo prazo ele diminuiu um pouco, mas a custo da minha sanidade&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;tô fazendo o desmame da venlafaxina e meu deus, que doideira SENTIR SENTIMENTOS\n\nsemana passada eu até CHOREI&quot;}, {&quot;category&quot;: &quot;Nortriptilina&quot;, &quot;content&quot;: &quot;E daí é isso, crise de choro hoje, por qual motivo não sei, mas com o desbalanço emocional grátis causado por nortriptilina+ clorpromazina pq é isso q a neurologista escolheu pra usar pra eu sair desse estado porém essa combi tá estranho na minha mente&quot;}, {&quot;category&quot;: &quot;Clorpromazina&quot;, &quot;content&quot;: &quot;E daí é isso, crise de choro hoje, por qual motivo não sei, mas com o desbalanço emocional grátis causado por nortriptilina+ clorpromazina pq é isso q a neurologista escolheu pra usar pra eu sair desse estado porém essa combi tá estranho na minha mente&quot;}]" />
          <attvalue for="3" value="11" />
          <attvalue for="4" value="3" />
          <attvalue for="5" value="1.840291 -0.465520" />
          <attvalue for="6" value="#E9573F" />
