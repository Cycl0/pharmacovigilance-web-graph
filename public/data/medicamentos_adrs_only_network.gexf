          <attvalue for="0" value="medication" />
          <attvalue for="1" value="20" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Meu caso é ansiedade, n depresso, mas eu fui da fluoxetina p duloxetina pro que to agora que é fluvoxamina. A fluoxetina so demoliu minha libido e me intensificava dores musculares, a duloxetina nao dava dores mas ainda matava minha libido e nao resolvia taaaanto a ansiedade.\n\nFluvoxamina perfeita.&quot;}|||{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;Antidepressivos: De acordo com um estudo da Universidade de Harvard, os antidepressivos que mais podem causar aumento de peso são o escitalopram, a paroxetina e a duloxetina. Os antidepressivos tricíclicos e tetracíclicos também podem causar ganho de peso.&quot;}|||{&quot;category&quot;: &quot;Arritmia&quot;, &quot;content&quot;: &quot;La paroxetina, che ricordi\nPoi la duloxetina e infine la venlafaxina a cui sono tanto affezionato ma che mi ha rovinato il muscolo cardiaco\n\nPosso solo mandarti un grosso in bocca al lupo&quot;}|||{&quot;category&quot;: &quot;Disforia&quot;, &quot;content&quot;: &quot;Si el fármaco pertenece a la familia de los IRSN como la venlafaxina, desvenlafaxina o la duloxetina es bastante normal que produzcan disforia si se interrumpe de golpe, aunque sean dos días. Los ISRS como la fluoxetina o el escitalopram toleran mucho mejor los despistes.&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Llevo desde la semana pasada con espasmos, temblores, ronquera, me siento inquieta… Pensaba que me habría resfriado porque soy bastante propensa, pero de pronto he caído en que me subieron la dosis de la duloxetina esta semana 🙃\n\nDe verdad, qué harta estoy de los efectos secundarios de la medicación&quot;}|||{&quot;category&quot;: &quot;Alterações do sono&quot;, &quot;content&quot;: &quot;tomei cabergolina pq a duloxetina tava aumentando minha prolactina aí agora tô com fôlego curto kkkkk tomara q eu morra&quot;}|||{&quot;category&quot;: &quot;Diarreia&quot;, &quot;content&quot;: &quot;Não sei o que é pior. O nariz entupido da risperidona ou o estômago embrulhado da duloxetina…&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Eu tô chutando que a duloxetina é a culpada\nOu eu estou inflamado junto com abstinencia da duloxetina&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Pidele al doctor q te de duloxetina, dile q los dolores no se acaban. Se supone q el mix de duloxetina y pregabalina es super, además la duloxetina te sube el ánimo pero no sabes cuanto! Es terrible bkn (estoy con duloxetina y gabapentina q es parecida a la pregabalina).&quot;}|||{&quot;category&quot;: &quot;Aumento do apetite&quot;, &quot;content&quot;: &quot;Esse remédio mexe com seu corpo inteiro pqp, é o remédio mais louco que eu experimentei\nEu já sentia isso com o venlafaxina também, mas tô sentindo mais com o duloxetina\nE me dá uma fome desgraçada&quot;}|||{&quot;category&quot;: &quot;Anedonia&quot;, &quot;content&quot;: &quot;Issoo, vdd, e justamente a duloxetina tinha interação com o Venvanse e pontecializava seus efeitos, ai ficava igual ao Willy Wonka, full pistola crazy e do nada a branca de neve, era um carrossel, fora que dava compulsão sexual kkk pqp, ai o escitalopram caiu como uma luva, me sinto um robô, amei kk&quot;}|||{&quot;category&quot;: &quot;Disfunção sexual&quot;, &quot;content&quot;: &quot;Issoo, vdd, e justamente a duloxetina tinha interação com o Venvanse e pontecializava seus efeitos, ai ficava igual ao Willy Wonka, full pistola crazy e do nada a branca de neve, era um carrossel, fora que dava compulsão sexual kkk pqp, ai o escitalopram caiu como uma luva, me sinto um robô, amei kk&quot;}|||{&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;tô com umas tonturas e enjôo bem iguais ao que sentia no desmame da duloxetina, mas tô tomando certinho??? será que tô doente meu deus&quot;}|||{&quot;category&quot;: &quot;Vômito&quot;, &quot;content&quot;: &quot;tô com umas tonturas e enjôo bem iguais ao que sentia no desmame da duloxetina, mas tô tomando certinho??? será que tô doente meu deus&quot;}|||{&quot;category&quot;: &quot;Síndrome serotoninérgica&quot;, &quot;content&quot;: &quot;Duloxetina parece que faz minha garganta fechar&quot;}|||{&quot;category&quot;: &quot;Soninho&quot;, &quot;content&quot;: &quot;O escitalopram e a duloxetina fazendo exatamente isso na minha cabecinha!\n\n\&quot;Quer morrer, amor? Que pena que você tá com tanto soninho......hmmmmm vamo dar uma deitadinha? Isso....que gostoso 😋\&quot;&quot;}|||{&quot;category&quot;: &quot;Pensamentos destrutivos&quot;, &quot;content&quot;: &quot;será que dia a duloxetina vai tentar parar de me matar e vai resolver minhas dores&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;3 dias sem a duloxetina e tô a ponto de matar alguém&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Ou tomo duloxetina e vivo com sono ou eu paro e fico com dor na cervical e ansiosa. Tá difícil...&quot;}|||{&quot;category&quot;: &quot;Pesadelos&quot;, &quot;content&quot;: &quot;Ou tomo duloxetina e vivo com sono ou eu paro e fico com dor na cervical e ansiosa. Tá difícil...&quot;}" />
