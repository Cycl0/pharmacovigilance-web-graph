      <node id="Desvenlafaxina" label="Desvenlafaxina">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="229" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Embotamento afetivo&quot;, &quot;content&quot;: &quot;No geral todos os antidepressivos deixam a gente lesa. Tomei a venla a desvenla, lítio, sertralina, fluoxetina, nortriptilina , Amitriptilina. A risperidona comecei estes dias e faço combo com mais dois dos citados. O nosso cérebro parece derreter. ( São 22 anos com remédios, ainda não acertam)&quot;}, {&quot;category&quot;: &quot;Fadiga&quot;, &quot;content&quot;: &quot;qnd parei a bupropiona fiquei 2 semanas felicidade eterna ai agr parei a desvenlafaxina e nunca estive tao bem e nem parece efeito de remedio simplesmente nao sabia q eu tava perdendo TANTA energia&quot;}, {&quot;category&quot;: &quot;Apatia&quot;, &quot;content&quot;: &quot;qnd parei a bupropiona fiquei 2 semanas felicidade eterna ai agr parei a desvenlafaxina e nunca estive tao bem e nem parece efeito de remedio simplesmente nao sabia q eu tava perdendo TANTA energia&quot;}, {&quot;category&quot;: &quot;Desregulação emocional&quot;, &quot;content&quot;: &quot;Pior que quando eu parei de tomar eu me senti ótimo relativamente rápido pq era a desvenlafaxina que estava me fazendo surtar&quot;}, {&quot;category&quot;: &quot;Mal-estar&quot;, &quot;content&quot;: &quot;Alguém aqui já parou de tomar desvenlafaxina? Por quantos dias você se sente um LIXO?&quot;}, {&quot;category&quot;: &quot;Alteração do apetite&quot;, &quot;content&quot;: &quot;O tanto que desvenlafaxina tá me tirando a fome não é brincadeira&quot;}, {&quot;category&quot;: &quot;Pesadelos&quot;, &quot;content&quot;: &quot;A desvenlafaxina me faz ter muito pesadelo, tanto que eu já consigo me acordar dentro do sonho xingando \&quot;caraio tanta coisa pra sonhar e eu sonhando com essa bosta\&quot;&quot;}, {&quot;category&quot;: &quot;Acne&quot;, &quot;content&quot;: &quot;as vezes o celular coloca foto minha da época que eu tomava desvenlafaxina e eu fico muito aterrorizada do quanto isso me dava acne, eu não me reconhecia no espelho&quot;}, {&quot;category&quot;: &quot;Choque cerebral&quot;, &quot;content&quot;: &quot;dois dias sem tomar desvenlafaxina e a sensação é de que meu cerebro ta solto na cabeça&quot;}, {&quot;category&quot;: &quot;Disfunção sexual&quot;, &quot;content&quot;: &quot;Rapaz... Lembro de quando estava usando desvenlafaxina... Eu sentia que havia morrido da cintura para baixo.&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;abstinência de desvenlafaxina é pior que chute no saco&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;acho que só tomei calmante uma vez quando fiquei em abstinência de desvenlafaxina e chorava o tempo todo? nem sei como deve ser num dia \&quot;normal\&quot;&quot;}, {&quot;category&quot;: &quot;Labilidade emocional&quot;, &quot;content&quot;: &quot;acho que só tomei calmante uma vez quando fiquei em abstinência de desvenlafaxina e chorava o tempo todo? nem sei como deve ser num dia \&quot;normal\&quot;&quot;}, {&quot;category&quot;: &quot;Irritação&quot;, &quot;content&quot;: &quot;to literalmente uma combinação de pinscher com pitbull esses dias resultado do desmame da desvenlafaxina + tpm + ódio de classe&quot;}, {&quot;category&quot;: &quot;Agitação&quot;, &quot;content&quot;: &quot;to literalmente uma combinação de pinscher com pitbull esses dias resultado do desmame da desvenlafaxina + tpm + ódio de classe&quot;}, {&quot;category&quot;: &quot;Boca seca&quot;, &quot;content&quot;: &quot;Comecei a ter o efeito colateral de boca seca da desvenlafaxina. Não tem água que eu beba que consiga manter meus lábios hidratados, que infernooooo.&quot;}, {&quot;category&quot;: &quot;Sensação de calor&quot;, &quot;content&quot;: &quot;15 graus e eu com calor, obrigada desvenlafaxina&quot;}, {&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;meu deus acho que a desvenlafaxina ta me deixando enjoada, juro que to com uma sensação de nausea horrível 😭&quot;}, {&quot;category&quot;: &quot;Fadiga&quot;, &quot;content&quot;: &quot;nossa 2 semanas!! que ótimo!! eu tenho justamente esse problema de me sentir cansada e desanimada todo dia o dia todo rs a desvenlafaxina segura o sofrimento (quase n choro, n tenho ideação etc) mas tb n tenho energiaaa&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Nossa desmame da desvenlafaxina sempre me derrub\nUltima vez tive que voltar&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;Amigos q tomam desvenlafaxina, ela dá tontura?&quot;}, {&quot;category&quot;: &quot;Aumento do apetite&quot;, &quot;content&quot;: &quot;nossa eu sinto que a desvenlafaxina resolveu arrombar as portas do meu cerebro e botar ordem pq DO NADA eu só consegui me reestabelecer e ai me deu uma fome absurda de hamburguer com batata e refri!!!!!!!&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;minha depressão/ansiedade tá no talo hoje, quem diria que ficar 3 dias sem a desvenlafaxina me daria vontade de dormir por uma semana seguida&quot;}, {&quot;category&quot;: &quot;Sensações estranhas&quot;, &quot;content&quot;: &quot;Ontem esqueci de tomar a desvenlafaxina e hj estou em uma constante brisa de loló&quot;}, {&quot;category&quot;: &quot;Confusão&quot;, &quot;content&quot;: &quot;Ontem esqueci de tomar a desvenlafaxina e hj estou em uma constante brisa de loló&quot;}, {&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;Tomei desvenlafaxina e minha pernas começaram a tremer\n\nDevo me preocupar?&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;minha psiquiatra falando que o desmame da desvenlafaxina é mais dificil do que o normal e mandando eu fazer o desmame certo&quot;}, {&quot;category&quot;: &quot;Vômito&quot;, &quot;content&quot;: &quot;Me olvidé de tomar la desvenlafaxina porque día de locos y terminé vomitando antes de cenar. No tomen ese antidepresivo, es una trampa.&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Pois é, no meu caso é a desvenlafaxina e a abstinência dela é brutal, eu fico biruta&quot;}, {&quot;category&quot;: &quot;Estado confusional&quot;, &quot;content&quot;: &quot;Pois é, no meu caso é a desvenlafaxina e a abstinência dela é brutal, eu fico biruta&quot;}, {&quot;category&quot;: &quot;Pesadelos&quot;, &quot;content&quot;: &quot;o lado bom do desvenlafaxina é q ele te dá uns sonhos estranhos e aleatórios, seria mt divertido se fosse possível gravar oq a gente sonha. Dá umas histórias interessantes por incrível q pareça kk&quot;}, {&quot;category&quot;: &quot;Visão dupla&quot;, &quot;content&quot;: &quot;manas realmente n da pra ficar um dia sequer sem a porra da desvenlafaxina jesus to vendo tudo dobrado&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;Desvenlafaxina remedio nojento escroto odeio tomar essa merda preciso desmamar e simplesmente não consigo passar mais de 24h sem tomar q dá tontura e náusea e vontade d eme jogar da janela \nIncrivel&quot;}, {&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;Desvenlafaxina remedio nojento escroto odeio tomar essa merda preciso desmamar e simplesmente não consigo passar mais de 24h sem tomar q dá tontura e náusea e vontade d eme jogar da janela \nIncrivel&quot;}, {&quot;category&quot;: &quot;Pensamentos destrutivos&quot;, &quot;content&quot;: &quot;Desvenlafaxina remedio nojento escroto odeio tomar essa merda preciso desmamar e simplesmente não consigo passar mais de 24h sem tomar q dá tontura e náusea e vontade d eme jogar da janela \nIncrivel&quot;}, {&quot;category&quot;: &quot;Zumbido&quot;, &quot;content&quot;: &quot;Meio que eu vou ter que aceitar conviver com zumbido no ouvido. Desvenlafaxina inaugurou um lado e os eventos de rock vieram pra fechar o outro (isso eu usando protetores)&quot;}, {&quot;category&quot;: &quot;Alterações de humor&quot;, &quot;content&quot;: &quot;por aqui eu só deixo a coisa rolar e não paro a medicação. se tiver que ficar na merda, fico, mas aviso ao meu namorado e acabo me apoiando mto nele pra lembrar que ainda sou amada e que é só minha cabeça confundindo as coisas. tive uns momentos pesados com a desvenlafaxina no final do ano passado/+&quot;}, {&quot;category&quot;: &quot;Embotamento emocional&quot;, &quot;content&quot;: &quot;aumentar a dose da desvenlafaxina realmente funcionou. funcionou pra virar um robô que nada sente incapaz de chorar e por consequência paro de sofrer por aquilo que está fora do meu controle. obrigado indústria farmacêutica&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Caralho eu esqueci de tomar meus remédios ent mto provavelmente vou passar mal sem a desvenlafaxina😭😭 ABSTINENCIA VC ME PAGA!!&quot;}, {&quot;category&quot;: &quot;Mania&quot;, &quot;content&quot;: &quot;Nunca tomei quetiapina. Acreditam que seja TAB II por causa da depressão. Fiquei muito maluca tomando só desvenlafaxina (não me adaptei ao lítio, então larguei por conta própria 🫣), agora parece que vai dar certo com o depakene de 500mg a cada 12h. Espero que descubram o que acontece nessa cabecinha&quot;}, {&quot;category&quot;: &quot;Agitação&quot;, &quot;content&quot;: &quot;fiquei sem desvenlafaxina uns dias pq fiquei com preguiça de comprar e quando fui na farmácia quase sai no braço com o farmaceutico de tanto que eu tava coringando&quot;}, {&quot;category&quot;: &quot;Irritabilidade&quot;, &quot;content&quot;: &quot;fiquei sem desvenlafaxina uns dias pq fiquei com preguiça de comprar e quando fui na farmácia quase sai no braço com o farmaceutico de tanto que eu tava coringando&quot;}, {&quot;category&quot;: &quot;Fadiga&quot;, &quot;content&quot;: &quot;desvenlafaxina: fadiga excitada, letargia, vontade de morrer mas sem energia suficiente.&quot;}, {&quot;category&quot;: &quot;Agitação&quot;, &quot;content&quot;: &quot;desvenlafaxina: fadiga excitada, letargia, vontade de morrer mas sem energia suficiente.&quot;}, {&quot;category&quot;: &quot;Letargia&quot;, &quot;content&quot;: &quot;desvenlafaxina: fadiga excitada, letargia, vontade de morrer mas sem energia suficiente.&quot;}, {&quot;category&quot;: &quot;Pensamentos destrutivos&quot;, &quot;content&quot;: &quot;desvenlafaxina: fadiga excitada, letargia, vontade de morrer mas sem energia suficiente.&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;meritíssimo o meu cliente estava em desmame de desvenlafaxina&quot;}, {&quot;category&quot;: &quot;Letargia&quot;, &quot;content&quot;: &quot;tinha esquecido que além da enxaqueca a desvenlafaxina te dá uma leseira absurda quando você não toma ela no horário. agora tô aqui lutando pra realizar 1 unidade de sinapse atendendo&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Uma vez confundi os remédios e fiquei 2 dias sem tomar a desvenlafaxina. Achei q ia morrer&quot;}, {&quot;category&quot;: &quot;Alterações do sono&quot;, &quot;content&quot;: &quot;fiquei assim qndo tomava desvenlafaxina, cada sonho um roteiro de cinema e lembrava td&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;É minha cachorra kkkkkk faz amizade com todo mundo, a miss simpatia \n\nE siiiiim, eu não tava com grana pra ir no psiquiatra, e ele me vendeu o remédio. Abstinência de desvenlafaxina é brutal e eu não tô podendo&quot;}, {&quot;category&quot;: &quot;Pensamentos destrutivos&quot;, &quot;content&quot;: &quot;Autodeclarados suicidas após 150mg de desvenlafaxina e saturação de lítio no sangue&quot;}, {&quot;category&quot;: &quot;Apatia&quot;, &quot;content&quot;: &quot;ai amg pior que os remedios acabam msm com a gnt. quando eu tomava desvenlafaxina eu ficava bem meh + sem libido total,,,&quot;}, {&quot;category&quot;: &quot;Perda da libido&quot;, &quot;content&quot;: &quot;ai amg pior que os remedios acabam msm com a gnt. quando eu tomava desvenlafaxina eu ficava bem meh + sem libido total,,,&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;passou o efeito inicial do desmame da desvenlafaxina ou eu realmente tô felizinha hoje????&quot;}, {&quot;category&quot;: &quot;Disforia&quot;, &quot;content&quot;: &quot;Si el fármaco pertenece a la familia de los IRSN como la venlafaxina, desvenlafaxina o la duloxetina es bastante normal que produzcan disforia si se interrumpe de golpe, aunque sean dos días. Los ISRS como la fluoxetina o el escitalopram toleran mucho mejor los despistes.&quot;}, {&quot;category&quot;: &quot;Sensação de calor&quot;, &quot;content&quot;: &quot;É calor ou é a desvenlafaxina?&quot;}, {&quot;category&quot;: &quot;Abstinência&quot;, &quot;content&quot;: &quot;Vou morrer de abstinência de desvenlafaxina jesus amado&quot;}, {&quot;category&quot;: &quot;Sonhos proféticos&quot;, &quot;content&quot;: &quot;depois que parei de tomar desvenlafaxina nunca mais tive sonhos proféticos&quot;}, {&quot;category&quot;: &quot;Sensação de calor&quot;, &quot;content&quot;: &quot;Mana, nem eu! Pensei até que tava na perimenopausa, mas a gineco descartou por conta do calor constante, não em ondas. \n\nDaí tava no tiktok e um psiquiatra falou de quem toma venlafaxina e desvenlafaxina sofrendo no calor por conta do estímulo de noradrenalina&quot;}, {&quot;category&quot;: &quot;Sensação de calor&quot;, &quot;content&quot;: &quot;Nao aguento mais passar mal de calor, são tempos difíceis para as patricinhas*\n\n*neurodivergentes com sensibilidade ao calor que tomam desvenlafaxina e por tanto já sentem mais calor naturalmente&quot;}, {&quot;category&quot;: &quot;Mal-estar&quot;, &quot;content&quot;: &quot;Nao aguento mais passar mal de calor, são tempos difíceis para as patricinhas*\n\n*neurodivergentes com sensibilidade ao calor que tomam desvenlafaxina e por tanto já sentem mais calor naturalmente&quot;}, {&quot;category&quot;: &quot;Labilidade emocional&quot;, &quot;content&quot;: &quot;não tenho fotos do onsen em si porque não podia entrar com celular obviamente então me contento vendo essas da página do hotel.. 2 dias sem a desvenlafaxina e eu to chorando só de olhar fotos que nao fui nem eu que tirei&quot;}, {&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;eu tomo desvenlafaxina vai fazer uns 5 anos, foi o que deu uma segurada durante a pandemia, junto com a terapia\n\n&lt;&lt;&lt;PORÉM&gt;&gt;&gt;\n\ncacete, esquecer desse remédio de manhã, na hora do almoço eu já tô dando pinote de enxaqueca + tontura e enjoo\n\no remédio bom pra quem esquece, cê aprende a tomar na marra&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;eu tomo desvenlafaxina vai fazer uns 5 anos, foi o que deu uma segurada durante a pandemia, junto com a terapia\n\n&lt;&lt;&lt;PORÉM&gt;&gt;&gt;\n\ncacete, esquecer desse remédio de manhã, na hora do almoço eu já tô dando pinote de enxaqueca + tontura e enjoo\n\no remédio bom pra quem esquece, cê aprende a tomar na marra&quot;}, {&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;eu tomo desvenlafaxina vai fazer uns 5 anos, foi o que deu uma segurada durante a pandemia, junto com a terapia\n\n&lt;&lt;&lt;PORÉM&gt;&gt;&gt;\n\ncacete, esquecer desse remédio de manhã, na hora do almoço eu já tô dando pinote de enxaqueca + tontura e enjoo\n\no remédio bom pra quem esquece, cê aprende a tomar na marra&quot;}, {&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;Mais um dia que é o terror de quem usa desvenlafaxina e transpira em bicas (eu)&quot;}, {&quot;category&quot;: &quot;Alucinação&quot;, &quot;content&quot;: &quot;esqueci de tomar desvenlafaxina ontem e hoje estou sofrendo as consequências\ncomecei a alucinar ter tontura e não conseguir fazer nada\n\ntenho uma reuniao importantissima com minha chefe 14h. \n\nmorte morte morte morte morte&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;esqueci de tomar desvenlafaxina ontem e hoje estou sofrendo as consequências\ncomecei a alucinar ter tontura e não conseguir fazer nada\n\ntenho uma reuniao importantissima com minha chefe 14h. \n\nmorte morte morte morte morte&quot;}, {&quot;category&quot;: &quot;Fadiga&quot;, &quot;content&quot;: &quot;esqueci de tomar desvenlafaxina ontem e hoje estou sofrendo as consequências\ncomecei a alucinar ter tontura e não conseguir fazer nada\n\ntenho uma reuniao importantissima com minha chefe 14h. \n\nmorte morte morte morte morte&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Com desvenlafaxina eu sobreviveria num possível apocalipse, mas no primeiro dia sem remédio já morreria. Doze horas contadas.&quot;}, {&quot;category&quot;: &quot;Embotamento emocional&quot;, &quot;content&quot;: &quot;Quase sete da noite e estava aqui nossa pq minha cara e os pensamentos estão dormentes........ Dez horas de atraso da desvenlafaxina&quot;}, {&quot;category&quot;: &quot;Sensações estranhas&quot;, &quot;content&quot;: &quot;Quase sete da noite e estava aqui nossa pq minha cara e os pensamentos estão dormentes........ Dez horas de atraso da desvenlafaxina&quot;}, {&quot;category&quot;: &quot;Vômito&quot;, &quot;content&quot;: &quot;Si no la tomo un día* o a veces menos, 12 horas, vomito todo durante varios días. Estuve un año buscando la causa y era eso. \n\n*igual yo tomo desvenlafaxina y en dosis altas, por eso el síndrome de abstinencia.&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Si no la tomo un día* o a veces menos, 12 horas, vomito todo durante varios días. Estuve un año buscando la causa y era eso. \n\n*igual yo tomo desvenlafaxina y en dosis altas, por eso el síndrome de abstinencia.&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;não tomei meu ansiolítico hoje e minha cabeça tá girando meus ouvidos estão estourando parabéns por dar uma abstinência ridícula de um dia desvenlafaxina&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;não tomei meu ansiolítico hoje e minha cabeça tá girando meus ouvidos estão estourando parabéns por dar uma abstinência ridícula de um dia desvenlafaxina&quot;}, {&quot;category&quot;: &quot;Sensação de calor&quot;, &quot;content&quot;: &quot;sou a pessoa passando mais calor em todo o saguao de imigracao do japao  desvenlafaxina eu vou te MATAR&quot;}, {&quot;category&quot;: &quot;Perda da libido&quot;, &quot;content&quot;: &quot;estou desleixado em tomar minha desvenlafaxina, meu tesão até voltou, devo me preocupar.&quot;}, {&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;Contando os dias pra desvenlafaxina parar de tiração de onda com a minha cara e parar de me fazer suar frio igual uma descompensada.&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;desvenlafaxina te faz feliz mas cobra seu preço: se você não tomar fica DOENTE&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;estou desmamando da desvenlafaxina que os anjos olhem por mim&quot;}, {&quot;category&quot;: &quot;Pensamentos destrutivos&quot;, &quot;content&quot;: &quot;a sensacao e vontade de morte quando fico um dia sem tomar desvenlafaxina\n\nn sei se amo ou odeio esse remedio&quot;}, {&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;Drogas? Ressaca? Não, desvenlafaxina de estômago vazio&quot;}, {&quot;category&quot;: &quot;Distúrbios gastrointestinais&quot;, &quot;content&quot;: &quot;Drogas? Ressaca? Não, desvenlafaxina de estômago vazio&quot;}, {&quot;category&quot;: &quot;Fadiga&quot;, &quot;content&quot;: &quot;Drogas? Ressaca? Não, desvenlafaxina de estômago vazio&quot;}, {&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;Drogas? Ressaca? Não, desvenlafaxina de estômago vazio&quot;}, {&quot;category&quot;: &quot;Perda da libido&quot;, &quot;content&quot;: &quot;nossa lítio deve derrubar memo né que merda meu deus\ntalvez meu desvenlafaxina funcione pela associação também e na moral que ficar sem libido traz PAZ DE ESPÍRITO&quot;}, {&quot;category&quot;: &quot;Mal-estar&quot;, &quot;content&quot;: &quot;desvenlafaxina eu gostei mto da combinação das duas!! mas se ficar um dia sem da mtoo mal estar&quot;}, {&quot;category&quot;: &quot;Comprometimento cognitivo&quot;, &quot;content&quot;: &quot;será que a desvenlafaxina tá me deixando meio burra? tô sentindo um declínio cognitivo e a memória tá uma porcaria&quot;}, {&quot;category&quot;: &quot;Pesadelos&quot;, &quot;content&quot;: &quot;Eu tomo desvenlafaxina há mais de 8 anos. Ontem esqueci meu remédio em Campinas e estou há mais de 48h sem.\nÉ impressionante o efeito da abstinência dele. Tive os piores pesadelos à noite e não consigo esboçar um sorriso nesse Natal. Me sinto exausto, culpado e tudo de pior.&quot;}, {&quot;category&quot;: &quot;Fadiga&quot;, &quot;content&quot;: &quot;Eu tomo desvenlafaxina há mais de 8 anos. Ontem esqueci meu remédio em Campinas e estou há mais de 48h sem.\nÉ impressionante o efeito da abstinência dele. Tive os piores pesadelos à noite e não consigo esboçar um sorriso nesse Natal. Me sinto exausto, culpado e tudo de pior.&quot;}, {&quot;category&quot;: &quot;Anedonia&quot;, &quot;content&quot;: &quot;Eu tomo desvenlafaxina há mais de 8 anos. Ontem esqueci meu remédio em Campinas e estou há mais de 48h sem.\nÉ impressionante o efeito da abstinência dele. Tive os piores pesadelos à noite e não consigo esboçar um sorriso nesse Natal. Me sinto exausto, culpado e tudo de pior.&quot;}, {&quot;category&quot;: &quot;Sensação de calor&quot;, &quot;content&quot;: &quot;muito bom o desvenlafaxina, já não penso o tempo todo em morrer, mas PUTA QUE PARIU QUE CALOR&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;umas 3 semanas, porém, eu to passando por um processo insuportável de desmame da desvenlafaxina... tá bem merda pq to sentindo sintomas físicos da abstinência, então acho que isso contribui pro estado que me encontro&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;o meu de tpb prefiro morrer do que ficar sem, desvenlafaxina. salvou minha vida mas se faltar era melhor nem ter uma, juro.\n\ne aaa to feliz que nao foi o venvanse entao!&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;viado do ceu tomei a desvenlafaxina e nao consigo ficar sequer de olho aberto e eu preciso estudar&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;Todo mês eu deixo pra comprar s desvenlafaxina em cima da hora aí eu chego na farmácia tonta passando mal&quot;}, {&quot;category&quot;: &quot;Mal-estar&quot;, &quot;content&quot;: &quot;Todo mês eu deixo pra comprar s desvenlafaxina em cima da hora aí eu chego na farmácia tonta passando mal&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Eu já fiquei ruim com crise de retirada de ISRS, mas da desvenlafaxina é paulada. Parece que é mais intensa pela ação na noradrenalina.&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Tomo desvenlafaxina para depressão e não sinto efeitos colaterais, exceto se passar mais de um dia sem tomar, aí vem uma crise de retirada intensa. Já tentei parar de tomar como \&quot;teste\&quot; para ver como ficaria sem e não aguentei mais de 3 dias devido à crise de retirada que deixou muito disfuncional.&quot;}, {&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;600 MILIGRAMAS DE DESVENLAFAXINA????? Meu amigo isso aí deve matar um ser humano&quot;}, {&quot;category&quot;: &quot;Euforia&quot;, &quot;content&quot;: &quot;Primeiro comprimido de desvenlafaxina e tô curtindo onda aqui no quarto&quot;}, {&quot;category&quot;: &quot;Perda da libido&quot;, &quot;content&quot;: &quot;Tô tomando desvenlafaxina e olha, morreu tudo aqui.&quot;}, {&quot;category&quot;: &quot;Disfunção sexual&quot;, &quot;content&quot;: &quot;Depois de 3 semanas eu transei na sexta feira, mas continuo a três meses sem saber o que gozar \n\nObrigado Succinato de Desvenlafaxina Monoidratado 👍🏽🤡🤡🤡&quot;}, {&quot;category&quot;: &quot;Embotamento emocional&quot;, &quot;content&quot;: &quot;mais ou menos, a desvenlafaxina me deixa mais anestesiado q bem propriamente&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;O meu é venlafaxina, a desvenlafaxina é outro. Mas ela tb deve ser ruim de fazer desmame&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;NUNCA TOMEM DESVENLAFAXINA.\n\nNÃO ACEITEM\n\nISSO VAI DESTRUIR SUAS VIDAS\n\nÉ O PIOR DESMAME\n\nNAO USEM!!!!&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Não queria estragar a piada, mas desde quando desvenlafaxina da sono?&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;peraí a desvenlafaxina deixam vcs sonolentos? com a desvenfalaxina eu fico assim tenho que tomar 4mg de alprazolam pra dormir&quot;}, {&quot;category&quot;: &quot;Sensação de queimação&quot;, &quot;content&quot;: &quot;desvenlafaxina acabou e ainda não fui comprar mais\nresultado? minha língua hj tá que nem um chicote banhado no fogo do inferno&quot;}, {&quot;category&quot;: &quot;Alteração do apetite&quot;, &quot;content&quot;: &quot;to tomando Desduo (desvenlafaxina) fiquei aliviada dps de saber disso🙌🏻🙌🏻🙌🏻 \nmas sinto uma sensação de saciedade e nao to comendo mt, igual o meu tratamento pra ansiedade, quando eu tomava escitalopram (perdi 6kg em meses)&quot;}, {&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;psiquiatra me voltou pra desvenlafaxina e já estou sentindo as dores de cabeça nauseantes pq nunca tomo essa bosta no horário certo&quot;}, {&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;psiquiatra me voltou pra desvenlafaxina e já estou sentindo as dores de cabeça nauseantes pq nunca tomo essa bosta no horário certo&quot;}, {&quot;category&quot;: &quot;Estado confusional&quot;, &quot;content&quot;: &quot;monas esqueci de tomar minha desvenlafaxina ONTEM E HOJE agora estou fora de casa e me sentindo a Elizabeth sem a substância totalmente drogada&quot;}, {&quot;category&quot;: &quot;Aumento do apetite&quot;, &quot;content&quot;: &quot;parei de tomar desvenlafaxina na raça e agora to comendo igualzinha uma draga\nnós mulheres que brincamos de retorno de saturno com tdpm com desmame de antidepressivo 🥰&quot;}, {&quot;category&quot;: &quot;Choque cerebral&quot;, &quot;content&quot;: &quot;a desvenlafaxina é fascinante, vc passa 1h do horário de tomar e começa a sentir CHOQUE NO CÉREBRO&quot;}, {&quot;category&quot;: &quot;Sensação de confusão mental&quot;, &quot;content&quot;: &quot;Quando vc esquece de tomar a desvenlafaxina e só percebe depois de algumas horas, quando parece que seu cérebro foi substituído por uma gelatina&quot;}, {&quot;category&quot;: &quot;Fraqueza&quot;, &quot;content&quot;: &quot;Fiquei sem tomar a desvenlafaxina por 2 dias e parecia que tinham sugado todas as minhas forças. Bateu logo uma tontura e minha pressão foi no chão.&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;Fiquei sem tomar a desvenlafaxina por 2 dias e parecia que tinham sugado todas as minhas forças. Bateu logo uma tontura e minha pressão foi no chão.&quot;}, {&quot;category&quot;: &quot;Hipotensão&quot;, &quot;content&quot;: &quot;Fiquei sem tomar a desvenlafaxina por 2 dias e parecia que tinham sugado todas as minhas forças. Bateu logo uma tontura e minha pressão foi no chão.&quot;}, {&quot;category&quot;: &quot;Bocejo&quot;, &quot;content&quot;: &quot;eu realmente n esperava pelo efeito colateral de ficar bocejando toda hora nem q era tao irritante mas pelo menos a desvenlafaxina ta sendo boa&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;ontem tive uma das piores crises da minha vida pois além de estar com uma desmentidura que me deixou todo quebrado com febre e dor ainda tava sofrendo de abstinência de desvenlafaxina pq tentei parar e n deu certo.\n\njá me puxei e mais tarde vou passar na bemol pra comprar essa droga de remédio&quot;}, {&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;Depois do desmame de desvenlafaxina ficou a questão: eu prefiro poder dormir ou poder sentir alguma coisa?\n\nQuestões&quot;}, {&quot;category&quot;: &quot;Embotamento emocional&quot;, &quot;content&quot;: &quot;Depois do desmame de desvenlafaxina ficou a questão: eu prefiro poder dormir ou poder sentir alguma coisa?\n\nQuestões&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;tava pesquisando e muito provavelmente os surtos que ando tendo são abstinência de desvenlafaxina, mas eu vou continuar tonto sequelado e maluco até essa abstinência passar eu não quero mais saber de remédio controlado nem ficar gastando 300 todo mês com isso! tanta coisa que eu preciso comprar&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;tava pesquisando e muito provavelmente os surtos que ando tendo são abstinência de desvenlafaxina, mas eu vou continuar tonto sequelado e maluco até essa abstinência passar eu não quero mais saber de remédio controlado nem ficar gastando 300 todo mês com isso! tanta coisa que eu preciso comprar&quot;}, {&quot;category&quot;: &quot;Mal-estar&quot;, &quot;content&quot;: &quot;a dica do dia é: \nse você tama desvenlafaxina NÃO fique sem tomar por mais de 2 dias pq você vai passar mt mal e sua cabeça vai parecer que tá \&quot;dando choque\&quot; \npaz ✌️&quot;}, {&quot;category&quot;: &quot;Choque cerebral&quot;, &quot;content&quot;: &quot;a dica do dia é: \nse você tama desvenlafaxina NÃO fique sem tomar por mais de 2 dias pq você vai passar mt mal e sua cabeça vai parecer que tá \&quot;dando choque\&quot; \npaz ✌️&quot;}, {&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;para dormir uso o Rivotril, mas tem dias que mesmo assim não durmo\n\na tremedeira eu tinha tomando carbolitio/desvenlafaxina&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;É importante não interromper abruptamente o uso da Desvenlafaxina, pois pode causar síndrome de descontinuação, com sintomas como tontura e irritabilidade.\n\n#saudemental&quot;}, {&quot;category&quot;: &quot;Irritabilidade&quot;, &quot;content&quot;: &quot;É importante não interromper abruptamente o uso da Desvenlafaxina, pois pode causar síndrome de descontinuação, com sintomas como tontura e irritabilidade.\n\n#saudemental&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;É importante não interromper abruptamente o uso da Desvenlafaxina, pois pode causar síndrome de descontinuação, com sintomas como tontura e irritabilidade.\n\n#saudemental&quot;}, {&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;Entre os efeitos colaterais mais comuns da Desvenlafaxina estão náusea, dor de cabeça, tontura, boca seca e aumento da sudorese.\n\n#saudemental&quot;}, {&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;Entre os efeitos colaterais mais comuns da Desvenlafaxina estão náusea, dor de cabeça, tontura, boca seca e aumento da sudorese.\n\n#saudemental&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;Entre os efeitos colaterais mais comuns da Desvenlafaxina estão náusea, dor de cabeça, tontura, boca seca e aumento da sudorese.\n\n#saudemental&quot;}, {&quot;category&quot;: &quot;Boca seca&quot;, &quot;content&quot;: &quot;Entre os efeitos colaterais mais comuns da Desvenlafaxina estão náusea, dor de cabeça, tontura, boca seca e aumento da sudorese.\n\n#saudemental&quot;}, {&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;Entre os efeitos colaterais mais comuns da Desvenlafaxina estão náusea, dor de cabeça, tontura, boca seca e aumento da sudorese.\n\n#saudemental&quot;}, {&quot;category&quot;: &quot;Apatia&quot;, &quot;content&quot;: &quot;Desvenlafaxina é um remédio dos deuses pq eu não ando fazendo NADA o dia todo e mesmo assim não ando depressiva&quot;}, {&quot;category&quot;: &quot;Embotamento emocional&quot;, &quot;content&quot;: &quot;O ruim da desvenlafaxina foi ter me tirado a \&quot;capacidade\&quot; de chorar, aí fico com essa sensação por muito tempo&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;mas dizem que o desmame da desvenlafaxina é brabo mesmo.&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;MULHER SIM!!!!!!! inclusive dizem q o desmame da desvenlafaxina é horrendo, né? eu já esqueci algumas vezes e parecia q eu ia morrer&quot;}, {&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;agora se eu esquecer de tomar a desvenlafaxina de manhã, no final da tarde eu já tô nauseando, com dor de cabeça e querendo sair correndo pelo mundo 🫠 não perdoa 1 dia essa peste!&quot;}, {&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;agora se eu esquecer de tomar a desvenlafaxina de manhã, no final da tarde eu já tô nauseando, com dor de cabeça e querendo sair correndo pelo mundo 🫠 não perdoa 1 dia essa peste!&quot;}, {&quot;category&quot;: &quot;Inquietação&quot;, &quot;content&quot;: &quot;agora se eu esquecer de tomar a desvenlafaxina de manhã, no final da tarde eu já tô nauseando, com dor de cabeça e querendo sair correndo pelo mundo 🫠 não perdoa 1 dia essa peste!&quot;}, {&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;A desvenlafaxina devia me deixar feliz, ao invés disso só me da dor de cabeça vsf&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;hoje eu tive que tomar muito cuidado pra não cair na rua\ne foram só 3 dias sem a desvenlafaxina e já fiquei assim&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;sobrevivendo hj com aquela tontura gostosa de abstinência de desvenlafaxina \n(já comprei meu remédio)&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;dois dias sem desvenlafaxina e eu já estou há dois dias prestes a cometer um crime\ne minha ex-psicóloga dizia que meu problema é obsessão por controle\neu PRECISO estar sob controle&quot;}, {&quot;category&quot;: &quot;Redução da criatividade&quot;, &quot;content&quot;: &quot;acho que vou ficar um tempo sem desvenlafaxina pra ver se eu consigo voltar a escrever&quot;}, {&quot;category&quot;: &quot;Sensações estranhas&quot;, &quot;content&quot;: &quot;They changed me to desvenlafaxina recently and damn I feel so weird 🙃&quot;}, {&quot;category&quot;: &quot;Embotamento emocional&quot;, &quot;content&quot;: &quot;no último halloween eu lavei minha câmera no banheiro do oasis... o que será que vai rolar nesse.. (nada. não sou a mesma pessoa. obg desvenlafaxina)&quot;}, {&quot;category&quot;: &quot;Abstinência&quot;, &quot;content&quot;: &quot;indo no psiquiatra com a abstinência da desvenlafaxina batendo&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;então!! de todos que eu tomei até hoje, a desvenlafaxina foi o único que tipo, segurou bem todos os meus problemas e sem muito estresse durante o período de adaptação. eu me sinto muito funcional tomando, mas a abstinência é a pior que eu já tive de longe (e isso pq nem chega a de fato ser uma abst)&quot;}, {&quot;category&quot;: &quot;Visão turva&quot;, &quot;content&quot;: &quot;por enquanto o único efeito colateral que sinto da desvenlafaxina é o olho embaçando. mas é o menor dos males considerando que a sertralina tinha sugado minha vontade de viver&quot;}, {&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;segundo dia sem desvenlafaxina e uma tremedeira incontrolável já me acometeu&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Como assim efeitos colaterais com o desmame de desvenlafaxina? É só continuar mamando&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;👈esqueceu de tomar a desvenlafaxina no horário e agora está com tontura&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;a abstinência da desvenlafaxina batendo&quot;}, {&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;Eu já sou calorento e a adaptação da desvenlafaxina causa sudorese tô sentindo como se estivesse uns 30°C 🫠&quot;}, {&quot;category&quot;: &quot;Angústia&quot;, &quot;content&quot;: &quot;Geralmente passa com uma ou 2 semanas, ainda mais essa classe aí\nEu tomo desvenlafaxina e passei 3 semanas achando q  ia morrer, depois passou (e funcionou)&quot;}, {&quot;category&quot;: &quot;Delírio&quot;, &quot;content&quot;: &quot;veio a mim durante um delírio de desvenlafaxina&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;Não me adaptei a desvenlafaxina, me dava uma tontura pavorosa! Imagino se eu bebesse então!&quot;}, {&quot;category&quot;: &quot;Hipotensão&quot;, &quot;content&quot;: &quot;Sertralina bebeu, dormiu, parece que é até automático, já eu tomo desvenlafaxina e ele fez minha pressão cair do penhasco fora o embrulho no estômago, nota 0/10 para experiência&quot;}, {&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;Sertralina bebeu, dormiu, parece que é até automático, já eu tomo desvenlafaxina e ele fez minha pressão cair do penhasco fora o embrulho no estômago, nota 0/10 para experiência&quot;}, {&quot;category&quot;: &quot;Choque cerebral&quot;, &quot;content&quot;: &quot;20 e poucas horas sem desvenlafaxina e já senti meu cérebro derretendo a cabeça dando choque e os carai&quot;}, {&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;desvenlafaxina engorda??&quot;}, {&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;Descobri que é a Desvenlafaxina que tá me fazendo suar mais que tampa de marmita.&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;quanto tempo será que ainda vai durar essa abstinência de desvenlafaxina&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Ai gnt n tomem desvenlafaxina o dia q vcs tiverem q parar cm essa merda vai ser o inferno, mt abstinência&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;abstinência de desvenlafaxina........... preciso ser forte e me adaptar a ficar sem, pq olha...................&quot;}, {&quot;category&quot;: &quot;Choque cerebral&quot;, &quot;content&quot;: &quot;é 3 dias sem o desvenlafaxina que minha cabeça fica 100% um remix de todos os funk de assobio mata nóia tocando ao mesmo tempo&quot;}, {&quot;category&quot;: &quot;Choque cerebral&quot;, &quot;content&quot;: &quot;sensação de que meu celebro tá solto na cabeça em razão do desmame da desvenlafaxina + enjôo em razão da adaptação do o vortioxetina = drama de minha parte&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;O desmame da Desvenlafaxina humilha demais! Socorro, Deus!&quot;}, {&quot;category&quot;: &quot;Alteração do apetite&quot;, &quot;content&quot;: &quot;desvenlafaxina dessa vez me deixou sem apetite para nada\nqnd como algo o peristaltismo parece que ligado num amplificador&quot;}, {&quot;category&quot;: &quot;Diarreia&quot;, &quot;content&quot;: &quot;desvenlafaxina dessa vez me deixou sem apetite para nada\nqnd como algo o peristaltismo parece que ligado num amplificador&quot;}, {&quot;category&quot;: &quot;Apatia&quot;, &quot;content&quot;: &quot;A desvenlafaxina me deixa apatica 99% do tempo mas aquele 1% tbm desbagaça tudo. Comecei a chorar por causa do que aconteceu no aeroporto hoje e agora ja to chorando pq nunca serei amada !!!&quot;}, {&quot;category&quot;: &quot;Enxaqueca&quot;, &quot;content&quot;: &quot;olá eu sou a enxaqueca da desvenlafaxina atrasada, sua amiguinha&quot;}, {&quot;category&quot;: &quot;Mal-estar&quot;, &quot;content&quot;: &quot;ressaca monstra com 4 copos de cerveja. obrigada, desvenlafaxina, eu já queria parar de beber mesmo. agora vou ter motivos mais fortes.&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;tudo isso em abstinência da desvenlafaxina!! a cerejinha do bolo&quot;}, {&quot;category&quot;: &quot;Gosto amargo&quot;, &quot;content&quot;: &quot;achei que tava bem e não precisava mais (é irracional mas sempre faço isso) \n\ne tb odiava o gosto amargo que ficava minha boca o dia inteiro \n\nmuitos meses depois voltei a tomar medicação, mas aí o médico já entrou com desvenlafaxina&quot;}, {&quot;category&quot;: &quot;Sensação de calor&quot;, &quot;content&quot;: &quot;nossa eu vejo tanta gente que se deu bem com a desvenlafaxina, eu tomei por uns meses e a única coisa que sentia era MT calor. minha irma toma e se deu super bem mas tambem sentiu essas ondas de calor&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Eu não sei se tô passando por um placebo de falta (?), mas esqueci a desvenlafaxina ontem (já retomei hoje) e parece que fui atropelada por um ônibus.&quot;}, {&quot;category&quot;: &quot;Sensação de calor&quot;, &quot;content&quot;: &quot;eu troquei do escitalopram pra desvenlafaxina ano passado!! nao sei dizer oq mudou sinceramente.. mas o efeito colateral mais esquisito q eu tenho é que agora eu sinto calor pra caralho&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;ps. desmamar escitalopram foi um passeio no parque se eu comparo com a abstinência que tenho com desvenlafaxina&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;olha. eu tomo desvenlafaxina vai fazer um ano e a minha vida melhorou MUITO, mas muito mesmo. o problema só é que se eu passo 24 horas sem tomar (as veis menos) eu começo a ter uma abstinência pancada. a venlafaxina, pelo que pesquisei, é parecida. FÉ E MARCHA&quot;}, {&quot;category&quot;: &quot;Alteração do apetite&quot;, &quot;content&quot;: &quot;é oficial: meu apetite tá voltando. por um tempo a desvenlafaxina tava fazendo um efeito melhor que ozempic, grazadeus passou&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;E eu que esqueci de tomar a desvenlafaxina hj cedo e agora tô chapadao de abstinência&quot;}, {&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;tô tentando ao máximo fingir que não tô tendo uma crise, mas minhas mãos não mentem........... desvenlafaxina já me deixa normalmente tremendo, qd tô mal, piora&quot;}, {&quot;category&quot;: &quot;Euforia&quot;, &quot;content&quot;: &quot;Queria dar um abraço em quem criou a desvenlafaxina ando feliz até demais&quot;}, {&quot;category&quot;: &quot;Dissociação&quot;, &quot;content&quot;: &quot;saudades da minha desvenlafaxina de rir atoa constantemente de não pensar em morrer 24h unica parte ruim era a dissociação os pesadelos o suor a falta de memória e q matou minha libido mas pelo menos eu tava alegrinha com 0 neurônios 0 ansiedade&quot;}, {&quot;category&quot;: &quot;Pesadelos&quot;, &quot;content&quot;: &quot;saudades da minha desvenlafaxina de rir atoa constantemente de não pensar em morrer 24h unica parte ruim era a dissociação os pesadelos o suor a falta de memória e q matou minha libido mas pelo menos eu tava alegrinha com 0 neurônios 0 ansiedade&quot;}, {&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;saudades da minha desvenlafaxina de rir atoa constantemente de não pensar em morrer 24h unica parte ruim era a dissociação os pesadelos o suor a falta de memória e q matou minha libido mas pelo menos eu tava alegrinha com 0 neurônios 0 ansiedade&quot;}, {&quot;category&quot;: &quot;Esquecimento&quot;, &quot;content&quot;: &quot;saudades da minha desvenlafaxina de rir atoa constantemente de não pensar em morrer 24h unica parte ruim era a dissociação os pesadelos o suor a falta de memória e q matou minha libido mas pelo menos eu tava alegrinha com 0 neurônios 0 ansiedade&quot;}, {&quot;category&quot;: &quot;Perda da libido&quot;, &quot;content&quot;: &quot;saudades da minha desvenlafaxina de rir atoa constantemente de não pensar em morrer 24h unica parte ruim era a dissociação os pesadelos o suor a falta de memória e q matou minha libido mas pelo menos eu tava alegrinha com 0 neurônios 0 ansiedade&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;A abstinência de desvenlafaxina antes de te matar ela humilha&quot;}, {&quot;category&quot;: &quot;Disfunção erétil&quot;, &quot;content&quot;: &quot;ai na moral eu fui muito ingrato de reclamar da sertralina, prefiro não gozar tomando sertralina do que ficar quase broxa tomando desvenlafaxina&quot;}, {&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;como eu ODEIO desvenlafaxina eu tomei ontem antes d dormir consegui dormir 3hrs só e to tremendo igual cachorro ate agora vsf&quot;}, {&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;como eu ODEIO desvenlafaxina eu tomei ontem antes d dormir consegui dormir 3hrs só e to tremendo igual cachorro ate agora vsf&quot;}, {&quot;category&quot;: &quot;Mal-estar&quot;, &quot;content&quot;: &quot;O meu é o desvenlafaxina, e o pior é q ele n costumava me dá esse mal estar :(&quot;}, {&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;mt legal a desvenlafaxina pois na hora de dormir não te deixa dormir e na hora de trabalhar quer q vc durma&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;mt legal a desvenlafaxina pois na hora de dormir não te deixa dormir e na hora de trabalhar quer q vc durma&quot;}, {&quot;category&quot;: &quot;Orgasmo retardado&quot;, &quot;content&quot;: &quot;A desvenlafaxina no meu corpo: \nLibido - sim\nOrgasmo - não&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;A abstinência de desvenlafaxina me humilhando. Já vomitei 3x. Sujei as paredes do banheiro em meio metro de altura. Tive de lavar TUDO, passando mal.&quot;}, {&quot;category&quot;: &quot;Vômito&quot;, &quot;content&quot;: &quot;A abstinência de desvenlafaxina me humilhando. Já vomitei 3x. Sujei as paredes do banheiro em meio metro de altura. Tive de lavar TUDO, passando mal.&quot;}, {&quot;category&quot;: &quot;Mal-estar&quot;, &quot;content&quot;: &quot;A abstinência de desvenlafaxina me humilhando. Já vomitei 3x. Sujei as paredes do banheiro em meio metro de altura. Tive de lavar TUDO, passando mal.&quot;}, {&quot;category&quot;: &quot;Alterações de humor&quot;, &quot;content&quot;: &quot;fiquei um dia sem desvenlafaxina… agora entendi o meu mood de hoje!&quot;}, {&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;Eita hahaha mas pensei que fosse desvenlafaxina pq todos meus pacientes reclamam de enjôo desse&quot;}, {&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;eu tomando desvenlafaxina\n\nqueria: disposição\ntenho: tremedeira dps de fzr exercício/esforço físico&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Incrível a abstinência da desvenlafaxina, sempre me deixa baqueada&quot;}, {&quot;category&quot;: &quot;Mal-estar&quot;, &quot;content&quot;: &quot;Incrível a abstinência da desvenlafaxina, sempre me deixa baqueada&quot;}, {&quot;category&quot;: &quot;Apatia&quot;, &quot;content&quot;: &quot;gente desculpa ai td mundo por hoje\neu não consegui existir direito por motivos de DESVENLAFAXINA&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;nada como um cochilasso p passar a abstinência de desvenlafaxina 🕊️&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Abstinência de desvenlafaxina: nao recomendo.&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;em abstinência de desvenlafaxina pq o médico me passou a receita toda errada e preguiça de perder 2 horas do dia indo lá pedir pra arrumar&quot;}, {&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;Meu olho tremendo e meus 100mg de desvenlafaxina concordam com tudo nesse fio…&quot;}, {&quot;category&quot;: &quot;Choque cerebral&quot;, &quot;content&quot;: &quot;quando eu tomava sertralina e esquecia parecia que meu cérebro tirava print \n\nsinto a mesma coisa agora que tomo desvenlafaxina mas bemm pior&quot;}, {&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;Me prometeram vontade de viver com desvenlafaxina e eu to cada vez menos querendo existir&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Meu Deus abstinência de desvenlafaxina eh coisa do inimigo&quot;}, {&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;amanhã eu começo a tomar uma dose maior de desvenlafaxina e eu to ansiosa mesmo sabendo q eu posso piorar ainda mais e q vai demorar pelo menos umas 2 semanas pra fazer efeito 🥰&quot;}, {&quot;category&quot;: &quot;Dissociação&quot;, &quot;content&quot;: &quot;gente, situação incomoda a desvenlafaxina me ensinou como lida: Desassocie-se \n\nvocê não existe. eu mesmo fico cantando Im not here this isnt happening. é o pior que funciona\n\nmas assim né? yall cant do anything hun?&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;nossa eu faco absolutamente qualquer coisa pra nao deixar acabar minha desvenlafaxina pq 1 dia sem tomar ja eh o fim do mundo&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;parece ressaca mas eh apenas abstinência de desvenlafaxina&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Ele eu posso cortar de boa no meu tratamento, pq ele era pra me fazer dormir (não faz), o mais foda se eu ficar sem tomar é a porra da desvenlafaxina que passou mal se esquecer e foi o que fiz ontem e tô morrendo agora Kkkkkkkkrying&quot;}, {&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;nao sei se isso tem a ver, mas eu tomo desvenlafaxina e eu SEMPRE acordo encharcado de suor, mesmo se estiver frio e eu estiver de coberta&quot;}, {&quot;category&quot;: &quot;Mal-estar&quot;, &quot;content&quot;: &quot;ai vei eu esqueci de tomar a desvenlafaxina hj eu to pra morrerrr sendo q eu tomei de 16h que foi qnd lembrei e o mau estar nao passou&quot;}, {&quot;category&quot;: &quot;Dor&quot;, &quot;content&quot;: &quot;esqueço de tomar metilfenidato: no máximo uma dorzinha de cabeça \n\nesqueço a desvenlafaxina: dor morte tendências homicid&quot;}, {&quot;category&quot;: &quot;Pensamentos destrutivos&quot;, &quot;content&quot;: &quot;esqueço de tomar metilfenidato: no máximo uma dorzinha de cabeça \n\nesqueço a desvenlafaxina: dor morte tendências homicid&quot;}, {&quot;category&quot;: &quot;Disfunção sexual&quot;, &quot;content&quot;: &quot;minha boceta com desvenlafaxina&quot;}]" />
