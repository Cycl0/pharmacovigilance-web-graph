      <node id="Vertigem" label="Vertigem">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="23" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Gravol&quot;, &quot;content&quot;: &quot;.....what. i have been comining shit for years and was never told that. im talking gravol + naproxen + acetaminophen + citalopram :0&quot;}|||{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Wonder what would happen if I boofed a citalopram&quot;}|||{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Drei weitere interessante Fakten:\n\nDie Wirkung von Citalopram kann bei manchen Menschen mit Depressionen nur auf einem Placeboeffekt beruhen.\n\nZu Beginn der Einnahme kann das Suizidrisiko bei jüngeren Menschen steigen, weshalb engmaschige...\n#DerApotheker 🥷 2&quot;}|||{&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;llevo creo que menos de 1 semana sin paroxetina y estoy con unos vértigos/lloros de la hostia, mi psiquiatra y psicóloga de vacaciones y la de cabecera que me recibe tan solo dentro de 2 días pray for me&quot;}|||{&quot;category&quot;: &quot;Bupropion&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Paroxetine&quot;, &quot;content&quot;: &quot;minha última prescrição era 300mg d bupropiona e 150 d paroxetina, dps d um tempo eu comecei a ter tds os efeitos adversos d bula (q eu n tinha lido)&quot;}|||{&quot;category&quot;: &quot;Paroxetin&quot;, &quot;content&quot;: &quot;n sei se foi uma boa ideia tomar paroxetina e dorflex um atrás do outro&quot;}|||{&quot;category&quot;: &quot;Mirtazapin&quot;, &quot;content&quot;: &quot;eu SABIA que ia dar merda a mirtazapina que o psiquiatra passou pra minha mãe, dito e feito: a bichinha foi tentar ir no banheiro, foi escorregando de moleza e tava lá sentada no chão, tive que erguer pra por na cama de novo&quot;}|||{&quot;category&quot;: &quot;Trazodone&quot;, &quot;content&quot;: &quot;Voltei a tomar trazodona pra dormir e estou sentindo muito efeito colateral, que o médico prometeu que não ia ter. Tontura, sensação de corpo pesado, dificuldade até pra andar, muito muito sono e o mais estranho: dores musculares (?).&quot;}|||{&quot;category&quot;: &quot;Zolpidem&quot;, &quot;content&quot;: &quot;usar na web nI eh tão ruim assim tô medicada com 20mg de zolpidem e 50mg de trazodona e eu tô sentindo tud9 flutuar aí tinha duS ssnhS cantando music de cinderela ela eh a da coraline indo pro jardim das 9oanras rosas r9xos diversas correr&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;tinha esquecido que além da enxaqueca a desvenlafaxina te dá uma leseira absurda quando você não toma ela no horário. agora tô aqui lutando pra realizar 1 unidade de sinapse atendendo&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;não tomei meu ansiolítico hoje e minha cabeça tá girando meus ouvidos estão estourando parabéns por dar uma abstinência ridícula de um dia desvenlafaxina&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Fiquei sem tomar a desvenlafaxina por 2 dias e parecia que tinham sugado todas as minhas forças. Bateu logo uma tontura e minha pressão foi no chão.&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;sobrevivendo hj com aquela tontura gostosa de abstinência de desvenlafaxina \n(já comprei meu remédio)&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxine&quot;, &quot;content&quot;: &quot;Sertralina bebeu, dormiu, parece que é até automático, já eu tomo desvenlafaxina e ele fez minha pressão cair do penhasco fora o embrulho no estômago, nota 0/10 para experiência&quot;}|||{&quot;category&quot;: &quot;Duloxetin&quot;, &quot;content&quot;: &quot;Na última consulta esqueci de pedir pro meu psiq a receita de duloxetina, ele esqueceu de enviar o PDF\nO remédio acabou ontem eu já tô com tonteira e brain zap\nPQP COMO EU ODEIO TER TDAHHHHHHH&quot;}|||{&quot;category&quot;: &quot;Duloxetine&quot;, &quot;content&quot;: &quot;Qdo eu faço movimentos bruscos minha visao começa a girar. Nnn sei oq eh, e a duloxetina ta em dia. Entao nn eh falta de ansiolítico/antidepressivo&quot;}|||{&quot;category&quot;: &quot;Venlafaxine&quot;, &quot;content&quot;: &quot;esqueci de tomar o doidex™ ontem e foi ok o dia mas hj to completamente coisada as coisa piscando a cabeça rodando venlafaxina eu te odeio (amo mt mas pourran n pode esquecer 1 dia&quot;}|||{&quot;category&quot;: &quot;Venlafaxine&quot;, &quot;content&quot;: &quot;efeitos da falta de venlafaxina hoje: sensação de desmaio, irritabilidade, paranoia&quot;}|||{&quot;category&quot;: &quot;Amitriptyline&quot;, &quot;content&quot;: &quot;Voltei com a amitriptilina e tinha esquecido do efeito ~ mente flutuante ~ que ele deixa.\n\nMe sentindo embaixo d'água/num sonho o dia inteiro. Mas de uma forma ok.&quot;}|||{&quot;category&quot;: &quot;Amitriptyline&quot;, &quot;content&quot;: &quot;Tomei amitriptilina ontem p tentar dormir e atualmente tô rodando a 2 fps por causa da lombeira q esse remédio da no dia seguinte&quot;}|||{&quot;category&quot;: &quot;Clomipramina&quot;, &quot;content&quot;: &quot;meu psiquiatra falou que clomipramina diminui o libido mas desde a hora que acordei hj só penso em sexo com o *&quot;}|||{&quot;category&quot;: &quot;Methylphenidate&quot;, &quot;content&quot;: &quot;hoje não tomei o metilfenidato porque acho que tá me dando enxaqueca mas aí tou feito barata tonta tentando ser produtivo fazendo tudo de forma desorganizada&quot;}" />
