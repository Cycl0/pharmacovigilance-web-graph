      <node id="Calafrios" label="Calafrios">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="17" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;think I just got fucked up by just a different brand of my usual med? But I switch up brands all the time and this doesn’t happen? I just took my escitalopram and experienced something that felt v much like hardcore venlafaxine withdrawal??Has this happened to anyone? I know u r all on escitalopram&quot;}|||{&quot;category&quot;: &quot;Paroxetin&quot;, &quot;content&quot;: &quot;Eu fiz tratamento com ela durante anos, na época me ajudou muito, mas os efeitos colaterais são péssimos mesmo, agora eu troquei pelo paroxetina&quot;}|||{&quot;category&quot;: &quot;Sertraline&quot;, &quot;content&quot;: &quot;kkkkkkkkk aqui eu senti uma onde calor enorme, até fui no ps pq parecia q tava queimando. tbm to tomando com a sertralina mas essa só por mais dois dias&quot;}|||{&quot;category&quot;: &quot;Bupropion&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxine&quot;, &quot;content&quot;: &quot;15 graus e eu com calor, obrigada desvenlafaxina&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Nao aguento mais passar mal de calor, são tempos difíceis para as patricinhas*\n\n*neurodivergentes com sensibilidade ao calor que tomam desvenlafaxina e por tanto já sentem mais calor naturalmente&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;nossa eu vejo tanta gente que se deu bem com a desvenlafaxina, eu tomei por uns meses e a única coisa que sentia era MT calor. minha irma toma e se deu super bem mas tambem sentiu essas ondas de calor&quot;}|||{&quot;category&quot;: &quot;Duloxetin&quot;, &quot;content&quot;: &quot;Duloxetina me fazendo ter um calor ABSURDO\nVou é parar de tomar essa porra vai tomar no cu&quot;}|||{&quot;category&quot;: &quot;Duloxetin&quot;, &quot;content&quot;: &quot;Com o calor que eu sinto tomando duloxetina e da fibromialgia, se eu morasse onde faz 35+ todo dia eu me matava\nOntem quase tive que ser socorrido porque estava uns 32 graus e eu fui na feira da minha rua&quot;}|||{&quot;category&quot;: &quot;Duloxetine&quot;, &quot;content&quot;: &quot;Que calor insuportável tô sentindo meu deus\nMeu corpo está em chamas por dentro\nIsso tudo patrocinado pela duloxetina&quot;}|||{&quot;category&quot;: &quot;Cymbalta&quot;, &quot;content&quot;: &quot;No subreddit de cymbalta (duloxetina) um dos maiores efeitos colaterais dele é o calor no corpo\nImagina eu com fibromialgia que meu corpo simplesmente fica 1000x mais pesado no calor\nFora a sensação de mal estar que não passa&quot;}|||{&quot;category&quot;: &quot;Duloxetin&quot;, &quot;content&quot;: &quot;Pelo amor de deus eu já tinha ido de arrasta pra cima\nEu vou ter que me mudar de pais porque eu não suporto mais calor, e a duloxetina me dá mais calor ainda&quot;}|||{&quot;category&quot;: &quot;Ciclobenzaprina&quot;, &quot;content&quot;: &quot;queria almoçar um corote de limão ruim da duelo com um maço de cigarro saborizado de melancia 3 kumbaya de camomila e 3 comprimido de ciclobenzaprina com 5 amitriptilina&quot;}|||{&quot;category&quot;: &quot;Ciclobenzaprina&quot;, &quot;content&quot;: &quot;queria almoçar um corote de limão ruim da duelo com um maço de cigarro saborizado de melancia 3 kumbaya de camomila e 3 comprimido de ciclobenzaprina com 5 amitriptilina&quot;}|||{&quot;category&quot;: &quot;Ciclobenzaprina&quot;, &quot;content&quot;: &quot;queria almoçar um corote de limão ruim da duelo com um maço de cigarro saborizado de melancia 3 kumbaya de camomila e 3 comprimido de ciclobenzaprina com 5 amitriptilina&quot;}|||{&quot;category&quot;: &quot;Ciclobenzaprina&quot;, &quot;content&quot;: &quot;queria almoçar um corote de limão ruim da duelo com um maço de cigarro saborizado de melancia 3 kumbaya de camomila e 3 comprimido de ciclobenzaprina com 5 amitriptilina&quot;}|||{&quot;category&quot;: &quot;Methylphenidate&quot;, &quot;content&quot;: &quot;Amor al metilfenidato pero en verano me da más calor&quot;}" />
