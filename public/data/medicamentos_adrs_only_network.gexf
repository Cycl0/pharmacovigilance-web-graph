      <node id="Amitriptilina" label="Amitriptilina">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="18" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;Eu sou um viciado de merda dependente de cigarro, eu tô tremendo pra cacete pq não achei a porra de um cigarro, tomei 4 amitriptilina pra me acalmar e Agr minha boca tá extremamente seca Urgh&quot;}|||{&quot;category&quot;: &quot;Sonambulismo&quot;, &quot;content&quot;: &quot;Estou tentando começar o clomipramina\nPrimeira vez que tomei tive pesadelos horríveis\nHoje pelo menos não tive, mas tbm tomei junto o amitriptilina\nSó 25mg de cada é fraquinho&quot;}|||{&quot;category&quot;: &quot;Sonambulismo&quot;, &quot;content&quot;: &quot;nao tomei amitriptilina pq dormi tudo errado pós envio da monografia\n\nresultado \nsonhei com guerra e um monte de coisa muito muito pesada&quot;}|||{&quot;category&quot;: &quot;Esquecimento&quot;, &quot;content&quot;: &quot;meu deus a gramática russa eh mta coisa pra memorizar to desafiando meu cérebro cm tdah e ainda tomando amitriptilina q piora minha memória&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;Já tomei quetiapina, mas não deu certo. Agora tô na venlafaxina e tem sido ótimo, tô bem estável sem perder a alma KKKKKK\nSobre a amitriptilina, no começo era um inferno, eu só queria dormir, parecia uma morta-viva, agora tá super de boas, amo 🫶🏾&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;senhor ando com tanto sono q parece q eu tomeu uma caixa de ciclobenzaprina com amitriptilina&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;+ parei por conta própria e no outro dia acordei bem mais disposta\nRelatei a minha psiquiatra e ela aumentou a dosagem da amitriptilina pra 1 comprimido de 25mg (q já tomo) + metade, no entanto nesses 2 dias q comecei a tomar me senti muito mal, muito grogue, indisposta e me deixou angustiada+&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;Estou muito cracuda, sertralina com amitriptilina deu bom não.\nVou dormir.&quot;}|||{&quot;category&quot;: &quot;Zumbido&quot;, &quot;content&quot;: &quot;tinha esquecido que o amitriptilina me deixa zonza e com muito sono, vou passar o dia todo ranzinza&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;tinha esquecido que o amitriptilina me deixa zonza e com muito sono, vou passar o dia todo ranzinza&quot;}|||{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;Eu engordei uns 10kg na amitriptilina, sem brincadeira. A fome que ele te faz sentir é incontrolável e surreal, nunca senti isso na vida, nem depois de dias em jejum&quot;}|||{&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;Eu comecei a tratar agora com Topiramato. Eu já tratei antes com Amitriptilina, mas ele me deixava com muita ressaca. Eu sempre tive crises, mas ultimamente estou tendo dores todos os dias e se eu não tomar remédio acaba evoluíndo para crise, por isso vou fazer a profilaxia.&quot;}|||{&quot;category&quot;: &quot;Desmaio&quot;, &quot;content&quot;: &quot;o efeito do amitriptilina fazendo minha pressão cair pqp\nja eh a segunda vez que desmaio hoje&quot;}|||{&quot;category&quot;: &quot;Sedação&quot;, &quot;content&quot;: &quot;Os áudios dela tem o dom de me acalmar mais que uma dose de Rivotril com Amitriptilina 😌❤️🖤&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Amitriptilina bateu, dormiu 😅&quot;}|||{&quot;category&quot;: &quot;Incontinência urinária&quot;, &quot;content&quot;: &quot;ai q bom q ta dando tudo certo pra vcc mto bom serio eu agora vou falar cm meu médico pra ver se eu tento voltar com o amitriptilina ele dava dando certo pra mim mas dps com uma semana tomando me deu efeito colateral de prender meu xixi aí vou tentar voltar pra ver se o efeito some com o tempo&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;to fazendo desmame de um remedio pra dormir e troquei por amitriptilina, o ruim é que ele nao me derruba rápido mas o bom é que quando derruba eu durmo pelo menos umas 10h facinho&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Esse eles ansiedade né? Pra ansiedade tomo Amitriptilina&quot;}" />
