      <node id="Síncope" label="Síncope">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="11" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Trazodona&quot;, &quot;content&quot;: &quot;aaa accidentally took trazodone instead of my escitalopram and now i feel like im gonna pass out&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;-Ufff qué mareo tengo, siento que voy a desfallecer. La verdad es que no sé por qué me siento así -exclamó el muchacho mientras que en su cuerpo solamente se hallaba una sertralina de 100mg.&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;venlafaxina ou da mto certo ou mto errado\ncomigo deu mto errado pq eu suava pra krl e desmaiava kkkkkkk\nos que mais deram certo cmgo foram citalopram, bupropiona e brintellix, atualmente tomo bupropiona and brintellix&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;tomei mirtazapina ontem e quase desmaiei no caminho da cozinha até meu quarto \n\ndeve ser um dos únicos antidepressivos que eu não tinha tomado... agora to tomando apenas *quatro* em doses cavalares 👍&quot;}, {&quot;category&quot;: &quot;Trazodona&quot;, &quot;content&quot;: &quot;pior que não faço ideia pois a trazodona só me desmaia&quot;}, {&quot;category&quot;: &quot;Trazodona&quot;, &quot;content&quot;: &quot;to a 2 dias sem a trazodona e parece que vou desmaiar a qualquer instante !&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;efeitos da falta de venlafaxina hoje: sensação de desmaio, irritabilidade, paranoia&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;sempre erravam a minha veia pra colher sangue e ficavam cutucando e eu já devo ter desmaiado umas 3 vezes nisso\n\noutra vez foi o dia seguinte de eu ter começado a tomar amitriptilina \n\nminha mãe e meu tio viviam desmaiando por ver sangue kkkkkk\n\no namo do meu primo pq quebrou o braço não recomendo&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;o efeito do amitriptilina fazendo minha pressão cair pqp\nja eh a segunda vez que desmaio hoje&quot;}, {&quot;category&quot;: &quot;Clomipramina&quot;, &quot;content&quot;: &quot;ai passo mal demais com alguns nomes de medicamento referência saindo diretamente de uma roda de amigos da faria lima\n\nja conhecia o DESVE e o ESC mas o CLO pra clomipramina acabou de me causar uma síncope&quot;}, {&quot;category&quot;: &quot;Clomipramina&quot;, &quot;content&quot;: &quot;Acho que é um efeito comum desses medicamentos pra tratar coisas psicológicas. Eu tomo cloridrato de clomipramina 75mg por dia. Eu tava pra desmaiar e tacar a cara no teclado no trabalho nos primeiros dias. Hoje ta de bouas.&quot;}]" />
          <attvalue for="3" value="6" />
          <attvalue for="4" value="18" />
          <attvalue for="5" value="1.697086 0.391584" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
      <node id="Pregabalina" label="Pregabalina">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="2" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;eh muito complicado ter que tomar um monte de remedio pq vc começa a consertar uma coisa a outra vai pro caralho pregabalina pra estabilizar mas me da insonia entao tem que tomar a trazodona por cima dai o prozac me tira da depressao mas me faz querer passar fome ou seja nao se pode ter tudo&quot;}, {&quot;category&quot;: &quot;Mal-estar&quot;, &quot;content&quot;: &quot;Yo amor eterno a la duloxetina, la pregabalina me deja mal.&quot;}]" />
          <attvalue for="3" value="2" />
          <attvalue for="4" value="18" />
