      <node id="Orgasmo retardado" label="Orgasmo retardado">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="13" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Mood.\n\nTakes me twice as much effort to cum these days (citalopram)&quot;}, {&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;My #antideptessants prevent me from cumming but without killing my sex drive. So, I'm hornier than ever with no outlet.\n\nThanks, #citalopram!&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;escitalopram? more like automatic edging system (I’m sorry)&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Curiosamente depois do escitalopram virei shooter nível da pra ouvir saindo. Acho que por estar guardando e demorando mais?&quot;}, {&quot;category&quot;: &quot;Fluoxetina&quot;, &quot;content&quot;: &quot;poxa depois de quatro anos a fluoxetina fez meu orgasmo de refém de novo preciso de bupropiona&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Lembrei de uma pessoa com o nick \&quot;punheta seca de paroxetina\&quot;&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Os voy a contar una cosita sobre la paroxetina y los orgasmos y las erecciones:\nSi, tener una erección lo suficientemente firme era imposible.\nLlegar al orgasmo no era lo mas fácil.\n\nPero pude (pudimos) dar placer y recibir placer. Los orgasmos en compañía son preciosos&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Eu tomo paroxetina todo dia dai eu demoro 8h pra gozar quando vou fazer o aiaiaiuiuiui c o andre&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Quando eu tomava Paroxetina eu não conseguia gozar… então cheguei a ficar 1 hora transando sem parar… coitado do meu namorado na época&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Quando eu tomava paroxetina eu não conseguia gozar… chegava a esfolar… mais ou menos 1 h transando&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;H38, Sim, a sertralina pode diminuir a libido, atrasar ou dificultar o orgasmo e até causar disfunção erétil em alguns casos. Isso é efeito colateral comum em antidepressivos ISRS. Se estiver te afetando, vale conversar com o psiquiatra — às vezes dá pra ajustar a dose ou trocar o remédio.&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;Eu tomava sertralina, mas não conseguia ter um orgasmo e pedi para trocarem, comecei a tomar desvenlafaxina que era bem boa, mas quando troquei a unidade de acompanhamento mudei para fluoxetina e é bem bom&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;A desvenlafaxina no meu corpo: \nLibido - sim\nOrgasmo - não&quot;}]" />
          <attvalue for="3" value="6" />
