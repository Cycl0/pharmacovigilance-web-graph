      <node id="Prolongamento do intervalo QT" label="Prolongamento do intervalo QT">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="4" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Drugs to avoid in the name of better patient care according to Prescrire - 2025 uptdate includes #SSRI citalopram, escitalopram and venlafaxine because of risk of cardiovascular events, including QT interval prolongation english.prescrire.org/en/1256/3059... #Medsky #Psysky&quot;}, {&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Drugs to avoid in the name of better patient care according to Prescrire - 2025 uptdate includes #SSRI citalopram, escitalopram and venlafaxine because of risk of cardiovascular events, including QT interval prolongation english.prescrire.org/en/1256/3059... #Medsky #Psysky&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Drugs to avoid in the name of better patient care according to Prescrire - 2025 uptdate includes #SSRI citalopram, escitalopram and venlafaxine because of risk of cardiovascular events, including QT interval prolongation english.prescrire.org/en/1256/3059... #Medsky #Psysky&quot;}, {&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Ja. Und soweit ich weiß ist das gar nicht unüblich, bzw. QT-Zeit Verlängerung ist was, was selbst so 0815 Antidepressiva wie Citalopram verursachen können, weshalb man regelmäßig zur Herzkontrolle soll(te)&quot;}]" />
