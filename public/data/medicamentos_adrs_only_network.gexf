      <node id="Fraqueza" label="Fraqueza">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="18" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;I have a sneaky suspicion that the physical weakness side effect associated with escitalopram use may be caused by an overall reduction in the frequency of tetanic muscle contractions.&quot;}, {&quot;category&quot;: &quot;Fluvoxamina&quot;, &quot;content&quot;: &quot;e antes dessa praga tomei outra praga: fluvoxamina. me sentia doente, fraca e me deixou uma reação adversa que até hoje não passou.&quot;}, {&quot;category&quot;: &quot;Propranolol&quot;, &quot;content&quot;: &quot;Agora eu fui raciocinar q oq me deixou assim foi os 15 comprimido de propanolol q eu tomei junto com meia cartela de sertralina 😔 burra do carai\nAi a pressão desregulou e to aqui desfalecida&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;Agora eu fui raciocinar q oq me deixou assim foi os 15 comprimido de propanolol q eu tomei junto com meia cartela de sertralina 😔 burra do carai\nAi a pressão desregulou e to aqui desfalecida&quot;}, {&quot;category&quot;: &quot;Quetiapina&quot;, &quot;content&quot;: &quot;to fraquissima e não sei se é a quetiapina batendo, eu não ter tomado minha bupropiona, ambas as opções ou algo mais grave&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;to fraquissima e não sei se é a quetiapina batendo, eu não ter tomado minha bupropiona, ambas as opções ou algo mais grave&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;eu SABIA que ia dar merda a mirtazapina que o psiquiatra passou pra minha mãe, dito e feito: a bichinha foi tentar ir no banheiro, foi escorregando de moleza e tava lá sentada no chão, tive que erguer pra por na cama de novo&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;gente ?? por quanto tempo o mirtazapina fez vcs apagarem por mais de 15 horas e acordarem completamente perdidos e sem força????&quot;}, {&quot;category&quot;: &quot;Trazodona&quot;, &quot;content&quot;: &quot;400mg de trazodona deixa o sujeito igual uma folha de papel a4 colorida do senninha&quot;}, {&quot;category&quot;: &quot;Trazodona&quot;, &quot;content&quot;: &quot;tomei trazodona ontem pela 1a vez e hoje to MOLE obg por me amolecer filho da puta só quero dormir por 13h seguidas 👍&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Fiquei sem tomar a desvenlafaxina por 2 dias e parecia que tinham sugado todas as minhas forças. Bateu logo uma tontura e minha pressão foi no chão.&quot;}, {&quot;category&quot;: &quot;Duloxetina&quot;, &quot;content&quot;: &quot;5° dia sem a duloxetina, não sei como consegui levantar da cama.&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;passando mal de enjoo, cuspindo a cada 10 segundos, tonta, fraca, mente anuviada e ouvindo o ventilador de satanás do lado esquerdo\nnynca mais atraso a venlafaxina&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Parei de tomar venlafaxina por isso kkk me sentia uma folha de papel&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;\&quot;ai porque uma pessoa depressiva tomar remédio é perigoso porque ela tem energia pra se matar\&quot; eu depressivo tomando remédio sem conseguir me matar porque não consigo levantar da cama mesmo tomando 150mg de venlafaxina&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;Rapaz amitriptilina faz dormir um soninho bom né, mas de manhã é só a boca seca e o corpo mole \nUma batalha p acordar kkkkk&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;eu to total dopada do amitriptilina \neu to mt molenga e sem paciência&quot;}, {&quot;category&quot;: &quot;Clomipramina&quot;, &quot;content&quot;: &quot;Queria. Eu tomo cloridrato de clomipramina e funciona pra ansiedade, sugando ela e minhas forças junto pro limbo de um sono sem fim&quot;}]" />
          <attvalue for="3" value="13" />
          <attvalue for="4" value="1" />
          <attvalue for="5" value="2.558931 1.938809" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
