      <node id="Nortriptyline" label="Nortriptyline">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="7" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Sleepiness&quot;, &quot;content&quot;: &quot;Quero sair do amitriptilina pro nortriptilina\nE testar talvez o imipramina, porém não daria pra usar os dois juntos pq ambos dão sono. Vortioxetina é interessante também mas não trata neuropatia\nEntão eu teria que escolher só um&quot;}|||{&quot;category&quot;: &quot;Enxaqueca&quot;, &quot;content&quot;: &quot;neurologista pq o remédio do psiquiatra me dá enxaqueca pelo menos 1x por semana mesmo tomando nortriptilina pra evitar enxaqueca ♥️\n\nai ele virou pra mim e disse \&quot;vc aumentou a dose faz só 1 semana, espere 2 meses e volte\&quot; e assim foram meus 500 reais pq retorno grátis eh só até 30 dias&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;ansiosa e querendo fumar, ja que cortaram meu nortriptilina e ainda nao lido bem com mudanças de ambiente de conforto, meu quarto&quot;}|||{&quot;category&quot;: &quot;Sleepiness&quot;, &quot;content&quot;: &quot;mas eu tomo a nortriptilina que sinceramente acho que é o que faz dormir o ansitec so da um senso de tranquilidade mesmo (que eu estava precisando sinceramente)&quot;}|||{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;mentiram pra mim, nortriptilina dá sono caralho nenhum&quot;}|||{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;engordei 10kg com nortriptilina essa merda&quot;}|||{&quot;category&quot;: &quot;Taquicardia&quot;, &quot;content&quot;: &quot;dps que eu passei a tomar desvenlafaxina meu intestino voltou ao normal e agr eu consigo ir no banheiro todo dia 😸 já amo mais que a cachorra da nortriptilina que me deu taquicardia e eu ficava 1 semana sem c4g4r&quot;}" />
          <attvalue for="3" value="6" />
          <attvalue for="4" value="9" />
          <attvalue for="5" value="3.618813 0.791482" />
          <attvalue for="6" value="#2DCD9F" />
