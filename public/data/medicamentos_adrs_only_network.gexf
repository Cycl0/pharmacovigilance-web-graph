      <node id="Clonazepam" label="Clonazepam">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="3" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;remedios q eu ja tomei \n\nfluoxetina 😐\nclonazepam 🥱\nsertralina ❤️\ndepakene 😐\nparoxetina ❤️\ncarbolitium ❤️\nrisperidona 😒&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Tomei 3 trazodona e 2 clonazepam , qro ver eu acordar amanhã 😈😈😈&quot;}, {&quot;category&quot;: &quot;Ressaca&quot;, &quot;content&quot;: &quot;Eu tive mta ressaca com outros remédios, principalmente o zolpidem e clonazepam, aí a trazodona é oq menos me dá ressaca e sinto q realmente descansei...&quot;}]" />
          <attvalue for="3" value="2" />
