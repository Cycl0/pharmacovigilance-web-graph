      <node id="Formigamento" label="Formigamento">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="7" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Duloxetina&quot;, &quot;content&quot;: &quot;...só percebi que era o duloxetina porque na vez que fiquei sem tomar ele por 3 dias o formigamento sumiu kkkkk af, além de formigar deixava dormente, eu não podia deixar a perna meio presa formigava e adormecia kkkk nam&quot;}, {&quot;category&quot;: &quot;Duloxetina&quot;, &quot;content&quot;: &quot;Que louco isso amigo, porque foi justamente às 17h que estou tendo as dores de cabeça, porém está diminuindo mais, ultimamente é mais um incômodo... Então, com o duloxetina eu tinha formigamentos sim, MUITO E DIRETO, e tipo, até o último dia que eu tomei eu tinha...&quot;}, {&quot;category&quot;: &quot;Duloxetina&quot;, &quot;content&quot;: &quot;Também tive dores de cabeça na primeira semana.\nSempre pelas 17h.\nForam uns 5 dias, depois passou.\nMelhoras ai!\nNesse duloxetina voce teve formigamentos?&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;nossa eu odiei usar venlafaxina! Minha perna formigava e eu sentia que ficava mais dopado que tudo.&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;Sempre fico agoniada quando tomo o amitriptilina, onde o comprimido encosta fica com uma sensação de dormência…&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;Amigos q tomam remédio, vcs tomam cloridrato de amitriptilina?\n\nSe sim, vcs se sentem meio coisado dps como se tivesse num formigueiro (mas dps passa)?&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;to tendo que tomar amitriptilina e agora toda noite é uma lingua dormente por algum tempo&quot;}]" />
          <attvalue for="3" value="3" />
          <attvalue for="4" value="18" />
          <attvalue for="5" value="4.128048 3.535810" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
