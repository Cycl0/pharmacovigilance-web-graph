      <node id="Duloxetin" label="Duloxetin">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="24" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Apatia&quot;, &quot;content&quot;: &quot;eu odeio como a duloxetina me tira de \&quot;sentir tudo violentamente ao ponto de não conseguir controlar meus pensamentos mais sombrios\&quot; para uma completa anestesia emocional insana\n\ni feel nothing\n\nand i utterly hate feeling nothing&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;Não sei se foi efeito de ficar dois dias sem duloxetina (ou foram três?), mas só sei que essa madrugada eu chorei como há tempos não chorava.&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;15 graus na rua e eu suando. Duloxetina vc me paga por tudo&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;hj a abstinência de duloxetina ta me mandando simplesmente desistir de dormir e ir correr uns 5km e dps ir na farmacia e comorar um monte de jujuba de melatonina&quot;}|||{&quot;category&quot;: &quot;Hidratação&quot;, &quot;content&quot;: &quot;La duloxetina y el aripiprazol me tienen tomando demasiada agua xD\n\nThe duloxetine and the aripiprazole it’s making to me drink too much water&quot;}|||{&quot;category&quot;: &quot;Calafrios&quot;, &quot;content&quot;: &quot;Duloxetina me fazendo ter um calor ABSURDO\nVou é parar de tomar essa porra vai tomar no cu&quot;}|||{&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;Duloxetina ou venlafaxina, você vai ter que reaprender a sentir coisas depois que começar a tomar e aí vc não aprende a ser muito triste&quot;}|||{&quot;category&quot;: &quot;Tristeza&quot;, &quot;content&quot;: &quot;Duloxetina ou venlafaxina, você vai ter que reaprender a sentir coisas depois que começar a tomar e aí vc não aprende a ser muito triste&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;Duloxetina ou venlafaxina, você vai ter que reaprender a sentir coisas depois que começar a tomar e aí vc não aprende a ser muito triste&quot;}|||{&quot;category&quot;: &quot;Calafrios&quot;, &quot;content&quot;: &quot;Com o calor que eu sinto tomando duloxetina e da fibromialgia, se eu morasse onde faz 35+ todo dia eu me matava\nOntem quase tive que ser socorrido porque estava uns 32 graus e eu fui na feira da minha rua&quot;}|||{&quot;category&quot;: &quot;Formigamento&quot;, &quot;content&quot;: &quot;Que louco isso amigo, porque foi justamente às 17h que estou tendo as dores de cabeça, porém está diminuindo mais, ultimamente é mais um incômodo... Então, com o duloxetina eu tinha formigamentos sim, MUITO E DIRETO, e tipo, até o último dia que eu tomei eu tinha...&quot;}|||{&quot;category&quot;: &quot;Desregulação emocional&quot;, &quot;content&quot;: &quot;Eu tomava duloxetina e agora mudei pra o escitalopram, a libido foi pro ralo e eu só agradeço a Deus porque tenho compulsão sexual por conta do tdah e o Venvanse só não segurava e a duloxetina potencializava a anfetamina me deixando maníaco, obg esc kkkkkk&quot;}|||{&quot;category&quot;: &quot;Securaocular&quot;, &quot;content&quot;: &quot;O pior é que eu tenho o óculos a meses\nDesde o começo eu não me sentia bem usando ele, mas não sabia dizer se era a duloxetina, ressecamento dos olhos por causa da amitriptilina\nTem dias que melhora e tem dias que pioram, preciso marcar oftalmo&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;eu tomava pra dar um ânimo e ajudar no foco e concentração tb, e pra depressao/ansiedade eu tomava junto a duloxetina&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;eu tomava pra dar um ânimo e ajudar no foco e concentração tb, e pra depressao/ansiedade eu tomava junto a duloxetina&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;ele me passou duloxetina para ansiedade, e quetiapina para dar um impulso no sono, nas doses mais baixas do mercado, os 2 tarja vermelha, primeira semana não ajudou em nada, estava desesperado, liguei para o médico que pediu para eu continuar, só depois da segunda semana começou a melhorar o sono.&quot;}|||{&quot;category&quot;: &quot;Vertigem&quot;, &quot;content&quot;: &quot;Na última consulta esqueci de pedir pro meu psiq a receita de duloxetina, ele esqueceu de enviar o PDF\nO remédio acabou ontem eu já tô com tonteira e brain zap\nPQP COMO EU ODEIO TER TDAHHHHHHH&quot;}|||{&quot;category&quot;: &quot;Confusão&quot;, &quot;content&quot;: &quot;Na última consulta esqueci de pedir pro meu psiq a receita de duloxetina, ele esqueceu de enviar o PDF\nO remédio acabou ontem eu já tô com tonteira e brain zap\nPQP COMO EU ODEIO TER TDAHHHHHHH&quot;}|||{&quot;category&quot;: &quot;Calafrios&quot;, &quot;content&quot;: &quot;Pelo amor de deus eu já tinha ido de arrasta pra cima\nEu vou ter que me mudar de pais porque eu não suporto mais calor, e a duloxetina me dá mais calor ainda&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Duloxetina = o remédio pra ansiedade que te causa ansiedade&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;vou começar a colocar data nos comprimidos dnv, pq sempre ocorria de eu não tomar duloxetina no domingo pq meu celular não despertava ou eu tava muito podre de sono e só acordava pra desligar o toque, agora q tomo ambas juntas então corro esse risco&quot;}|||{&quot;category&quot;: &quot;Reações alérgicas&quot;, &quot;content&quot;: &quot;Lula, eu tenho fibromialgia\nPela lei, o SUS deve oferecer tratamento (multidisciplinar)\nMas o SUS não oferece nem Duloxetina e nem Pregabalina, que são os medicamentos que eu tive mais eficácia (tomei os ofertados pelo SUS e tive reações)\nAlém disso, o atendimento na CAMPD demora pra sair pela UBS&quot;}|||{&quot;category&quot;: &quot;Anorexia&quot;, &quot;content&quot;: &quot;com duloxetina 60 mg vc fica sem comer por tipo 3 dias 🩷&quot;}|||{&quot;category&quot;: &quot;Sleepiness&quot;, &quot;content&quot;: &quot;duloxetina tira minha ansiedade mas em compensação me deixa meio vagabundo&quot;}" />
          <attvalue for="3" value="18" />
