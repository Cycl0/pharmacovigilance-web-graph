      <node id="Letargia" label="Letargia">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="13" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Wonder what would happen if I boofed a citalopram&quot;}|||{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Saudade de tomar remédio que não fazia sentir nada kkkkk\nQuando tomava a dose máxima de citalopram me ocorria isso, ao menos até ele parar de fazer efeito em mim&quot;}|||{&quot;category&quot;: &quot;Bupropion&quot;, &quot;content&quot;: &quot;Tomar bupropiona é um constante esquecer de comer e a pressao cair nas piores horas 🫠&quot;}|||{&quot;category&quot;: &quot;Bupropion&quot;, &quot;content&quot;: &quot;fico impressionada que a bupropiona dá o mesmo efeito que a ritalina em mim, mas de um jeito mais leve. até a minha mente fica silenciosa&quot;}|||{&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Aiii, de drogas a mí la mirtazapina me ayudó muchísimo. Te deja un poco ko al principio pero fue la mejor de todas las que me dieron&quot;}|||{&quot;category&quot;: &quot;Mirtazapine&quot;, &quot;content&quot;: &quot;Meu humor ficou uma bosta, meu animo zerado, parece que ta atrapalhando um pouco o soninho do mirtazapina, nao to conseguindo prestar atencao em nada (Nao que eu conseguisse antes, mas era menos pior e eu conseguia com esforço)&quot;}|||{&quot;category&quot;: &quot;Trazodona&quot;, &quot;content&quot;: &quot;esse trazodona me deixa assim&quot;}|||{&quot;category&quot;: &quot;Lotmetazepam&quot;, &quot;content&quot;: &quot;Sigue con Lotmetazepam, Sertralina y Trazodona, más o menos. 🤪&quot;}|||{&quot;category&quot;: &quot;Trazodone&quot;, &quot;content&quot;: &quot;Voltei a tomar trazodona pra dormir e estou sentindo muito efeito colateral, que o médico prometeu que não ia ter. Tontura, sensação de corpo pesado, dificuldade até pra andar, muito muito sono e o mais estranho: dores musculares (?).&quot;}|||{&quot;category&quot;: &quot;Trazodona&quot;, &quot;content&quot;: &quot;minha trazodona acabou vou me m&quot;}|||{&quot;category&quot;: &quot;Trazodone&quot;, &quot;content&quot;: &quot;Sabor delicioso quando o Trazodona começa a bater&quot;}|||{&quot;category&quot;: &quot;Amitriptyline&quot;, &quot;content&quot;: &quot;mds esse amitriptilina me dopou demais, qse q minha pressão vai de f tb&quot;}|||{&quot;category&quot;: &quot;Clomipramina&quot;, &quot;content&quot;: &quot;meu psiquiatra falou que clomipramina diminui o libido mas desde a hora que acordei hj só penso em sexo com o *&quot;}" />
