      <node id="Visão turva" label="Visão turva">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="9" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Igual te digo que la paroxetina, cuando me olvido de tomarla un día, me impide enfocar la vista (me tiemblan las pupilas) y me da una sensación de muerte inminente. Los antidepresivos son como las anticonceptivas: te olvidás de una pastilla y cag4ste (qué comparaba, no?)&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;amg quando faltava ou eu nao tomava a dose rapido minha visao ficava toda zoada eu ODEIO paroxetina\nmeu medico quer q eu saia do tarja preta nada mais dificil q isso\neu adoro tarja preta&quot;}, {&quot;category&quot;: &quot;Quetiapina&quot;, &quot;content&quot;: &quot;Grogue de quetiapina + mirtazapina e com uma colica do cacete to vendo tudi embacado com um olho so&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Grogue de quetiapina + mirtazapina e com uma colica do cacete to vendo tudi embacado com um olho so&quot;}, {&quot;category&quot;: &quot;Trazodona&quot;, &quot;content&quot;: &quot;tomei 1 trazodona e ja to enxergandk torto espero que fudo jsso tenha sido um pesadelo twitter nunca acabou&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;por enquanto o único efeito colateral que sinto da desvenlafaxina é o olho embaçando. mas é o menor dos males considerando que a sertralina tinha sugado minha vontade de viver&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;tive memórias d guerra de quando eu tava com a vitamina d baixa e eu nao podia levantar q ja tava com a vista bugada mas isso de hoje o culpado eh o amitriptilina&quot;}, {&quot;category&quot;: &quot;Clomipramina&quot;, &quot;content&quot;: &quot;eu tomo ele de manhã e tomo clomipramina a noite. eu tive alguns efeitos chatos com tremor de mão e vista embaçada, mas foi só no primeiro mês e depois foi bem de boa. só que eu não sou um bom exemplo porque eu já me dei de cara com o remédio rs&quot;}, {&quot;category&quot;: &quot;Nortriptilina&quot;, &quot;content&quot;: &quot;te falar q fiz tomando 150mg de nortriptilina dai tava c a pressao do nervo optico la na puta que pariu e fiz praticamente as cegas&quot;}]" />
          <attvalue for="3" value="8" />
          <attvalue for="4" value="1" />
          <attvalue for="5" value="3.181508 1.858551" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
      <node id="Ataques de pânico" label="Ataques de pânico">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="10" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Igual te digo que la paroxetina, cuando me olvido de tomarla un día, me impide enfocar la vista (me tiemblan las pupilas) y me da una sensación de muerte inminente. Los antidepresivos son como las anticonceptivas: te olvidás de una pastilla y cag4ste (qué comparaba, no?)&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Cloridrato de Paroxetina\nAntes de te ajudar ele te humilha.\nComecei a tomar hoje..  já tive quatro crises de pânico. \nQue infernoo&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;io ogni tanto ci provo a calare la paroxetina ma poi puntualmente mi vengono sti attacchi e niente\nviva la chimica!!&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;Aff eu alucinei com sertralina e propanolol juntos no começo eu tive ataque de pânico depois rachei o bico, o melhor foi meus pais achando q eu tinha usado alguma droga 🤡&quot;}, {&quot;category&quot;: &quot;Propranolol&quot;, &quot;content&quot;: &quot;Aff eu alucinei com sertralina e propanolol juntos no começo eu tive ataque de pânico depois rachei o bico, o melhor foi meus pais achando q eu tinha usado alguma droga 🤡&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;+ eu uso sertralina faz um bom tempo então minha ansiedade está controlada, e por causa da bupropiona as vezes começo a sentir um início de uma crise (peito doendo, início de falta de ar) sem motivo nenhum, mas meu lado controlado pela sertralina +&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;É engraçado usar bupropiona com sertralina ao mesmo tempo pq a bupropiona mexe com os neurotransmissores da noradrenalina, o que normalmente causa crises em quem tem ansiedade +&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;na boa é muito brutal a tontura causada pela falta de Venlafaxina\n\nontem eu esqueci de tomar o medicamento e agora a sensação é de que vou morrer a qualquer momento&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Maluco\nPrimeira hora depois de tomar venlafaxina pela primeira vez pensei que ia morrer&quot;}, {&quot;category&quot;: &quot;Ritalina&quot;, &quot;content&quot;: &quot;eu tava arregando aqui do amitriptilina por causa do sono e vendo se dava pra colocar atentah pq eu não me dei com nenhuma medicação pra TDAH com ritalina no meio. Concerta não consertou NADA e ritalina com 3 semanas culminou em crise de pânico e tentativa de s**. agora tô passada com essa info...&quot;}]" />
          <attvalue for="3" value="6" />
          <attvalue for="4" value="62" />
          <attvalue for="5" value="2.605289 3.823787" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
