      <node id="Ritalin" label="Ritalin">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="3" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;É interessante pq às vezes a Fluoxetina, no meu caso, parece que piora as características do TDAH. Mas se eu errar na dose da ritalina aumenta a ansiedade, é uma delícia! 😅&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;é, se tem coisa emocional n tem remedio no mundo q resolva\n\ntomo nortriptilina, bupropiona, divalproato, lurasidona, rivs e cabei de trocar a rita por aquela atomoxetina e eu to odiando mas perco a mao qdo tenho acesso a ritalina entao acho q por enquanto vai se isso&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;eu tava arregando aqui do amitriptilina por causa do sono e vendo se dava pra colocar atentah pq eu não me dei com nenhuma medicação pra TDAH com ritalina no meio. Concerta não consertou NADA e ritalina com 3 semanas culminou em crise de pânico e tentativa de s**. agora tô passada com essa info...&quot;}" />
          <attvalue for="3" value="2" />
