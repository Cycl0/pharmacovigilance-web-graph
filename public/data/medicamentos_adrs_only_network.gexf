      <node id="Desvenlafaxin" label="Desvenlafaxin">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="3" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;eu quero parar de tomar desvenlafaxina e tomar calmyn&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;Tomo desvenlafaxina para depressão e não sinto efeitos colaterais, exceto se passar mais de um dia sem tomar, aí vem uma crise de retirada intensa. Já tentei parar de tomar como \&quot;teste\&quot; para ver como ficaria sem e não aguentei mais de 3 dias devido à crise de retirada que deixou muito disfuncional.&quot;}|||{&quot;category&quot;: &quot;Headache&quot;, &quot;content&quot;: &quot;A desvenlafaxina devia me deixar feliz, ao invés disso só me da dor de cabeça vsf&quot;}" />
