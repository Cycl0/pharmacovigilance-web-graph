      <node id="Alprazolam" label="Alprazolam">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="4" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Toxicidade&quot;, &quot;content&quot;: &quot;Today In 2018 The Los Angeles County Medical Examiner announced that Tom Petty had died accidentally from mixed drug toxicity, a combination of fentanyl, oxycodone, acetyl fentanyl and despropionyl fentanyl (all opioids); temazepam and alprazolam (both sedatives); and citalopram (an antidepressant).&quot;}, {&quot;category&quot;: &quot;Pesadelos&quot;, &quot;content&quot;: &quot;2° dia sem cigarro, 1° dia da desvenlafaxina, 5° dia da bupropiona, dormindo à base de alprazolam, tive um dos piores pesadelos da minha vida. minha casa estava sendo invadida e eu sabia que não estava acordada, mas não parecia um sonho, parecia uma alucinação. acordei com a minha própria voz.&quot;}, {&quot;category&quot;: &quot;Alucinação&quot;, &quot;content&quot;: &quot;2° dia sem cigarro, 1° dia da desvenlafaxina, 5° dia da bupropiona, dormindo à base de alprazolam, tive um dos piores pesadelos da minha vida. minha casa estava sendo invadida e eu sabia que não estava acordada, mas não parecia um sonho, parecia uma alucinação. acordei com a minha própria voz.&quot;}, {&quot;category&quot;: &quot;Mal-estar&quot;, &quot;content&quot;: &quot;conheço o quetiapina pq minha irmã toma junto com o litio, eu não to podendo tomar psicoestimulador pq to tratando a insonia e o tag primeiro. por hora to tomando o trazodona pq meu psiq foi um anjo! tomava antes escitalopram e alprazolam pra dormir, mas passava muito mal com eles&quot;}]" />
          <attvalue for="3" value="4" />
          <attvalue for="4" value="5" />
          <attvalue for="5" value="3.663692 -1.027434" />
          <attvalue for="6" value="#2DCD9F" />
