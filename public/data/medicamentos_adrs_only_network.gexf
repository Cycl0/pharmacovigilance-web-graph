      <node id="Tolerância medicamentosa" label="Tolerância medicamentosa">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="3" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;La sedición es habitual con la mirtazapina, pero se puede empezar a hacer tolerancia a partir de la primera semana de tratamiento. Intenta aguantar unos días, es un antidepresivo muy seguro&quot;}, {&quot;category&quot;: &quot;Rivotril&quot;, &quot;content&quot;: &quot;Que tristezaaa\nRivotril perde o efeito com o tempo\nEu uso trazodona (q é um antidepressivo e dá soninho)&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Eu tomava venlafaxina, é de boinha tb, mas já é algo, se vc toma há mt tempo tb já aumwnta a resistência \nKKKKKKKKKKKDNWKAKWNFD EH UMA BOA HIPÓTESE&quot;}]" />
          <attvalue for="3" value="3" />
