          <attvalue for="4" value="17" />
          <attvalue for="5" value="1.933920 -0.904568" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
      <node id="Lorazepam" label="Lorazepam">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="3" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;-Te cambio la Paroxetina por Lorazepam.\n-Empecé por Lorezepam y sé que mi doctora puso en el informe que el cambio es por somnolencia y pérdida de reflejos. Yo vengo con miedo a que me maten trabajando. De múltiples formas. Debo estar híper vigilante.&quot;}|||{&quot;category&quot;: &quot;Perda de reflexos&quot;, &quot;content&quot;: &quot;-Te cambio la Paroxetina por Lorazepam.\n-Empecé por Lorezepam y sé que mi doctora puso en el informe que el cambio es por somnolencia y pérdida de reflejos. Yo vengo con miedo a que me maten trabajando. De múltiples formas. Debo estar híper vigilante.&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;Tomo drogas de forma recreativa. Diazepam, Lorazepam, Mirtazapina, Melatonina y Doxilamina. Porque para mí dormir del tirón del Tirol es algo muy recreativo.&quot;}" />
          <attvalue for="3" value="3" />
          <attvalue for="4" value="10" />
          <attvalue for="5" value="3.712621 -2.380894" />
          <attvalue for="6" value="#2DCD9F" />
        </attvalues>
      </node>
