          <attvalue for="1" value="2" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Já misturei escitalopram, e dipirona e uns outros 2 remédios que não lembro, deu um total de 60 comprimidos, tipo eu só fiquei 1 semana internada, e tive parada cardíaca, mas NN morri PTQP ;-;&quot;}, {&quot;category&quot;: &quot;Dipirona&quot;, &quot;content&quot;: &quot;Já misturei escitalopram, e dipirona e uns outros 2 remédios que não lembro, deu um total de 60 comprimidos, tipo eu só fiquei 1 semana internada, e tive parada cardíaca, mas NN morri PTQP ;-;&quot;}]" />
