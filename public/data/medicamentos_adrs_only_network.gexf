          <attvalue for="2" value="{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Mood.\n\nTakes me twice as much effort to cum these days (citalopram)&quot;}|||{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Wonder what would happen if I boofed a citalopram&quot;}|||{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;the universal experience of not being able to cum on escitalopram&quot;}|||{&quot;category&quot;: &quot;Bupropion&quot;, &quot;content&quot;: &quot;Eu pedi pra experimentar a bupropiona exatamente por isso, e o que ela me deu foi disfunção erétil 😭&quot;}|||{&quot;category&quot;: &quot;Bupropion&quot;, &quot;content&quot;: &quot;O antdepressivo Bupropiona, tá escrito que como vasodilatador e com efeitos secundários de uma \&quot;ereção prolongada\&quot; ou \&quot;maior perfomance sexual\&quot;, na própria bula.\n\nTinha que então vender com o slogan:\n\&quot;A vida é dura, mas seja mais duro que a vida!\&quot;&quot;}" />
