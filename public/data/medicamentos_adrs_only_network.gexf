      <node id="Desregulação emocional" label="Desregulação emocional">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="9" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Drei weitere interessante Fakten:\n\nDie Wirkung von Citalopram kann bei manchen Menschen mit Depressionen nur auf einem Placeboeffekt beruhen.\n\nZu Beginn der Einnahme kann das Suizidrisiko bei jüngeren Menschen steigen, weshalb engmaschige...\n#DerApotheker 🥷 2&quot;}|||{&quot;category&quot;: &quot;Bupropion&quot;, &quot;content&quot;: &quot;gnt descobri q eu não sou louca!!!\n\nvi um monte de mulher no tiktok dizendo q qdo começou a tomar bupropiona (q eu tomo) virou ninfomaniaca e vive com tesao&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxine&quot;, &quot;content&quot;: &quot;se a falta de desvenlafaxina faz com que eu sinta morte tomar então uma cartela inteira vai fazer eu me sentir viva ou me matar de vez?&quot;}|||{&quot;category&quot;: &quot;Duloxetin&quot;, &quot;content&quot;: &quot;Eu tomava duloxetina e agora mudei pra o escitalopram, a libido foi pro ralo e eu só agradeço a Deus porque tenho compulsão sexual por conta do tdah e o Venvanse só não segurava e a duloxetina potencializava a anfetamina me deixando maníaco, obg esc kkkkkk&quot;}|||{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Eu tomava duloxetina e agora mudei pra o escitalopram, a libido foi pro ralo e eu só agradeço a Deus porque tenho compulsão sexual por conta do tdah e o Venvanse só não segurava e a duloxetina potencializava a anfetamina me deixando maníaco, obg esc kkkkkk&quot;}|||{&quot;category&quot;: &quot;Venvanse&quot;, &quot;content&quot;: &quot;Eu tomava duloxetina e agora mudei pra o escitalopram, a libido foi pro ralo e eu só agradeço a Deus porque tenho compulsão sexual por conta do tdah e o Venvanse só não segurava e a duloxetina potencializava a anfetamina me deixando maníaco, obg esc kkkkkk&quot;}|||{&quot;category&quot;: &quot;Clomipramina&quot;, &quot;content&quot;: &quot;meu psiquiatra falou que clomipramina diminui o libido mas desde a hora que acordei hj só penso em sexo com o *&quot;}|||{&quot;category&quot;: &quot;Nortriptilina&quot;, &quot;content&quot;: &quot;E daí é isso, crise de choro hoje, por qual motivo não sei, mas com o desbalanço emocional grátis causado por nortriptilina+ clorpromazina pq é isso q a neurologista escolheu pra usar pra eu sair desse estado porém essa combi tá estranho na minha mente&quot;}|||{&quot;category&quot;: &quot;Clorpromazina&quot;, &quot;content&quot;: &quot;E daí é isso, crise de choro hoje, por qual motivo não sei, mas com o desbalanço emocional grátis causado por nortriptilina+ clorpromazina pq é isso q a neurologista escolheu pra usar pra eu sair desse estado porém essa combi tá estranho na minha mente&quot;}" />
