      <node id="Refluxo" label="Refluxo">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="2" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Fluvoxamina&quot;, &quot;content&quot;: &quot;Eu fiquei quase 1 ano com refluxo e azia também, por conta de efeito colateral de um remédio que eu tomava (fluvoxamina), destruiu meu estômago, e depois de meses de desmame, 90% dele sarou completamente\n\nTalvez você esteja tomando um remédio que não te faça bem?&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Não ingeri nem mil calorias hoje e não é desse jeito q eu queria fazer uma dieta, foi cerca de só 19 gramas de proteína pq tudo está me dando refluxo. cloridrato de paroxetina me destruiu até na hora do desmame, que ódio&quot;}]" />
          <attvalue for="3" value="2" />
          <attvalue for="4" value="8" />
