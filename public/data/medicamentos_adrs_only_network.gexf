          <attvalue for="2" value="[{&quot;category&quot;: &quot;Fluoxetina&quot;, &quot;content&quot;: &quot;Eu tomei uns 4 dias de fluoxetina e nos 4 eu senti uma paranoia imensa e uma vontade de me matar tenebrosa q eu nunca tinha sentido antes eu tava miseravel pra um caralho daí eu parei\nAgora eu voltei pra sertralina, era p eu ter voltado semana passada mas o caps fechou no feriadao e eu tive episódio&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;efeitos da falta de venlafaxina hoje: sensação de desmaio, irritabilidade, paranoia&quot;}, {&quot;category&quot;: &quot;Metilfenidato&quot;, &quot;content&quot;: &quot;É muito engraçado como o cérebro do tdah precisa de anfetamina pra funcionar normalmente (o meu pelo menos) enquanto os neurotípicos se tomam o metilfenidato ficam tudo nóia kkkkkkkkkkkkkkkkk&quot;}, {&quot;category&quot;: &quot;Antidepressivos&quot;, &quot;content&quot;: &quot;Antidepressivos típicos não funcionam em mim, já falei isso até pro psi antigo. Eu me sentia mais ansioso, com mais dificuldade pra dormir e até um pouco paranoico.\n\naté por isso ando vendo a questão da agomelatina&quot;}]" />
          <attvalue for="3" value="4" />
          <attvalue for="4" value="0" />
          <attvalue for="5" value="1.062132 2.716825" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
      <node id="Aumentou o colesterol" label="Aumentou o colesterol">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="1" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;A mí la sertralina me subió el colesterol 110 puntos en 3 meses, de un estado saludable a estado de peligro, pedí que me lo cambiarán y ahora estoy con brintellix.\n\nTambién probé la fluoxetina pero los efectos secundarios de esa son un putadon y fue cuando cambié a sertralina&quot;}]" />
          <attvalue for="3" value="1" />
          <attvalue for="4" value="0" />
          <attvalue for="5" value="4.932789 -0.330744" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
      <node id="Ideação suicida" label="Ideação suicida">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="2" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Fluoxetina&quot;, &quot;content&quot;: &quot;Es muy loco que me dieran fluoxetina (Prozac) y que la señora que me dio la dosis del mes desde la EPS me pasó un papelito que decía algo así como: “efectos secundarios: suicidio, intento de suicidio, ideación suicida, pensamientos suicidas, etc” y tuve ganas de matarme en serio. Logré volver a la u&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;a medica falando q a bupropiona me faria emagrecer aí eu falei q tinha ideacao suicida e ela disse q era contraindicado nesse sentido mas q \&quot;nao dava p resolver tudo\&quot;.. pensando nisso&quot;}]" />
          <attvalue for="3" value="2" />
          <attvalue for="4" value="0" />
          <attvalue for="5" value="-0.360741 1.826764" />
          <attvalue for="6" value="#E9573F" />
