      <node id="Enxaqueca" label="Enxaqueca">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="8" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;I likely have PMDD now (I feel like escitalopram for a year made it worse, like migraines) I haven't got dxed, as well as PCOS I finally did years later and it just didn't help recently.&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;com aumento de dose da sertralina, a crise de enxaqueca volta 😭&quot;}, {&quot;category&quot;: &quot;Depakene&quot;, &quot;content&quot;: &quot;Tenho me sentido tão mal ultimamente que meu psiquiatra aumentou mais um remédio pra eu fazer uso. 4 comprimidos de manhã da venlafaxina+ 1 comprimido a noite de mirtazapina e agora 1 comprimido de depakene... tem acontecido tanta coisa que tenho pra piorar sentido muita enxaqueca...&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;olá eu sou a enxaqueca da desvenlafaxina atrasada, sua amiguinha&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;nao apenas isso mas eu ia durar 24h ia morrer de enjoo e enxaqueca de abstinencia de venlafaxina&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Deixei de tomar a venlafaxina ontem de noite pra começar a tomar de manhã e esqueci hoje porque acordei atrasada pra atender e agora ACABEI com minha semana porque se eu tomar a essa hora eu perco o sono e se esperar até amanhã eu vou começar o mês com a maior enxaqueca e mau humor já vistos 🕊️&quot;}, {&quot;category&quot;: &quot;Metilfenidato&quot;, &quot;content&quot;: &quot;aí é bem ruim :(( que pena que não se adaptou\nme ajudou mt\neu tentei com metilfenidato e não deu nada certo, tive a pior enxaqueca da minha vida&quot;}, {&quot;category&quot;: &quot;Metilfenidato&quot;, &quot;content&quot;: &quot;hoje não tomei o metilfenidato porque acho que tá me dando enxaqueca mas aí tou feito barata tonta tentando ser produtivo fazendo tudo de forma desorganizada&quot;}]" />
          <attvalue for="3" value="6" />
          <attvalue for="4" value="3" />
          <attvalue for="5" value="3.486880 1.129398" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
      <node id="Febre" label="Febre">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="1" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Escitalopram é ótimo, mas sair dele tá me humilhando bastante. Febre, choques dentro do cérebro, zumbido no ouvido…&quot;}]" />
          <attvalue for="3" value="1" />
