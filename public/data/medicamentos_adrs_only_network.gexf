          <attvalue for="0" value="medication" />
          <attvalue for="1" value="2" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Labilidade emocional&quot;, &quot;content&quot;: &quot;E daí é isso, crise de choro hoje, por qual motivo não sei, mas com o desbalanço emocional grátis causado por nortriptilina+ clorpromazina pq é isso q a neurologista escolheu pra usar pra eu sair desse estado porém essa combi tá estranho na minha mente&quot;}, {&quot;category&quot;: &quot;Desregulação emocional&quot;, &quot;content&quot;: &quot;E daí é isso, crise de choro hoje, por qual motivo não sei, mas com o desbalanço emocional grátis causado por nortriptilina+ clorpromazina pq é isso q a neurologista escolheu pra usar pra eu sair desse estado porém essa combi tá estranho na minha mente&quot;}]" />
