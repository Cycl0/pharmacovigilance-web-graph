      <node id="Enxaqueca" label="Enxaqueca">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="14" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Tenho me sentido tão mal ultimamente que meu psiquiatra aumentou mais um remédio pra eu fazer uso. 4 comprimidos de manhã da venlafaxina+ 1 comprimido a noite de mirtazapina e agora 1 comprimido de depakene... tem acontecido tanta coisa que tenho pra piorar sentido muita enxaqueca...&quot;}|||{&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Tenho me sentido tão mal ultimamente que meu psiquiatra aumentou mais um remédio pra eu fazer uso. 4 comprimidos de manhã da venlafaxina+ 1 comprimido a noite de mirtazapina e agora 1 comprimido de depakene... tem acontecido tanta coisa que tenho pra piorar sentido muita enxaqueca...&quot;}|||{&quot;category&quot;: &quot;Depakene&quot;, &quot;content&quot;: &quot;Tenho me sentido tão mal ultimamente que meu psiquiatra aumentou mais um remédio pra eu fazer uso. 4 comprimidos de manhã da venlafaxina+ 1 comprimido a noite de mirtazapina e agora 1 comprimido de depakene... tem acontecido tanta coisa que tenho pra piorar sentido muita enxaqueca...&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;eu tomo desvenlafaxina vai fazer uns 5 anos, foi o que deu uma segurada durante a pandemia, junto com a terapia\n\n&lt;&lt;&lt;PORÉM&gt;&gt;&gt;\n\ncacete, esquecer desse remédio de manhã, na hora do almoço eu já tô dando pinote de enxaqueca + tontura e enjoo\n\no remédio bom pra quem esquece, cê aprende a tomar na marra&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Minha cabeça já tá toda errada pela falta da desvenlafaxina, aí esse cheiro de cinzeiro humanoide ainda fica me seguindo.. \nVou acabar com enxaqueca.&quot;}|||{&quot;category&quot;: &quot;Duloxetine&quot;, &quot;content&quot;: &quot;minha enxaqueca voltando com tudo desde que parei com a duloxetina&quot;}|||{&quot;category&quot;: &quot;Venlafaxine&quot;, &quot;content&quot;: &quot;nao apenas isso mas eu ia durar 24h ia morrer de enjoo e enxaqueca de abstinencia de venlafaxina&quot;}|||{&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Deixei de tomar a venlafaxina ontem de noite pra começar a tomar de manhã e esqueci hoje porque acordei atrasada pra atender e agora ACABEI com minha semana porque se eu tomar a essa hora eu perco o sono e se esperar até amanhã eu vou começar o mês com a maior enxaqueca e mau humor já vistos 🕊️&quot;}|||{&quot;category&quot;: &quot;Amitriptyline&quot;, &quot;content&quot;: &quot;Alguém q toma amitriptilina aí?\n \nTomo há uns 3 meses 25mg por conta da enxaqueca braba q tava tendo, e tenho TAG crônica + depressão, aí minha psiquiatra tb receitou clonazepam 2mg\nEla receitou 1 mês atrás carbolítio e não deu certo, tive intoxicação, passei muito mal por uma semana, aí parei+&quot;}|||{&quot;category&quot;: &quot;Clomipramina&quot;, &quot;content&quot;: &quot;meu psiquiatra falou que clomipramina diminui o libido mas desde a hora que acordei hj só penso em sexo com o *&quot;}|||{&quot;category&quot;: &quot;Nortriptyline&quot;, &quot;content&quot;: &quot;neurologista pq o remédio do psiquiatra me dá enxaqueca pelo menos 1x por semana mesmo tomando nortriptilina pra evitar enxaqueca ♥️\n\nai ele virou pra mim e disse \&quot;vc aumentou a dose faz só 1 semana, espere 2 meses e volte\&quot; e assim foram meus 500 reais pq retorno grátis eh só até 30 dias&quot;}|||{&quot;category&quot;: &quot;Nortriptilina&quot;, &quot;content&quot;: &quot;pensando seriamente em trocar a nortriptilina por propanolol no controle da enxaqueca porque ta insustentável&quot;}|||{&quot;category&quot;: &quot;Propanolol&quot;, &quot;content&quot;: &quot;pensando seriamente em trocar a nortriptilina por propanolol no controle da enxaqueca porque ta insustentável&quot;}|||{&quot;category&quot;: &quot;Methylphenidate&quot;, &quot;content&quot;: &quot;aí é bem ruim :(( que pena que não se adaptou\nme ajudou mt\neu tentei com metilfenidato e não deu nada certo, tive a pior enxaqueca da minha vida&quot;}" />
          <attvalue for="3" value="12" />
          <attvalue for="4" value="45" />
          <attvalue for="5" value="2.474557 3.424462" />
          <attvalue for="6" value="#E9573F" />
