      <node id="Gabapentina" label="Gabapentina">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="1" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;topiramato e bupropiona eu preciso pq a fibromialgia engorda e medicamentos como mirtazapina e gabapentina, engordam, mas não posso me livrar delas por serem eficazes. atomoxetina pro tdah é boa, melhor que a dependência da ritalina. acho que vou tirar a lamotrigina. se precisar, jogo um valproato.&quot;}]" />
