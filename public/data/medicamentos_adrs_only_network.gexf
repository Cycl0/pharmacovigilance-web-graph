      <node id="Aumento da libido" label="Aumento da libido">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="5" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;1 mês sem fumar. Remanejando minha fase oral mal trabalhada com auxílio da bupropiona cujo efeito colateral é aumento da libido AND no período fértil. Calcule...&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;vcs falando que antidepressivo tira sensibilidade certamente nunca sentiram o tesão cavalar de uma bupropiona 300mg lamento&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;gnt descobri q eu não sou louca!!!\n\nvi um monte de mulher no tiktok dizendo q qdo começou a tomar bupropiona (q eu tomo) virou ninfomaniaca e vive com tesao&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;bupropiona é tesão de vaca credenciado por laboratório&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;Estranho, eu tomava fluoxetina com amitriptilina e tinha o tesão de um cavalo. Kkkk&quot;}]" />
