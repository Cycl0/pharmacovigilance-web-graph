      <node id="cope" label="cope">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="2" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Desregulação emocional&quot;, &quot;content&quot;: &quot;Eu fiz tratamento com ela durante anos, na época me ajudou muito, mas os efeitos colaterais são péssimos mesmo, agora eu troquei pelo paroxetina&quot;}, {&quot;category&quot;: &quot;SobParoxetina&quot;, &quot;content&quot;: &quot;Eu fiz tratamento com ela durante anos, na época me ajudou muito, mas os efeitos colaterais são péssimos mesmo, agora eu troquei pelo paroxetina&quot;}]" />
