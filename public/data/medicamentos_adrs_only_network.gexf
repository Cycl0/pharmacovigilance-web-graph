      <node id="Dor" label="Dor">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="5" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Sertraline&quot;, &quot;content&quot;: &quot;Which ones, if you don't mind me asking? Citalopram gave me goldfish memory for a year, until I switched to Sertraline which just gave me occasionally vertigo instead.&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;ontem tive uma das piores crises da minha vida pois além de estar com uma desmentidura que me deixou todo quebrado com febre e dor ainda tava sofrendo de abstinência de desvenlafaxina pq tentei parar e n deu certo.\n\njá me puxei e mais tarde vou passar na bemol pra comprar essa droga de remédio&quot;}|||{&quot;category&quot;: &quot;Amitriptyline&quot;, &quot;content&quot;: &quot;tirei a amitriptilina e todo o meu corpo voltou a doer quem diria que eu tava novamente com a sindrome de impostor falando q eu n tenho nada (nao consigo andar sem me cansar)&quot;}|||{&quot;category&quot;: &quot;Methylphenidate&quot;, &quot;content&quot;: &quot;traz meu metilfenidato prefeitura, por favor, eu já tô ficando dodói de novo&quot;}|||{&quot;category&quot;: &quot;Lidocaína&quot;, &quot;content&quot;: &quot;Sentindo o treino nas paleta... Tudo doi — principalmente as panturrilhas. E eu ainda ia na aula de dança, acabei ficando porque ainda tava meio tontinha da lidocaína com cetamina que fiz na médica da dor.&quot;}" />
