          <attvalue for="0" value="medication" />
          <attvalue for="1" value="2" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Quetiapina&quot;, &quot;content&quot;: &quot;surtei de vez mas as coisas começaram a dar certo pra na minha vida me encontrei artisticamente então foda-se um parabéns a todos os surtados do brasil e\num beijo aos usuários de quetiapina, fluoxetina e clonazepam&quot;}|||{&quot;category&quot;: &quot;anax&quot;, &quot;content&quot;: &quot;xanax, clonazepam, trazodona, quetiapina e fluoxetina&quot;}" />
          <attvalue for="3" value="30" />
