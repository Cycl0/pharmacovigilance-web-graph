      <node id="Lamotrigina" label="Lamotrigina">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="7" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Embotamento emocional&quot;, &quot;content&quot;: &quot;Always so interesting to hear how people have such different reactions to different medications! I started on citalopram for depression, then the lamotrigine came in after my bp diagnosis. kind of made me feel like a zombie though, I’m not sure why. just hazy and like I wasn’t really there&quot;}, {&quot;category&quot;: &quot;Comprometimento cognitivo&quot;, &quot;content&quot;: &quot;Always so interesting to hear how people have such different reactions to different medications! I started on citalopram for depression, then the lamotrigine came in after my bp diagnosis. kind of made me feel like a zombie though, I’m not sure why. just hazy and like I wasn’t really there&quot;}, {&quot;category&quot;: &quot;Despersonalização&quot;, &quot;content&quot;: &quot;Always so interesting to hear how people have such different reactions to different medications! I started on citalopram for depression, then the lamotrigine came in after my bp diagnosis. kind of made me feel like a zombie though, I’m not sure why. just hazy and like I wasn’t really there&quot;}, {&quot;category&quot;: &quot;Mal-estar&quot;, &quot;content&quot;: &quot;WUAJAJAJSJAJ AYER ME SENTÍ COMO EL HOYO DESPUÉS DE TOMARME LA LAMOTRIGINA Y HOY CACHE QUE ME EQUIVOQUÉ Y ERA PAROXETINA WAAAAJDJAHSJWYEUWHEJW que aweonao ven x eso me recetaron lisdexamfetamina&quot;}, {&quot;category&quot;: &quot;Dano hepático&quot;, &quot;content&quot;: &quot;Lamotrigina (tive que parar pq atacou o fígado), aripiprazol e bupropiona&quot;}, {&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;soi diagnosticada com bipolaridade, borderline, depressão e ansiedade generalizada, e tomo bupropiona, trazodona, buspirona e lamotrigina 🙏 pelo oq eu pesquisei n dá ganho de peso mas se vcs souberem que algum engorda me digam pfvr / eu antes e depois mas meu menor peso ainda foi fucking 65kg&quot;}, {&quot;category&quot;: &quot;Sedação&quot;, &quot;content&quot;: &quot;eu o dia todo dopada de escitalopram lamotrigina trazodona rivotril nicotina cafeína e nada me ajuda nessa porra&quot;}]" />
