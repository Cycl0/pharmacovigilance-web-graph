          <attvalue for="2" value="[{&quot;category&quot;: &quot;*   Estado confusional (Estado confusional)\n    *   Agitação (Agitação)\n    *   Labilidade emocional (Labilidade emocional)\n    *   Desregulação emocional (Desregulação emocional)\n    *   Estado confusional (Estado confusional)Citalopram&quot;, &quot;content&quot;: &quot;I met Martin from Homes Under The Hammer at a work event. He was very drunk and I was on my first week of Citalopram and all over the place. He didn’t like being called Dion Dublin for lols&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Completamente chapado de paroxetina&quot;}, {&quot;category&quot;: &quot;Trazodona&quot;, &quot;content&quot;: &quot;Não era nada MT pesado, eu tomei trazodona uma época e um outro que eu não lembro o nome, mas eu só acordava c uns flashs de SLA saindo pra praça, fumar um cigarro c uns noia e voltar p casa&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Pois é, no meu caso é a desvenlafaxina e a abstinência dela é brutal, eu fico biruta&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;monas esqueci de tomar minha desvenlafaxina ONTEM E HOJE agora estou fora de casa e me sentindo a Elizabeth sem a substância totalmente drogada&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Pior qdo isso acontece com a minha Venlafaxina. Se eu não tomar eu morro se tomar dose dobrada fico chapada&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;O amitriptilina não tá ajudando em porra nenhuma na hora de dormir mas eu tô com muita dificuldade pra acordar e ainda fico umas 2 horas meio abublé&quot;}]" />
          <attvalue for="3" value="6" />
          <attvalue for="4" value="3" />
          <attvalue for="5" value="1.522693 0.239193" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
