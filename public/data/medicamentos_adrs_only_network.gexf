      <node id="Constipação" label="Constipação">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="5" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;Não tomar bupropiona: morrer de ansiedade\n\nTomar bupropiona: não cagar nunca mais.\n\nDifícil dilema...&quot;}, {&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Tomo venlafaxina e ela me deixa entupida ao cubo. Alguém já passou por isso?&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;pelo amor de deus o amitriptilina de 25mg n deixava eu fazer xixi e agora o de 10mg nao deixa eu fazer coco q putaria do caralho eh essa to tendo q tomar suplemento p ir no banheiro&quot;}, {&quot;category&quot;: &quot;Clomipramina&quot;, &quot;content&quot;: &quot;entao é mt feio parece q vc ta bebendo a propria merda!! eu tava tomando clomipramina e tava me ressecando dmssssssss&quot;}, {&quot;category&quot;: &quot;Nortriptilina&quot;, &quot;content&quot;: &quot;dps que eu passei a tomar desvenlafaxina meu intestino voltou ao normal e agr eu consigo ir no banheiro todo dia 😸 já amo mais que a cachorra da nortriptilina que me deu taquicardia e eu ficava 1 semana sem c4g4r&quot;}]" />
