      <node id="Tremores" label="Tremores">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="27" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Esqueci de tomar meu escitalopram hj daí chega final do dia eu tô como? Isso mesmo tremendo mais que um pincher&quot;}|||{&quot;category&quot;: &quot;Paroxetin&quot;, &quot;content&quot;: &quot;Igual te digo que la paroxetina, cuando me olvido de tomarla un día, me impide enfocar la vista (me tiemblan las pupilas) y me da una sensación de muerte inminente. Los antidepresivos son como las anticonceptivas: te olvidás de una pastilla y cag4ste (qué comparaba, no?)&quot;}|||{&quot;category&quot;: &quot;Paroxetine&quot;, &quot;content&quot;: &quot;eu to tomando Paxil(Paroxetina) e Seroquel (Quetiapina), vei meu corpo todo treme, parece que eu to doente, quais vc toma?&quot;}|||{&quot;category&quot;: &quot;Quetiapine&quot;, &quot;content&quot;: &quot;eu to tomando Paxil(Paroxetina) e Seroquel (Quetiapina), vei meu corpo todo treme, parece que eu to doente, quais vc toma?&quot;}|||{&quot;category&quot;: &quot;Bupropion&quot;, &quot;content&quot;: &quot;E me fode ridiculamente. É estar em um ótimo momento, feliz e \&quot;estável\&quot; que algo aqui dentro se ativa e vem me desestabilizar tentando fazer eu me sentir não merecedora de tudo isso. Mas eu sei que eu sou. Nem que eu coma bupropiona e selegilina eu vou passar pelos tremores e tensão e vou ir trampar&quot;}|||{&quot;category&quot;: &quot;Bupropion&quot;, &quot;content&quot;: &quot;já tomei bupropiona e as pessoas começaram a me falar pra consultar com neuro por causa da tremedeira&quot;}|||{&quot;category&quot;: &quot;Lítio&quot;, &quot;content&quot;: &quot;Eu não consigo parar pq a tremedeira do lítio e da bupropiona vai nas alturas, parece que estou misturando um milk-shake&quot;}|||{&quot;category&quot;: &quot;Bupropion&quot;, &quot;content&quot;: &quot;Eu não consigo parar pq a tremedeira do lítio e da bupropiona vai nas alturas, parece que estou misturando um milk-shake&quot;}|||{&quot;category&quot;: &quot;Bupropion&quot;, &quot;content&quot;: &quot;começou a tremedeira na mão pq coca cola (cafeina) + bupropiona 🫨&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Tomei desvenlafaxina e minha pernas começaram a tremer\n\nDevo me preocupar?&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxine&quot;, &quot;content&quot;: &quot;a mão de dizer \&quot;vamo voltar pra desvenlafaxina\&quot; chega a tremer 👋&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxine&quot;, &quot;content&quot;: &quot;DITO ISSO eu descobri que se eu tomo a desvenlafaxina mais cedo eu fico com menos tremelique da cafeína, então estou aos poucos lutando para resgatar meu direito ao segundo café&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Tô ctg na desvenlafaxina, mil vezes ela do que ficar sofrendo de tremores, calafrios e caganeira de ansiedade.&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxine&quot;, &quot;content&quot;: &quot;segundo dia sem desvenlafaxina e uma tremedeira incontrolável já me acometeu&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;tô tentando ao máximo fingir que não tô tendo uma crise, mas minhas mãos não mentem........... desvenlafaxina já me deixa normalmente tremendo, qd tô mal, piora&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;como eu ODEIO desvenlafaxina eu tomei ontem antes d dormir consegui dormir 3hrs só e to tremendo igual cachorro ate agora vsf&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxine&quot;, &quot;content&quot;: &quot;eu tomando desvenlafaxina\n\nqueria: disposição\ntenho: tremedeira dps de fzr exercício/esforço físico&quot;}|||{&quot;category&quot;: &quot;Duloxetine&quot;, &quot;content&quot;: &quot;O duloxetina tá me deixando assim\nHoje na feira eu não conseguia segurar nada sem tremer, tava torcendo pra ninguém perceber&quot;}|||{&quot;category&quot;: &quot;Venlafaxine&quot;, &quot;content&quot;: &quot;ᵈᶦᵃʳᶦᵒ ᵈᵉ ᵐᵉᵈᶦᶜᵃᶜᵃᵒ \nhoje não tomei o clonazepan, mas ainda fiquei com mto sono, não sei o pq, o venlafaxina me deu ansiedade, uma palpitação horrível, e não sei se vou tomar o lítio, ele tira um pouco do meu sono. queria inverter os dois remédios, tomar o lítio no almoço e o clonazepan no jantar :(&quot;}|||{&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;porra essa venlafaxina ta me dando MUITA tremedeira e uma dor no peito&quot;}|||{&quot;category&quot;: &quot;Fluoxetin&quot;, &quot;content&quot;: &quot;sim, eu tomo fluoxetina e amitriptilina, me dá tanto tremor que não consigo ter firmeza mas mãos KKKKKKKK&quot;}|||{&quot;category&quot;: &quot;Amitriptilin&quot;, &quot;content&quot;: &quot;sim, eu tomo fluoxetina e amitriptilina, me dá tanto tremor que não consigo ter firmeza mas mãos KKKKKKKK&quot;}|||{&quot;category&quot;: &quot;Clomipramine&quot;, &quot;content&quot;: &quot;chorando de frustração pq quero fazer uma coisa fofa mas minha mão fica tremendo por causa da clomipramina e aí tudo que eu desenho fica uma BOSTA&quot;}|||{&quot;category&quot;: &quot;Methylphenidate&quot;, &quot;content&quot;: &quot;galera acho que misturar energético, metilfenidato e nicotina começou a dar ruim, to tremendo \n\n(sim, eu sei que dá ruim e eu vou morrer. é o objetivo. o post é irônico. obg.)&quot;}|||{&quot;category&quot;: &quot;Nicotine&quot;, &quot;content&quot;: &quot;galera acho que misturar energético, metilfenidato e nicotina começou a dar ruim, to tremendo \n\n(sim, eu sei que dá ruim e eu vou morrer. é o objetivo. o post é irônico. obg.)&quot;}|||{&quot;category&quot;: &quot;Methylphenidate&quot;, &quot;content&quot;: &quot;lembrete: NUNCA tomar café quando eu for tomar metilfenidato, to tremendo aqui\nporra, o café demorou muito tempo pra funcionar, tomei meu remedio dps do almoço E AGR O CAFÉ FEZ EFEITO... PQP&quot;}|||{&quot;category&quot;: &quot;Methylphenidate&quot;, &quot;content&quot;: &quot;Só para vocês terem noção: o metilfenidato pode produzir intoxicação dopaminérgica e envelhecer/demanciar um cérebro de uma pessoa n-TDAH, mas pode gerar neurônios e fazê-loa se conectá-los com mais destreza em alguns autistas e na maioria dos TDAHs.&quot;}" />
