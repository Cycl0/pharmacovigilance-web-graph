      <node id="Desvenlafaxina" label="Desvenlafaxina">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="114" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;tomei: desvenlafaxina, zolpidem, rivotril\n\ntomo: escitalopram&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;antes eu tomava desvenlafaxina junto e nao sentia esse problema tanto assim, era bem facil de arrumar meu horario, eu acredito q seja do remedio pq eu n mudei nada alem de ter feito o desmame da desvenlafaxina e ter aumentado a dose da fluvoxamina&quot;}|||{&quot;category&quot;: &quot;Confusão&quot;, &quot;content&quot;: &quot;cara acabei de tomar meus remedios ne sendo que assim que engoli eles fiquei com uma sensação de que ja tinha tomado de manha e agr to achando que meti 200mg de desvenlafaxina e 600mg de bupropiona para dentro so hoje vei to com medo&quot;}|||{&quot;category&quot;: &quot;Trazodona&quot;, &quot;content&quot;: &quot;pelo menos o quetiapina é baratinho né galera tava dando uns 100 reais no desvenlafaxina+trazodona agora será só 55 🙏🏻&quot;}|||{&quot;category&quot;: &quot;Acne&quot;, &quot;content&quot;: &quot;as vezes o celular coloca foto minha da época que eu tomava desvenlafaxina e eu fico muito aterrorizada do quanto isso me dava acne, eu não me reconhecia no espelho&quot;}|||{&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;abstinência de desvenlafaxina é pior que chute no saco&quot;}|||{&quot;category&quot;: &quot;Angústia&quot;, &quot;content&quot;: &quot;to literalmente uma combinação de pinscher com pitbull esses dias resultado do desmame da desvenlafaxina + tpm + ódio de classe&quot;}|||{&quot;category&quot;: &quot;Anedonia&quot;, &quot;content&quot;: &quot;to literalmente uma combinação de pinscher com pitbull esses dias resultado do desmame da desvenlafaxina + tpm + ódio de classe&quot;}|||{&quot;category&quot;: &quot;Isolamento social&quot;, &quot;content&quot;: &quot;to literalmente uma combinação de pinscher com pitbull esses dias resultado do desmame da desvenlafaxina + tpm + ódio de classe&quot;}|||{&quot;category&quot;: &quot;Embotamento emocional&quot;, &quot;content&quot;: &quot;to literalmente uma combinação de pinscher com pitbull esses dias resultado do desmame da desvenlafaxina + tpm + ódio de classe&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;to literalmente uma combinação de pinscher com pitbull esses dias resultado do desmame da desvenlafaxina + tpm + ódio de classe&quot;}|||{&quot;category&quot;: &quot;Driedness&quot;, &quot;content&quot;: &quot;Comecei a ter o efeito colateral de boca seca da desvenlafaxina. Não tem água que eu beba que consiga manter meus lábios hidratados, que infernooooo.&quot;}|||{&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;meu deus acho que a desvenlafaxina ta me deixando enjoada, juro que to com uma sensação de nausea horrível 😭&quot;}|||{&quot;category&quot;: &quot;Apatia&quot;, &quot;content&quot;: &quot;nossa eu sinto que a desvenlafaxina resolveu arrombar as portas do meu cerebro e botar ordem pq DO NADA eu só consegui me reestabelecer e ai me deu uma fome absurda de hamburguer com batata e refri!!!!!!!&quot;}|||{&quot;category&quot;: &quot;Diarreia&quot;, &quot;content&quot;: &quot;Ontem esqueci de tomar a desvenlafaxina e hj estou em uma constante brisa de loló&quot;}|||{&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;Tomei desvenlafaxina e minha pernas começaram a tremer\n\nDevo me preocupar?&quot;}|||{&quot;category&quot;: &quot;Vômito&quot;, &quot;content&quot;: &quot;Me olvidé de tomar la desvenlafaxina porque día de locos y terminé vomitando antes de cenar. No tomen ese antidepresivo, es una trampa.&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Esperando ansiosamente a desvenlafaxina me deixar apática, sem tristeza, sem alegria, sem ansiedade, sem raiva, sem nada.&quot;}|||{&quot;category&quot;: &quot;Visão turva&quot;, &quot;content&quot;: &quot;manas realmente n da pra ficar um dia sequer sem a porra da desvenlafaxina jesus to vendo tudo dobrado&quot;}|||{&quot;category&quot;: &quot;Zumbido&quot;, &quot;content&quot;: &quot;Meio que eu vou ter que aceitar conviver com zumbido no ouvido. Desvenlafaxina inaugurou um lado e os eventos de rock vieram pra fechar o outro (isso eu usando protetores)&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;O dia todo passando mal, enjoo, dor de cabeça. Lembrei agora que esqueci de tomar minha desvenlafaxina. Ela tira toda a sua depressão e ansiedade, mas se esquecer de tomar um dia, a humilhação é grande, é pior que a pior das ressacas&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;eu tava pesquisando (como sempre) opções melhores pro meu tratamento pq as medicações atuais n tão funcionando e vi indicações positivas da associação do buspirona (ansitec) e desvenlafaxina pro meu caso. foi a primeira vez q li sobre o ansitec&quot;}|||{&quot;category&quot;: &quot;Fadiga&quot;, &quot;content&quot;: &quot;desvenlafaxina: fadiga excitada, letargia, vontade de morrer mas sem energia suficiente.&quot;}|||{&quot;category&quot;: &quot;Sedação&quot;, &quot;content&quot;: &quot;desvenlafaxina: fadiga excitada, letargia, vontade de morrer mas sem energia suficiente.&quot;}|||{&quot;category&quot;: &quot;Vertigem&quot;, &quot;content&quot;: &quot;tinha esquecido que além da enxaqueca a desvenlafaxina te dá uma leseira absurda quando você não toma ela no horário. agora tô aqui lutando pra realizar 1 unidade de sinapse atendendo&quot;}|||{&quot;category&quot;: &quot;Distúrbios respiratórios do sono&quot;, &quot;content&quot;: &quot;fiquei assim qndo tomava desvenlafaxina, cada sonho um roteiro de cinema e lembrava td&quot;}|||{&quot;category&quot;: &quot;Disfunção sexual&quot;, &quot;content&quot;: &quot;o que a desvenlafaxina não faz ninguém fará (diminuir minha libido)&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Mas vc toma medicação pra ansiedade tb???? Minha asma resolveu com alenia 2x por dia + bombinha de aerolin se precisasse, mas depois que comecei a desvenlafaxina uso pouquíssimo o alenia&quot;}|||{&quot;category&quot;: &quot;Asma&quot;, &quot;content&quot;: &quot;Mas vc toma medicação pra ansiedade tb???? Minha asma resolveu com alenia 2x por dia + bombinha de aerolin se precisasse, mas depois que comecei a desvenlafaxina uso pouquíssimo o alenia&quot;}|||{&quot;category&quot;: &quot;Alterações de libido&quot;, &quot;content&quot;: &quot;ai amg pior que os remedios acabam msm com a gnt. quando eu tomava desvenlafaxina eu ficava bem meh + sem libido total,,,&quot;}|||{&quot;category&quot;: &quot;Disforia&quot;, &quot;content&quot;: &quot;Si el fármaco pertenece a la familia de los IRSN como la venlafaxina, desvenlafaxina o la duloxetina es bastante normal que produzcan disforia si se interrumpe de golpe, aunque sean dos días. Los ISRS como la fluoxetina o el escitalopram toleran mucho mejor los despistes.&quot;}|||{&quot;category&quot;: &quot;Abstinência&quot;, &quot;content&quot;: &quot;Vou morrer de abstinência de desvenlafaxina jesus amado&quot;}|||{&quot;category&quot;: &quot;Calafrios&quot;, &quot;content&quot;: &quot;Nao aguento mais passar mal de calor, são tempos difíceis para as patricinhas*\n\n*neurodivergentes com sensibilidade ao calor que tomam desvenlafaxina e por tanto já sentem mais calor naturalmente&quot;}|||{&quot;category&quot;: &quot;Enxaqueca&quot;, &quot;content&quot;: &quot;eu tomo desvenlafaxina vai fazer uns 5 anos, foi o que deu uma segurada durante a pandemia, junto com a terapia\n\n&lt;&lt;&lt;PORÉM&gt;&gt;&gt;\n\ncacete, esquecer desse remédio de manhã, na hora do almoço eu já tô dando pinote de enxaqueca + tontura e enjoo\n\no remédio bom pra quem esquece, cê aprende a tomar na marra&quot;}|||{&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;eu tomo desvenlafaxina vai fazer uns 5 anos, foi o que deu uma segurada durante a pandemia, junto com a terapia\n\n&lt;&lt;&lt;PORÉM&gt;&gt;&gt;\n\ncacete, esquecer desse remédio de manhã, na hora do almoço eu já tô dando pinote de enxaqueca + tontura e enjoo\n\no remédio bom pra quem esquece, cê aprende a tomar na marra&quot;}|||{&quot;category&quot;: &quot;Vômito&quot;, &quot;content&quot;: &quot;eu tomo desvenlafaxina vai fazer uns 5 anos, foi o que deu uma segurada durante a pandemia, junto com a terapia\n\n&lt;&lt;&lt;PORÉM&gt;&gt;&gt;\n\ncacete, esquecer desse remédio de manhã, na hora do almoço eu já tô dando pinote de enxaqueca + tontura e enjoo\n\no remédio bom pra quem esquece, cê aprende a tomar na marra&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;Mais um dia que é o terror de quem usa desvenlafaxina e transpira em bicas (eu)&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Quase sete da noite e estava aqui nossa pq minha cara e os pensamentos estão dormentes........ Dez horas de atraso da desvenlafaxina&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Tripliquei a dose de desvenlafaxina hoje pra poder existir&quot;}|||{&quot;category&quot;: &quot;Vertigem&quot;, &quot;content&quot;: &quot;não tomei meu ansiolítico hoje e minha cabeça tá girando meus ouvidos estão estourando parabéns por dar uma abstinência ridícula de um dia desvenlafaxina&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;Contando os dias pra desvenlafaxina parar de tiração de onda com a minha cara e parar de me fazer suar frio igual uma descompensada.&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;tive um episódio depressivo mais cedo. reparei que esqueci a desvenlafaxina por 2 dias. tomei minhas 100mg. agora estou na frente do espelho treinando os discursos de eliminação que eu faria se fosse apresentador do bbb.&quot;}|||{&quot;category&quot;: &quot;Inquietação&quot;, &quot;content&quot;: &quot;Quando não tomo Desduo (desvenlafaxina) me dá isso. Sonhos vívidos absurdos e muito agitados, acabo acordando com exaustão mental😔&quot;}|||{&quot;category&quot;: &quot;Comprometimento cognitivo&quot;, &quot;content&quot;: &quot;será que a desvenlafaxina tá me deixando meio burra? tô sentindo um declínio cognitivo e a memória tá uma porcaria&quot;}|||{&quot;category&quot;: &quot;Esquecimento&quot;, &quot;content&quot;: &quot;será que a desvenlafaxina tá me deixando meio burra? tô sentindo um declínio cognitivo e a memória tá uma porcaria&quot;}|||{&quot;category&quot;: &quot;Sensações estranhas&quot;, &quot;content&quot;: &quot;é esse machuca o neném djnaskds\neu mudei pro desvenlafaxina e passei 1~2 fogos no rabo semanais pra 2~3. life changing.&quot;}|||{&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;Tô ctg na desvenlafaxina, mil vezes ela do que ficar sofrendo de tremores, calafrios e caganeira de ansiedade.&quot;}|||{&quot;category&quot;: &quot;Cramps&quot;, &quot;content&quot;: &quot;Tô ctg na desvenlafaxina, mil vezes ela do que ficar sofrendo de tremores, calafrios e caganeira de ansiedade.&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;Tô ctg na desvenlafaxina, mil vezes ela do que ficar sofrendo de tremores, calafrios e caganeira de ansiedade.&quot;}|||{&quot;category&quot;: &quot;Enxaqueca&quot;, &quot;content&quot;: &quot;Minha cabeça já tá toda errada pela falta da desvenlafaxina, aí esse cheiro de cinzeiro humanoide ainda fica me seguindo.. \nVou acabar com enxaqueca.&quot;}|||{&quot;category&quot;: &quot;Dizziness&quot;, &quot;content&quot;: &quot;Começaram as vertigens esquisitas por conta da falta da desvenlafaxina.&quot;}|||{&quot;category&quot;: &quot;Lítio&quot;, &quot;content&quot;: &quot;Como dizer que fui triste em 2024 se desvenlafaxina 200mg + Lítio 300mg de manhã e 300mg antes de dormir?&quot;}|||{&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;Todo mês eu deixo pra comprar s desvenlafaxina em cima da hora aí eu chego na farmácia tonta passando mal&quot;}|||{&quot;category&quot;: &quot;Tristeza&quot;, &quot;content&quot;: &quot;como eu vou ser triste se esse ano eu tomei 150mg de desvenlafaxina todos os dias&quot;}|||{&quot;category&quot;: &quot;Sentimentos de inadequação&quot;, &quot;content&quot;: &quot;mais ou menos, a desvenlafaxina me deixa mais anestesiado q bem propriamente&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;peraí a desvenlafaxina deixam vcs sonolentos? com a desvenfalaxina eu fico assim tenho que tomar 4mg de alprazolam pra dormir&quot;}|||{&quot;category&quot;: &quot;Alucinação&quot;, &quot;content&quot;: &quot;to tomando Desduo (desvenlafaxina) fiquei aliviada dps de saber disso🙌🏻🙌🏻🙌🏻 \nmas sinto uma sensação de saciedade e nao to comendo mt, igual o meu tratamento pra ansiedade, quando eu tomava escitalopram (perdi 6kg em meses)&quot;}|||{&quot;category&quot;: &quot;Síndrome serotoninérgica&quot;, &quot;content&quot;: &quot;to tomando Desduo (desvenlafaxina) fiquei aliviada dps de saber disso🙌🏻🙌🏻🙌🏻 \nmas sinto uma sensação de saciedade e nao to comendo mt, igual o meu tratamento pra ansiedade, quando eu tomava escitalopram (perdi 6kg em meses)&quot;}|||{&quot;category&quot;: &quot;Comprometimento cognitivo&quot;, &quot;content&quot;: &quot;to tomando Desduo (desvenlafaxina) fiquei aliviada dps de saber disso🙌🏻🙌🏻🙌🏻 \nmas sinto uma sensação de saciedade e nao to comendo mt, igual o meu tratamento pra ansiedade, quando eu tomava escitalopram (perdi 6kg em meses)&quot;}|||{&quot;category&quot;: &quot;Fratura&quot;, &quot;content&quot;: &quot;to tomando Desduo (desvenlafaxina) fiquei aliviada dps de saber disso🙌🏻🙌🏻🙌🏻 \nmas sinto uma sensação de saciedade e nao to comendo mt, igual o meu tratamento pra ansiedade, quando eu tomava escitalopram (perdi 6kg em meses)&quot;}|||{&quot;category&quot;: &quot;Inquietação&quot;, &quot;content&quot;: &quot;to tomando Desduo (desvenlafaxina) fiquei aliviada dps de saber disso🙌🏻🙌🏻🙌🏻 \nmas sinto uma sensação de saciedade e nao to comendo mt, igual o meu tratamento pra ansiedade, quando eu tomava escitalopram (perdi 6kg em meses)&quot;}|||{&quot;category&quot;: &quot;Paranoia&quot;, &quot;content&quot;: &quot;to tomando Desduo (desvenlafaxina) fiquei aliviada dps de saber disso🙌🏻🙌🏻🙌🏻 \nmas sinto uma sensação de saciedade e nao to comendo mt, igual o meu tratamento pra ansiedade, quando eu tomava escitalopram (perdi 6kg em meses)&quot;}|||{&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;to tomando Desduo (desvenlafaxina) fiquei aliviada dps de saber disso🙌🏻🙌🏻🙌🏻 \nmas sinto uma sensação de saciedade e nao to comendo mt, igual o meu tratamento pra ansiedade, quando eu tomava escitalopram (perdi 6kg em meses)&quot;}|||{&quot;category&quot;: &quot;Sensação de confusão mental&quot;, &quot;content&quot;: &quot;monas esqueci de tomar minha desvenlafaxina ONTEM E HOJE agora estou fora de casa e me sentindo a Elizabeth sem a substância totalmente drogada&quot;}|||{&quot;category&quot;: &quot;Vertigem&quot;, &quot;content&quot;: &quot;Fiquei sem tomar a desvenlafaxina por 2 dias e parecia que tinham sugado todas as minhas forças. Bateu logo uma tontura e minha pressão foi no chão.&quot;}|||{&quot;category&quot;: &quot;Hipotensão&quot;, &quot;content&quot;: &quot;Fiquei sem tomar a desvenlafaxina por 2 dias e parecia que tinham sugado todas as minhas forças. Bateu logo uma tontura e minha pressão foi no chão.&quot;}|||{&quot;category&quot;: &quot;Febre&quot;, &quot;content&quot;: &quot;ontem tive uma das piores crises da minha vida pois além de estar com uma desmentidura que me deixou todo quebrado com febre e dor ainda tava sofrendo de abstinência de desvenlafaxina pq tentei parar e n deu certo.\n\njá me puxei e mais tarde vou passar na bemol pra comprar essa droga de remédio&quot;}|||{&quot;category&quot;: &quot;Dor&quot;, &quot;content&quot;: &quot;ontem tive uma das piores crises da minha vida pois além de estar com uma desmentidura que me deixou todo quebrado com febre e dor ainda tava sofrendo de abstinência de desvenlafaxina pq tentei parar e n deu certo.\n\njá me puxei e mais tarde vou passar na bemol pra comprar essa droga de remédio&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;Tendo. Mas antes com desvenlafaxina eu dormia cedo. Agora mudei de remédio estou menos apática mas em compensação o sono está custoso&quot;}|||{&quot;category&quot;: &quot;Hipersensibilidade&quot;, &quot;content&quot;: &quot;O medicamento não deve ser usado por pessoas com hipersensibilidade à Desvenlafaxina ou em tratamento com inibidores da MAO nos últimos 14 dias.\n\n#saudemental&quot;}|||{&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;Entre os efeitos colaterais mais comuns da Desvenlafaxina estão náusea, dor de cabeça, tontura, boca seca e aumento da sudorese.\n\n#saudemental&quot;}|||{&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;Entre os efeitos colaterais mais comuns da Desvenlafaxina estão náusea, dor de cabeça, tontura, boca seca e aumento da sudorese.\n\n#saudemental&quot;}|||{&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;Entre os efeitos colaterais mais comuns da Desvenlafaxina estão náusea, dor de cabeça, tontura, boca seca e aumento da sudorese.\n\n#saudemental&quot;}|||{&quot;category&quot;: &quot;Boca seca&quot;, &quot;content&quot;: &quot;Entre os efeitos colaterais mais comuns da Desvenlafaxina estão náusea, dor de cabeça, tontura, boca seca e aumento da sudorese.\n\n#saudemental&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;Entre os efeitos colaterais mais comuns da Desvenlafaxina estão náusea, dor de cabeça, tontura, boca seca e aumento da sudorese.\n\n#saudemental&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;Desvenlafaxina é um remédio dos deuses pq eu não ando fazendo NADA o dia todo e mesmo assim não ando depressiva&quot;}|||{&quot;category&quot;: &quot;Sentimentos de inadequação&quot;, &quot;content&quot;: &quot;O ruim da desvenlafaxina foi ter me tirado a \&quot;capacidade\&quot; de chorar, aí fico com essa sensação por muito tempo&quot;}|||{&quot;category&quot;: &quot;Vertigem&quot;, &quot;content&quot;: &quot;sobrevivendo hj com aquela tontura gostosa de abstinência de desvenlafaxina \n(já comprei meu remédio)&quot;}|||{&quot;category&quot;: &quot;Dependência&quot;, &quot;content&quot;: &quot;dois dias sem desvenlafaxina e eu já estou há dois dias prestes a cometer um crime\ne minha ex-psicóloga dizia que meu problema é obsessão por controle\neu PRECISO estar sob controle&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;mude o que a bruxinha está segurando:\n   /\\\n_/__\\_\n( •_•)\n /&gt; DESVENLAFAXINA E QUETIAPINA&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Geralmente passa com uma ou 2 semanas, ainda mais essa classe aí\nEu tomo desvenlafaxina e passei 3 semanas achando q  ia morrer, depois passou (e funcionou)&quot;}|||{&quot;category&quot;: &quot;Pensamentos intrusivos&quot;, &quot;content&quot;: &quot;nunca te passaram um remedio q ajuda com isso nao?  Eu tomo desvenlafaxina e ele ajuda com TOC, eu tinha MUITOS pensamentos intrusivos, tipo, era mto torturoso quando comecei a tomar eles pararam, tem varios antidepressivos q tambem ajudam com TOC nessa parte de pensamentos intrusivos&quot;}|||{&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;Não me adaptei a desvenlafaxina, me dava uma tontura pavorosa! Imagino se eu bebesse então!&quot;}|||{&quot;category&quot;: &quot;Cérebro derretendo&quot;, &quot;content&quot;: &quot;20 e poucas horas sem desvenlafaxina e já senti meu cérebro derretendo a cabeça dando choque e os carai&quot;}|||{&quot;category&quot;: &quot;Choque&quot;, &quot;content&quot;: &quot;20 e poucas horas sem desvenlafaxina e já senti meu cérebro derretendo a cabeça dando choque e os carai&quot;}|||{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;desvenlafaxina engorda??&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;Descobri que é a Desvenlafaxina que tá me fazendo suar mais que tampa de marmita.&quot;}|||{&quot;category&quot;: &quot;Dependência&quot;, &quot;content&quot;: &quot;Ai gnt n tomem desvenlafaxina o dia q vcs tiverem q parar cm essa merda vai ser o inferno, mt abstinência&quot;}|||{&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;é 3 dias sem o desvenlafaxina que minha cabeça fica 100% um remix de todos os funk de assobio mata nóia tocando ao mesmo tempo&quot;}|||{&quot;category&quot;: &quot;Alterações do apetite&quot;, &quot;content&quot;: &quot;desvenlafaxina dessa vez me deixou sem apetite para nada\nqnd como algo o peristaltismo parece que ligado num amplificador&quot;}|||{&quot;category&quot;: &quot;Apatia&quot;, &quot;content&quot;: &quot;A desvenlafaxina me deixa apatica 99% do tempo mas aquele 1% tbm desbagaça tudo. Comecei a chorar por causa do que aconteceu no aeroporto hoje e agora ja to chorando pq nunca serei amada !!!&quot;}|||{&quot;category&quot;: &quot;Calafrios&quot;, &quot;content&quot;: &quot;nossa eu vejo tanta gente que se deu bem com a desvenlafaxina, eu tomei por uns meses e a única coisa que sentia era MT calor. minha irma toma e se deu super bem mas tambem sentiu essas ondas de calor&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;Eu nem cheguei a usar. Quando descobrimos o TDAH minha médica mudou logo para desvenlafaxina, até pq eu tava muito deprimida e não dava pra ficar testando, ela preferiu passar logo o que tinha mais chance de funcionar e mudar no futuro, se eu quisesse. Nunca mudei.&quot;}|||{&quot;category&quot;: &quot;Perda de peso&quot;, &quot;content&quot;: &quot;é oficial: meu apetite tá voltando. por um tempo a desvenlafaxina tava fazendo um efeito melhor que ozempic, grazadeus passou&quot;}|||{&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;tô tentando ao máximo fingir que não tô tendo uma crise, mas minhas mãos não mentem........... desvenlafaxina já me deixa normalmente tremendo, qd tô mal, piora&quot;}|||{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;parei desvenlafaxina e já engordei vem ai compra de remédio sem receita&quot;}|||{&quot;category&quot;: &quot;Tremores&quot;, &quot;content&quot;: &quot;como eu ODEIO desvenlafaxina eu tomei ontem antes d dormir consegui dormir 3hrs só e to tremendo igual cachorro ate agora vsf&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;O meu é o desvenlafaxina, e o pior é q ele n costumava me dá esse mal estar :(&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;mt legal a desvenlafaxina pois na hora de dormir não te deixa dormir e na hora de trabalhar quer q vc durma&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Desvenlafaxina veio e tirou minha depressão e ansiedade me deixando apenas com depressão e ansiedade&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;Desvenlafaxina veio e tirou minha depressão e ansiedade me deixando apenas com depressão e ansiedade&quot;}|||{&quot;category&quot;: &quot;Vômito&quot;, &quot;content&quot;: &quot;A abstinência de desvenlafaxina me humilhando. Já vomitei 3x. Sujei as paredes do banheiro em meio metro de altura. Tive de lavar TUDO, passando mal.&quot;}|||{&quot;category&quot;: &quot;Nausea&quot;, &quot;content&quot;: &quot;Eita hahaha mas pensei que fosse desvenlafaxina pq todos meus pacientes reclamam de enjôo desse&quot;}|||{&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Incrível a abstinência da desvenlafaxina, sempre me deixa baqueada&quot;}|||{&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;nada como um cochilasso p passar a abstinência de desvenlafaxina 🕊️&quot;}|||{&quot;category&quot;: &quot;Doença de Parkinson&quot;, &quot;content&quot;: &quot;Ainda estou sem a Desvenlafaxina então estou morrendo de dor de cabeça e com a pressão no chão devia ser crime exigir que eu escreva oito páginas desse jeito&quot;}|||{&quot;category&quot;: &quot;Anxiety&quot;, &quot;content&quot;: &quot;esqueci de tomar a desvenlafaxina hj cedo \ne agora to morrendo de ansiedade 🤩&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;amanhã eu começo a tomar uma dose maior de desvenlafaxina e eu to ansiosa mesmo sabendo q eu posso piorar ainda mais e q vai demorar pelo menos umas 2 semanas pra fazer efeito 🥰&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;eu quando a desvenlafaxina nao ta mais segurando a ansiedade&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Esqueci de tomar a desvenlafaxina um dia e a ansiedade atacou de vez 😩😩&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;Ele eu posso cortar de boa no meu tratamento, pq ele era pra me fazer dormir (não faz), o mais foda se eu ficar sem tomar é a porra da desvenlafaxina que passou mal se esquecer e foi o que fiz ontem e tô morrendo agora Kkkkkkkkrying&quot;}|||{&quot;category&quot;: &quot;Adverse drug reaction&quot;, &quot;content&quot;: &quot;pior que ele foi o que mais me ajudou comparado aos outros que eu já tomei... o ruim mesmo é que ele tem mt efeito colateral, mas existe o desvenlafaxina q é basicamente a mesma coisa só que com - efeito, dizem que esse é bem melhor&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;nao sei se isso tem a ver, mas eu tomo desvenlafaxina e eu SEMPRE acordo encharcado de suor, mesmo se estiver frio e eu estiver de coberta&quot;}|||{&quot;category&quot;: &quot;Estresse&quot;, &quot;content&quot;: &quot;ai vei eu esqueci de tomar a desvenlafaxina hj eu to pra morrerrr sendo q eu tomei de 16h que foi qnd lembrei e o mau estar nao passou&quot;}" />
