      <node id=".&#10;&#10;Final plan:&#10;- Mirtazapina: Sonolência" label=".&#10;&#10;Final plan:&#10;- Mirtazapina: Sonolência">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="3" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Tô com uns problemas de pele q acho q é alergia provocada por ansiedade. \nTomei em 24h:\nMirtazapina 7,5 mg - dá sono\nHistamin - dá sono\nBupropiona 150mg - antidepressivo \nRivotril 0,25mg - dá sono\nNeusaldina\n\nSimplesmente hj eu n tenho pressão nenhuma. Eu tenho pressão baixa, hj é inexistente&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Tô com uns problemas de pele q acho q é alergia provocada por ansiedade. \nTomei em 24h:\nMirtazapina 7,5 mg - dá sono\nHistamin - dá sono\nBupropiona 150mg - antidepressivo \nRivotril 0,25mg - dá sono\nNeusaldina\n\nSimplesmente hj eu n tenho pressão nenhuma. Eu tenho pressão baixa, hj é inexistente&quot;}, {&quot;category&quot;: &quot;Hipotensão&quot;, &quot;content&quot;: &quot;Tô com uns problemas de pele q acho q é alergia provocada por ansiedade. \nTomei em 24h:\nMirtazapina 7,5 mg - dá sono\nHistamin - dá sono\nBupropiona 150mg - antidepressivo \nRivotril 0,25mg - dá sono\nNeusaldina\n\nSimplesmente hj eu n tenho pressão nenhuma. Eu tenho pressão baixa, hj é inexistente&quot;}]" />
          <attvalue for="3" value="3" />
