          <attvalue for="2" value="{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;I am feeling my tiredness in my bones currently but even my pms isn't affecting me this month. Thank you for saving my life citalopram&quot;}|||{&quot;category&quot;: &quot;Amitriptyline&quot;, &quot;content&quot;: &quot;amitriptilina me deixa muito cansada&quot;}" />
