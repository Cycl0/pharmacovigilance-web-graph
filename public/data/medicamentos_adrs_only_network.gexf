      <node id="Topiramato" label="Topiramato">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="1" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;após 1 mês com novas medicações vou falar como ta funcionando cmg..\n\nfluoxetina: funcionando mt bem, não me deixa apático que nem a paroxetina, consigo sentir as coisas!\n\ntopiramato: me ajudou na enxaqueca e apetite, mas fudeu o sono&quot;}]" />
