      <node id="Propranolol" label="Propranolol">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="3" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;By ‘take some drugs’ I mean my hardcore cocktail of 40mg of citalopram and 40mg of propranolol and a load of caffeine&quot;}|||{&quot;category&quot;: &quot;Estresse&quot;, &quot;content&quot;: &quot;By ‘take some drugs’ I mean my hardcore cocktail of 40mg of citalopram and 40mg of propranolol and a load of caffeine&quot;}|||{&quot;category&quot;: &quot;Dependência física&quot;, &quot;content&quot;: &quot;Passei por isso e a minha é refrativa, não melhora com nenhuma medicação depois que começa. Hoje faço tratamento preventivo com nortriptilina + propranolol, reduziu em 90%. Foi o único tratamento que deu certo...&quot;}" />
          <attvalue for="3" value="3" />
