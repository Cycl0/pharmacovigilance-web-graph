          <attvalue for="1" value="2" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;CN Periode, Tabletten\n\nOffenbar bekomme ich durch die Escitalopram meine Periode nicht mehr oder sehr verzögert und ich sage mal so: ich hatte schon schlimmere Nebenwirkungen!&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;a bupropiona me tirou sintomas depressivos e ansiosos e me deu menstruação desregulada&quot;}]" />
