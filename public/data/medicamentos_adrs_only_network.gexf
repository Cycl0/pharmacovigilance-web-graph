      <node id="Mirtazapina" label="Mirtazapina">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="62" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Hipotermia&quot;, &quot;content&quot;: &quot;They reckon we're in for a warm spell of weather so it's probably a good time to remind those of Depression medications Sertaline/Citalopram/Fluoxetine/Mirtazipine or any other SRRI 💊 to keep their fluids up\n\nTo stop you from becoming dehydrated or overheating\n\nIt could save a life&quot;}|||{&quot;category&quot;: &quot;Pesadelos&quot;, &quot;content&quot;: &quot;acho que é comum isso dos sonhos pq teoricamente vc descansa mais ai acaba sonhando e lembrando dos sonhos\npelo mesmo com mirtazapina era assim pra mim! torcendo pra dar certo amiga! ja tomei paroxetina e gostava&quot;}|||{&quot;category&quot;: &quot;Síndrome do intestino irritável&quot;, &quot;content&quot;: &quot;Grogue de quetiapina + mirtazapina e com uma colica do cacete to vendo tudi embacado com um olho so&quot;}|||{&quot;category&quot;: &quot;Mania&quot;, &quot;content&quot;: &quot;Ciekawostka: wenlafaksyna w połączeniu z mirtazapiną jest nazywana „californian rocket fuel”. Chuj wie, czemu californian, ale to był być może najlepszy miesiąc mojego życia. L4, spontaniczne malowanie mieszkania, udział w zamieszkach. Było super &lt;3&quot;}|||{&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;remédio sem vergonha essa tal de mirtazapina pqp, não pode nem comer comida gordurosa e tomar essa porra q vc passa mal&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;amanhã começa 7:10 e não 8h to cagada de medo de me atrasar, mas voltei a tomar o canabidiol a noite pois chegouuuu (eu tava tomando só de manhã pq tava no fim do fim) e ele me ajuda com o sono de noite junto com o mirtazapina e o meu chazin rs&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;o melhor que tomei até hoje foi a mirtazapina, a única que me fez dormir a noite inteira sem acordar e olha que já tomei zolpidem 5mg + quetiapina 25mg \nàs vezes dá saudade da onda dele mas pqp o PERIGO&quot;}|||{&quot;category&quot;: &quot;Fadiga&quot;, &quot;content&quot;: &quot;Abstinência de mirtazapina eu não desejo nem pro meu pior inimigo \n\nForam semanas sentindo uma fadiga horrível e pouca vontade de viver e o meu médico foi um vacilão me orientando mal&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Mirtazapina, un poquito de lectura, podcast y a dormir 💤&quot;}|||{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;Llevo desde la semana pasada con una sensación rara\nMe he querido acostar tarde para que no se me haga larga la noche\nTengo podcast, mirtazapina, benzos por si acaso, revistas para leer&quot;}|||{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;Quando eu comecei a tomar mirtazapina, eu tinha uma fissura insana por doce, principalmente de noite antes de ir dormir. Com o tempo foi passando e voltou ao normal, mas foram bem uns seis meses ou mais nisso, e foi assim que engordei 12kgs.&quot;}|||{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;Alguien por aquí que tome/haya tomado Mirtazapina? Lo de la somnolencia extrema se pasa? Porque comencé ayer por ls noche y llevo una endrogada que dudo que pudiera trabajar 💤&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Mirtazapina 15mg, vai dormir tanto que não vai conseguir nem levantar no outro dia 🤡&quot;}|||{&quot;category&quot;: &quot;Sonambulismo&quot;, &quot;content&quot;: &quot;A mirtazapina me dá cada sonho maluco&quot;}|||{&quot;category&quot;: &quot;Sintomas de TDAH&quot;, &quot;content&quot;: &quot;rezando para que meu estômago esteja tank hoje pra aguentar uma mirtazapina + iogurte se não tô fudido&quot;}|||{&quot;category&quot;: &quot;Letargia&quot;, &quot;content&quot;: &quot;Aiii, de drogas a mí la mirtazapina me ayudó muchísimo. Te deja un poco ko al principio pero fue la mejor de todas las que me dieron&quot;}|||{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;nossa ja tomei mirtazapina e é trash demais mal conseguia me manter acordada&quot;}|||{&quot;category&quot;: &quot;Sono Excessivo&quot;, &quot;content&quot;: &quot;Se eu tomo mirtazapina eu fico MT shapeada mas durmo 18h por dia se eu nao tomo eu emagreço um kg por semana e não durmo de jeito nenhum mas Deus sabe todas as coisas&quot;}|||{&quot;category&quot;: &quot;Perda de Peso&quot;, &quot;content&quot;: &quot;Se eu tomo mirtazapina eu fico MT shapeada mas durmo 18h por dia se eu nao tomo eu emagreço um kg por semana e não durmo de jeito nenhum mas Deus sabe todas as coisas&quot;}|||{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;sdds mirtazapina 😭 eu tomava ele e dez minutos depois já tava me acabando de sono e geralmente so acordava mesmo com o despertador, uma pena que tinha vezes que eu tomava e o sono demorava a bater e o mais triste ainda é que me fez engordar 10KG EM 6 MESES!!!!!! sinceramente&quot;}|||{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;sdds mirtazapina 😭 eu tomava ele e dez minutos depois já tava me acabando de sono e geralmente so acordava mesmo com o despertador, uma pena que tinha vezes que eu tomava e o sono demorava a bater e o mais triste ainda é que me fez engordar 10KG EM 6 MESES!!!!!! sinceramente&quot;}|||{&quot;category&quot;: &quot;Aumento do apetite&quot;, &quot;content&quot;: &quot;não aguento mais sentir tanta fome. eu não paro a bocaaaaaaaa tomar mirtazapina é humilhante dms&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;acabei de tomar 75mg de mirtazapina sem querer &amp; vamos de dormes&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;Sou uma baleia, galera. Tive descontrole ontem😐😐😐 não devia ter voltado pra mirtazapina. Agora é correr atrás do prejuízo&quot;}|||{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;Sem falar que um dos meus antidepressivos é a porra da MIRTAZAPINA. Essa BUCETA dá uma fome do caralho e no início do tratamento, me fez ganhar uns 5kg&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;Pouco mais de um mês tomando mirtazapina e... Achei que pelo menos ia aumentar minha fome, mas só tá ajudando a dormir e nada mais 🥲&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Estuve una temporada con mirtazapina y me dormía en lo alto de un pincho.&quot;}|||{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;Mirtazapina 15 mg 😴&quot;}|||{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;tw // o post não é necessariamente sobre isso mas é gatilho pra transtornos alimentares \n\nConselho do fundo do meu coração \n\nA não ser que vc esteja preparado pra engordar TANTO que vc vai ter que renovar seu guarda roupa inteiro PQ NENHUMA ROUPA SUA VAI SERVIR MAIS, não aceite tomar mirtazapina&quot;}|||{&quot;category&quot;: &quot;Enxaqueca&quot;, &quot;content&quot;: &quot;Tenho me sentido tão mal ultimamente que meu psiquiatra aumentou mais um remédio pra eu fazer uso. 4 comprimidos de manhã da venlafaxina+ 1 comprimido a noite de mirtazapina e agora 1 comprimido de depakene... tem acontecido tanta coisa que tenho pra piorar sentido muita enxaqueca...&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;como pode o mirtazapina ser o remedio mais perfeito pra dar o soninho dos deuses&quot;}|||{&quot;category&quot;: &quot;Sleepiness&quot;, &quot;content&quot;: &quot;dramin + mirtazapina \ncombinação do inferno\neu tomei ontem e tô com sono até agora&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;e assim o período q eu COMECEI a desmamar foi terribel mas agr ja ta d boas tomo só o mirtazapina pra dormir e mó paaaaz&quot;}|||{&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Tirei a sorte grande na loteria da upa hoje e o médico não quis renovar minha receita, rezando muito pra que o pessoal do PSF consiga me atender pq abstinência de mirtazapina é ruim demais&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;o efeito da mirtazapina é nível zolpidem pelo amor de deus se eu tomar esse remédio e não ir dormir logo eh capaz d'eu mandar mensagem pra ex ficante pedindo a pessoa em casamento e postar frente e verso do meu cartão com a senha nos stories do insta&quot;}|||{&quot;category&quot;: &quot;Comportamento compulsivo&quot;, &quot;content&quot;: &quot;Eu uso mirtazapina a noite e buspirona durante o dia só em casos de crise de ansiedade. A Sertralina marquei o bingo dos efeitos colaterais kkkk a mirtazapina tem muita gente que n da certo pq abre o apetite, aí a galera ganha peso&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;Poderia tomar um mirtazapina que eu tenho perdido aqui, mas aí ficaria imprestável o dia inteiro amanhã e não é isso que queremos&quot;}|||{&quot;category&quot;: &quot;Sonambulismo&quot;, &quot;content&quot;: &quot;vou ter que passar por modificações no remédio de dormir por simplesmente ficar acordando e tendo sonhos perturbadores, além de despertar muito cedo. eu vou tomar mirtazapina 30mg e dois comprimidos de quetiapina 25mg, antes era só um de 25mg.&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;Mds a hora que a mirtazapina bater vou apagar uns 2 dias direto&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;10mg melatonina \n2mg clonazepam \n7,5mg de mirtazapina \nCADÊ O SONO????&quot;}|||{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;Sendo que só 5 tão me servindo pq a desgraçada da mirtazapina me deu 10 kg de presente mas estou me vingando e uma hora chegarei lá novamente&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;acabou a mirtazapina e eu esqueci de comprar eu to a 1s de b4ter minha cabeça na parsde pra dormir&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;estou sem tomar mirtazapina há uma semana e simplesmente não tenho mais fome&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;consegui DORMIR pela primeira vez depois do desmame da mirtazapina 😭😭😭❤️❤️❤️&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;dormi 13 horas e não acordei de ressaca do sono obrigado mirtazapina&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Meu psiquiatra passou mirtazapina pra me ajudar a dormir.\n\nApaguei por 12h (e dormiria mais, até)&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;A vida é assim\nVc fica triste e toma dois comprimidos de Rivotril \n\nIsso pq já tinha tomado mirtazapina. Ou eu capoto ou eu fico acordada&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;faz mal misturar mirtazapina e clonazepan com md? pq so assim pra dormir gente (ja misturei&quot;}|||{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;Esse elfo tá meio inchado né. Será que tá tomando mirtazapina?&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;mirtazapina é tipo vc não vai te ansiedade e depressão se apenas passar sua vida dormindo&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;Tomei mirtazapina + tradozona agora, preciso acordar 6h30. Acho que vai dar bom... Rsrsrsr&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;mirtazapina eh tipo vc nao vai ter crise de ansiedade se dormir o dia inteiro&quot;}|||{&quot;category&quot;: &quot;Hipotensão&quot;, &quot;content&quot;: &quot;mirtazapina eu não posso que tenho a pressão baixa&quot;}|||{&quot;category&quot;: &quot;Engorda&quot;, &quot;content&quot;: &quot;pensando em pedir pro meu psiquiatra pra pararmos com a mirtazapina. engorda e dá sono, ta me irritando ja.&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;pensando em pedir pro meu psiquiatra pra pararmos com a mirtazapina. engorda e dá sono, ta me irritando ja.&quot;}|||{&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;A testosterona aumentou meu apetite e eu ainda tomo mirtazapina, sinto fome toda hora kkkk socorro&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;sempre que tomo minha querida mirtazapina mando 12h de sono é incrível&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;to com medo de tomar mirtazapina e enlouquecer q odio odeio comecar tratamento novo&quot;}|||{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;falaram que a mirtazapina engorda demais, mas vc gosta dos dois ?&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Amo minha mirtazapina, durmo que nem um neném&quot;}|||{&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;parei de tomar mirtazapina pq tava comendo demais e agora to com tremedeira e depressao&quot;}|||{&quot;category&quot;: &quot;Depressão&quot;, &quot;content&quot;: &quot;parei de tomar mirtazapina pq tava comendo demais e agora to com tremedeira e depressao&quot;}" />
