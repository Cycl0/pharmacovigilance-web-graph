      <node id="Nausea" label="Nausea">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="30" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Sertraline&quot;, &quot;content&quot;: &quot;I got nausea for a week or two when I first started on sertraline  ( over a decade ago) but I've never had any adverse effects to citalopram.&quot;}|||{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;sertralina tá sendo mt mt bom pra mim. usei escitalopram por 2,5 anos mas não tava funfando mais\ntive efeito colateral de ter enjoo por uns 3 meses, mas agora nada (tô usando há um ano já)\ntô com mais clareza mental, TAG muito mais em ordem&quot;}|||{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Infelizmente o efeito colateral mais comum e chato do escitalopram chegou. Espero que seja realmente só coisa da segunda semana.&quot;}|||{&quot;category&quot;: &quot;Fluoxetin&quot;, &quot;content&quot;: &quot;eu quando tomava fluoxetina&quot;}|||{&quot;category&quot;: &quot;Fluoxetin&quot;, &quot;content&quot;: &quot;Pra ser sincera não, eu tinha receita pra fluoxetina e o período pelo qual eu fiz uso foi horrível, meu desempenho acadêmico mesmo foi um dos que mais refletiu, aí eu só parei, e desde então eu tenho estado ok, por isso n penso em voltar pra nenhum&quot;}|||{&quot;category&quot;: &quot;Fluoxetin&quot;, &quot;content&quot;: &quot;Quase gabaritando os efeitos adversos da fluoxetina, mas pelo menos ainda tenho apetite&quot;}|||{&quot;category&quot;: &quot;Paroxetin&quot;, &quot;content&quot;: &quot;tomei paroxetina mas tá doido deu tremelique, insônia, enjoo e piriri, tomo mais não rs&quot;}|||{&quot;category&quot;: &quot;Sertraline&quot;, &quot;content&quot;: &quot;dps q passou o enjoo sertralina foi só flores&quot;}|||{&quot;category&quot;: &quot;Sertraline&quot;, &quot;content&quot;: &quot;periodo de adaptação do sertralina é mto ruim pprt\n\nnausea dor de barriga dor de cabeça cansaço #itsover&quot;}|||{&quot;category&quot;: &quot;Sertraline&quot;, &quot;content&quot;: &quot;Tava feliz com a disposição que a sertralina me deu, agora eu tô acordando querendo morrer por conta da náusea que eu tô sentindo&quot;}|||{&quot;category&quot;: &quot;Bupropion&quot;, &quot;content&quot;: &quot;A bupropiona te esculhamba antes de te tratar amigos\nUma náusea e tontura do cão&quot;}|||{&quot;category&quot;: &quot;Bupropion&quot;, &quot;content&quot;: &quot;Uma das maiores tristezas da minha vida: tomar bupropiona e ficar enjoada com cigarro&quot;}|||{&quot;category&quot;: &quot;Mirtazapine&quot;, &quot;content&quot;: &quot;E eu que tomo mirtazapina que dá uma fome desgramada, junta a fome desgramada com a nausea desgramada me dá vontade genuina de me matar&quot;}|||{&quot;category&quot;: &quot;Trazodone&quot;, &quot;content&quot;: &quot;O meu psiquiatra me dá receita para 2 meses certinho, inclusive dia 08 tô lá para falar com ele que a trazodona que ele colocou junto com os outros remédios até funcionou pra eu dormir mas a que preço? To bem enjoado e sem comer direito há 1 mês, perdi uns 2-3 kg já&quot;}|||{&quot;category&quot;: &quot;Trazodona&quot;, &quot;content&quot;: &quot;amo o meu trazodona mas é a coisa mais horrenda de ruim que já coloquei na boca na minha vida&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxine&quot;, &quot;content&quot;: &quot;Desvenlafaxina remedio nojento escroto odeio tomar essa merda preciso desmamar e simplesmente não consigo passar mais de 24h sem tomar q dá tontura e náusea e vontade d eme jogar da janela \nIncrivel&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxine&quot;, &quot;content&quot;: &quot;psiquiatra me voltou pra desvenlafaxina e já estou sentindo as dores de cabeça nauseantes pq nunca tomo essa bosta no horário certo&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxine&quot;, &quot;content&quot;: &quot;agora se eu esquecer de tomar a desvenlafaxina de manhã, no final da tarde eu já tô nauseando, com dor de cabeça e querendo sair correndo pelo mundo 🫠 não perdoa 1 dia essa peste!&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Eita hahaha mas pensei que fosse desvenlafaxina pq todos meus pacientes reclamam de enjôo desse&quot;}|||{&quot;category&quot;: &quot;Duloxetine&quot;, &quot;content&quot;: &quot;Acho que eu entendi minha diarréia e minha nausea, tontura\n\nTô começando a achar que é o duloxetina com a abstinencia retardada que deveria ter começado antes\nEu estou levemente fodido\nVou ter que comprar vonau&quot;}|||{&quot;category&quot;: &quot;Venlafaxine&quot;, &quot;content&quot;: &quot;Comecei a tomar ele recentemente, tô tomando o genérico, não tive nada disso. Em compensação com a Venlafaxina eu fiz check em tudo de efeito colateral que tinha&quot;}|||{&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;É Venlafaxina? Esse me deixou muito nauseada nas primeiras semanas.&quot;}|||{&quot;category&quot;: &quot;Venlafaxine&quot;, &quot;content&quot;: &quot;Eu tinha parado de tomar o Venlafaxina por conta e agora voltei, esqueci que um dos efeitos colaterais é um enjoo FODIDO, que inferno&quot;}|||{&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Eu tomei 150mg de venlafaxina por 3 dias so e foi o suficiente pra eu quase ir de comes e bebes, foi a pior experiência que eu já tive na vida&quot;}|||{&quot;category&quot;: &quot;Venlafaxine&quot;, &quot;content&quot;: &quot;passando mal de enjoo, cuspindo a cada 10 segundos, tonta, fraca, mente anuviada e ouvindo o ventilador de satanás do lado esquerdo\nnynca mais atraso a venlafaxina&quot;}|||{&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Tuve que ir a comprar reliveran por las náuseas que me produce la baja de venlafaxina más una ansiedad de la san punta quiero la cabeza de mí psiquiatra en una pica&quot;}|||{&quot;category&quot;: &quot;Venlafaxine&quot;, &quot;content&quot;: &quot;agora com todo o enjoo do mundo + dor de cabeça porque tomei atrasada venlafaxina remedio demoniaco&quot;}|||{&quot;category&quot;: &quot;Fluoxetin&quot;, &quot;content&quot;: &quot;Bom dia hoje para:\n\n- Quem tá entrando na última semana de trabalho;\n- Usuários de escitalopram, fluoxetina, sertralina e venlafaxina;\n- Quem acordou com torcicolo;\n- Quem tá com um dos olhos tremendo;\n- Quem quer amar ainda em 2024&quot;}|||{&quot;category&quot;: &quot;Amitriptyline&quot;, &quot;content&quot;: &quot;cara eu também tinha q ter tomado meu amitriptilina e até agr nada kkkkkkk nem vou tomar mais essa hora senão vou ter enjôo&quot;}|||{&quot;category&quot;: &quot;Sertraline&quot;, &quot;content&quot;: &quot;Día 5: Los primeros días de vuelta a la Sertralina y al metilfenidato son espantosos: Tengo poquísima energía, tengo frío, no me da hambre en todo el día, tengo sueño, todo me da asco.\n\nMe da bastante hambre en la noche, tho.\n\n#BitacoraND&quot;}" />
          <attvalue for="3" value="14" />
          <attvalue for="4" value="6" />
          <attvalue for="5" value="2.305311 1.670713" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
      <node id="Náusea" label="Náusea">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="49" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Anyone else on citalopram get an intense wave of nausea like half an hour after taking it? I've been on it for years and still get this&quot;}|||{&quot;category&quot;: &quot;Gravol&quot;, &quot;content&quot;: &quot;.....what. i have been comining shit for years and was never told that. im talking gravol + naproxen + acetaminophen + citalopram :0&quot;}|||{&quot;category&quot;: &quot;Naproxen&quot;, &quot;content&quot;: &quot;.....what. i have been comining shit for years and was never told that. im talking gravol + naproxen + acetaminophen + citalopram :0&quot;}|||{&quot;category&quot;: &quot;Acetaminophen&quot;, &quot;content&quot;: &quot;.....what. i have been comining shit for years and was never told that. im talking gravol + naproxen + acetaminophen + citalopram :0&quot;}|||{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Ugh, took my citalopram on an empty stomach now Im nauseated.  Fucking anxiety.&quot;}|||{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;The first day back on citalopram was a wild trip. I hope the worst of the side effects last the minimal amount of time possible.\n\nBeen a while since I’ve been on this stuff. It’s gonna take some getting used to.\n\nI’ve had a 5 year tolerance break from it. I’m signed off from work for 2 weeks as well&quot;}|||{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Citalopram definitely probably maybe saved me but Man those initial side effects were gnarly. And if I didn’t take it for a few days….. also gnarly. More positives than negatives though&quot;}|||{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Quick update! I actually feel pretty great? The only withdraw symptoms I had were nausea &amp; irritability. I know I'm not completely out of the woods yet but hopefully that this was the extent of it. Just to give you an idea of how odd this is, I was on Citalopram for 3 yrs and Bupropion for 2ish.&quot;}|||{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Passe um tempinho sem tomar o citalopram daí agora voltei a tomar e to quase me acabando de enjoo&quot;}|||{&quot;category&quot;: &quot;Sertraline&quot;, &quot;content&quot;: &quot;Thank you! I was previously on sertraline (3 years) and then citalopram (2 months) but they both caused bruxism which meant I permanently had a headaches! My first day on venlafaxine was yesterday and it sucked bc I threw up at work from the nausea... I'm hoping it gets better and works for me!&quot;}|||{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Thank you! I was previously on sertraline (3 years) and then citalopram (2 months) but they both caused bruxism which meant I permanently had a headaches! My first day on venlafaxine was yesterday and it sucked bc I threw up at work from the nausea... I'm hoping it gets better and works for me!&quot;}|||{&quot;category&quot;: &quot;Venlafaxine&quot;, &quot;content&quot;: &quot;Thank you! I was previously on sertraline (3 years) and then citalopram (2 months) but they both caused bruxism which meant I permanently had a headaches! My first day on venlafaxine was yesterday and it sucked bc I threw up at work from the nausea... I'm hoping it gets better and works for me!&quot;}|||{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Why do I feel queasy, I wonder, having taken a citalopram on an empty stomach because I lay in bed  depressed until 1.30pm. Anyway I have made it to the gym, that will be my one achievement for the day&quot;}|||{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;I’m on escitalopram and I’d say it’s been a net positive. Once was on fluoxetine and it gave me so many nightmares and night sweats 😵‍💫&quot;}|||{&quot;category&quot;: &quot;Fluoxetin&quot;, &quot;content&quot;: &quot;E oq pode ser no caso deu tomar dois cp de fluoxetina no seco e sentir meu esôfago(?) o dia todo? SUSBSUSHSUS parece q tô engasgado o tempo todo&quot;}|||{&quot;category&quot;: &quot;Fluoxetin&quot;, &quot;content&quot;: &quot;Obvio q nao tive coragem de reclamar nesse dia tbm, e ela era tão desgraçada q eu resolvi desmamar dos remedios q eu tomava ha 4 anos \n\nCheguei a ir em outro psiquiatra lgbt friendly do sus, mas ele trocou desve e litio (q tavam me fazendo passar mal no desmame) por fluoxetina\n\nTomei 2 vezes&quot;}|||{&quot;category&quot;: &quot;Paroxetin&quot;, &quot;content&quot;: &quot;sim, a paroxetina me ajudou quando eu precisei, mas foi um inferno tirar :( acho estranho terem te passado 2 meses de uso quando é sabido que o desmame é muito ruim... eu tinha que tomar vonau antes de toda refeição e mesmo assim não conseguia comer muito. espero que vc encontre seu remédio&quot;}|||{&quot;category&quot;: &quot;Paroxetin&quot;, &quot;content&quot;: &quot;Eu fiz tratamento com ela durante anos, na época me ajudou muito, mas os efeitos colaterais são péssimos mesmo, agora eu troquei pelo paroxetina&quot;}|||{&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;tmj na paroxetina, felizmente tem genérico baratinho pq referência de 40mg é um rombo&quot;}|||{&quot;category&quot;: &quot;Paroxetin&quot;, &quot;content&quot;: &quot;não tomei a paroxetina porque tava enjoada e esqueci de tomar a quetiapina. hoje eu to de parabéns&quot;}|||{&quot;category&quot;: &quot;Paroxetine&quot;, &quot;content&quot;: &quot;Paroxetina parece eficaz en sínt vasomotores; Evidencia moderada. Ef 2º→nauseas/mareos ─Metanálisis [Int J Obs Gyn] http://ow.ly/4n63Qp&quot;}|||{&quot;category&quot;: &quot;Sertraline&quot;, &quot;content&quot;: &quot;todo dia enjoada dps q comecei a tomar sertralina espero q passe logo pq n aguento mais&quot;}|||{&quot;category&quot;: &quot;Sertraline&quot;, &quot;content&quot;: &quot;passando mal desde ontem pq fiz burrada e tomei sertralina de estomago vazio&quot;}|||{&quot;category&quot;: &quot;Sertraline&quot;, &quot;content&quot;: &quot;mds como eu sou burra\nburra burra burra\n\ntomei o sertralina ontem com o estômago vazio e agr to passando mal 🥴&quot;}|||{&quot;category&quot;: &quot;Sertraline&quot;, &quot;content&quot;: &quot;serio sertralina destruindo meu estomago&quot;}|||{&quot;category&quot;: &quot;Sertraline&quot;, &quot;content&quot;: &quot;esqueço a sertralina por um dia e meu estômago tenta me assasinar&quot;}|||{&quot;category&quot;: &quot;Sertraline&quot;, &quot;content&quot;: &quot;Que tenso, eu tô aqui 24h  passando mal por causa de um sertralina, quase dei um treco de madrugada e só tenho enjôo tamanho do mundo, a médica passou logo de cara uma super dosagem e eu me lasquei&quot;}|||{&quot;category&quot;: &quot;Bupropion&quot;, &quot;content&quot;: &quot;eu quase vomitei nas internas hoje tamanho enjoo, foi o dia todo 🤢 certeza deve ser a bupropiona que ódio&quot;}|||{&quot;category&quot;: &quot;Bupropion&quot;, &quot;content&quot;: &quot;o tanto de efeito colateral do bupropiona eu vou é continuar fumando&quot;}|||{&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;remédio sem vergonha essa tal de mirtazapina pqp, não pode nem comer comida gordurosa e tomar essa porra q vc passa mal&quot;}|||{&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;parei de tomar mirtazapina pq tava comendo demais e agora to com tremedeira e depressao&quot;}|||{&quot;category&quot;: &quot;Trazodona&quot;, &quot;content&quot;: &quot;cara tomei a porra da trazodona, não deu nem 30min e comecei a sentir uma tontura e náusea do caralho&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;meu deus acho que a desvenlafaxina ta me deixando enjoada, juro que to com uma sensação de nausea horrível 😭&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Entre os efeitos colaterais mais comuns da Desvenlafaxina estão náusea, dor de cabeça, tontura, boca seca e aumento da sudorese.\n\n#saudemental&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxine&quot;, &quot;content&quot;: &quot;sensação de que meu celebro tá solto na cabeça em razão do desmame da desvenlafaxina + enjôo em razão da adaptação do o vortioxetina = drama de minha parte&quot;}|||{&quot;category&quot;: &quot;Vortioxetine&quot;, &quot;content&quot;: &quot;sensação de que meu celebro tá solto na cabeça em razão do desmame da desvenlafaxina + enjôo em razão da adaptação do o vortioxetina = drama de minha parte&quot;}|||{&quot;category&quot;: &quot;Venlafaxine&quot;, &quot;content&quot;: &quot;Dia 1 sem venlafaxina 150mg\n\nIremos atualizar com novidades porém já sabemos que passarei o dia tonta e aguentando ânsia de vômito&quot;}|||{&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;Cinco dias já tomando Venlafaxina e continuo me sentindo bem enjoado. Alguém que já tomou sabe se isso passa?&quot;}|||{&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;O Venlafaxina sempre inibiu meu choro, com 1 semana que troquei ja chorei em terapia coisa que quase nunca fazia. O Venla atrapalhou mto meu processo. To ansioso com esse novo, só não to aguentando ficar com enjoo todos os dias, to parecendo grávida kkkkkkk&quot;}|||{&quot;category&quot;: &quot;Venlafaxine&quot;, &quot;content&quot;: &quot;nao apenas isso mas eu ia durar 24h ia morrer de enjoo e enxaqueca de abstinencia de venlafaxina&quot;}|||{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Arranqué por escitalopram pero me hacía mal al estómago. Después pasé por venlafaxina y me quedé en la sertralina (por ahora)&quot;}|||{&quot;category&quot;: &quot;Venlafaxine&quot;, &quot;content&quot;: &quot;O pior sintoma de abstinência de venlafaxina são os \&quot;brain zaps\&quot;. É uma sensação de choque no cérebro. Horrível demais. Parece que o cérebro vibra a cada passo dado, ou quando eu olho pros lados.\n\nAí começa a dissociação. \nSem falar da náusea constante.&quot;}|||{&quot;category&quot;: &quot;Venlafaxin&quot;, &quot;content&quot;: &quot;É então o venlafaxina é horrivel justamente por isso né....eu ja fiquei 2 dias sem tomar e foi surreal de RUIM (so podia renovar a merda da receita no dia que eles atendem). Mas enfim o bom que no momento tenho minha tia pra me lembrar, mas morro de medo de morar sozinho e dar essa merda dnv&quot;}|||{&quot;category&quot;: &quot;Amitriptyline&quot;, &quot;content&quot;: &quot;El tryptanol, que es el mismo compuesto, la amitriptilina, cuando comencé con esto. No me funciona bien. De hecho, lo pasé fatal al ser un antidepresivo sin necesitarlo.\n\nMe daba más dolor de cabeza y las náuseas fueron terribles.&quot;}|||{&quot;category&quot;: &quot;Topiramat&quot;, &quot;content&quot;: &quot;Eu comecei a tratar agora com Topiramato. Eu já tratei antes com Amitriptilina, mas ele me deixava com muita ressaca. Eu sempre tive crises, mas ultimamente estou tendo dores todos os dias e se eu não tomar remédio acaba evoluíndo para crise, por isso vou fazer a profilaxia.&quot;}|||{&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;Eu comecei a tratar agora com Topiramato. Eu já tratei antes com Amitriptilina, mas ele me deixava com muita ressaca. Eu sempre tive crises, mas ultimamente estou tendo dores todos os dias e se eu não tomar remédio acaba evoluíndo para crise, por isso vou fazer a profilaxia.&quot;}|||{&quot;category&quot;: &quot;Amitriptyline&quot;, &quot;content&quot;: &quot;- tomei minha amitriptilina!! firme e forte!! achei q ia me estatelar no chão entre 22hrs e 1 am e eu nem me importaria pq qlqr coisa é melhor doq vomitar de dor de cabeça de enxaqueca \n- cheguei na cs do lucas agr umas 5 am\n- persobus até alvorada 😌&quot;}|||{&quot;category&quot;: &quot;Amitriptyline&quot;, &quot;content&quot;: &quot;La amitriptilina (Tryptizol) es un antidepresivo tricíclico. Se usa en procesos dolorosos crónicos porque eleva el umbral del dolor (un cierto estímulo debe ser un poco más doloroso para que me entere de él). El problema es que no a todo el mundo, y además sus efectos secundarios:&quot;}|||{&quot;category&quot;: &quot;Nortriptilina&quot;, &quot;content&quot;: &quot;náusea inacreditável causada por abstinência de nortriptilina e privação de sono&quot;}" />
          <attvalue for="3" value="23" />
          <attvalue for="4" value="11" />
          <attvalue for="5" value="3.074867 -0.226475" />
          <attvalue for="6" value="#E9573F" />
        </attvalues>
      </node>
      <node id="Zolpidem" label="Zolpidem">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="11" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;o melhor que tomei até hoje foi a mirtazapina, a única que me fez dormir a noite inteira sem acordar e olha que já tomei zolpidem 5mg + quetiapina 25mg \nàs vezes dá saudade da onda dele mas pqp o PERIGO&quot;}|||{&quot;category&quot;: &quot;Sleepiness&quot;, &quot;content&quot;: &quot;tomei mirtazapina e zolpidem por ter certeza que se eu ficar acordado, vou fazer uma besteira.&quot;}|||{&quot;category&quot;: &quot;Delírio&quot;, &quot;content&quot;: &quot;amg, zolpidem é mto forte 🥺 minha mãe toma ele e fica delirando e 2x que eu tomei, fiquei do mesmo jeito. \nagr eu tomo trazodona&quot;}|||{&quot;category&quot;: &quot;Sensações estranhas&quot;, &quot;content&quot;: &quot;Acontecia comigo ao associar Trazodona e Zolpidem. É uma sensação estranha de não saber se ocorreu mesmo ou não.&quot;}|||{&quot;category&quot;: &quot;Sono&quot;, &quot;content&quot;: &quot;Eu tinha tomado entre 2022 e 2023 mas como não dormia de jeito nenhum ele trocou por alprazolam, depois acrescentou zolpidem e agora acrescentou trazodona de volta \n\n3 remédios para dormir toda noite e nem sempre eu durmo kkkkkkkk&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;eu tenho eh medo do zolpidem... pior que eu já tomei trazodona antes, mas na época eu tava tomando duloxetina que tinha cortado 100% meu sono, então eu dormia normal com ele kkkk agora tô achando forte também&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Não faz nem cócegas kk amiga eu tomo cerca de 3 remédios e todos dão sono: atualmente só o zolps ou a trazodona me apagam, mas a que custo....&quot;}|||{&quot;category&quot;: &quot;Vertigem&quot;, &quot;content&quot;: &quot;usar na web nI eh tão ruim assim tô medicada com 20mg de zolpidem e 50mg de trazodona e eu tô sentindo tud9 flutuar aí tinha duS ssnhS cantando music de cinderela ela eh a da coraline indo pro jardim das 9oanras rosas r9xos diversas correr&quot;}|||{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;Mainha tomou amitriptilina e alprazolam pra dormir, ela sofre mt c a menopausa pq a dela começou mt cedo pq ela tirou o útero qnd tinha minha idade, o sono nunca mais foi o mesmo. Eu morro de medo de zolpidem, pq eu amo o efeito de sono pesado q um anestésico dá,então sei q seria candidata ao vício&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Hoje eu to o amitriptilina pra dormir, tipo, ela só dá uma relaxada, o efeito é bem mais suave que a quetiapina.  E eu acho que como meu vício de zolpidem começou com eu usando quetiapina e zolpidem, eu associava um ao outro e isso me fez demorar muito mais pra me livrar do vício, perdi tanto 😔&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;eu troquei pra doxepina e funcionou bemmm melhor\ne tem sempre o famoso zolps né&quot;}" />
          <attvalue for="3" value="8" />
          <attvalue for="4" value="10" />
          <attvalue for="5" value="1.807400 -0.758478" />
          <attvalue for="6" value="#2DCD9F" />
        </attvalues>
      </node>
      <node id="Embotamento afetivo" label="Embotamento afetivo">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="15" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Still here.\n\n#citalopram has me feeling quite weird. Numb. It’s improved some things but I’m still dead inside.\n\nAnyway, ADHD is also  kicking my ass today and hindering study. I’m incredibly skittish.\n\nBut. Here’s a recycled one of my butt and thighs for #thighthursday&quot;}|||{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;I was on citaloprqm for 10 years. It made me numb and detached. Went cold turkey (harrrd) had life coaching and now use ashwaganda- seriously I would think I’m on a lighter version of citalopram- it allows things to wash over you but not detached. 6wks on 3wks off - repeat. Worth a try?&quot;}|||{&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;\&quot;Citalopram keeps you from crying\&quot; Wrong, all I need to do is listen to Washing Machine Heart in my Gaz/Grul playlist and the dam breaks&quot;}|||{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Also ich hab schon beides genommen, Adhs/Audhs ist aber nur Verdacht aktuell. Ich hab auch das Gefühl, dass mich (Es)citalopram emotional und intellektuell halbiert (Citalopram schlimmer als Escitalopram), damit geht's mir zwar irgendwie \&quot;besser\&quot;, aber ich hasse es auch und setze immer irgendwann ab&quot;}|||{&quot;category&quot;: &quot;Rivotril&quot;, &quot;content&quot;: &quot;tomei: desvenlafaxina, zolpidem, rivotril\n\ntomo: escitalopram&quot;}|||{&quot;category&quot;: &quot;Fluvoxamina&quot;, &quot;content&quot;: &quot;estou tão irritada com tantas coisas que não consigo nem colocar em palavras fluvoxamina amorteça imediatamente minhas emoções!!!!!!&quot;}|||{&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;com 4 dias tomando paroxetina eu acordei com o cérebro no mudo, não escutava um pensamento sequer, foi a sensação mais estranha da minha vida&quot;}|||{&quot;category&quot;: &quot;Sertraline&quot;, &quot;content&quot;: &quot;o sertralina me causou efeitos colaterais terríveis de inicio\n\nvivi igual zumbi, mas dps veio a energia q a psiquiatra prometeu&quot;}|||{&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;Tem certeza que é bupropiona? Bateu diferente, parece que é mistura de raiva com vontade de resolver tudo em um dia. Parece até que os divertidamente saíram do home office&quot;}|||{&quot;category&quot;: &quot;Desvenlafaxine&quot;, &quot;content&quot;: &quot;aumentar a dose da desvenlafaxina realmente funcionou. funcionou pra virar um robô que nada sente incapaz de chorar e por consequência paro de sofrer por aquilo que está fora do meu controle. obrigado indústria farmacêutica&quot;}|||{&quot;category&quot;: &quot;Duloxetine&quot;, &quot;content&quot;: &quot;agora que mudei de antidepressivo voltei a ser chorona, a única coisa boa da duloxetina é que eu tava zero emoção e desbocada de falar sem chorar 🫷🏽😭&quot;}|||{&quot;category&quot;: &quot;Venlafaxina&quot;, &quot;content&quot;: &quot;amanha faz 1 semana que aumentei o venlafaxina e eu já to tão anestesiado que não to mais ligando de ta + 6 meses sem beijar (o * não conta pq eu dissociei ja, nem lembro)&quot;}|||{&quot;category&quot;: &quot;Venlafaxine&quot;, &quot;content&quot;: &quot;segundo dia tomando venlafaxina e meu humor não oscilou uma vez, não fiquei ansiosa por nada e me sinto morta por dentro e isso me deixa adorável&quot;}|||{&quot;category&quot;: &quot;Clomipramina&quot;, &quot;content&quot;: &quot;meu psiquiatra falou que clomipramina diminui o libido mas desde a hora que acordei hj só penso em sexo com o *&quot;}|||{&quot;category&quot;: &quot;Methylphenidate&quot;, &quot;content&quot;: &quot;E com essa situação eu consegui identificar uma mudança no meu humor que a falta do metilfenidato está fazendo. Eu não me irritava tanto e com tanta facilidade enquanto tomava ele.\nMeu humor está bem mais desregulado.&quot;}" />
          <attvalue for="3" value="13" />
          <attvalue for="4" value="9" />
          <attvalue for="5" value="1.151348 0.561492" />
          <attvalue for="6" value="#E9573F" />
