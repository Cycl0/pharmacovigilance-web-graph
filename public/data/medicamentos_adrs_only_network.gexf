      <node id="Paralisia" label="Paralisia">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="3" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;A sertralina me tirou a inquietação das crises de ansiedade e trocou por apatia 👍\n\nFico paralisada, esqueço que ia fazer&quot;}, {&quot;category&quot;: &quot;Quetiapina&quot;, &quot;content&quot;: &quot;Eu tomo quetiapina e mirtazapina antes de dormir, mas é a primeira vez que acontece. Eu acordava e dormia de novo. Sabia que tava dormindo, tentava gritar, me acordar, debater e nada. Andei pela casa toda enquanto dormia e não conseguia fazer nada.&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Eu tomo quetiapina e mirtazapina antes de dormir, mas é a primeira vez que acontece. Eu acordava e dormia de novo. Sabia que tava dormindo, tentava gritar, me acordar, debater e nada. Andei pela casa toda enquanto dormia e não conseguia fazer nada.&quot;}]" />
