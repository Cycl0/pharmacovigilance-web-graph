      <node id="Donaren" label="Donaren">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="1" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Vontade de viver - perdi\nSertralina e Donaren tem me feito dormir e mantendo acordada durante o dia pra conseguir ser uma adulta minimamente funcional (mas bem minimamente mesmo)&quot;}]" />
