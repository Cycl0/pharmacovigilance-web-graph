      <node id="Nervosismo" label="Nervosismo">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="2" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Escitalopram&quot;, &quot;content&quot;: &quot;Ich schleiche gerade Escitalopram aus (ja ich versuche es mal wieder) und ich bin deswegen genauso hibbelig wie damals beim einschleichen. Nervig Ich hoffe das legt sich bald.&quot;}, {&quot;category&quot;: &quot;Metilfenidato&quot;, &quot;content&quot;: &quot;passar nervoso depois de 18mg de metilfenidato é um laxante alternativo&quot;}]" />
