      <node id="Olanzapina" label="Olanzapina">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="2" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Aumento do apetite&quot;, &quot;content&quot;: &quot;eu no bunker explicando que a comida acabou pq eu tomei mirtazapina/olanzapina e virei A Gula de madrugada&quot;}, {&quot;category&quot;: &quot;Alteração do apetite&quot;, &quot;content&quot;: &quot;Preguntas seria: algunas de estas pastillas os quita completamente el hambre:\n-Esomeprazol \n- Olanzapina \n- Nolotil \n- Tramadol \n- Venlafaxina\n- Depakine Crono \n- Noctamid \n- Diazepan \nLlevo días sin comer y sin nada de hambre.\nBebo yogur líquido, 2 vasos, y también es cierto que gasto poca energía.&quot;}]" />
          <attvalue for="3" value="2" />
          <attvalue for="4" value="5" />
          <attvalue for="5" value="2.082253 4.951045" />
          <attvalue for="6" value="#2DCD9F" />
