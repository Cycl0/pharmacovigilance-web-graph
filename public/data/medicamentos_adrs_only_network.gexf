      <node id="Bupropiona" label="Bupropiona">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="5" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;quetiapina só me da sono, eu uso pra dormir, nao ajuda mto com ansiedade, talvez precise de um medicamento que age com mais foco \neu tomo escitalopram, bupropiona e fluvoxamina e mesmo assim tenho me sentido ansioso kkkkk até me lembrou de marcar psiquiatra obg&quot;}|||{&quot;category&quot;: &quot;Embotamento afetivo&quot;, &quot;content&quot;: &quot;Tem certeza que é bupropiona? Bateu diferente, parece que é mistura de raiva com vontade de resolver tudo em um dia. Parece até que os divertidamente saíram do home office&quot;}|||{&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;Mana, tu é a única pessoa além de mim que eu conheço que tomou Bupropiona e engordou. Eu tomei por três meses, engordei seis quilos nesse tempo e passei a roncar tão alto que nem meu marido queria dormir ao meu lado. Parei, sigo só com o Escitalopram.&quot;}|||{&quot;category&quot;: &quot;Libido&quot;, &quot;content&quot;: &quot;é lindo como a bupropiona melhora a libido. no ssri eu estava 'se eu nunca mais transar na minha vida por mim está ótimo' \n\ncom a bupropiona eu estou 'eu provavelmente ia começar a sentir falta se passasse uns 2 meses sem dar'&quot;}|||{&quot;category&quot;: &quot;Confusão&quot;, &quot;content&quot;: &quot;cara acabei de tomar meus remedios ne sendo que assim que engoli eles fiquei com uma sensação de que ja tinha tomado de manha e agr to achando que meti 200mg de desvenlafaxina e 600mg de bupropiona para dentro so hoje vei to com medo&quot;}" />
          <attvalue for="3" value="5" />
          <attvalue for="4" value="9" />
          <attvalue for="5" value="2.015473 -0.285480" />
          <attvalue for="6" value="#2DCD9F" />
        </attvalues>
      </node>
      <node id="Fluvoxamina" label="Fluvoxamina">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="14" />
          <attvalue for="2" value="{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;quetiapina só me da sono, eu uso pra dormir, nao ajuda mto com ansiedade, talvez precise de um medicamento que age com mais foco \neu tomo escitalopram, bupropiona e fluvoxamina e mesmo assim tenho me sentido ansioso kkkkk até me lembrou de marcar psiquiatra obg&quot;}|||{&quot;category&quot;: &quot;Somnolência&quot;, &quot;content&quot;: &quot;aaaaaahhhhh, é por causa do aumento da dose. um dos efeitos da fluvoxamina é a sonolência mesmo, talvez seja isso que tá te deixando pra baixo. em alguns casos a sonolência com o tempo, voce tá tomando de noite?&quot;}|||{&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;Até agr a fluvoxamina tá sendo o melhor remédio de gente dodói da cabeça que eu já tomei&quot;}|||{&quot;category&quot;: &quot;Refluxo&quot;, &quot;content&quot;: &quot;Eu fiquei quase 1 ano com refluxo e azia também, por conta de efeito colateral de um remédio que eu tomava (fluvoxamina), destruiu meu estômago, e depois de meses de desmame, 90% dele sarou completamente\n\nTalvez você esteja tomando um remédio que não te faça bem?&quot;}|||{&quot;category&quot;: &quot;Azia&quot;, &quot;content&quot;: &quot;Eu fiquei quase 1 ano com refluxo e azia também, por conta de efeito colateral de um remédio que eu tomava (fluvoxamina), destruiu meu estômago, e depois de meses de desmame, 90% dele sarou completamente\n\nTalvez você esteja tomando um remédio que não te faça bem?&quot;}|||{&quot;category&quot;: &quot;Reações alérgicas&quot;, &quot;content&quot;: &quot;e antes dessa praga tomei outra praga: fluvoxamina. me sentia doente, fraca e me deixou uma reação adversa que até hoje não passou.&quot;}|||{&quot;category&quot;: &quot;Sleepiness&quot;, &quot;content&quot;: &quot;tropa da fluvoxamina não ganha bom dia porque não consegue acordar de manhã&quot;}|||{&quot;category&quot;: &quot;Ansiedade&quot;, &quot;content&quot;: &quot;antes eu tomava desvenlafaxina junto e nao sentia esse problema tanto assim, era bem facil de arrumar meu horario, eu acredito q seja do remedio pq eu n mudei nada alem de ter feito o desmame da desvenlafaxina e ter aumentado a dose da fluvoxamina&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;fml tem alguem aqui que toma maleato de fluvoxamina (luvox/revoc) e tem problema com sono excessivo? minha psiquiatra falou q isso podia acontecer mas recentemente tem me dado mto problema\neu to com o sono errado mesmo mas mesmo quando eu tava dormindo cedo eu tinha muito problema pra acordar cedo 💀&quot;}|||{&quot;category&quot;: &quot;Embotamento afetivo&quot;, &quot;content&quot;: &quot;estou tão irritada com tantas coisas que não consigo nem colocar em palavras fluvoxamina amorteça imediatamente minhas emoções!!!!!!&quot;}|||{&quot;category&quot;: &quot;Vômito&quot;, &quot;content&quot;: &quot;meu remedio pra ANOREXIA tem como sintoma comum ANOREXIA E VOMITO \n\nsave me maleato de fluvoxamina save me&quot;}|||{&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Se eu dormir 2 horinhas essa noite eu tô feliz mas vou usar o último pico da fluvoxamina pra viver e depois é só botada nas cachorra&quot;}|||{&quot;category&quot;: &quot;Sudorese&quot;, &quot;content&quot;: &quot;fluvoxamina 100mg está fazendo minhas mões suarem&quot;}|||{&quot;category&quot;: &quot;Alucinação&quot;, &quot;content&quot;: &quot;ontem mesmo estava pensando que os sonhos malucos de fluvoxamina tinham passado pois essa noite eles voltaram com força total remexendo coisas insuperáveis de passado presente e futuro&quot;}" />
