      <node id="Trazodona" label="Trazodona">
        <attvalues>
          <attvalue for="0" value="medication" />
          <attvalue for="1" value="90" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Síncope&quot;, &quot;content&quot;: &quot;aaa accidentally took trazodone instead of my escitalopram and now i feel like im gonna pass out&quot;}, {&quot;category&quot;: &quot;Ganho de peso&quot;, &quot;content&quot;: &quot;soi diagnosticada com bipolaridade, borderline, depressão e ansiedade generalizada, e tomo bupropiona, trazodona, buspirona e lamotrigina 🙏 pelo oq eu pesquisei n dá ganho de peso mas se vcs souberem que algum engorda me digam pfvr / eu antes e depois mas meu menor peso ainda foi fucking 65kg&quot;}, {&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;Tu tá ruim com ele e eu com a Trazodona depois de ter ficado 10 dias sem tomar por falta de receita! O problema é que já tem 15 dias q voltei e ainda tô à base de Vonau🥺&quot;}, {&quot;category&quot;: &quot;Comportamento impulsivo&quot;, &quot;content&quot;: &quot;Me sentindo ousadah hoje (tomei 2 comprimidos de trazodona)&quot;}, {&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;primeiro episódio de insônia em três semanas de trazodona patrocinado por congestão nasal e estômago vazio&quot;}, {&quot;category&quot;: &quot;Congestão nasal&quot;, &quot;content&quot;: &quot;primeiro episódio de insônia em três semanas de trazodona patrocinado por congestão nasal e estômago vazio&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;a doutora quer que eu continue no trazodona mas eu tô sempre acordando em cima da hora pq meu corpo deseja dormir mais do que o normal 😵‍💫&quot;}, {&quot;category&quot;: &quot;Pesadelos&quot;, &quot;content&quot;: &quot;foda que hj tenho que tomar trazodona pra dormir ja que meu amado remedio acabou e é tarja preta e consulta só na terça pqp\n\nodeio mt esse remedio sempre tenho pesadelo ou sonhos completamente perturbadores&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;cara tomei a porra da trazodona, não deu nem 30min e comecei a sentir uma tontura e náusea do caralho&quot;}, {&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;cara tomei a porra da trazodona, não deu nem 30min e comecei a sentir uma tontura e náusea do caralho&quot;}, {&quot;category&quot;: &quot;Estado confusional&quot;, &quot;content&quot;: &quot;Não era nada MT pesado, eu tomei trazodona uma época e um outro que eu não lembro o nome, mas eu só acordava c uns flashs de SLA saindo pra praça, fumar um cigarro c uns noia e voltar p casa&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Finalmente começar esse (fotinha de ontem, a trazodona bateu e esqueci de postar)&quot;}, {&quot;category&quot;: &quot;Esquecimento&quot;, &quot;content&quot;: &quot;Finalmente começar esse (fotinha de ontem, a trazodona bateu e esqueci de postar)&quot;}, {&quot;category&quot;: &quot;Dor de cabeça&quot;, &quot;content&quot;: &quot;isso porque ao inves de tomar a trazodona e ir dormir eu decidi Fazer Um Milhao De Coisas pois afinal sou capaz de todas elas. e agora eu queria Fazer Mais Outro Milhao De Coisas porque AFINAL quem precisa DORMIR? NOT ME, e a cabeça faz (fisicamente) buonnnn buonnnnn buonnnnn e eu queria jogar minec&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Exagerei no trazodona ontem e agora to lesada&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Começei a tomar trazodona de novo, tomei de manhã e tô com um sono do caralho aí dps vi na receita que era p eu tomar de noite msm&quot;}, {&quot;category&quot;: &quot;Esquecimento&quot;, &quot;content&quot;: &quot;O duro é que a trazodona afeta a memória, hoje esqueci o número da minha casa mas tudo bem&quot;}, {&quot;category&quot;: &quot;Alterações do sono&quot;, &quot;content&quot;: &quot;Eu tomo trazodona pra dormir, durmo bem pesado, daí os sonhos são bem vividos :x&quot;}, {&quot;category&quot;: &quot;Sensação de confusão mental&quot;, &quot;content&quot;: &quot;O trazodona deixa minha cabecinha bem aleatória na hora do sono, amo&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;meu corpo tá realmente em abstinência de sonic (trazodona)&quot;}, {&quot;category&quot;: &quot;Sedação&quot;, &quot;content&quot;: &quot;as vezes um sorvetinho chapado de trazodona enquanto chora com turnover peripheral vision full album 2015 eh janta sim&quot;}, {&quot;category&quot;: &quot;Sedação&quot;, &quot;content&quot;: &quot;zolpidem eu nunca tomei não!! o clonazepam o médico não passou pra dormir, foi só pra crise mesmo\n\nantes eu tomava trazodona e parecia que eu entrava em coma de tanto dormir kk&quot;}, {&quot;category&quot;: &quot;Sensações estranhas&quot;, &quot;content&quot;: &quot;Acontecia comigo ao associar Trazodona e Zolpidem. É uma sensação estranha de não saber se ocorreu mesmo ou não.&quot;}, {&quot;category&quot;: &quot;Esquecimento&quot;, &quot;content&quot;: &quot;caralho to tentando lembrar qq trazodona fez de tão ruim em mim mas acho q nao lembrar de absolutamente nada ja eh bem sugestivo&quot;}, {&quot;category&quot;: &quot;Náusea&quot;, &quot;content&quot;: &quot;O meu psiquiatra me dá receita para 2 meses certinho, inclusive dia 08 tô lá para falar com ele que a trazodona que ele colocou junto com os outros remédios até funcionou pra eu dormir mas a que preço? To bem enjoado e sem comer direito há 1 mês, perdi uns 2-3 kg já&quot;}, {&quot;category&quot;: &quot;Alteração do apetite&quot;, &quot;content&quot;: &quot;O meu psiquiatra me dá receita para 2 meses certinho, inclusive dia 08 tô lá para falar com ele que a trazodona que ele colocou junto com os outros remédios até funcionou pra eu dormir mas a que preço? To bem enjoado e sem comer direito há 1 mês, perdi uns 2-3 kg já&quot;}, {&quot;category&quot;: &quot;Perda de peso&quot;, &quot;content&quot;: &quot;O meu psiquiatra me dá receita para 2 meses certinho, inclusive dia 08 tô lá para falar com ele que a trazodona que ele colocou junto com os outros remédios até funcionou pra eu dormir mas a que preço? To bem enjoado e sem comer direito há 1 mês, perdi uns 2-3 kg já&quot;}, {&quot;category&quot;: &quot;Insônia&quot;, &quot;content&quot;: &quot;dormi pouco e mal de ontem pra hoje, tomei 300mg de trazodona e ainda assim não consigo dormir. queria que meu corpo me odiasse MENOS&quot;}, {&quot;category&quot;: &quot;Espasmos nas pernas&quot;, &quot;content&quot;: &quot;Eu tomo trazodona e tenho uns espasmos nas pernas.&quot;}, {&quot;category&quot;: &quot;Pesadelos&quot;, &quot;content&quot;: &quot;Sabe que no meu também não? Mas eu tomava trazodona e deu certo por um tempo, mas me fazia ter uns sonhos muito vívidos e isso meio que estraga o objetivo. Além disso eu passava a manhã toda mau humorada com sono.&quot;}, {&quot;category&quot;: &quot;Irritabilidade&quot;, &quot;content&quot;: &quot;Sabe que no meu também não? Mas eu tomava trazodona e deu certo por um tempo, mas me fazia ter uns sonhos muito vívidos e isso meio que estraga o objetivo. Além disso eu passava a manhã toda mau humorada com sono.&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Sabe que no meu também não? Mas eu tomava trazodona e deu certo por um tempo, mas me fazia ter uns sonhos muito vívidos e isso meio que estraga o objetivo. Além disso eu passava a manhã toda mau humorada com sono.&quot;}, {&quot;category&quot;: &quot;Sabor desagradável&quot;, &quot;content&quot;: &quot;cara pq a trazodona tem esse gosto HORRIVEL eh obrigatório remedio que da onda te matar no processo????? misericordia sabe pior q alprazolam&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;vou tomar 4 trazodona quero ver nao acordar 100% recuperada nem me lembrando de nada&quot;}, {&quot;category&quot;: &quot;Esquecimento&quot;, &quot;content&quot;: &quot;vou tomar 4 trazodona quero ver nao acordar 100% recuperada nem me lembrando de nada&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Tô tão limpa de remédio que achei um comprimido de trazodona aqui, parti em 4 pedaços e tomei o menor pq tava ansiosa, agora tô grogue grogue ableblebleeeeee \n(Antes eu tomava vários e ficava assim 😳😐&quot;}, {&quot;category&quot;: &quot;Pesadelos&quot;, &quot;content&quot;: &quot;trazodona me faz ter os sonhos mais bizarros possíveis&quot;}, {&quot;category&quot;: &quot;Comprometimento cognitivo&quot;, &quot;content&quot;: &quot;Y hoy bien ?\n\nA mí me han mandado una cosa llamada trazodona que no me acaba de gustar. Me levanto tonto.\n\nÁnimo 🫂&quot;}, {&quot;category&quot;: &quot;Sedação&quot;, &quot;content&quot;: &quot;do nada o trazodona bate, só resta me entregar&quot;}, {&quot;category&quot;: &quot;Sonhos intranquilos&quot;, &quot;content&quot;: &quot;Primeira vez na semana que consigo dormir 8h sem problemas...tive sonhos intranquilos, mas nada comparado a ficar acordando a noite toda\nObrigada, trazodona&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Não faz nem cócegas kk amiga eu tomo cerca de 3 remédios e todos dão sono: atualmente só o zolps ou a trazodona me apagam, mas a que custo....&quot;}, {&quot;category&quot;: &quot;Letargia&quot;, &quot;content&quot;: &quot;Podia tomar trazodona ou victan mas os dois me deixam super pra baixo pqp no outro dia eu viro um zumbi&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Podia tomar trazodona ou victan mas os dois me deixam super pra baixo pqp no outro dia eu viro um zumbi&quot;}, {&quot;category&quot;: &quot;Tontura&quot;, &quot;content&quot;: &quot;Voltei a tomar trazodona pra dormir e estou sentindo muito efeito colateral, que o médico prometeu que não ia ter. Tontura, sensação de corpo pesado, dificuldade até pra andar, muito muito sono e o mais estranho: dores musculares (?).&quot;}, {&quot;category&quot;: &quot;Fadiga&quot;, &quot;content&quot;: &quot;Voltei a tomar trazodona pra dormir e estou sentindo muito efeito colateral, que o médico prometeu que não ia ter. Tontura, sensação de corpo pesado, dificuldade até pra andar, muito muito sono e o mais estranho: dores musculares (?).&quot;}, {&quot;category&quot;: &quot;Fraqueza muscular&quot;, &quot;content&quot;: &quot;Voltei a tomar trazodona pra dormir e estou sentindo muito efeito colateral, que o médico prometeu que não ia ter. Tontura, sensação de corpo pesado, dificuldade até pra andar, muito muito sono e o mais estranho: dores musculares (?).&quot;}, {&quot;category&quot;: &quot;Mialgia&quot;, &quot;content&quot;: &quot;Voltei a tomar trazodona pra dormir e estou sentindo muito efeito colateral, que o médico prometeu que não ia ter. Tontura, sensação de corpo pesado, dificuldade até pra andar, muito muito sono e o mais estranho: dores musculares (?).&quot;}, {&quot;category&quot;: &quot;Sedação&quot;, &quot;content&quot;: &quot;eu odiei trazodona pq é sedativo de um jeito ruim… ai nao tomava so acumulava medicação… \nmas a nortriptilina foi perfeita, me estabilizou bastante na gestação e ate agora não tenho nada ruim sobre&quot;}, {&quot;category&quot;: &quot;Síncope&quot;, &quot;content&quot;: &quot;pior que não faço ideia pois a trazodona só me desmaia&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Que tristezaaa\nRivotril perde o efeito com o tempo\nEu uso trazodona (q é um antidepressivo e dá soninho)&quot;}, {&quot;category&quot;: &quot;Embotamento emocional&quot;, &quot;content&quot;: &quot;to com vontade de chorar mas acabo de perceber que a fluoxetina e  trazodona secaram minhas lágrimas&quot;}, {&quot;category&quot;: &quot;Fadiga&quot;, &quot;content&quot;: &quot;comecei a tomar um novo remédio trazodona 300 mg e parece que passou um caminhão por cima de mim, só tenho energia para ficar deitada se eu levantar fia dá vontade de sentar imediatamente e nunca mais sair da cama&quot;}, {&quot;category&quot;: &quot;Sedação&quot;, &quot;content&quot;: &quot;Eu fico bêbado tão fácil, obrigado trazodona&quot;}, {&quot;category&quot;: &quot;Sonhos bizarros&quot;, &quot;content&quot;: &quot;Como pode a trazodona, um comprimido tão pequeno, te fazer dormir tão profundamente e ter sonhos tão bizarros.&quot;}, {&quot;category&quot;: &quot;Perda de peso&quot;, &quot;content&quot;: &quot;ALEM DE VENLAFAXINA ELE ME RECEITOU TRAZODONA TAMBEM E EU LI QUE UM DOS EFEITOS COLATERAIS É A PERDA DE PESO !!! 🥳🥳🥳🥳🎉🎉🎉🎉🎉🎊&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Tomei um trazodona ontem pra induzir meu sono e tô 2h atrasada pro trabalho 😭 puta que pariu&quot;}, {&quot;category&quot;: &quot;Pesadelos&quot;, &quot;content&quot;: &quot;Adoro os sonhos que eu tenho depois de beber e tomar trazodona, só loucura&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;esse trazodona nao ta me fazendo bem nao eu to sempre acordando dopada e fico assim o dia inteiro&quot;}, {&quot;category&quot;: &quot;Alterações sensoriais&quot;, &quot;content&quot;: &quot;usar na web nI eh tão ruim assim tô medicada com 20mg de zolpidem e 50mg de trazodona e eu tô sentindo tud9 flutuar aí tinha duS ssnhS cantando music de cinderela ela eh a da coraline indo pro jardim das 9oanras rosas r9xos diversas correr&quot;}, {&quot;category&quot;: &quot;Sedação&quot;, &quot;content&quot;: &quot;eu o dia todo dopada de escitalopram lamotrigina trazodona rivotril nicotina cafeína e nada me ajuda nessa porra&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;400mg de trazodona deixa o sujeito igual uma folha de papel a4 colorida do senninha&quot;}, {&quot;category&quot;: &quot;Sedação&quot;, &quot;content&quot;: &quot;400mg de trazodona deixa o sujeito igual uma folha de papel a4 colorida do senninha&quot;}, {&quot;category&quot;: &quot;Fraqueza&quot;, &quot;content&quot;: &quot;400mg de trazodona deixa o sujeito igual uma folha de papel a4 colorida do senninha&quot;}, {&quot;category&quot;: &quot;Distúrbios gastrointestinais&quot;, &quot;content&quot;: &quot;quando eu dropo duas trazodona pra mimir e da vontade de ir no banheiro:&quot;}, {&quot;category&quot;: &quot;Viagem ruim&quot;, &quot;content&quot;: &quot;tão bom dormir com o efeito de alprazolam a paz e calmaria do dia seguinte, nem parece que passou um trator por cima de mim usando agora trazodona, que viagem ruim Vey&quot;}, {&quot;category&quot;: &quot;Síncope&quot;, &quot;content&quot;: &quot;to a 2 dias sem a trazodona e parece que vou desmaiar a qualquer instante !&quot;}, {&quot;category&quot;: &quot;Dificuldades de processamento cognitivo&quot;, &quot;content&quot;: &quot;SIM\neu amo que tomo Atentah pra ficar Atentah\nE trazodona de noite, que aí meu pensamento fica atrazadona HDKSNJDJSJD&quot;}, {&quot;category&quot;: &quot;Pesadelos&quot;, &quot;content&quot;: &quot;eu: trazodona é tranquilo sim\n\ntrazodona: toma esse sonho em q gisele bundchen te convida p uma suruba com ela + lula + tom cruise + um mordomo velho, isso sendo prelúdio p uma história pós apocalíptica estilo anime q é uma metáfora sobre a exploração da força de trabalho feminina pelo capitalismo&quot;}, {&quot;category&quot;: &quot;Sedação&quot;, &quot;content&quot;: &quot;hoje foi o primeiro dia com trazodona, e puta que pariu, parede que levei uma pedrada&quot;}, {&quot;category&quot;: &quot;Pesadelos&quot;, &quot;content&quot;: &quot;Trazodona e os sonhos malucos. Eu tive 2 sonhos xaropes essa noite. \n\nSonho 1: eu jogava um game, que tinha um mafioso e toda vez que eu matava ele, o maldito voltava mais forte e me perseguia. O problema é que eu desligava o game e ele aparecia na vida real, mandando vários bonecos atrás de mim.&quot;}, {&quot;category&quot;: &quot;Sabor desagradável&quot;, &quot;content&quot;: &quot;amo o meu trazodona mas é a coisa mais horrenda de ruim que já coloquei na boca na minha vida&quot;}, {&quot;category&quot;: &quot;Fraqueza&quot;, &quot;content&quot;: &quot;tomei trazodona ontem pela 1a vez e hoje to MOLE obg por me amolecer filho da puta só quero dormir por 13h seguidas 👍&quot;}, {&quot;category&quot;: &quot;Sedação&quot;, &quot;content&quot;: &quot;tomei trazodona ontem pela 1a vez e hoje to MOLE obg por me amolecer filho da puta só quero dormir por 13h seguidas 👍&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;So setralina com trazodona me fez dormir… nem zolpidem me apagava&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;Tomei 3 trazodona e 2 clonazepam , qro ver eu acordar amanhã 😈😈😈&quot;}, {&quot;category&quot;: &quot;Alteração do apetite&quot;, &quot;content&quot;: &quot;acho que é a trazodona mesmo que tá diminuindo meu apetite, nos ultimos dois dias eu não tomei e to com uma fome absurda&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;tomo trazodona também!! como tá sendo sua experiência? eu tomo 100mg e tô tentando passar p 75mg mas eu tenho q ter umas 10-11 horas de sono senão eu fico com muita sonolência durante o dia&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;você acha que se tiver 8 horas se sono é o suficiente pra ele ? tô pensando em comprar ele, eu tomo trazodona mas tá insustentável tem q dormir 10-11 hrs por dia p conseguir viver&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;eu tomo trazodona de 100 mg, já tomei 50mg de trazodona + 15mg de quetiapina mas sempre tive q dormir umas 10 horas pra não sentir muito sono durante o dia, vou ver o q ele passa amg, obrigada pela ajuda meu amor&quot;}, {&quot;category&quot;: &quot;Sedação&quot;, &quot;content&quot;: &quot;Chapadinha de trazodona&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;as vezes é adaptação amor, mas vê com ele sobre trocar, eu tomo trazodona 100mg mas eu preciso dormir tipo 10-11 hrs p conseguir me sentir viva no resto do dia&quot;}, {&quot;category&quot;: &quot;Letargia&quot;, &quot;content&quot;: &quot;as vezes é adaptação amor, mas vê com ele sobre trocar, eu tomo trazodona 100mg mas eu preciso dormir tipo 10-11 hrs p conseguir me sentir viva no resto do dia&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;queria saber a experiência das pessoas com a trazodona, eu tô com uma dose maior e tô tendo q dormir unas 10 horas senão fico c ressaca de sono&quot;}, {&quot;category&quot;: &quot;Sonolência&quot;, &quot;content&quot;: &quot;E eu q na correria hoje tomei trazodona ao invés de escitalopram AGR tô morrendo de sono&quot;}, {&quot;category&quot;: &quot;Síndrome de abstinência&quot;, &quot;content&quot;: &quot;Meio que curtindo muito a nóia de abstinência da trazodona amo (tirei pq me deu na telha&quot;}, {&quot;category&quot;: &quot;Pesadelos&quot;, &quot;content&quot;: &quot;A parte boa é que tenho trazodona suficiente pra passar dois meses tendo sonhos malucos, fora a venlafaxina. Primeira vez em quatro dias que o humor tá estável, pelo menos.&quot;}, {&quot;category&quot;: &quot;Visão turva&quot;, &quot;content&quot;: &quot;tomei 1 trazodona e ja to enxergandk torto espero que fudo jsso tenha sido um pesadelo twitter nunca acabou&quot;}, {&quot;category&quot;: &quot;Pesadelos&quot;, &quot;content&quot;: &quot;tomei 1 trazodona e ja to enxergandk torto espero que fudo jsso tenha sido um pesadelo twitter nunca acabou&quot;}, {&quot;category&quot;: &quot;Fadiga&quot;, &quot;content&quot;: &quot;a trazodona me faz sentir que peso o dobro, então preciso do dobro do esforço pra me movimentar também, subir as escadas da escola tem sido um pesadelo&quot;}, {&quot;category&quot;: &quot;Interação medicamentosa&quot;, &quot;content&quot;: &quot;Trazodona en España: ↑uso en ancianos con ↑indicación off-label y ↑interacciones potenciales. Nuevo estudio #BIFAP http://ow.ly/DcOJ307WiXo&quot;}]" />
