      <node id="Boca seca" label="Boca seca">
        <attvalues>
          <attvalue for="0" value="adr" />
          <attvalue for="1" value="16" />
          <attvalue for="2" value="[{&quot;category&quot;: &quot;Fluoxetina&quot;, &quot;content&quot;: &quot;Lembrando da música:\n\nFluoxetine, fluoxetine\nParoxetine, paroxetine\nCitalopram, citalopram\nMay cause dry mouth\n\nQueria que essa última parte não tivesse tão presente agora kkkring&quot;}, {&quot;category&quot;: &quot;Paroxetina&quot;, &quot;content&quot;: &quot;Lembrando da música:\n\nFluoxetine, fluoxetine\nParoxetine, paroxetine\nCitalopram, citalopram\nMay cause dry mouth\n\nQueria que essa última parte não tivesse tão presente agora kkkring&quot;}, {&quot;category&quot;: &quot;Citalopram&quot;, &quot;content&quot;: &quot;Lembrando da música:\n\nFluoxetine, fluoxetine\nParoxetine, paroxetine\nCitalopram, citalopram\nMay cause dry mouth\n\nQueria que essa última parte não tivesse tão presente agora kkkring&quot;}, {&quot;category&quot;: &quot;Sertralina&quot;, &quot;content&quot;: &quot;nenhum remédio para ansiedade fez efeito para mim, nem no humor, nem sono, nada, tirando a sertralina capaz de secar um oceano inteiro\n\no que eu senti mesmo foi a abstinência quando parei de tomar. credo, que sensação horrível de lembrar, parecia que tinha perdido meu cérebro&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;1 dia sem bupropiona. Boca já está menos seca, diminuiu o trismo. Humor um pouco mais rebaixado.&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;Escitalopram nunca usei, vamos ver como vai ser\nBupropiona não senti mudança no apetite nem na raiva mas em compensação secou minha boca toda, fiquei igual o bob esponja na casa da sandy, eu não tinha 1 gota de saliva, era desesperador&quot;}, {&quot;category&quot;: &quot;Bupropiona&quot;, &quot;content&quot;: &quot;bupropiona aquela gala seca&quot;}, {&quot;category&quot;: &quot;Mirtazapina&quot;, &quot;content&quot;: &quot;Leyendoun vademécum parece que lo del sueño parece que es su mayor efecto adverso y lo de la boca seca tb.&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Comecei a ter o efeito colateral de boca seca da desvenlafaxina. Não tem água que eu beba que consiga manter meus lábios hidratados, que infernooooo.&quot;}, {&quot;category&quot;: &quot;Desvenlafaxina&quot;, &quot;content&quot;: &quot;Entre os efeitos colaterais mais comuns da Desvenlafaxina estão náusea, dor de cabeça, tontura, boca seca e aumento da sudorese.\n\n#saudemental&quot;}, {&quot;category&quot;: &quot;Duloxetina&quot;, &quot;content&quot;: &quot;La duloxetina y el aripiprazol me tienen tomando demasiada agua xD\n\nThe duloxetine and the aripiprazole it’s making to me drink too much water&quot;}, {&quot;category&quot;: &quot;Aripiprazol&quot;, &quot;content&quot;: &quot;La duloxetina y el aripiprazol me tienen tomando demasiada agua xD\n\nThe duloxetine and the aripiprazole it’s making to me drink too much water&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;como pode uma única unidade de amitriptilina e uma de flunarizina tomadas há mais de 12 horas seguir me deixando completamente grogue\nalém do sono tem também boca seca e gosto estranho\neu espero muito que passe logo&quot;}, {&quot;category&quot;: &quot;Flunarizina&quot;, &quot;content&quot;: &quot;como pode uma única unidade de amitriptilina e uma de flunarizina tomadas há mais de 12 horas seguir me deixando completamente grogue\nalém do sono tem também boca seca e gosto estranho\neu espero muito que passe logo&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;Eu sou um viciado de merda dependente de cigarro, eu tô tremendo pra cacete pq não achei a porra de um cigarro, tomei 4 amitriptilina pra me acalmar e Agr minha boca tá extremamente seca Urgh&quot;}, {&quot;category&quot;: &quot;Amitriptilina&quot;, &quot;content&quot;: &quot;Rapaz amitriptilina faz dormir um soninho bom né, mas de manhã é só a boca seca e o corpo mole \nUma batalha p acordar kkkkk&quot;}]" />
          <attvalue for="3" value="11" />
